function txtFourPeriodGap(a,b){
  // 同日期号差几期；跨日或无法比 → 大数（视为飘太远）
  a=String(a||"").replace(/\D/g,"");
  b=String(b||"").replace(/\D/g,"");
  if(!a||!b)return 999;
  if(a===b)return 0;
  if(a.length===b.length&&a.length>=11&&a.slice(0,8)===b.slice(0,8)){
    var ga=Math.abs(Number(a.slice(8))-Number(b.slice(8)));
    return isFinite(ga)?ga:999;
  }
  if(a.length>=8&&b.length>=8&&a.slice(0,8)!==b.slice(0,8))return 999;
  return 999;
}
