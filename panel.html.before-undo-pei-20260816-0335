      details.push({kind:"hewei",text:h.label+"杀"+h.digit,actual:actual,ok:ok});
      if(!ok)allOk=false;
    }
    return {
      period:String(ev.targetPeriod||pred.basePeriod||pred.baseUid||""),
      allOk:allOk,
      posOk:posOk,
      details:details,
      picks:posTop.map(function(x){return x.label+"-"+x.digit;}).concat(hew.top2.map(function(x){return x.label+"杀"+x.digit;}))
    };
  }
  function fourDingPosTop3ComboStats(data){
