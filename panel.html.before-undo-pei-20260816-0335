        if(status===403)throw txtPositionMakeError("当前账号没有读取 RDS 转换历史的权限","PANEL_HISTORY_FORBIDDEN",false);
        if(status===503)throw txtPositionMakeError("共享 RDS 历史尚未追平当前期","RDS_HISTORY_NOT_READY",true);
        if(status===429)throw txtPositionMakeError("历史接口请求过快，正在退避重试","RDS_HISTORY_RATE_LIMITED",true);
        throw txtPositionMakeError("RDS 转换历史接口返回 HTTP "+(status||"未知"),"RDS_HISTORY_HTTP_"+(status||"UNKNOWN"),status>=500||status===0);
      }
      return res.json().catch(function(){
        throw txtPositionMakeError("RDS 转换历史接口返回了无效 JSON","RDS_HISTORY_JSON_INVALID",true);
      });
    }).catch(function(err){
      if(err&&typeof err.retryable==="boolean")throw err;
      if(err&&err.name==="AbortError")throw txtPositionMakeError("RDS 转换历史请求超过 15 秒","RDS_HISTORY_TIMEOUT",true);
      throw txtPositionMakeError("RDS 转换历史请求失败："+(err&&err.message?err.message:String(err||"网络异常")),"RDS_HISTORY_NETWORK",true);
    }).finally(function(){if(timer)clearTimeout(timer);});
  }
  function verifiedConverterHistoryRows(payload,expectedPeriod){
    var rows=Array.isArray(payload&&payload.history)?payload.history:[];
    var sharedSource=String(payload&&payload.sharedHistorySource||"").toLowerCase();
    var sharedPeriod=String(payload&&payload.sharedHistoryLatestPeriod||"");
    var rdsPeriod=String(payload&&payload.sharedHistoryRdsLatestPeriod||"");
    var first=rows[0]||{};
    var firstPeriod=String((first.period!=null&&first.period!=="")?first.period:(first.uid||""));
    if(!payload||payload.ok!==true)throw txtPositionMakeError(payload&&payload.error||"RDS 转换历史不可用","RDS_HISTORY_NOT_READY",true);
    if(sharedSource!=="rds")throw txtPositionMakeError("共享历史来源尚未切换到 RDS","RDS_SOURCE_NOT_READY",true);
    if(!rows.length)throw txtPositionMakeError("RDS 转换历史为空","RDS_HISTORY_EMPTY",true);
    if(!sharedPeriod||!rdsPeriod||sharedPeriod!==rdsPeriod)throw txtPositionMakeError("共享历史期号尚未追平 RDS","RDS_PERIOD_LAGGING",true);
    if(expectedPeriod&&(sharedPeriod!==String(expectedPeriod)||firstPeriod!==String(expectedPeriod))){
      throw txtPositionMakeError("RDS 最新期 "+(sharedPeriod||firstPeriod||"空")+" 与当前期 "+expectedPeriod+" 不一致","RDS_PERIOD_LAGGING",true);
    }
    var firstNumbers=Array.isArray(first&&first.numbers)?first.numbers:[];
    if(!/^\d+$/.test(firstPeriod)||!String(first&&first.opentime||"").trim()||firstNumbers.length<4||firstNumbers.slice(0,4).some(function(value){return !/^\d$/.test(String(value));})){
      throw txtPositionMakeError("RDS 当前期记录尚未包含真实期号、开奖时间和前四位号码","RDS_LATEST_ROW_PENDING",true);
    }
    return rows;
  }
  function fetchVerifiedConverterHistory(limit,expectedPeriod){
    return txtPositionFetchJson("/converter-history?limit="+Math.max(1,Math.min(5000,Number(limit||1))),TXT_POSITION_HISTORY_FETCH_TIMEOUT_MS)
      .then(function(payload){return verifiedConverterHistoryRows(payload,expectedPeriod);});
  }
  function ensureVerifiedConverterHistoryCache(minCount,expectedPeriod,forceRefresh){
    var need=Math.max(1,Number(minCount||2000)||2000);
    var limit=Math.min(5000,Math.max(need,2000));
    var cached=Array.isArray(window.__penta5HistoryCache)?window.__penta5HistoryCache:[];
    var first=cached[0]||{};
    var cachedPeriod=String((first.period!=null&&first.period!=="")?first.period:(first.uid||""));
    if(!forceRefresh&&cached.length>=need&&(!expectedPeriod||cachedPeriod===String(expectedPeriod)))return Promise.resolve(cached);
    var requestKey=String(expectedPeriod||"")+"|"+String(limit);
    if(verifiedConverterHistoryPromise&&verifiedConverterHistoryPromiseKey===requestKey)return verifiedConverterHistoryPromise;
    var request=fetchVerifiedConverterHistory(limit,expectedPeriod).then(function(rows){
      window.__penta5HistoryCache=rows;
      return rows;
    });
    verifiedConverterHistoryPromise=request;
    verifiedConverterHistoryPromiseKey=requestKey;
    return request.finally(function(){
      if(verifiedConverterHistoryPromise===request){
        verifiedConverterHistoryPromise=null;
        verifiedConverterHistoryPromiseKey="";
      }
    });
  }
  window.__penta5EnsureVerifiedConverterHistoryCache=ensureVerifiedConverterHistoryCache;
  window.__penta5VerifyConverterHistoryPeriod=function(expectedPeriod){
    return fetchVerifiedConverterHistory(1,expectedPeriod).then(function(rows){return rows[0]||null;});
  };
  function startPanelLoop(){
    if(panelLoopStarted)return;
    panelLoopStarted=true;
    panelBootReady=false;
    initPanelChrome();
    
    initTxtConverter();
    if(!window.__peiCopyBound){
      window.__peiCopyBound=true;
      document.addEventListener("click",function(event){
        var btn=event.target&&event.target.closest?event.target.closest("#sixPeiSixCopyBtn,#fivePeiFiveCopyBtn"):null;
        if(!btn)return;
        var isSix=btn.id==="sixPeiSixCopyBtn";
        var fallback=isSix?"":"42368配52147四定";
        var shot=document.getElementById(isSix?"sixPeiSixPublicShot":"fivePeiFivePublicShot");
        var text=shot&&shot.textContent?String(shot.textContent||fallback).trim():fallback;
        if(!text||text==="等待生成")return;
        var status=document.getElementById(isSix?"sixPeiSixCopyStatus":"fivePeiFiveCopyStatus");
        function done(){if(status)status.textContent="已复制："+text;}
        if(navigator.clipboard&&navigator.clipboard.writeText){
          navigator.clipboard.writeText(text).then(done).catch(function(){done();});
        }else{
          done();
        }
      });
    }
    if(typeof initTxtPositionDocumentClicks==="function")initTxtPositionDocumentClicks();
    window.__penta5PanelRefresh=refresh;
    window.loadState=function(){return refresh(true,{source:"user"});};
    window.__penta5ManualSync=async function(){
      try{
        setStatus("正在手动同步...",true);
        panelFetch("/sync",{
          method:"POST",
          cache:"no-store",
          headers:{"Content-Type":"application/json"},
          body:JSON.stringify({trigger:"manual"})
        }).catch(function(err){
          console.warn("manual sync failed",err);
          setStatus("同步失败："+(err&&err.message?err.message:err),false);
        });
        for(var i=0;i<120;i+=1){
          await refresh(false,{source:"user"});
          if(!state||!state.syncing)break;
          await new Promise(function(r){setTimeout(r,800);});
        }
        if(state&&!state.syncing)setStatus("远程同步成功",true);
      }catch(err){
        setStatus("同步失败："+(err&&err.message?err.message:err),false);
      }
    };
    window.manualSync=window.__penta5ManualSync;
    setStatus("页面已打开，正在准备读取数据...",true);
    setTimeout(function(){
      Promise.resolve(ensureQpSealKeyFromLoginTemp()).catch(function(){}).then(function(){
        return refresh(true,{source:"boot"});
      }).finally(function(){
        panelBootReady=true;
        recommend2PromptArmed=true;
        schedulePanelRefreshLoop();
        // 首屏只暖今日近窗；8s 后再补到 800。满量 5000 仅三定/转换器主动拉，避免一开就卡。
        setTimeout(function(){
          try{
            ensureExtendedHistoryCache(360).then(function(){
              setTimeout(function(){
                try{ensureExtendedHistoryCache(800);}catch(eWarm){}
              },8000);
            }).catch(function(){});
          }catch(eHist){}
        },2500);
      });
    },700);
    document.addEventListener("visibilitychange",function(){if(!document.hidden)coalescePanelRefresh(false,"auto");});
    window.addEventListener("focus",function(){coalescePanelRefresh(false,"auto");});
    // 普通刷新会走 boot，不必再叠一次 pageshow 静默刷新（会二次重绘导致漂移）
    window.addEventListener("pageshow",function(ev){
      if(ev&&ev.persisted)coalescePanelRefresh(false,"auto");
    });
    window.addEventListener("online",function(){coalescePanelRefresh(true,"auto");});
    try{if(history&&"scrollRestoration" in history)history.scrollRestoration="manual";}catch(eScroll){}
  }
  document.addEventListener("DOMContentLoaded",startPanelLoop);
  if(document.readyState!=="loading")startPanelLoop();





