    var score=Number(row.score);
    if(isFinite(score)&&score>=0)return score;
    var r30=Number(row.rate30);
    if(isFinite(r30)&&r30>=0)return r30;
    var perf=row.performance&&typeof row.performance==="object"?row.performance:{};
    var pr=Number(perf.rate);
    return isFinite(pr)&&pr>=0?pr:-1;
  }
  function fourDingHeweiRate(row){
