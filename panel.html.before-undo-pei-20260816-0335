      if(curMiss>maxMiss)maxMiss=curMiss;
    }
  });
  var currentWin=0,currentMiss=0;
  if(list.length){
    if(list[list.length-1].hit===true)currentWin=curWin;
    else if(list[list.length-1].hit===false)currentMiss=curMiss;
  }
  return {
    total:total,
    hit:hit,
    rate:total?Number((hit*100/total).toFixed(2)):null,
    maxWin:maxWin,
    maxMiss:maxMiss,
    currentWin:currentWin,
