    loading=true;
    try{
      if(!silent)setStatus("正在读取数据...",true);
      var nextState=null;
      var stateReadError=null;
      var stateAuthExpired=false;

      for(var stateTry=0;stateTry<3;stateTry+=1){
        if(stateTry>0){
          await new Promise(function(resolve){
            setTimeout(resolve,stateTry===1?900:1800);
          });
        }

        try{
          var response=await panelFetch(
            "/state?_="+Date.now()+"&try="+stateTry,
            {cache:"no-store"}
          );
          var rawText=await response.text();

          // 登录失效属于确定错误，不重复请求。
          if(!response.ok || /^\s*</.test(rawText)){
            if(response.status===401||/登录|loginForm|请输入密码/.test(rawText)){
              stateAuthExpired=true;
              throw new Error("登录已失效，请刷新页面重新输入密码");
            }
            throw new Error("HTTP "+response.status);
          }

          try{
            nextState=JSON.parse(rawText);
          }catch(parseErr){
            throw new Error("状态不是 JSON");
          }

          if(!nextState||nextState.ok===false){
            throw new Error(
              nextState&&nextState.error
                ? nextState.error
                : "状态无效"
            );
          }

          stateReadError=null;
          break;
        }catch(readErr){
          stateReadError=readErr;
          nextState=null;
          if(stateAuthExpired)break;
        }
      }

      if(!nextState){
        panelStateReadFailureCount+=1;

        var readMessage=
          stateReadError&&stateReadError.message
            ? stateReadError.message
            : String(stateReadError||"状态无效");

        if(stateAuthExpired){
          setStatus(readMessage,false);
        }else if(!silent||!state||panelStateReadFailureCount>=3){
          setStatus("读取失败："+readMessage+"（已重试3次）",false);
        }else{
          // 自动轮询偶发失败：保留最后一次正常状态，不闪红色错误。
          console.warn(
            "state read transient failure; keep last good state",
            readMessage
          );
        }
        return;
      }

      panelStateReadFailureCount=0;
      var previousKey=stateRenderKey(state);
      var nextKey=stateRenderKey(nextState);
      var firstRender=!state;
      var keyChanged=previousKey!==nextKey;
      state=nextState;
