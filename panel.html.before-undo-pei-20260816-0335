function paintFourDingShapeBoard(){ return; // panel-lite

  var meta=document.getElementById("fourDingShapeMeta");
  var shotEl=document.getElementById("fourDingShapeShot");
  function fillOne(prefix, code, metaTxt, nameTxt){
    var codeEl=document.getElementById(prefix+"Code");
    var metaEl=document.getElementById(prefix+"Meta");
    var nameEl=document.getElementById(prefix+"Name");
    if(codeEl)codeEl.textContent=code||"--";
    if(metaEl)metaEl.textContent=metaTxt||"--";
    if(nameEl&&nameTxt)nameEl.textContent=nameTxt;
  }
  function fillEmpty(msg){
    if(meta)meta.textContent=msg||"four-ding-shape-kills 未就绪";
    if(shotEl)shotEl.textContent="--";
    fillOne("fourDingShapeSize","--","--");
    fillOne("fourDingShapeParity","--","--");
  }
  function fmtKill(row){
    if(!row||!row.kill)return {code:"--", meta:"未就绪", attack:""};
    var k=row.kill||{};
    var code=k.code?String(k.code):"--";
    var parts=[];
    if(k.rate120!=null)parts.push("120期 "+Number(k.rate120).toFixed(1)+"%");
    if(k.hit120!=null&&k.total120!=null)parts.push(k.hit120+"/"+k.total120);
    if(k.lower120!=null)parts.push("下界 "+Number(k.lower120).toFixed(1)+"%");
    if(k.missStreak30!=null)parts.push("近30连挂 "+k.missStreak30);
    return {
      code:code,
      meta:parts.length?parts.join(" · "):"--",
      attack:k.attack?String(k.attack):(code!=="--"?("除"+code):"")
    };
  }
  fetch("/four-ding-shape-kills?t="+Date.now(),{credentials:"same-origin",cache:"no-store"})
    .then(function(r){return r.ok?r.json():null;})
    .then(function(own){
      if(!own||own.ok===false){fillEmpty(own&&own.error?String(own.error):"旁路未就绪");return;}
      var size=fmtKill(own.size);
      var parity=fmtKill(own.parity);
      var period=own.latestPeriod
        ||(own.size&&own.size.latestPeriod)
        ||(own.parity&&own.parity.latestPeriod)
        ||"--";
      if(meta)meta.textContent="四定 · 千百十个 · 期号 "+period+" · 大小/单双各杀1形";
      fillOne("fourDingShapeSize", size.code, size.meta, (own.size&&own.size.label)||"大小形态");
      fillOne("fourDingShapeParity", parity.code, parity.meta, (own.parity&&own.parity.label)||"单双形态");
      if(shotEl){
        var shot=[size.attack,parity.attack].filter(Boolean).join("");
        shotEl.textContent=shot?("攻击语："+shot):"--";
      }
    })
    .catch(function(){fillEmpty("读取四定形态杀码失败");});
}
function paintShaMaBoard(data){
  posExcludeReverseBindClicks();
  if(typeof shaMaSettingsBindClicks==="function")shaMaSettingsBindClicks();
  if(typeof posExcludeSettingsSyncInputs==="function")posExcludeSettingsSyncInputs();
  var pred=(data&&data.currentPrediction)||{};
  var four=pred.fourPosExclude||{};
  var settings=typeof posExcludeSettingsGet==="function"?posExcludeSettingsGet():{recommendCount:3,minWinStreak:2,maxMissStreak:2};
  var recPack=typeof shaMaPickRecommendKeys==="function"?shaMaPickRecommendKeys(data,pred,settings):{picked:[],all:[]};
  var recommendSet={};
  (recPack.picked||[]).forEach(function(row){recommendSet[row.key]=row;});
  var specs=[
    {key:"wan",digitId:"shaMaWan",metaId:"shaMaWanMeta",actionId:"shaMaWanAction",cardId:"shaMaWanCard",statsId:"shaMaWanStats",label:"千"},
    {key:"qian",digitId:"shaMaQian",metaId:"shaMaQianMeta",actionId:"shaMaQianAction",cardId:"shaMaQianCard",statsId:"shaMaQianStats",label:"百"},
    {key:"bai",digitId:"shaMaBai",metaId:"shaMaBaiMeta",actionId:"shaMaBaiAction",cardId:"shaMaBaiCard",statsId:"shaMaBaiStats",label:"十"},
    {key:"shi",digitId:"shaMaShi",metaId:"shaMaShiMeta",actionId:"shaMaShiAction",cardId:"shaMaShiCard",statsId:"shaMaShiStats",label:"个"}
  ];
  function fillShaMaStreakStats(el,stats){
    if(!el)return;
    if(!stats||!stats.total){
      el.innerHTML="<span>连中 --</span><span>连败 --</span><span>最高连中 --</span><span>最大连败 --</span>";
      return;
    }
    var cw=Number(stats.currentWin||0),cm=Number(stats.currentMiss||0);
    var mw=Number(stats.maxWin||0),mm=Number(stats.maxMiss||0);
    el.innerHTML=
      '<span class="'+(cw>0?"is-win":"")+'">连中 '+cw+'</span>'+
      '<span class="'+(cm>0?"is-miss":"")+'">连败 '+cm+'</span>'+
      '<span class="is-win">最高连中 '+mw+'</span>'+
      '<span class="is-miss">最大连败 '+mm+'</span>';
  }
  var parts=[];
  var reverseParts=[];
  var forwardParts=[];
  var mode=posExcludeReverseModeGet();
  specs.forEach(function(spec){
    // 每位独立：自己的排除码、自己的连挂、自己的近120，互不带动
    var digit=fourPosExcludeDigit(pred,spec.key);
    if(!digit)digit=resolveComposerPosKillDigit(pred,spec.key);
    var digitEl=document.getElementById(spec.digitId);
    var metaEl=document.getElementById(spec.metaId);
    var actionEl=document.getElementById(spec.actionId);
    var cardEl=document.getElementById(spec.cardId);
    var statsEl=document.getElementById(spec.statsId);
    var streakStats=typeof fourPosExcludePosStreakStats==="function"?fourPosExcludePosStreakStats(data,spec.key):null;
    fillShaMaStreakStats(statsEl,streakStats);
    var item=null;
    var items=Array.isArray(four.items)?four.items:[];
    for(var i=0;i<items.length;i++){
      if(items[i]&&String(items[i].key)===spec.key){item=items[i];break;}
    }
    var decide=posExcludeReverseDecide(data,spec.key,digit,item);
    if(digitEl){
      digitEl.textContent=decide.active?(decide.appearDigit||digit||"--"):(digit||"--");
      digitEl.style.color="";
      digitEl.title=decide.reason||"";
    }
    if(cardEl){
      cardEl.classList.remove("is-reverse","is-forward","is-recommend","is-dim");
      if(digit)cardEl.classList.add(decide.active?"is-reverse":"is-forward");
      if(recommendSet[spec.key])cardEl.classList.add("is-recommend");
      else if(digit)cardEl.classList.add("is-dim");
    }
    if(actionEl){
      if(!digit){
        actionEl.textContent=spec.label+"位：等待排除码";
        actionEl.style.color="#94a3b8";
      }else if(decide.active){
        actionEl.textContent="反车猜出 "+decide.appearDigit+"（原杀"+digit+"）";
        actionEl.style.color="#9a3412";
      }else{
        actionEl.textContent="正向杀 "+digit;
        actionEl.style.color="#166534";
      }
    }
    var rateLong=item&&item.rateLong!=null?Number(item.rateLong):NaN;
    var lowerLong=item&&item.lowerLong!=null?Number(item.lowerLong):(item&&item.lower300!=null?Number(item.lower300):NaN);
    var sampleLong=item&&item.sampleLong!=null?Number(item.sampleLong):NaN;
    var rate120=item&&item.rate120!=null?Number(item.rate120):NaN;
    var metaText="本位置算法";
    if(isFinite(rateLong)||isFinite(lowerLong)||isFinite(sampleLong)){
      metaText=(isFinite(rateLong)?rateLong.toFixed(2)+"%":"--")
        +(isFinite(sampleLong)?" · 近"+String(Math.round(sampleLong))+"期":" · 长窗")
        +(isFinite(lowerLong)?" · 下界 "+lowerLong.toFixed(2)+"%":"")
        +(isFinite(rate120)?" · 近120 "+rate120.toFixed(1)+"%":"");
    }else if(isFinite(rate120)){
      metaText=rate120.toFixed(1)+"% · 近120（待长窗重算）";
    }
    var winStreak=streakStats?Number(streakStats.currentWin||0):(typeof fourPosExcludePosWinStreak==="function"?fourPosExcludePosWinStreak(data,spec.key):0);
    var maxWin=streakStats?Number(streakStats.maxWin||0):0;
    var maxMiss=streakStats?Number(streakStats.maxMiss||0):0;
    metaText+=(metaText?" · ":"")+"连中"+String(winStreak)+" · 连败"+String(decide.missStreak||0)
      +" · 最高连中"+String(maxWin)+" · 最大连败"+String(maxMiss);
    if(recommendSet[spec.key])metaText+=" · 主推";
    if(metaEl)metaEl.textContent=metaText;
    if(digit){
      parts.push((item&&item.label?item.label:spec.label)+digit);
      if(decide.active)reverseParts.push(spec.label+"出"+decide.appearDigit);
      else forwardParts.push(spec.label+"杀"+digit);
    }
  });
  var meta=document.getElementById("shaMaMeta");
  if(meta){
    var base=four.sealedBaseUid||pred.basePeriod||pred.baseUid||"--";
    var sealed=four.sealed?"已封存":"未封存";
    var ver=four.version||"fourPosExclude";
    meta.textContent=ver+" · "+sealed+" · 基准 "+String(base).replace(/^period:/,"")+" · 主推"+settings.recommendCount+"位(连中≥"+settings.minWinStreak+") · 连败翻车"+(settings.maxMissStreak<=0?"关":("≥"+settings.maxMissStreak))+" · 反车="+(mode==="on"?"强制":mode==="off"?"关":"低谷自动");
  }
  var recLine=document.getElementById("shaMaRecommendLine");
  if(recLine){
    if(!(recPack.picked||[]).length){
      recLine.textContent="主推：等待排除码…（连中≥"+settings.minWinStreak+" 优先，不足按近120%补齐到"+settings.recommendCount+"位）";
    }else{
      recLine.textContent="下一期主推 "+settings.recommendCount+" 位："+(recPack.picked||[]).map(function(row){
        return row.label+row.digit+"(连中"+row.winStreak+"/连败"+row.missStreak+"/最高连中"+Number(row.maxWin||0)+"/最大连败"+Number(row.maxMiss||0)+")";
      }).join(" / ")+" ｜ 门槛：连中≥"+settings.minWinStreak+" · 连败翻车"+(settings.maxMissStreak<=0?"关":("≥"+settings.maxMissStreak));
    }
  }
  var jointStatsEl=document.getElementById("shaMaRecommendStats");
  if(jointStatsEl&&typeof shaMaRecommendJointTruthStats==="function"){
    fillShaMaRecommendJointStats(jointStatsEl,shaMaRecommendJointTruthStats(data,settings),settings);
  }
  var line=document.getElementById("shaMaLine");
  if(line){
    if(!parts.length){
      line.textContent="等待服务器产出 fourPosExclude…";
    }else{
      line.textContent="四位各自："+(forwardParts.length?("正向 "+forwardParts.join(" / ")):"")
        +(forwardParts.length&&reverseParts.length?" ｜ ":"")
        +(reverseParts.length?("反车 "+reverseParts.join(" / ")):"")
        +(!forwardParts.length&&!reverseParts.length?("本期杀码 "+parts.join(" / ")+"各"):"");
    }
  }
  killRevBindPager();
  if(!forwardParts.length&&!reverseParts.length){
    if(mode==="off")forwardParts=["四位跟排除走"];
    else if(mode==="on")reverseParts=["强制反车待命"];
    else forwardParts=["低谷自动：未见翻面"];
  }
  killRevSetLists("pos",forwardParts,reverseParts);
  var box=document.getElementById("shaMaReverseBox");
  if(box){
    var buttons=box.querySelectorAll("[data-pos-reverse-mode]");
    for(var bi=0;bi<buttons.length;bi++){
      var b=buttons[bi];
      var on=String(b.getAttribute("data-pos-reverse-mode"))===mode;
      b.style.background=on?"#9a3412":"#fff";
      b.style.color=on?"#fff":"#9a3412";
      b.style.borderColor=on?"#9a3412":"#fdba74";
    }
  }
  paintFlexDualPosHewei(pred);
  paintDualPosTotalHewei(pred);
  paintClaudeDualPosHewei(pred);
