  var jointTable=document.getElementById("shapeAvoid3JointTable");
  var groupTable=document.getElementById("shapeAvoid3GroupTable");
  function fracCell(hit,total,rate){
    if(hit==null||total==null){
      return rate!=null?(Number(rate).toFixed(1)+"%"):"--";
    }
    var txt=String(hit)+"/"+String(total);
    if(rate!=null)txt+="（"+Number(rate).toFixed(1)+"%）";
    return txt;
  }
  function renderJointTable(joint){
    if(!jointTable)return;
    var head="<tr><td>窗口</td><td>命中</td><td>总数</td><td>命中率</td><td>下界</td><td>连挂</td></tr>";
    var rows=Array.isArray(joint&&joint.windows)?joint.windows:[];
    if(!rows.length&&joint){
      rows=[
        {window:30,hit:joint.hit30,total:joint.total30,rate:joint.rate30,lower:null,missStreak:joint.missStreak30},
        {window:120,hit:joint.hit120,total:joint.total120,rate:joint.rate120,lower:joint.lower120,missStreak:null},
        {window:1000,hit:joint.hitLong,total:joint.totalLong,rate:joint.rateLong,lower:joint.lowerLong,missStreak:null}
      ].filter(function(r){return r.total!=null||r.rate!=null;});
    }
    if(!rows.length){
      jointTable.innerHTML=head+"<tr><td colspan=\"6\">--</td></tr>";
      return;
    }
    var body=rows.map(function(r){
      var rateTxt=r.rate!=null?(Number(r.rate).toFixed(1)+"%"):"--";
      var lowTxt=r.lower!=null?(Number(r.lower).toFixed(1)+"%"):"--";
      var missTxt=r.missStreak!=null?String(r.missStreak):"--";
      return "<tr><td>近"+esc(r.window)+"</td><td>"+esc(r.hit!=null?r.hit:"--")+"</td><td>"+esc(r.total!=null?r.total:"--")+"</td><td>"+esc(rateTxt)+"</td><td>"+esc(lowTxt)+"</td><td>"+esc(missTxt)+"</td></tr>";
    }).join("");
    jointTable.innerHTML=head+body;
