      var ev=(row&&row.evaluation)||{};
      var extras=ev.independentExtras||{};
      var results=[],period=ev.targetPeriod||row.basePeriod||"";
      for(var i=0;i<keys.length;i++){
        var saved=extras[keys[i]];
        if(saved&&typeof saved.success==="boolean"){
          var itemOk=!!saved.success;
          applyStats(itemStats[keys[i]],itemOk,period);
          results.push(itemOk);
        }else{
          results.push(null);
        }
      }
      if(results.filter(function(item){return typeof item==="boolean";}).length!==keys.length)return;
      var ok=results.every(Boolean);
      valid++;
      if(ok)hit++;
      lastResult=ok;
      lastPeriod=String(period||"");
      if(ok){
        currentWin++;
        currentMiss=0;
        if(currentWin>maxWin)maxWin=currentWin;
      }else{
        currentMiss++;
        currentWin=0;
        if(currentMiss>maxMiss)maxMiss=currentMiss;
      }
    });
    return {
      day:today,
      total:valid,
      hit:hit,
      rate:valid?hit*100/valid:null,
      currentWin:lastResult===true?currentWin:0,
      currentMiss:lastResult===false?currentMiss:0,
      maxWin:maxWin,
      maxMiss:maxMiss,
      lastPeriod:lastPeriod,
      items:itemStats
