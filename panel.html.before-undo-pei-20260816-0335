      if(!own||own.ok===false){fillEmpty(own&&own.error?String(own.error):"旁路未就绪");return;}
      var groups=Array.isArray(own.groups)?own.groups:[];
      var joint=own.joint||{};
      var ding=own.ding||"四定";
      var scope=own.scope||"千百十个";
      var period=own.latestPeriod||"--";
      var jointTxt="--";
      if(joint&&(joint.rate120!=null||joint.rateLong!=null)){
        var pct=joint.rate120!=null?Number(joint.rate120):Number(joint.rateLong);
        var low=joint.lower120!=null?Number(joint.lower120):(joint.lowerLong!=null?Number(joint.lowerLong):null);
        var hit=joint.hit120!=null?joint.hit120:joint.hitLong;
        var tot=joint.total120!=null?joint.total120:joint.totalLong;
        jointTxt="联合命中 "+pct.toFixed(1)+"%";
