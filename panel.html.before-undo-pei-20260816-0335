  candidatePool=candidatePool&&typeof candidatePool==="object"?candidatePool:{};
  var limit=txtFourHistoryLimitNormalize(historyLimit!=null?historyLimit:(hist.historyLimit!=null?hist.historyLimit:txtFourHistoryLimitGet()));
  var opened=Array.isArray(hist.opened)?hist.opened:[];
  var pool=Array.isArray(candidatePool.codes)?candidatePool.codes:[];
  if(!pool.length){
    throw txtPositionMakeError("没有攻击语候选码，禁止从全集糊弄回删","FOUR_NO_ATTACK_POOL",false);
  }
  var set={};
  pool.forEach(function(code){
    var c=String(code||"");
    if(/^\d{4}$/.test(c))set[c]=true;
  });
  var before=Object.keys(set).length;
  if(before!==pool.length){
    throw txtPositionMakeError("攻击语候选池含无效/重复码，已停止","FOUR_ATTACK_POOL_INVALID",false);
  }
  var seenOld={};
  var deletedSources=[];
  var deletedUnique=0;
  for(var i=0;i<opened.length;i++){
    var oldCode=String(opened[i]||"");
    // 只删「同样位置同样号码」的整串四位码；位置不同一律不动（禁止按数字集合/乱序匹配）
    if(!/^\d{4}$/.test(oldCode)||seenOld[oldCode])continue;
    seenOld[oldCode]=true;
    if(!Object.prototype.hasOwnProperty.call(set,oldCode))continue;
    delete set[oldCode];
    deletedUnique+=1;
    deletedSources.push({
      code:oldCode,
      period:"",
      opentime:"",
      historyIndex:i,
      source:"rds-direct-unique"
    });
  }
  var codes=Object.keys(set).sort();
  if(codes.length!==before-deletedUnique){
    throw txtPositionMakeError("四定回删计数不一致，已停止发布","BACKDELETE_COUNT_MISMATCH",false);
  }
  var pages=txtFourPagesFromCodes(codes);
  var scanned=Number(hist.scanned||0);
  var windowShort=hist.windowShort===true||scanned<limit;
  return {
    ok:true,
    kind:"four",
    label:"四定真旧码回删",
    expectedPeriod:String(expectedPeriod||""),
    rdsFirstPeriod:String(hist.latestPeriod||""),
    rdsLastPeriod:String(hist.oldestPeriod||""),
    historyCount:scanned,
    historyLimit:limit,
    scanned:scanned,
    windowShort:windowShort,
    truncated:false,
    deletedUnique:deletedUnique,
    excluded:deletedUnique,
    afterFilter:before,
    before:before,
    left:codes.length,
    count:codes.length,
    pageSize:TXT_FOUR_PAGE_SIZE,
    pageCount:pages.length,
    codes:codes,
    pages:pages,
    deletedSources:deletedSources,
    attackPool:true,
    attackNote:String(candidatePool.note||""),
    mark:String(candidatePool.mark||candidatePool.note||""),
    poolMark:String(candidatePool.mark||""),
    poolSource:String(candidatePool.source||""),
    sticky:false,
    note:"【四定回删】攻击语缩池 "+before+" 组 → 扫近 "+scanned+"/"+limit+" 期（历史唯一旧码 "+(hist.openedUnique!=null?hist.openedUnique:opened.length)+"）→ 命中删 "+deletedUnique+" → 现剩 "+codes.length+" 组（只删历史开过的整串四位码；未开过的保留；无数组截断）"
