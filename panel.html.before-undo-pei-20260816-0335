  function heweiRateValue(data,h){
    var rt=0,rm=0,mt=0,mm=0,bt=0,bm=0;
    var list=(Array.isArray(data&&data.predictions)?data.predictions:[]).filter(function(p){return p&&p.evaluated&&p.evaluation;}).slice(0,30);
    list.forEach(function(pred){
      var group=pred.evaluation.actualCompositeHeweiGroup;
      if(!Array.isArray(group))return;
      var recommend="",main="",backup="";
      if(h.key==="unified"){
        var detail=pred.detail&&pred.detail.threeFourHeweiKill||{};
        recommend=String(pred.threeFourHeweiKillDigit||detail.killDigit||"");
        main=String(detail.primaryDigit||recommend||"");
        backup=String(pred.threeFourHeweiBackupDigit||detail.backupDigit||"");
        if(recommend&&recommend!=="--"){
          rt++;
          if(recommend!==String(group[0])&&recommend!==String(group[1])&&recommend!==String(group[2]))rm++;
        }
        if(main&&main!=="--"){
          mt++;
          if(main!==String(group[0])&&main!==String(group[1])&&main!==String(group[2]))mm++;
        }
        if(backup&&backup!=="--"){
          bt++;
          if(backup!==String(group[0])&&backup!==String(group[1])&&backup!==String(group[2]))bm++;
        }
      }else{
        var saved=pred.independentHeweiKills||pred.evaluation.previousIndependentHeweiKills||{};
        var item=saved[h.key]||{};
        recommend=String(item.killDigit||"");
        main=String(item.primaryDigit||recommend||"");
        backup=String(item.backupDigit||"");
        var actual="";
        if(h.metricField){
          var evalItem=pred.evaluation.independentHewei&&pred.evaluation.independentHewei[h.key];
          actual=evalItem&&evalItem.actualDigit!=null?String(evalItem.actualDigit):"";
          if(!/^\d$/.test(actual)){
            var nums=pred.evaluation.actualNumbers;
            if(Array.isArray(nums)&&nums.length>=4){
              if(h.metricField==="wanQianGeHewei")actual=String((Number(nums[0]||0)+Number(nums[1]||0)+Number(nums[3]||0))%10);
              else if(h.metricField==="wanBaiShiHewei")actual=String((Number(nums[0]||0)+Number(nums[2]||0)+Number(nums[3]||0))%10);
            }
          }
        }else{
          var index=h.key==="wanQianBai"?0:(h.key==="qianBaiShi"?1:2);
          actual=String(group[index]);
        }
        if(!/^\d$/.test(actual))return;
        if(recommend&&recommend!=="--"){
          rt++;
          if(recommend!==actual)rm++;
        }
        if(main&&main!=="--"){
          mt++;
          if(main!==actual)mm++;
        }
        if(backup&&backup!=="--"){
          bt++;
          if(backup!==actual)bm++;
        }
      }
    });
    return {recommend:rate(rt,rm),main:rate(mt,mm),backup:rate(bt,bm)};
  }
