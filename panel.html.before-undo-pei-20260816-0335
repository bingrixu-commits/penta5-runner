        if(joint.rate30!=null){
          jointTxt+=" · 近30 "+Number(joint.rate30).toFixed(1)+"%";
          if(joint.hit30!=null&&joint.total30!=null)jointTxt+="（"+joint.hit30+"/"+joint.total30+"）";
        }
      }
      if(meta)meta.textContent=ding+" · "+scope+" · 三组AND · 期号 "+period+" · "+jointTxt;
      for(var i=0;i<3;i++){
