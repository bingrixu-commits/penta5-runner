      return null;
    }
    if(!res.ok)throw new Error("HTTP "+res.status);
    var outer=await res.json();
    if(outer&&outer.sealed&&outer.envelope)return unsealQualifiedPicksEnvelope(outer.envelope);
    return outer;
  }
