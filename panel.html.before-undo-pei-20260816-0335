  function initPanelChrome(){
    if(window.__pentaPanelChromeReady)return;
    window.__pentaPanelChromeReady=true;
    if(typeof fourPosDrop6BindClicks==="function")fourPosDrop6BindClicks();
    if(typeof fourFanModel2BindClicks==="function")fourFanModel2BindClicks();
