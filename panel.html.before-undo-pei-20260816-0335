    if(!(idx>0))return;
    var targetRow=rows[idx-1]||{};
    var targetCode=txtPositionCodeFromRow(targetRow,model.positions);
    if(!targetCode)return;
    snapshot.targetPeriod=txtStrictThreePeriod(targetRow);
    snapshot.targetDay=txtStrictThreeRowDay(targetRow);
