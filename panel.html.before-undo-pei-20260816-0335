  function updatePanelChrome(data){
    var latest=data&&data.latestRecord||{};
    var sync=data&&data.lastSync||{};
    var prediction=data&&data.currentPrediction||{};
    var periodEl=document.getElementById("summaryPeriod");
    if(periodEl)periodEl.textContent=latest.period||latest.uid||"--";
    var numbersEl=document.getElementById("summaryNumbers");
    if(numbersEl){
      var nums=Array.isArray(latest.numbers)?latest.numbers.slice(0,5):[];
      numbersEl.textContent=nums.length?nums.join(" "):"--";
    }
    var baseEl=document.getElementById("summaryBasePeriod");
    if(baseEl)baseEl.textContent=prediction.basePeriod||prediction.baseUid||"--";
    var syncEl=document.getElementById("summarySync");
    if(syncEl){
      var syncText=String(sync.text||sync.at||"--");
      syncEl.textContent=syncText.length>20?syncText.slice(0,20):syncText;
      syncEl.title=syncText;
    }
    var histEl=document.getElementById("summaryHistory");
    if(histEl){
      var hc=data&&data.sharedHistoryCount!=null?Number(data.sharedHistoryCount):(data&&data.historyCount!=null?Number(data.historyCount):(Array.isArray(data&&data.history)?data.history.length:null));
      histEl.textContent=(hc!=null&&isFinite(hc))?(hc+"期"):"--";
    }
    var storm=data&&data.stormMode||{};
    var stormBanner=document.getElementById("stormBanner");
    if(stormBanner){
      if(storm&&storm.active){
        stormBanner.className="storm-banner is-on";
        stormBanner.innerHTML="风暴模式已开启：冻结换码锁 + 机器人停射。原因："+esc(storm.reason||"--")
          +" ｜ 六项连败 "+esc(storm.autoTop6CurrentMiss||0)
          +" ｜ 三对数连败 "+esc(storm.threeDuishuCurrentMiss||0)
          +"。恢复需连败归零或连中达标并稳定。";
      }else{
        stormBanner.className="storm-banner";
        stormBanner.innerHTML="";
      }
    }
    var tipReadyBanner=document.getElementById("tipReadyBanner");
    if(tipReadyBanner){
      var tipReady=data&&data.tipReady;
      var tipIssues=Number(data&&data.tipReadyIssueCount||0);
      var operationalReady=data&&data.operationalReady;
      var degradedCount=Number(data&&data.algorithmProjectDegradedCount||0);
      if(tipReady===false){
        tipReadyBanner.className="tip-ready-banner is-on";
        tipReadyBanner.innerHTML="结构未完美：tipReady=false，已阻断射击发布。问题数 "+esc(tipIssues)
          +"。后端将自动修到八框架完整封存后才放行。";
      }else if(tipReady===true&&operationalReady===false){
        tipReadyBanner.className="tip-ready-banner is-on";
        tipReadyBanner.innerHTML="结构已封存，但质量/运行未就绪：降级项目 "+esc(degradedCount)+" 个；tipReady=true 不等于模型有效。";
      }else if(tipReady===true){
        tipReadyBanner.className="tip-ready-banner is-on is-ok";
        tipReadyBanner.innerHTML="结构完美：八框架完整且开奖前封存有效，tipReady=true。";
      }else{
        tipReadyBanner.className="tip-ready-banner";
        tipReadyBanner.innerHTML="";
      }
    }
  }
  window.updatePanelChrome=updatePanelChrome;
