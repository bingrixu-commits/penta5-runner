  function topSeven(data,items){
    var list=(items||currentItems(data)).slice().filter(function(x){return x&&x.rate!=null;});
    var evaluatedCount=evalRows(data).length;
    function stageLabel(){
      if(evaluatedCount>=MODEL_STABLE_WINDOW)return "稳定期";
      if(evaluatedCount>=120)return "小修期";
      return "观察期";
    }
    function calcMulti(item){
      var r30=displayedItemRate(data,item,30);
      var r60=displayedItemRate(data,item,60);
      var r120=displayedItemRate(data,item,120);
      var r300=displayedItemRate(data,item,MODEL_STABLE_WINDOW);
      if(r60==null||!isFinite(Number(r60)))r60=r30;
      if(r120==null||!isFinite(Number(r120)))r120=r60;
      if(r300==null||!isFinite(Number(r300)))r300=r120;
      var score;
      if(evaluatedCount>=MODEL_STABLE_WINDOW){
        score=(Number(r30||0)*0.10)+(Number(r60||0)*0.15)+(Number(r120||0)*0.20)+(Number(r300||0)*0.55);
      }else if(evaluatedCount>=120){
        score=(Number(r30||0)*0.20)+(Number(r60||0)*0.20)+(Number(r120||0)*0.40)+(Number(r300||0)*0.20);
      }else{
        score=(Number(r30||0)*0.45)+(Number(r60||0)*0.35)+(Number(r120||0)*0.20);
      }
      item.rate30=r30;
      item.rate60=r60;
      item.rate120=r120;
      item.rate300=r300;
      item.rateLong=r300;
      item.stageLabel=stageLabel();
      item.stableScore=score;
      return item;
    }
    list.forEach(function(item){calcMulti(item);markItemConfidence(data,item);});
    function order(a,b){
      if((b.stableScore||0)!==(a.stableScore||0))return (b.stableScore||0)-(a.stableScore||0);
      if((b.rate300||0)!==(a.rate300||0))return (b.rate300||0)-(a.rate300||0);
      if((b.rate60||0)!==(a.rate60||0))return (b.rate60||0)-(a.rate60||0);
      if((b.rate120||0)!==(a.rate120||0))return (b.rate120||0)-(a.rate120||0);
      return String(a.name||"").localeCompare(String(b.name||""));
    }
    function itemId(item){return [item.kind,item.key,item.side||"recommend",String(item.code)].join(":");}
