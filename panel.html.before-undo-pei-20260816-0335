  function brotherNumberRecommendFromRows(previousRows){
    var source=(previousRows||[]).filter(function(row){return !!brotherNumberReferenceCode(row);});
    if(!source.length)return null;
    var referenceChoice=brotherNumberReferenceActual(source[0]);
    var windows=[30,120,300,1000];
    var weights=[5,3,2,1];
    var yesScore=0,baselineYesScore=0,weightTotal=0;
    windows.forEach(function(limit,index){
      var base=brotherNumberWindowRate(source,limit);
      if(!base.total)return;
      var cond=referenceChoice?brotherNumberConditionalRate(source,limit,referenceChoice):{total:0,yesRate:null,noRate:null};
      var weight=weights[index]||1;
      var enoughCondition=cond.total>=8&&cond.yesRate!==null;
      var yesRate=enoughCondition?(cond.yesRate*0.7+(base.yesRate||0)*0.3):(base.yesRate||0);
      yesScore+=yesRate*weight;
      baselineYesScore+=(base.yesRate||0)*weight;
      weightTotal+=weight;
    });
    if(!weightTotal)return null;
    var finalYes=yesScore/weightTotal;
    var finalNo=100-finalYes;
    var baselineYes=baselineYesScore/weightTotal;
    var decisionBoundary=baselineYes-1.5;
    var choice=finalYes>=decisionBoundary?"有":"否";
    return {
      choice:choice,
      score:choice==="有"?finalYes:finalNo,
      yesScore:finalYes,
      noScore:finalNo,
      referenceChoice:referenceChoice,
      baselineYes:baselineYes,
      decisionBoundary:decisionBoundary,
      signalDelta:finalYes-baselineYes
    };
  }
