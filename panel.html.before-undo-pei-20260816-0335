    var outFactor=txtFourStickyAdvance(latest,data,TXT_FOUR_LANE_FACTOR_EXCLUDE);
    return txtFourLaneActive()===TXT_FOUR_LANE_DING?outDing:outFactor;
  }
  lane=txtFourLaneNormalize(lane);
  var sticky=txtFourStickyLoad({lane:lane});
  if(!sticky||!Array.isArray(sticky.codes)||!sticky.codes.length)return sticky;
  if(!latest.period||!/^\d{4}$/.test(String(latest.code||"")))return sticky;
  if(!txtFourPeriodNewer(latest.period,sticky.basePeriod))return sticky;
  var store=txtFourStatsLoad();
  var alreadyEntry=null;
  var stickyLimit=txtFourHistoryLimitNormalize(sticky.historyLimit||txtFourHistoryLimitGet());
  var evaluated=store.evaluated||[];
  for(var ei=0;ei<evaluated.length;ei++){
    var item=evaluated[ei];
