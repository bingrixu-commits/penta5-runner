function posExcludeReverseDecide(data,key,excludeDigit,item){
  // 低谷反车：排除集里猜 1 码「会出现」。fourPosExclude 每位本就 1 码，反车=该排除码会出现。
  data=data||{};
  var digit=String(excludeDigit==null?"":excludeDigit).replace(/\D/g,"").charAt(0);
  var mode=posExcludeReverseModeGet();
  var labelMap={wan:"千",qian:"百",bai:"十",shi:"个"};
  var label=labelMap[key]||key;
  if(!/^\d$/.test(digit)){
    return {active:false,mode:mode,appearDigit:"",excludeDigit:"",reason:label+"暂无排除码",missStreak:0};
  }
  if(mode==="on"){
    return {active:true,mode:mode,appearDigit:digit,excludeDigit:digit,reason:"强制反车："+label+"猜会出现 "+digit,missStreak:fourPosExcludePosMissStreak(data,key)};
  }
  if(mode==="off"){
    return {active:false,mode:mode,appearDigit:"",excludeDigit:digit,reason:"正向杀："+label+"排除 "+digit,missStreak:fourPosExcludePosMissStreak(data,key)};
  }
  var miss=fourPosExcludePosMissStreak(data,key);
  var rate120=item&&item.rate120!=null?Number(item.rate120):NaN;
  var cfg=typeof posExcludeSettingsGet==="function"?posExcludeSettingsGet():{maxMissStreak:POS_EXCLUDE_REVERSE_MISS_FLIP};
  var missFlipRaw=Number(cfg.maxMissStreak);
  if(!isFinite(missFlipRaw))missFlipRaw=POS_EXCLUDE_REVERSE_MISS_FLIP;
  missFlipRaw=Math.floor(missFlipRaw);
  // 0=关闭连败翻车（也不走软档连挂翻车）；仍可因近120%过低翻车
  var missFlip=missFlipRaw<=0?0:Math.min(30,Math.max(1,missFlipRaw));
  var softMiss=missFlip>1?missFlip-1:0;
  if(missFlip>0&&miss>=missFlip){
    return {active:true,mode:mode,appearDigit:digit,excludeDigit:digit,reason:"低谷反车："+label+"连挂 "+miss+"≥"+missFlip+"，猜会出现 "+digit,missStreak:miss};
  }
  if(isFinite(rate120)&&rate120<POS_EXCLUDE_REVERSE_RATE120_FLIP){
    return {active:true,mode:mode,appearDigit:digit,excludeDigit:digit,reason:"低谷反车："+label+"近120 "+rate120.toFixed(1)+"%偏低，猜会出现 "+digit,missStreak:miss};
  }
  if(missFlip>0&&softMiss>0&&miss>=softMiss&&isFinite(rate120)&&rate120<55){
    return {active:true,mode:mode,appearDigit:digit,excludeDigit:digit,reason:"低谷反车："+label+"刚挂"+miss+"且近120一般，正车不硬撑，猜会出现 "+digit,missStreak:miss};
  }
  return {active:false,mode:mode,appearDigit:"",excludeDigit:digit,reason:"正向杀："+label+"排除 "+digit+(missFlip<=0?"（连败翻车已关）":"（未见低谷）"),missStreak:miss};
}
