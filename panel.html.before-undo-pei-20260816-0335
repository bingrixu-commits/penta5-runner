      seen[code]=true;
      opened.push(code);
    }
  }
  var expect=String(expectedPeriod||"").replace(/\D/g,"");
  // 卡顿时不在这里作废：期号不准由上层对准重拉；此处只标记
  var periodMismatch=!!(expect&&latestPeriod&&latestPeriod!==expect);
  return {
    opened:opened,
