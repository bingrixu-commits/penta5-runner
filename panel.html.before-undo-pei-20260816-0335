  function expandThreeDingAttackToFourDingText(raw){
    var text=String(raw||"").replace(/\s+/g,"").replace(/各+$/,"");
    if(!text||text.indexOf("三定")<0)return "";
    var matches=[],match,regex=/(千|百|十|个)(\d+)/g;
    while((match=regex.exec(text))){
      matches.push({label:match[1],digits:match[2],end:match.index+match[0].length});
    }
    // 展示攻击语可为千百十个中的任意三段；转TXT时补齐空位并升为四定底稿。
    if(matches.length<1||matches.length>4)return "";
    var seen={},order=["千","百","十","个"],byLabel={};
    matches.forEach(function(item){
      if(seen[item.label])return;
      seen[item.label]=true;
      byLabel[item.label]=item.digits;
    });
    if(!byLabel["千"]&&!byLabel["百"]&&!byLabel["十"])return "";
    var head=order.map(function(label){return label+(byLabel[label]||"1234567890");}).join("");
    var lastPos=matches[matches.length-1];
    var tail=text.slice(lastPos.end).replace(/^三定/,"四定");
    if(tail.indexOf("四定")!==0)tail="四定"+tail.replace(/^三定/,"");
    return head+tail;
  }
