    snapshot=txtFourVerifyLoad({lane:lane})||snapshot||{};
    if(!snapshot.basePeriod||String(snapshot.basePeriod||"")!==String(sticky.basePeriod||"")||Number(snapshot.left||0)!==sticky.codes.length){
      snapshot.basePeriod=String(sticky.basePeriod||"");
      snapshot.left=sticky.codes.length;
      snapshot.scanned=Number(sticky.scanned||snapshot.scanned||0);
      snapshot.deletedUnique=Number(sticky.deletedUnique||snapshot.deletedUnique||0);
      snapshot.evaluated=false;
      snapshot.targetPeriod="";
      snapshot.targetCode="";
      snapshot.hit=null;
      txtFourVerifySave(snapshot,{lane:lane});
    }
    return snapshot;
  }
  snapshot=txtFourVerifyLoad({lane:lane})||snapshot;
  if(!snapshot||!snapshot.basePeriod||!snapshot.bitmap)return snapshot||null;
  if(!latest.period||!/^\d{4}$/.test(String(latest.code||"")))return snapshot;
  if(!txtFourPeriodNewer(latest.period,snapshot.basePeriod))return snapshot;
  if(snapshot.evaluated===true&&String(snapshot.targetPeriod||"")===String(latest.period)&&typeof snapshot.hit==="boolean"){
    snapshot.lastCheck={
      basePeriod:String(snapshot.basePeriod),
      left:Number(snapshot.left||0),
      targetPeriod:String(snapshot.targetPeriod),
      targetCode:String(snapshot.targetCode||""),
      hit:snapshot.hit===true,
      evaluatedAt:snapshot.evaluatedAt||Date.now()
    };
    txtFourVerifySave(snapshot,{lane:lane});
    return snapshot;
  }
  snapshot.targetPeriod=String(latest.period);
  snapshot.targetCode=String(latest.code);
