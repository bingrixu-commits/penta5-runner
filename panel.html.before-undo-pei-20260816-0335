  function threeDingKeepDigitsFromExclude(code){
    var value="1234567890";
    String(code==null?"":code).replace(/\D/g,"").split("").forEach(function(digit){
      if(digit)value=value.split(digit).join("");
    });
    return value;
  }
  function threeDingPositionKeepPoolFromItem(item){
    if(!item||item.kind!=="position")return "";
    var raw=String(item.code==null?"":item.code).replace(/\D/g,"");
    if(!raw)return "";
    // 已是保留池（≥9 位）则直接用；单/双码仍按排除码扣池
    if(raw.length>=9){
      var pool="1234567890",out="";
      for(var i=0;i<pool.length;i++){
        if(raw.indexOf(pool.charAt(i))>=0)out+=pool.charAt(i);
      }
      return out.length>=9?out:"";
    }
    var keep=threeDingKeepDigitsFromExclude(raw);
    return keep&&keep.length?keep:"";
  }
  function threeDingFormalPositionKillDigit(item){
    if(!item||item.kind!=="position")return "";
    var raw=String(item.code==null?"":item.code).replace(/\D/g,"");
    if(!raw)return "";
    if(raw.length>=9)return "";
    return raw.charAt(0)||"";
