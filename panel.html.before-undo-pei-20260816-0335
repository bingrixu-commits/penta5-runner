      if(out.length>=count)return;
      if(!item||item.code==null||String(item.code)==="--"||String(item.code)==="")return;
      var key=String(item.key||item.stateKey||"");
      if(preferUniqueKey&&key&&usedKeys[key])return;
      var digit=heweiDigit(item);
      if(digit&&usedHeweiDigits[digit])return;
      usedKeys[key]=true;
      if(digit)usedHeweiDigits[digit]=true;
      out.push(item);
