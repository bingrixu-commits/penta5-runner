    var item=map[period]||{},two=item.two||{},three=item.three||{};
    if(typeof two.success!=="boolean"||typeof three.success!=="boolean")return;
    stats.total+=1;
    var bothPass=two.success===true&&three.success===true;
    var bothFail=two.success===false&&three.success===false;
    if(bothPass){
      stats.allPass+=1;
      stats.currentAllPass+=1;
      stats.currentAllFail=0;
      stats.last="pass";
    }else if(bothFail){
      stats.allFail+=1;
      stats.currentAllFail+=1;
      stats.currentAllPass=0;
      stats.last="fail";
    }else{
      stats.mixed+=1;
      stats.currentAllPass=0;
      stats.currentAllFail=0;
      stats.last="mixed";
    }
  });
  if(stats.last!=="pass")stats.currentAllPass=0;
  if(stats.last!=="fail")stats.currentAllFail=0;
  return stats;
