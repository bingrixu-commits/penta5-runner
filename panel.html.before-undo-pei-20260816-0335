function fourPosExcludePosVersion(){
  var ver="four-pos-exclude-v3-long5k";
  try{
    if(typeof PANEL_SNAPSHOT_VERSIONS==="object"&&PANEL_SNAPSHOT_VERSIONS&&PANEL_SNAPSHOT_VERSIONS.fourPosExclude){
      ver=String(PANEL_SNAPSHOT_VERSIONS.fourPosExclude);
    }
  }catch(e){}
  return ver;
