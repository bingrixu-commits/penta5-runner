  function sealedThreeDuishuBackupPair(source){
    source=source||{};
    var main=String(source.selectedPair||source.selectedPairCode||"").replace(/\D/g,"").slice(0,2);
    var pairSelection=source.pairSelection&&typeof source.pairSelection==="object"?source.pairSelection:{};
    var scored=Array.isArray(pairSelection.candidates)?pairSelection.candidates:[];
    var i,j,cand,alt,pairs;
    for(i=0;i<scored.length;i++){
      cand=String(scored[i]&&scored[i].pair||"").replace(/\D/g,"").slice(0,2);
      if(/^\d{2}$/.test(cand)&&cand!==main)return cand;
    }
    pairs=Array.isArray(source.pairs)?source.pairs:[];
    for(j=0;j<pairs.length;j++){
      alt=String(pairs[j]||"").replace(/\D/g,"").slice(0,2);
      if(/^\d{2}$/.test(alt)&&alt!==main)return alt;
    }
    return "";
  }
  function threeDuishuPairWouldHit(actualText,pair){
    pair=String(pair||"").replace(/\D/g,"").slice(0,2);
