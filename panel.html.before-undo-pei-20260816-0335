      return "<tr><td>"+esc((g&&g.group)!=null?g.group:(i+1))+"</td><td>"+esc(typeTxt)+"</td><td>"+esc(cond)+"</td>"
        +"<td>"+esc(fracCell(g&&g.hit30,g&&g.total30,g&&g.rate30))+"</td>"
        +"<td>"+esc(fracCell(g&&g.hit120,g&&g.total120,g&&g.rate120))+"</td>"
        +"<td>"+esc(fracCell(g&&g.hitLong,g&&g.totalLong,g&&g.rateLong))+"</td></tr>";
    }).join("");
    groupTable.innerHTML=head+body;
  }
