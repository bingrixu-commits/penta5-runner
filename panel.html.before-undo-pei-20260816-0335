        throw txtPositionMakeError(spec.mark+" 截断拒绝：实收 "+list.length+" ≠ 应有 "+expectCount,"FAN_TRUNCATE",false);
      }
      if(!period){
        try{
          var st=window.__penta5TxtState||{};
          period=String(txtPositionLatestPeriod(st)||"");
        }catch(e){}
      }
      var pool=txtFourPoolFromCodes(list,spec.mark+" "+list.length+" 组·全面照收",spec.source);
      pool.mark=spec.mark;
      pool.modelId=spec.id;
      pool.period=period;
      pool.expectedCount=expectCount!=null?expectCount:list.length;
      pool.fullTake=true;
      window[txtFourLaneExternalMem(TXT_FOUR_LANE_FACTOR_EXCLUDE)]=pool;
      window.__penta5FourExternalPool=pool;
      txtFourSetPoolMark(spec.mark,pool.count,period);
      return pool;
    });
}
