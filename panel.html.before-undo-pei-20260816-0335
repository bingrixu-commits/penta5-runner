    var comboRows=evalRows(data);
    var comboLimit=Math.min(MODEL_STABLE_WINDOW, comboRows.length||0);
    var comboWindow=comboRows.slice(0,comboLimit);
    function comboStatsFor(items){
      var list=(items||[]).filter(Boolean),total=0,hit=0,nearHit=0,validChecks=0,successChecks=0;
      comboWindow.forEach(function(row){
        var results=list.map(function(item){
          return itemSuccess(data,item,row);
        }).filter(function(x){return typeof x==="boolean";});
        if(results.length!==list.length||!results.length)return;
        total++;
        var wins=0;
        results.forEach(function(ok){validChecks++;if(ok){wins++;successChecks++;}});
        if(wins===results.length)hit++;
        if(results.length>1&&wins>=results.length-1)nearHit++;
