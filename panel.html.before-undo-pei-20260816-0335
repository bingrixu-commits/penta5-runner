  function ensureExtendedHistoryCache(minCount,expectedPeriod,forceRefresh){
    // 按需拉取：请求多少拉多少。慢可以；半截/失败绝不拿旧缓存冒充满窗。
    var need=Math.max(120,Math.min(5000,Number(minCount||360)||360));
    var limit=need;
    if(Number(minCount||0)>=5000)limit=5000;
    var cached=Array.isArray(window.__penta5HistoryCache)?window.__penta5HistoryCache:[];
    var cachedFirst=cached[0]||{};
    var cachedFirstPeriod=String((cachedFirst.period!=null&&cachedFirst.period!=="")?cachedFirst.period:(cachedFirst.uid||""));
