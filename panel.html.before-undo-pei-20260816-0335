    var ev=row&&row.evaluation||{};
    var actual=(Array.isArray(ev.actualNumbers)&&ev.actualNumbers.length>=4)?ev.actualNumbers:(Array.isArray(ev.actualFirstFourDigits)?ev.actualFirstFourDigits:[]);
    if(!Array.isArray(actual)||actual.length<4)return null;
    var code=String(item.code);
    if(item.kind==="position"){
      var pos=positionByKey(item.key);
      if(!pos||actual[pos.index]===undefined)return null;
      var digits=code.replace(/\D/g,"").split("").filter(function(digit,index,self){return digit!==""&&self.indexOf(digit)===index;});
      if(!digits.length)return null;
      return digits.indexOf(String(actual[pos.index]))<0;
    }
    if(item.kind==="hewei"){
      var group=ev.actualCompositeHeweiGroup;
      if(!Array.isArray(group)||group.length<3)return null;
      var heweiDigits=code.replace(/\D/g,"").split("").filter(function(digit,index,self){return digit!==""&&self.indexOf(digit)===index;});
      if(!heweiDigits.length)return null;
