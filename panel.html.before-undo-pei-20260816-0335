function txtFourOpenedFromPanelHistoryRows(rows,limit,expectedPeriod,meta){
  rows=Array.isArray(rows)?rows:[];
  meta=meta&&typeof meta==="object"?meta:{};
  var want=Math.max(0,Number(limit||0)||0);
  var available=Number(meta.availableHistoryCount!=null?meta.availableHistoryCount:rows.length);
  // 库内够却只给半截：硬停，禁止 windowShort 继续扫
  if(want>0&&rows.length<want&&available>=want){
    throw txtPositionMakeError(
      "四定回删：历史半截（要 "+want+"，只给 "+rows.length+"，库内 "+available+"），禁止截断扫码",
      "HISTORY_INCOMPLETE",
      true
    );
  }
  var n=Math.min(want,rows.length);
  if(n<TXT_FOUR_HISTORY_MIN){
    throw txtPositionMakeError("四定回删：面板历史不足 "+TXT_FOUR_HISTORY_MIN+" 期（当前 "+n+"），无法回删","PANEL_HISTORY_SHORT",true);
  }
  // 请求满窗时必须扫满；库内真不够才允许短窗（库内 7000+ 时不应走到这）
  if(want>=TXT_FOUR_HISTORY_MIN&&n<want){
    throw txtPositionMakeError(
      "四定回删：未扫满请求期数（要 "+want+"，实得 "+n+"），已停止。可慢重试，禁止半截继续。",
      "HISTORY_NOT_FULL_WINDOW",
      true
    );
  }
  var seen=Object.create(null);
  var opened=[];
  var latestPeriod="";
  var oldestPeriod="";
  for(var i=0;i<n;i++){
    var row=rows[i]||{};
    var period=String(row.period!=null&&row.period!==""?row.period:(row.uid||"")).replace(/\D/g,"");
    var code=txtFourFourCodeFromHistoryRow(row);
    if(i===0)latestPeriod=period;
    oldestPeriod=period;
    if(!/^\d+$/.test(period)){
      throw txtPositionMakeError("四定回删：面板历史第 "+(i+1)+" 条期号无效","PANEL_HISTORY_PERIOD",false);
    }
