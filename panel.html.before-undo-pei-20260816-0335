  function buildThreeDingFrameworkAttackText(items,options){
    var list=frameworkAttackItems(items);
    if(!list.length)return "";
    // 三定系列（原/A/B）攻击语只吃本框定位项单码：挑中位除对应码，未挑中位保留全码；
    // 禁止叠全局 positionKills 双码看板，否则会比模型多排除数字（A/B 各只除1码却变成除2码）。
    var opts=options&&typeof options==="object"?options:{};
    var anyThreeOfFour=opts.anyThreeOfFour===true;
    var order=Array.isArray(opts.positionLabels)&&opts.positionLabels.length===3
      ?opts.positionLabels.slice()
      :(anyThreeOfFour?["千","百","十","个"]:["千","百","十"]);
    var keepByLabel={};
    var picked=0;
    list.forEach(function(item){
      if(!item||item.kind!=="position")return;
      var label=threeDingAttackPositionLabel(item);
      if(order.indexOf(label)<0)return;
      var keep=threeDingPositionKeepPoolFromItem(item);
      if(!keep)return;
      picked+=1;
      if(!keepByLabel[label]){
        keepByLabel[label]=keep;
        return;
      }
      keepByLabel[label]=keepByLabel[label].split("").filter(function(digit){
        return keep.indexOf(digit)>=0;
      }).join("");
    });
    if(picked<1){
      list.forEach(function(item){
        if(!item||item.kind!=="position"||picked>=1)return;
        var label=threeDingAttackPositionLabel(item);
        if(order.indexOf(label)<0)return;
        var kill=threeDingFormalPositionKillDigit(item);
        if(!/^\d$/.test(kill))return;
        var retryKeep=threeDingKeepDigitsFromExclude(kill);
        if(!retryKeep||retryKeep.length>=10)return;
        keepByLabel[label]=retryKeep;
        picked+=1;
      });
    }
    if(picked<1)return "";
    if(anyThreeOfFour&&Object.keys(keepByLabel).length!==3)return "";
    var head=(anyThreeOfFour?order.filter(function(label){return !!keepByLabel[label];}):order).map(function(label){
      return label+(keepByLabel[label]||"1234567890");
    }).join("");
    // 三定攻击语口径对齐抓四项：三定 + 二数合 + 除对数 + 除形态 + 除千百十合X（禁合尾保留池/多余合字）
    var tailParts=[];
    list.forEach(function(item){
      if(!item||item.code==null||String(item.code)===""||String(item.code)==="--")return;
      if(item.kind==="extra"&&item.key==="anyTwoHeweiHit"){
        var anyTwoTok=threeDingAnyTwoAttackToken(item,opts);
        if(anyTwoTok)tailParts.push({order:10,text:anyTwoTok});
      }else if(item.kind==="extra"&&item.key==="anyThreeHeweiHit"){
        tailParts.push({order:11,text:"三数合"+String(item.code).replace(/\D/g,"")});
      }else if(item.kind==="extra"&&(item.key==="twoDigitAvoid"||item.key==="twoDigitAvoid2"||item.key==="twoDigitAvoid3")){
        tailParts.push({order:20,text:"除对数"+String(item.code).replace(/\D/g,"")});
      }else if(item.kind==="derivedReverseShape"){
        var shapeCode=threeDingShapeAttackCode(String(item.code||""));
        if(shapeCode)tailParts.push({order:30,text:"除"+shapeCode});
      }else if(item.kind==="hewei"){
        var heweiTok=threeDingHeweiAttackToken(item);
        if(heweiTok)tailParts.push({order:40,text:heweiTok});
      }
    });
    tailParts.sort(function(a,b){return a.order-b.order;});
    var tail=tailParts.map(function(part){return part.text;}).join("");
    return ensurePracticeShotGeTail(head+"三定"+tail);
  }
