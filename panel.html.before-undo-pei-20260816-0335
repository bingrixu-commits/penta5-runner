  function todayTwoDigitAvoidGroupLedgerStats(data){
    var today=penta5CurrentBusinessDayKey(data);
    var keys=["twoDigitAvoid","twoDigitAvoid2","twoDigitAvoid3"];
    function freshStats(){
      return {total:0,hit:0,rate:null,currentWin:0,currentMiss:0,maxWin:0,maxMiss:0,lastResult:null,lastPeriod:""};
    }
    function applyStats(stats,ok,period){
      stats.total++;
      if(ok)stats.hit++;
      stats.rate=stats.total?stats.hit*100/stats.total:null;
      stats.lastResult=ok;
      stats.lastPeriod=String(period||"");
      if(ok){
        stats.currentWin++;
        stats.currentMiss=0;
        if(stats.currentWin>stats.maxWin)stats.maxWin=stats.currentWin;
      }else{
        stats.currentMiss++;
        stats.currentWin=0;
        if(stats.currentMiss>stats.maxMiss)stats.maxMiss=stats.currentMiss;
      }
    }
    var itemStats={};
    keys.forEach(function(key){itemStats[key]=freshStats();});
    var list=evalRows(data).filter(function(row){return penta5EvalRowBusinessDayKey(row)===today;});
    list=list.slice().sort(function(a,b){
      var ae=(a&&a.evaluation)||{},be=(b&&b.evaluation)||{};
      return String(ae.targetOpenTime||ae.evaluatedAt||a.baseOpenTime||a.basePeriod||"").localeCompare(String(be.targetOpenTime||be.evaluatedAt||b.baseOpenTime||b.basePeriod||""));
    });
