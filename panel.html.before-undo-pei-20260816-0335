  function parsePanelTimeMs(value){
    if(!value)return 0;
    var direct=Date.parse(String(value));
    if(isFinite(direct))return direct;
    var normalized=String(value).replace(/-/g,"/");
    var parsed=Date.parse(normalized);
    return isFinite(parsed)?parsed:0;
  }
  function latestSyncAgeMs(data){
    var last=(data&&data.lastSync)||{};
    var latest=(data&&data.latestRecord)||{};
    var ms=parsePanelTimeMs(last.at)||parsePanelTimeMs(latest.capturedAt)||parsePanelTimeMs(latest.opentime);
    return ms?Math.max(0,Date.now()-ms):Number.POSITIVE_INFINITY;
  }
  function drawSlotFloorMs(nowMs){
    var d=new Date(Number.isFinite(nowMs)?nowMs:Date.now());
    var minute=d.getMinutes()- (d.getMinutes()%5);
    var slot=new Date(d.getFullYear(),d.getMonth(),d.getDate(),d.getHours(),minute,DRAW_SECOND,0).getTime();
    if(slot>d.getTime())slot-=5*60*1000;
    return slot;
  }
  function nextDrawSlotMs(nowMs){
    return drawSlotFloorMs(nowMs)+5*60*1000;
  }
  function labeledDrawSlotMs(nowMs){
    var d=new Date(Number.isFinite(nowMs)?nowMs:Date.now());
    var minute=d.getMinutes()-(d.getMinutes()%5);
    return new Date(d.getFullYear(),d.getMonth(),d.getDate(),d.getHours(),minute,DRAW_SECOND,0).getTime();
  }
  function inDrawSyncWindow(nowMs){
    var now=Number.isFinite(nowMs)?nowMs:Date.now();
    var lastDraw=drawSlotFloorMs(now);
    var since=now-lastDraw;
    if(since>= -DRAW_SYNC_WINDOW_BEFORE_MS && since<=DRAW_SYNC_WINDOW_AFTER_MS)return true;
    var untilNext=nextDrawSlotMs(now)-now;
    return untilNext>=0 && untilNext<=DRAW_SYNC_WINDOW_BEFORE_MS;
  }
  function missingCurrentDraw(data,nowMs){
    var now=Number.isFinite(nowMs)?nowMs:Date.now();
    var labeled=labeledDrawSlotMs(now);
    // 认定开奖秒点前数秒源站就可能出号；提前约8秒开始按“缺期”催同步
    if(now<labeled-8000)return false;
    var latest=(data&&data.latestRecord)||{};
    var openMs=parsePanelTimeMs(latest.opentime);
    if(!openMs)return true;
    return openMs<labeled-2000;
  }
  function panelRefreshIntervalMs(){
    // tip 已就绪且不在开奖窗：再放慢，避免正车页空转重绘卡死操作
    if(!inDrawSyncWindow() && state && state.tipReady === true) return 90000;
    return inDrawSyncWindow()?PANEL_REFRESH_DRAW_MS:PANEL_REFRESH_MS;
  }
  function panelSyncStaleLimitMs(){
    return inDrawSyncWindow()?PANEL_SYNC_DRAW_STALE_MS:PANEL_SYNC_STALE_MS;
  }
  function maybeKickPanelSync(data){
    var now=Date.now();
    if(panelSyncRunning)return;
    if(typeof txtFourBackdeleteFreezeActive==="function"&&txtFourBackdeleteFreezeActive())return;
    // 后端正在 sync：只读 /state，别再叠 POST /sync，否则会把事件循环打满
    if(data&&data.syncing)return;
    var inWindow=inDrawSyncWindow(now);
    var missing=missingCurrentDraw(data,now);
    if(now-panelLastSyncAttemptAt<PANEL_AUTO_SYNC_MIN_MS && !inWindow && !missing)return;
    // 开奖窗内：已出新期放慢；缺期再催，避免连环 /sync 卡死回登录页
    if(inWindow||missing){
      var gap=missing?3500:10000;
      if(now-panelLastSyncAttemptAt<gap)return;
    }
    if(data&&data.ok&&latestSyncAgeMs(data)<=panelSyncStaleLimitMs() && !missing)return;
    panelLastSyncAttemptAt=now;
    panelSyncRunning=true;
    panelFetch("/sync",{
      method:"POST",
      cache:"no-store",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({trigger:"panel-auto"})
    })
      .then(function(){setTimeout(function(){refresh(false,{source:"auto"});},500);})
      .catch(function(err){console.warn("panel auto sync failed",err);})
      .finally(function(){panelSyncRunning=false;});
  }
