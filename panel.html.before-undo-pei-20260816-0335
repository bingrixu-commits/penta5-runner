  function parseShotLanguageRules(value){
    var rules=[];
    String(value||"").split(/\r?\n/).forEach(function(line){
      var text=String(line||"").trim();
      if(!text||text.charAt(0)==="#")return;
      var index=text.indexOf("=>");
      var step=2;
      if(index<0){index=text.indexOf("=");step=1;}
      if(index<0)return;
      var from=text.slice(0,index);
      var to=text.slice(index+step);
      if(from)rules.push({from:from,to:to});
    });
    return rules;
  }
  function applyShotLanguageRules(text,rulesText,enabled){
    var output=String(text||"");
    if(!enabled)return output;
    parseShotLanguageRules(rulesText).forEach(function(rule){
      output=output.split(rule.from).join(rule.to);
    });
    return output;
  }
