    var nums=Array.isArray(ev.actualNumbers)?ev.actualNumbers.slice(0,4).map(String):[];
    if(nums.length<4)return null;
    // 历史回算不套今日 counters，按当期封存码+面板同款排序字段
    var pos=pickFourDingTop2PositionsFromPred(pred,null);
    var hew=pickFourDingTop2HeweiFromPred(pred,null);
    var posTop=(pos.top3&&pos.top3.length?pos.top3:pos.top2)||[];
    if(posTop.length<3||hew.top2.length<2)return null;
    var details=[], allOk=true, posOk=true, i, p, h, actual, ok, evH;
    for(i=0;i<posTop.length;i++){
      p=posTop[i];
      actual=nums[FOUR_DING_POS_INDEX[p.key]];
      ok=String(actual)!==String(p.digit);
      details.push({kind:"pos",text:p.label+"-"+p.digit,actual:actual,ok:ok});
      if(!ok){allOk=false;posOk=false;}
    }
    for(i=0;i<hew.top2.length;i++){
      h=hew.top2[i];
      evH=ev.independentHewei&&ev.independentHewei[h.key];
      actual=evH&&evH.actualDigit!=null?String(evH.actualDigit):fourDingHeweiActualDigit(nums.map(Number),h.idxs||FOUR_DING_HEWEI_INDEX[h.key]||[]);
