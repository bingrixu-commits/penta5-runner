            // 可重试：卡顿时首期落后/超前，由上层对准；禁止非重试直接作废满窗回删
            var lagErr=new Error("RDS /history 首期 "+(firstPeriod||"空")+" 与当前最新期 "+expectedPeriod+" 不一致");
            lagErr.retryable=true;
            lagErr.code="RDS_PERIOD_LAGGING";
            lagErr.firstPeriod=firstPeriod;
            throw lagErr;
