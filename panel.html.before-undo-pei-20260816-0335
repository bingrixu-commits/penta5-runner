    if(window.__penta5HistoryCachePromise){
      var inflightLimit=Number(window.__penta5HistoryCachePromiseLimit||0)||0;
      if(inflightLimit>=need)return window.__penta5HistoryCachePromise;
      return window.__penta5HistoryCachePromise.then(function(){
        return ensureExtendedHistoryCache(need,expectedPeriod,forceRefresh);
      });
    }
