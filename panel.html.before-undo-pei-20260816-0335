      var index=item.key==="wanQianBai"?0:(item.key==="qianBaiShi"?1:2);
      return heweiDigits.indexOf(String(group[index]))<0;
    }
    if(item.kind==="shape"){
      return /^[大小单双]{4}$/.test(code)?!shapeMatches({numbers:actual},item.key,forceThreeWithOneShape(code,item.key)):null;
    }
    if(item.kind==="derivedReverseShape"){
      var reverseShapeKey=item.shapeKey||(item.key==="reverseSize"?"shapeSize":"shapeParity");
      if(Number(item.shapeScopeLength||0)===3){
        var qbsCode=threeDingShapeAttackCode(code);
        return /^[大小单双]{3}$/.test(qbsCode)?!shapeMatchesQbs({numbers:actual},reverseShapeKey,qbsCode):null;
      }
      return /^[大小单双]{4}$/.test(code)?!shapeMatches({numbers:actual},reverseShapeKey,forceThreeWithOneShape(code,reverseShapeKey)):null;
    }
    if(item.kind==="extra"){
      var sealedAnyTwo=sealedFrameworkItemSuccess(ev,item);
      if(typeof sealedAnyTwo==="boolean")return sealedAnyTwo;
      var extra=EXTRAS.filter(function(s){return s.key===item.key;})[0];
      if(!extra)return null;
      var extraRuntime=Object.assign({},extra);
      if(Array.isArray(item.codes))extraRuntime.codes=item.codes.slice();
