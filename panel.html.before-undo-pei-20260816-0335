            shortErr.retryable=true;
            shortErr.code="HISTORY_INCOMPLETE";
            throw shortErr;
          }
          if(rows.length<need){
            // 小窗预热允许短历史；大窗回删由上层强制满窗
            if(need<=400&&rows.length>=120){
              window.__penta5HistoryCache=rows;
              return rows;
            }
            var dbShort=new Error("历史不足 "+need+" 期（当前 "+rows.length+"），可慢点再拉，禁止半截糊弄");
            dbShort.retryable=true;
