  };
  txtFourStatsAppend(entry);
  // 跨期只结算：命中删那一码，剩码保留继续转发/下期再用（禁止清零逼换码）
  txtFourStickyWriteLastCheck(settleBase,poolLeft,latest,hit===true,evaluatedAt,lane);
  txtFourStickySave(sticky,{lane:lane});
  try{
    var snap=txtFourVerifyLoad({lane:lane})||{};
    snap.basePeriod=String(latest.period);
    snap.left=sticky.codes.length;
    snap.evaluated=false;
    snap.targetPeriod="";
    snap.targetCode="";
    snap.hit=null;
    txtFourVerifySave(snap,{lane:lane});
  }catch(eKeep){}
  if(sticky.mark&&!txtFourLaneIsDing(lane))txtFourSetPoolMark(sticky.mark,sticky.left,sticky.basePeriod);
  txtSetStatus((txtFourLaneIsDing(lane)?"四定框架":"混四因子")+"开奖比对："+(hit?"中":"不中")+"（"+target+"）。剩 "+sticky.codes.length+" 组。");
  return sticky;
