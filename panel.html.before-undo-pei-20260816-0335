  function qpSealKeyB64(){
    try{return sessionStorage.getItem("penta5_qp_seal_key")||"";}catch(e){return "";}
  }

  async function ensureQpSealKeyFromLoginTemp(){
    try{
      if(qpSealKeyB64()){
        try{sessionStorage.removeItem("penta5_qp_seal_pw_tmp");}catch(e0){}
        return !!qpSealKeyB64();
      }
      var pw="";
      try{pw=sessionStorage.getItem("penta5_qp_seal_pw_tmp")||"";}catch(e1){pw="";}
      if(!pw||typeof crypto==="undefined"||!crypto.subtle)return false;
      await new Promise(function(r){setTimeout(r,0);});
      var enc=new TextEncoder();
      var keyMaterial=await crypto.subtle.importKey("raw",enc.encode(pw),{name:"PBKDF2"},false,["deriveBits"]);
      var bits=await crypto.subtle.deriveBits({name:"PBKDF2",salt:enc.encode(QP_SEAL_SALT),iterations:120000,hash:"SHA-256"},keyMaterial,256);
      var arr=new Uint8Array(bits), bin="";
      for(var i=0;i<arr.length;i+=1)bin+=String.fromCharCode(arr[i]);
      sessionStorage.setItem("penta5_qp_seal_key",btoa(bin));
      try{sessionStorage.removeItem("penta5_qp_seal_pw_tmp");}catch(e2){}
      return true;
    }catch(err){
      try{sessionStorage.removeItem("penta5_qp_seal_pw_tmp");}catch(e3){}
      console.warn("qp seal key derive failed",err);
      return false;
    }
  }

  async function unsealQualifiedPicksEnvelope(envelope){
    var keyB64=qpSealKeyB64();
    if(!envelope||!keyB64||typeof crypto==="undefined"||!crypto.subtle)return null;
    var raw=Uint8Array.from(atob(keyB64),function(c){return c.charCodeAt(0);});
    var key=await crypto.subtle.importKey("raw",raw,{name:"AES-GCM"},false,["decrypt"]);
    var iv=Uint8Array.from(atob(envelope.iv||""),function(c){return c.charCodeAt(0);});
    var data=Uint8Array.from(atob(envelope.data||""),function(c){return c.charCodeAt(0);});
    var tag=Uint8Array.from(atob(envelope.tag||""),function(c){return c.charCodeAt(0);});
    var merged=new Uint8Array(data.length+tag.length);
    merged.set(data,0); merged.set(tag,data.length);
    var plain=await crypto.subtle.decrypt({name:"AES-GCM",iv:iv,tagLength:128},key,merged);
    return JSON.parse(new TextDecoder().decode(plain));
  }
  async function fetchSealedQualified(path){
