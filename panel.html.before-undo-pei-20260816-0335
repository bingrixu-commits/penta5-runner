      alreadyEntry.basePeriod,
      sticky.codes.length,
      latest,
      alreadyEntry.hit===true,
      alreadyEntry.evaluatedAt||Date.now(),
      lane
    );
    if(String(sticky.basePeriod||"")!==String(latest.period)){
      sticky.basePeriod=String(latest.period);
      sticky.left=sticky.codes.length;
      txtFourStickySave(sticky,{lane:lane});
    }
    return sticky;
  }
  var settleBase=String(sticky.basePeriod||"");
  var poolLeft=sticky.codes.length;
  var target=String(latest.code);
