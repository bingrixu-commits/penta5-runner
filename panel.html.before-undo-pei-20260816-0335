      return;
    }
    var period=practiceOutcomePeriod(row);
    var scriptResults=[];
    var results=[];
    if(snapshot){
      scriptResults=practiceScriptEvaluationResults(snapshot.standardValue,row);
      if(items.length){
        results=items.map(function(item){
          var success=practiceStrictItemSuccess(state||{},item,row);
          return {item:item,success:success};
        });
      }else{
        results=scriptResults;
      }
    }else if(useBackendOnly){
      results=items.map(function(item){return {item:item,success:item.success};});
    }else{
      results=items.map(function(item){
        var success=practiceStrictItemSuccess(state||{},item,row);
        return {item:item,success:success};
      });
    }
    if(snapshot&&!results.length){
      box.style.display="block";
      box.style.background="#f8fafc";
      box.style.borderColor="#e2e8f0";
      box.style.color="#475569";
      box.className="";
      box.textContent="本期开奖结果（"+modeLabel+"）："+(period||"--")+"｜脚本快照无法完整解析，不触发烟花";
      return;
    }
    var valid=results.filter(function(result){return typeof result.success==="boolean";});
    var passed=valid.filter(function(result){return result.success;}).length;
    var failed=valid.length-passed;
    var scriptValid=scriptResults.filter(function(result){return typeof result.success==="boolean";});
    var scriptCountAligned=!snapshot||!items.length||scriptValid.length===items.length;
    var scriptFailed=!!(snapshot&&scriptValid.some(function(result){return result.success===false;}));
    box.style.display="block";
    var expectedCount=items.length||results.length;
    if(valid.length!==expectedCount){
      box.style.background="#f8fafc";
      box.style.borderColor="#e2e8f0";
      box.style.color="#475569";
      box.textContent="本期开奖结果（"+modeLabel+"）："+(period||"--")+"｜已识别 "+valid.length+"/"+expectedCount+" 项，等待完整回算";
      return;
    }
    var strictAllPassed=valid.length>0&&passed===valid.length;
    var allPassed=strictAllPassed&&(!snapshot||!items.length||(scriptCountAligned&&!scriptFailed));
    box.style.background=allPassed?"#dcfce7":"#fff7ed";
    box.style.borderColor=allPassed?"#86efac":"#fed7aa";
    box.style.color=allPassed?"#166534":"#9a3412";
    box.className=allPassed?"practice-hit-strong":"";
    var baseKey=practiceRowBaseKey(row);
    var sourceText=snapshot?"按实际生成脚本快照 "+esc(baseKey)+"，来源："+esc(snapshot.armedReason||"generate"):"按后端账本显示，不触发烟花";
    var notes=[];
    var failedNames=valid.filter(function(result){return result.success===false;}).map(practiceResultLabel).slice(0,4);
    var scriptFailedNames=scriptValid.filter(function(result){return result.success===false;}).map(practiceResultLabel).slice(0,4);
    if(failedNames.length)notes.push("失败项："+failedNames.map(esc).join("、"));
    if(snapshot&&items.length&&!scriptCountAligned)notes.push("脚本识别 "+esc(scriptValid.length)+"/"+esc(items.length)+" 项，按未过处理");
    if(scriptFailedNames.length)notes.push("脚本未过："+scriptFailedNames.map(esc).join("、"));
    setHtml(box,"本期开奖结果（"+esc(modeLabel)+"）："+esc(period||"--")+"｜通过 "+esc(passed)+"/"+esc(valid.length)+(failed?("｜未过 "+esc(failed)):"｜全部通过")
      +(notes.length?' <span style="font-weight:700;">｜'+notes.join("｜")+"</span>":"")
      +' <span style="font-weight:500;color:#64748b;">（'+sourceText+'）</span>'
      +'<div style="margin-top:4px;font-size:12px;font-weight:600;opacity:.92;">按开奖前脚本快照/后端账本结算，不是当前输入框即时改码回算。</div>');
    if(allPassed&&snapshot){
      var key=String(period||"")+"|"+String(modeLabel||"")+"|base="+baseKey+"|standard="+String(snapshot.standardValue||"")+"|final="+String(snapshot.finalValue||"");
      if(key&&key!==practiceLastCelebrationKey){
