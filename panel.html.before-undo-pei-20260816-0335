  }
  fetch("/four-factor-rank?t="+Date.now(),{credentials:"same-origin",cache:"no-store"})
    .then(function(r){return r.ok?r.json():null;})
    .then(function(own){
      if(!own||own.ok===false){fillEmpty(own&&own.error?String(own.error):"旁路未就绪");return;}
      window.__penta5FourFactorOwn=own;
      var items=Array.isArray(own.items)?own.items:[];
      var byKey={};
      items.forEach(function(it){if(it&&it.key)byKey[it.key]=it;});
      var period=own.latestPeriod||"--";
      var joint=own.joint||(own.backtest&&own.backtest.joint)||{};
      var jointTxt="";
      // 联合=正路盖全=排除侧；剩码=反路剩池
      var remain=own.remain||(own.backtest&&own.backtest.remain)||{};
      var remainTxt="";
      var dropN=Number(own.dropN||0)||((own.dropKills||[]).length||0);
      // 拒读旧口径：排除6 / 联合直选0.8% / 缺 meaning 一律不展示百分比
      var jointOk=String(joint.meaning||"")==="kill-not-in-remain";
      var remainOk=String(remain.meaning||"")==="remain-pool";
      var poolOk=dropN===7&&Number(own.remainCount)>0&&Number(own.remainCount)<5000;
      var statsOk=jointOk&&remainOk&&poolOk;
      if(statsOk&&remain.rate120!=null){
        remainTxt="剩码 "+Number(remain.rate120).toFixed(1)+"%";
        if(remain.hit120!=null&&remain.total120!=null)remainTxt+="（"+remain.hit120+"/"+remain.total120+"）";
      }
      if(statsOk&&joint.rate120!=null){
        jointTxt="联合 "+Number(joint.rate120).toFixed(1)+"%";
        if(joint.hit120!=null&&joint.total120!=null)jointTxt+="（"+joint.hit120+"/"+joint.total120+"）";
      }
      function remainStatBits(){
        var bits=[];
        if(statsOk&&own.remainCount!=null)bits.push("剩号 "+own.remainCount+" 组");
        if(remainTxt)bits.push(remainTxt);
        if(statsOk&&remain.maxWinToday!=null&&remain.maxMissToday!=null){
          bits.push("今日最高连中 "+remain.maxWinToday+" · 今日最高连败 "+remain.maxMissToday
            +(remain.todayTotal!=null?("（"+remain.todayTotal+"期）"):""));
        }
        if(statsOk&&remain.currentWinToday!=null&&remain.currentMissToday!=null){
          bits.push("当前连中 "+remain.currentWinToday+" · 当前连败 "+remain.currentMissToday);
        }
        return bits;
      }
      if(meta){
        var metaBits=["四因子","期号 "+period,"排除"+String(dropN||7)];
        metaBits=metaBits.concat(remainStatBits());
        if(!statsOk)metaBits.push("统计口径未就绪(需重启 four-factor-rank)");
        meta.textContent=metaBits.join(" · ");
      }
      specs.forEach(function(spec){
        var it=byKey[spec.key]||null;
        var digit=(it&&it.digit!=null)?String(it.digit):(own.picks&&own.picks[spec.key]!=null?String(own.picks[spec.key]):"");
        var digitEl=document.getElementById(spec.digitId);
        var metaEl=document.getElementById(spec.metaId);
        var statsEl=document.getElementById(spec.statsId);
        if(digitEl)digitEl.textContent=digit||"--";
        var parts=[];
        if(it&&Array.isArray(it.dropDigits)&&it.dropDigits.length){
          parts.push("排除 "+it.dropDigits.join(","));
        }
        if(it&&it.rate120!=null){
          var r120="120期 "+Number(it.rate120).toFixed(1)+"%";
          if(it.hit120!=null&&it.total120!=null)r120+="（"+it.hit120+"/"+it.total120+"）";
          parts.push(r120);
        }
        if(it&&it.rate30!=null)parts.push("近30 "+Number(it.rate30).toFixed(1)+"%");
        if(it&&it.score!=null)parts.push("分 "+Number(it.score).toFixed(3));
        if(it&&it.miss!=null)parts.push("遗漏 "+it.miss);
        if(it&&it.top3&&it.top3[1]&&it.top3[1].digit!=null)parts.push("次选 "+it.top3[1].digit);
        if(metaEl)metaEl.textContent=parts.length?parts.join(" · "):"--";
        fillFourFactorStats(statsEl,it);
      });
      if(line){
        var base=own.line?("本期主排："+own.line):"--";
        if(own.reverseLine)base+=" ｜ 全排除"+String(dropN||7)+"："+own.reverseLine;
        var rBits=remainStatBits();
        if(rBits.length)base+=" ｜ "+rBits.join(" ｜ ");
        if(!statsOk)base+=" ｜ ⚠旁路仍是旧统计(排除6/联合直选)，请重启 four-factor-rank";
        line.textContent=base;
      }
      var todayStatsEl=document.getElementById("fourFactorTodayStats");
      if(todayStatsEl){
        if(statsOk&&joint){
          todayStatsEl.textContent=[
            "今日统计器",
            "当前命中 "+(joint.currentWin!=null?joint.currentWin:"--"),
            "最高命中 "+(joint.maxWin!=null?joint.maxWin:"--"),
            "最高连败 "+(joint.maxMiss!=null?joint.maxMiss:"--"),
            "今日最大连中 "+(joint.maxWinToday!=null?joint.maxWinToday:"--"),
            "今日最大连败 "+(joint.maxMissToday!=null?joint.maxMissToday:"--")
          ].join(" ｜ ");
        }else{
          todayStatsEl.textContent="今日统计器：口径未就绪";
        }
      }
      var glanceEl=document.getElementById("fourFactorFrameworkGlanceLine");
      if(glanceEl){
        if(own.reverseLine){
          var glanceBits=[
            "期号 "+period,
            "全排除"+String(dropN||7)+"："+own.reverseLine
          ];
          if(statsOk&&joint){
            glanceBits.push(
              "当前命中 "+(joint.currentWin!=null?joint.currentWin:"--"),
              "今日最大连中 "+(joint.maxWinToday!=null?joint.maxWinToday:"--"),
              "今日最大连败 "+(joint.maxMissToday!=null?joint.maxMissToday:"--")
            );
          }
          glanceEl.textContent=glanceBits.join(" ｜ ");
        }else{
          glanceEl.textContent=statsOk?"四因子排除暂无全排除行":"四因子旁路未就绪";
        }
      }
      var remainCountEl=document.getElementById("fourFactorRemainCount");
      if(remainCountEl){
        var rc;
        if(statsOk){
          rc=remainStatBits().join(" ｜ ")||("剩号 "+String(own.remainCount!=null?own.remainCount:"--")+" 组");
        }else{
          rc="口径未就绪 · 勿信旧 5184/0.8% · 请重启 four-factor-rank";
        }
        remainCountEl.textContent=rc;
      }
    })
    .catch(function(){fillEmpty("读取四因子排码失败");});
}
function paintShapeAvoid3Board(){ return; // panel-lite

  var meta=document.getElementById("shapeAvoid3Meta");
