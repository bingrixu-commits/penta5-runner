    items.forEach(function(it){
      if(!it||FOUR_DING_POS_ORDER.indexOf(String(it.key))<0)return;
      var digit=String(it.code==null?"":it.code).replace(/\D/g,"").slice(0,1);
      if(!/^\d$/.test(digit))return;
      var st=data?fourDingDailyPosStat(data,it.key):{rate:-1,hit:0,total:0};
      var rate=st.rate>=0?st.rate:fourDingPosRate(it);
      byKey[it.key]={key:it.key,label:FOUR_DING_POS_LABELS[it.key],digit:digit,rate:rate,hit:st.hit,total:st.total,source:"fourPosExclude"};
    });
    var kills=pred.positionKills||{};
    FOUR_DING_POS_ORDER.forEach(function(k){
      if(byKey[k]||!kills[k])return;
      var row=kills[k];
      var digit=String(row.selectedDigit||row.primaryDigit||row.recommendDigit||row.main||"").replace(/\D/g,"").slice(0,1);
      if(!/^\d$/.test(digit))return;
      var st=data?fourDingDailyPosStat(data,k):{rate:-1,hit:0,total:0};
      var rate=st.rate>=0?st.rate:fourDingPosRate(row);
      byKey[k]={key:k,label:FOUR_DING_POS_LABELS[k],digit:digit,rate:rate,hit:st.hit,total:st.total,source:"positionKills"};
    });
    var all=FOUR_DING_POS_ORDER.map(function(k){return byKey[k];}).filter(Boolean);
