      ||dateKeyFromValue(row&&row.baseOpenTime)
      ||dateKeyFromValue(row&&row.basePeriod)
      ||dateKeyFromValue(ev.targetPeriod)
      ||dateKeyFromValue(row&&row.opentime)
      ||dateKeyFromValue(row&&row.period);
