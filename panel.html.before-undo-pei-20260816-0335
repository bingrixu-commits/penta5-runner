            err.status=res.status;
            throw err;
          }
          var rows=Array.isArray(payload.history)?payload.history:[];
          if(!rows.length)throw new Error("RDS /history 返回空历史");
          var first=rows[0]||{};
          var firstPeriod=String((first.period!=null&&first.period!=="")?first.period:(first.uid||""));
