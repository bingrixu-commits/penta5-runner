  function evaluateFourDingThreeDigitGroupOnPred(pred){
    if(!pred||!pred.evaluation)return null;
    var ev=pred.evaluation;
    if(ev.truthEligible===false||ev.voided===true||pred.counterSkipped)return null;
    var extras=ev.independentExtras||{};
    var keys=["threeDigitAvoid","threeDigitHit","threeDigitAvoid2"];
    var details=[], allOk=true, i, key, row, code, ok, nums;
    nums=Array.isArray(ev.actualNumbers)?ev.actualNumbers.slice(0,4).map(String):[];
    for(i=0;i<keys.length;i++){
      key=keys[i];
      row=extras[key];
      code=String((row&&row.value)||"").replace(/\D/g,"").slice(0,3);
      // 缺组跳过（历史期可能无 threeDigitAvoid2），有多少算多少，至少 2 组才结算
