  var latestPeriod="";
  TXT_STRICT_THREE_HISTORY_PRESETS.forEach(function(limit){
    byLimit[limit]={hit:0,total:0,rate:null,byCombo:{}};
  });
  TXT_STRICT_THREE_MODELS.forEach(function(model){
    var codes=[], periods=[];
    for(var i=0;i<rows.length;i++){
      var code=txtPositionCodeFromRow(rows[i],model.positions);
      var period=txtStrictThreePeriod(rows[i]);
      if(!/^\d{3}$/.test(code)||!/^\d+$/.test(period))continue;
      codes.push(code);
      periods.push(period);
    }
    if(!latestPeriod&&periods[0])latestPeriod=periods[0];
    TXT_STRICT_THREE_HISTORY_PRESETS.forEach(function(limit){
      var hit=0,total=0;
      var maxEval=Math.min(TXT_THREE_RATE_EVAL,Math.max(0,codes.length-limit));
      for(var ei=0;ei<maxEval;ei++){
        var seen=Object.create(null);
        var end=Math.min(codes.length,ei+1+limit);
        for(var j=ei+1;j<end;j++)seen[codes[j]]=true;
        // 无攻击语全池1000：开奖三位不在近N唯一旧码=仍在剩码=中
        if(!seen[codes[ei]])hit+=1;
        total+=1;
      }
      byLimit[limit].byCombo[model.name]={hit:hit,total:total,rate:total?Number((hit*100/total).toFixed(2)):null};
      byLimit[limit].hit+=hit;
      byLimit[limit].total+=total;
    });
  });
  TXT_STRICT_THREE_HISTORY_PRESETS.forEach(function(limit){
    var row=byLimit[limit];
    row.rate=row.total?Number((row.hit*100/row.total).toFixed(2)):null;
  });
  return {ok:true,latestPeriod:latestPeriod,evalLimit:TXT_THREE_RATE_EVAL,scanned:rows.length,byLimit:byLimit,at:Date.now(),mode:"no-attack"};
