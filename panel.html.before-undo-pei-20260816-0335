  for(var ci=0;ci<sticky.codes.length;ci++){
    if(String(sticky.codes[ci])===target){inRemain=true;break;}
  }
  var hit=inRemain===true;
  if(inRemain){
    sticky.codes=sticky.codes.filter(function(code){return String(code)!==target;});
  }
  sticky.left=sticky.codes.length;
  sticky.basePeriod=String(latest.period);
  var evaluatedAt=Date.now();
  var entry={
    lane:lane,
    basePeriod:settleBase,
    targetPeriod:String(latest.period),
