function txtStrictThreeHistoryLimitNormalize(value){
  var n=Math.floor(Number(value||0));
  if(!(n>0))n=TXT_STRICT_THREE_HISTORY_COUNT;
  if(n>TXT_STRICT_THREE_HISTORY_COUNT)n=TXT_STRICT_THREE_HISTORY_COUNT;
  if(TXT_STRICT_THREE_HISTORY_PRESETS.indexOf(n)<0){
    // 允许主跑档；不在预设内则夹到最接近预设
    var best=TXT_STRICT_THREE_HISTORY_PRESETS[TXT_STRICT_THREE_HISTORY_PRESETS.length-1];
    var bestDiff=Math.abs(best-n);
    TXT_STRICT_THREE_HISTORY_PRESETS.forEach(function(p){
      var d=Math.abs(p-n); if(d<bestDiff){best=p;bestDiff=d;}
    });
    n=best;
  }
  return n;
}
