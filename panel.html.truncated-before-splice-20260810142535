function txtFourStickyAdvance(latest,data){
  latest=latest||txtFourLatestDraw(data);
  var sticky=txtFourStickyLoad();
  if(!sticky||!Array.isArray(sticky.codes)||!sticky.codes.length)return sticky;
  if(!latest.period||!/^\d{4}$/.test(String(latest.code||"")))return sticky;
  if(!txtFourPeriodNewer(latest.period,sticky.basePeriod))return sticky;
  var store=txtFourStatsLoad();
  var alreadyEntry=null;
  var stickyLimit=txtFourHistoryLimitNormalize(sticky.historyLimit||txtFourHistoryLimitGet());
  var evaluated=store.evaluated||[];
  for(var ei=0;ei<evaluated.length;ei++){
    var item=evaluated[ei];
    if(item&&item.evaluated===true
      &&String(item.targetPeriod||"")===String(latest.period)
      &&txtFourHistoryLimitNormalize(item.historyLimit)===stickyLimit){
      alreadyEntry=item;
      break;
    }
  }
  if(alreadyEntry){
    // 本档本期已记过：只刷新 lastCheck，剩码继续留着给转发/下期再用
    txtFourStickyWriteLastCheck(
      alreadyEntry.basePeriod,
      sticky.codes.length,
      latest,
      alreadyEntry.hit===true,
      alreadyEntry.evaluatedAt||Date.now()
    );
    if(String(sticky.basePeriod||"")!==String(latest.period)){
      sticky.basePeriod=String(latest.period);
      sticky.left=sticky.codes.length;
      txtFourStickySave(sticky);
    }
    return sticky;
  }
  var settleBase=String(sticky.basePeriod||"");
  var poolLeft=sticky.codes.length;
  var target=String(latest.code);
  // 核对口径：开奖码在装载池里=中（四因子默认排除池=正路盖全）；不在=不中
  var inRemain=false;
  for(var ci=0;ci<sticky.codes.length;ci++){
    if(String(sticky.codes[ci])===target){inRemain=true;break;}
  }
  var hit=inRemain===true;
  if(inRemain){
    sticky.codes=sticky.codes.filter(function(code){return String(code)!==target;});
  }
  sticky.left=sticky.codes.length;
  sticky.basePeriod=String(latest.period);
  var evaluatedAt=Date.now();
  var entry={
    basePeriod:settleBase,
    targetPeriod:String(latest.period),
    targetCode:target,
    targetDay:txtFourStatsTodayKey(data),
    hit:hit===true,
    inRemain:inRemain===true,
    left:poolLeft,
    historyLimit:Number(sticky.historyLimit||txtFourHistoryLimitGet()),
    evaluated:true,
    evaluatedAt:evaluatedAt
  };
  txtFourStatsAppend(entry);
  // 跨期只结算：命中删那一码，剩码保留继续转发/下期再用（禁止清零逼换码）
  txtFourStickyWriteLastCheck(settleBase,poolLeft,latest,hit===true,evaluatedAt);
  txtFourStickySave(sticky);
  try{
    var snap=txtFourVerifyLoad()||{};
    snap.basePeriod=String(latest.period);
    snap.left=sticky.codes.length;
    snap.evaluated=false;
    snap.targetPeriod="";
    snap.targetCode="";
    snap.hit=null;
    txtFourVerifySave(snap);
  }catch(eKeep){}
  if(sticky.mark)txtFourSetPoolMark(sticky.mark,sticky.left,sticky.basePeriod);
  txtSetStatus("开奖比对完成："+(hit?"中":"不中")+"（"+target+"）。剩 "+sticky.codes.length+" 组已保留，可继续转发或下期再用（无需重生成）。");
  return sticky;
}
