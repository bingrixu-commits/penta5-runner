function txtDownload(name,text){
  // 纯本机下载：主窗口绝不导航。忽略 a.download 时，旧写法会整页跳到 blob: 文本页。
  var fileName=String(name||"penta5.txt").replace(/[\\/:*?"<>|\u0000-\u001f]+/g,"_").trim()||"penta5.txt";
  if(!/\.txt$/i.test(fileName))fileName+=".txt";
  var payload=String(text||"");
  var blob=new Blob([payload],{type:"application/octet-stream"});
  var panelStayUrl=(function(){
    try{return location.origin+"/panel";}catch(e){return "http://8.210.5.221/panel";}
  })();
  function guardMainFrame(){
    try{
      var href=String(location.href||"");
      if(String(location.protocol||"")==="blob:"||href.indexOf("blob:")===0){
        location.replace(panelStayUrl);
      }
    }catch(e){}
  }
  if(typeof navigator!=="undefined"&&typeof navigator.msSaveOrOpenBlob==="function"){
    navigator.msSaveOrOpenBlob(blob,fileName);
    return;
  }
  function downloadInHiddenFrame(){
    var url=URL.createObjectURL(blob);
    var frame=document.createElement("iframe");
    frame.setAttribute("aria-hidden","true");
    frame.style.cssText="position:fixed;left:-99999px;top:-99999px;width:1px;height:1px;opacity:0;border:0;pointer-events:none;";
    document.body.appendChild(frame);
    var cleaned=false;
    function cleanup(){
      if(cleaned)return;
      cleaned=true;
      setTimeout(function(){
        try{URL.revokeObjectURL(url);}catch(e){}
        try{if(frame&&frame.parentNode)frame.parentNode.removeChild(frame);}catch(e){}
      },20000);
    }
    try{
      var idoc=frame.contentDocument||(frame.contentWindow&&frame.contentWindow.document);
      if(idoc){
        idoc.open();
        idoc.write("<!doctype html><html><head><meta charset=\"utf-8\"></head><body></body></html>");
        idoc.close();
        var a=idoc.createElement("a");
        a.href=url;
        a.setAttribute("download",fileName);
        a.rel="noopener";
        idoc.body.appendChild(a);
        a.click();
        cleanup();
        setTimeout(guardMainFrame,0);
        setTimeout(guardMainFrame,50);
        return true;
      }
    }catch(e){}
    // iframe 写不进去时：只让 iframe 自己加载 blob，主页面仍留在 /panel
    try{
      frame.onload=function(){cleanup();setTimeout(guardMainFrame,0);};
      frame.src=url;
      setTimeout(cleanup,20000);
      setTimeout(guardMainFrame,0);
      return true;
    }catch(e2){
      try{if(frame&&frame.parentNode)frame.parentNode.removeChild(frame);}catch(e3){}
      try{URL.revokeObjectURL(url);}catch(e4){}
      return false;
    }
  }
  function downloadViaBlankTab(){
    // 最后兜底：新标签打开，主页面不跳
    var url=URL.createObjectURL(blob);
    var a=document.createElement("a");
    a.href=url;
    a.download=fileName;
    a.target="_blank";
    a.rel="noopener noreferrer";
    a.style.cssText="display:none;position:fixed;left:-9999px;top:-9999px;";
    document.body.appendChild(a);
    a.click();
    setTimeout(guardMainFrame,0);
    setTimeout(guardMainFrame,50);
    setTimeout(function(){
      try{URL.revokeObjectURL(url);}catch(e){}
      try{if(a&&a.parentNode)a.parentNode.removeChild(a);}catch(e){}
    },20000);
  }
  if(typeof window.showSaveFilePicker==="function"){
    window.showSaveFilePicker({
      suggestedName:fileName,
      types:[{description:"TXT",accept:{"text/plain":[".txt"],"application/octet-stream":[".txt"]}}]
    }).then(function(handle){
      return handle.createWritable().then(function(writable){
        return writable.write(blob).then(function(){return writable.close();});
      });
    }).catch(function(err){
      if(err&&err.name==="AbortError")return;
      if(!downloadInHiddenFrame())downloadViaBlankTab();
    });
    return;
  }
  if(!downloadInHiddenFrame())downloadViaBlankTab();
}
