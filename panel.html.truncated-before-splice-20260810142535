function txtStrictThreeCodesBitmap(codes){
  var bytes=[];
  for(var i=0;i<125;i++)bytes[i]=0;
  (Array.isArray(codes)?codes:[]).forEach(function(code){
    if(!/^\d{3}$/.test(String(code)))return;
    var n=Number(code);
    if(n<0||n>999)return;
    bytes[Math.floor(n/8)]|=(1<<(n%8));
  });
  return bytes.map(function(value){return Number(value).toString(16).padStart(2,"0");}).join("");
}
function txtStrictThreeBitmapHas(bitmap,code){
  if(!/^\d{3}$/.test(String(code))||!/^[0-9a-f]{250}$/i.test(String(bitmap||"")))return false;
  var n=Number(code),byteIndex=Math.floor(n/8),bit=n%8;
  var value=parseInt(String(bitmap).slice(byteIndex*2,byteIndex*2+2),16)||0;
  return (value&(1<<bit))!==0;
}
