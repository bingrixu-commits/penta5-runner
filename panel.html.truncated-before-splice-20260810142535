function txtPositionPairStatsFromRows(twoRows,threeRows){
  var map={};
  (Array.isArray(twoRows)?twoRows:[]).forEach(function(row){
    if(!row||!row.period)return;
    map[row.period]=Object.assign({},map[row.period]||{}, {two:row,period:row.period,code:row.code});
  });
  (Array.isArray(threeRows)?threeRows:[]).forEach(function(row){
    if(!row||!row.period)return;
    map[row.period]=Object.assign({},map[row.period]||{}, {three:row,period:row.period,code:(map[row.period]&&map[row.period].code)||row.code});
  });
  var periods=Object.keys(map).sort(function(a,b){return String(a).localeCompare(String(b));});
  var stats={total:0,allPass:0,allFail:0,mixed:0,currentAllPass:0,currentAllFail:0,last:null};
  periods.forEach(function(period){
    var item=map[period]||{},two=item.two||{},three=item.three||{};
    if(typeof two.success!=="boolean"||typeof three.success!=="boolean")return;
    stats.total+=1;
    var bothPass=two.success===true&&three.success===true;
    var bothFail=two.success===false&&three.success===false;
    if(bothPass){
      stats.allPass+=1;
      stats.currentAllPass+=1;
      stats.currentAllFail=0;
      stats.last="pass";
    }else if(bothFail){
      stats.allFail+=1;
      stats.currentAllFail+=1;
      stats.currentAllPass=0;
      stats.last="fail";
    }else{
      stats.mixed+=1;
      stats.currentAllPass=0;
      stats.currentAllFail=0;
      stats.last="mixed";
    }
  });
  if(stats.last!=="pass")stats.currentAllPass=0;
  if(stats.last!=="fail")stats.currentAllFail=0;
  return stats;
}
