    return Promise.reject(txtPositionMakeError("未知反车模型","FAN_MODEL_UNKNOWN",false));
  }
  if(!spec.ready||!spec.endpoint){
    return Promise.reject(txtPositionMakeError(spec.mark+" 尚未上线","FAN_MODEL_NOT_READY",false));
  }
  var expectCount=null;
  var period="";
  // 先读状态拿期望组数，再拉全集码表，禁止短码/截断照收（四因子默认排除侧）
  var metaUrl=(spec.source==="four-factor-rank")
    ?("/four-factor-rank?t="+Date.now())
    :"";
  var metaP=metaUrl
    ?fetch(metaUrl,{credentials:"same-origin",cache:"no-store"}).then(function(r){return r.ok?r.json():null;}).catch(function(){return null;})
    :Promise.resolve(null);
  return metaP.then(function(meta){
    if(meta&&meta.ok!==false){
      if(spec.poolSide==="exclude"&&meta.excludeCount!=null)expectCount=Number(meta.excludeCount);
      else if(meta.remainCount!=null)expectCount=Number(meta.remainCount);
      if(meta.latestPeriod)period=String(meta.latestPeriod);
    }
    return fetch(spec.endpoint+(spec.endpoint.indexOf("?")>=0?"&":"?")+"t="+Date.now(),{credentials:"same-origin",cache:"no-store"});
  }).then(function(r){
      if(!r.ok)return Promise.reject(txtPositionMakeError("读取"+spec.mark+"失败 HTTP "+r.status,"FAN_MODEL_HTTP",true));
      var hdrCount=Number(r.headers&&r.headers.get?r.headers.get("X-Remain-Count"):0);
      if(hdrCount>0)expectCount=hdrCount;
      return r.text();
    })
    .then(function(txt){
      var rawLines=String(txt||"").split(/\r?\n/).map(function(s){return String(s||"").trim();}).filter(Boolean);
      for(var i=0;i<rawLines.length;i++){
