}
function txtThreeRateRefresh(force){
  var period=txtPositionLatestPeriod(window.__penta5TxtState||{});
  if(!force&&TXT_THREE_RATE_CACHE&&TXT_THREE_RATE_CACHE.ok&&TXT_THREE_RATE_LAST_PERIOD===period){
    return Promise.resolve(TXT_THREE_RATE_CACHE);
  }
  if(TXT_THREE_RATE_BUSY)return Promise.resolve(TXT_THREE_RATE_CACHE);
  TXT_THREE_RATE_BUSY=true;
  var content=$("txtThreeRemainContent");
  if(content&&!(TXT_THREE_RATE_CACHE&&TXT_THREE_RATE_CACHE.ok)){
    setHtml(content,txtThreeRateShellHtml('<div style="color:#9a3412;font-weight:800;">正在拉取 RDS 历史并回算回删100/120/150命中率…</div>'));
  }
  var need=Math.max(TXT_THREE_RATE_FETCH, Math.max.apply(null,TXT_STRICT_THREE_HISTORY_PRESETS)+TXT_THREE_RATE_EVAL);
  need=Math.max(1,Math.min(5000,need));
  // 与四定命中率同路：走顶层 panelFetch + /history，避免调用内层作用域的 converter-history 助手
  var fetchFn=typeof panelFetch==="function"?panelFetch:fetch;
  return fetchFn("/history?limit="+need,{cache:"no-store"}).then(function(res){
    if(!res||res.ok!==true){
      var status=Number(res&&res.status||0);
      throw new Error(status===401?"面板登录已失效，请刷新重登":("历史接口 HTTP "+(status||"未知")));
    }
    return res.json();
  }).then(function(payload){
    var rows=txtStrictThreeNewestFirst(txtThreeRateRowsFromPayload(payload));
    if(!rows.length)throw new Error("历史为空，无法回算命中率");
    var head=txtStrictThreePeriod(rows[0]);
    if(period&&head&&head!==String(period)){
      // 软对齐：差一期仍继续回算，避免百分比一直空白
      console.warn("three rate period soft mismatch",head,period);
    }
    TXT_THREE_RATE_CACHE=txtThreeRateComputeFromRows(rows);
    TXT_THREE_RATE_LAST_PERIOD=period||head;
    if(typeof txtThreeRemainBuildAll==="function"){
      TXT_THREE_REMAIN_CACHE={period:TXT_THREE_RATE_LAST_PERIOD,byLimit:txtThreeRemainBuildAll(rows),at:Date.now()};
    }
    TXT_THREE_RATE_BUSY=false;
    return TXT_THREE_RATE_CACHE;
  }).catch(function(err){
    TXT_THREE_RATE_BUSY=false;
    console.error("three rate refresh failed",err);
    throw err;
  });
}
