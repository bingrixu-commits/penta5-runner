    if(row.hit){hit+=1;curWin+=1;curMiss=0;if(curWin>maxWin)maxWin=curWin;}
    else{curMiss+=1;curWin=0;if(curMiss>maxMiss)maxMiss=curMiss;}
  });
  var currentWin=0,currentMiss=0;
  if(list.length){
    if(list[list.length-1].hit===true)currentWin=curWin;
