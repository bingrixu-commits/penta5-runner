  var opened=txtPositionUniqueOpenedMemo(trainingRows,positions,deleteCount);
  var code=txtPositionCodeFromRow(row,positions);
  var name=txtPositionComboName(positions);
  var kept=[];
  txtPositionUniverse(size).forEach(function(c){
    if(opened.set[c])return;
    kept.push({
      code:c,
      token:txtPositionMask(c,positions),
      tie:txtHashSeed("position-history-independent|"+String(size)+"|"+String((row&&row.day)||"")+"|fast|"+name+"|"+c)
    });
  });
  kept.sort(function(a,b){
    if(a.token!==b.token)return a.token.localeCompare(b.token);
    return a.tie-b.tie;
  });
  // 禁止用数组硬截断冒充回删：真实命中多少删多少，不补删、不强制剩目标数。
  var keptSet={};
  kept.forEach(function(item){keptSet[item.code]=true;});
  var bandReady=size!==3||txtPositionThreeRemainReady(kept.length,modelTarget);
  var success=bandReady&&code?keptSet[code]===true:null;
  var backupDigits=[];
  var backupApplied=false;
  var backupKilled=false;
  // 三定只认真实旧号回删；历史唯一旧号不足、未打到目标剩余时不把当前码冒充回测结果
  return {
    success:success,
    count:kept.length,
    remainTarget:modelTarget,
    modelTarget:modelTarget,
    code:code,
    excluded:opened.unique,
    excludeTarget:modelTarget,
    deleteTarget:opened.target,
    scanned:opened.scanned,
    backupDigits:backupDigits,
    backupApplied:backupApplied,
    backupKilled:backupKilled
  };
}
