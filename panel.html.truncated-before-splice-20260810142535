function txtPositionValidateHistoryRows(rows,data,requiredUnique){
  rows=Array.isArray(rows)?rows:[];
  var expected=txtPositionLatestPeriod(data||{});
  if(!rows.length)return {ok:false,retryable:true,code:"RDS_HISTORY_EMPTY",message:"RDS 历史暂为空，正在等待重新灌注。"};
  var firstPeriod=txtPositionHistoryRowPeriod(rows[0]);
  if(!expected)return {ok:false,retryable:true,code:"LATEST_PERIOD_PENDING",message:"当前最新期号为空，正在等待后端同步后再核对 RDS 历史。"};
  if(firstPeriod!==expected){
    return {ok:false,retryable:true,code:"RDS_PERIOD_LAGGING",message:"RDS 历史首期 "+(firstPeriod||"空")+" 与当前最新期 "+expected+" 不一致，正在等待追平。"};
  }
  requiredUnique=Math.max(1,Number(requiredUnique||200));
  var comboStates=txtPositionCombos(3).map(function(positions){
    return {name:txtPositionComboName(positions),positions:positions.slice(),set:{},unique:0,scanned:0};
  });
  var seenPeriods={};
  var validatedHistoryCount=0;
  for(var i=0;i<rows.length;i++){
    var row=rows[i]||{};
    var period=txtPositionHistoryRowPeriod(row);
    if(!/^\d+$/.test(period))return {ok:false,retryable:false,code:"RDS_SOURCE_PERIOD_INVALID",message:"实际回删来源窗口第 "+(i+1)+" 条缺少真实期号，已停止发布。"};
    if(seenPeriods[period])return {ok:false,retryable:false,code:"RDS_SOURCE_PERIOD_DUPLICATE",message:"实际回删来源窗口期号 "+period+" 重复，已停止发布。"};
    seenPeriods[period]=true;
    if(!String(row.opentime||"").trim())return {ok:false,retryable:false,code:"RDS_SOURCE_OPENTIME_INVALID",message:"实际回删来源期号 "+period+" 缺少真实开奖时间，已停止发布。"};
    var nums=Array.isArray(row.numbers)?row.numbers:[];
    if(nums.length<4||nums.slice(0,4).some(function(value){return !/^\d$/.test(String(value));})){
      return {ok:false,retryable:false,code:"RDS_SOURCE_NUMBERS_INVALID",message:"实际回删来源期号 "+period+" 的前四位号码不完整，已停止发布。"};
    }
    validatedHistoryCount=i+1;
    comboStates.forEach(function(state){
      if(state.unique>=requiredUnique)return;
      var code=txtPositionCodeFromRow(row,state.positions);
      if(!state.set[code]){
        state.set[code]=true;
        state.unique+=1;
      }
      if(state.unique>=requiredUnique)state.scanned=i+1;
    });
    if(comboStates.every(function(state){return state.unique>=requiredUnique;}))break;
  }
  var comboChecks=comboStates.map(function(state){
    return {name:state.name,positions:state.positions.slice(),unique:state.unique,scanned:state.scanned||validatedHistoryCount};
  });
  var failedCombo=comboChecks.filter(function(check){return check.unique<requiredUnique;})[0]||null;
  if(failedCombo){
    return {
      ok:false,
      retryable:rows.length<Math.max(2000,requiredUnique),
      code:"RDS_UNIQUE_CODES_INSUFFICIENT",
      message:"RDS 真实"+failedCombo.name+"旧码不足：需要 "+requiredUnique+" 个唯一旧码，当前只有 "+failedCombo.unique+" 个；禁止补码、截断或伪造。",
      combos:comboChecks
    };
  }
  var minUnique=comboChecks.length?Math.min.apply(null,comboChecks.map(function(check){return check.unique;})):0;
  var maxScanned=comboChecks.length?Math.max.apply(null,comboChecks.map(function(check){return check.scanned;})):0;
  return {ok:true,expectedPeriod:expected,historyCount:rows.length,validatedHistoryCount:validatedHistoryCount,unique:minUnique,scanned:maxScanned,combos:comboChecks};
}
