  try{
    if(snapshot){
      // 核对条只存期号/剩组/lastCheck，丢掉巨型 bitmap 避免每次写盘卡顿
      if(snapshot.bitmap){
        var slim={};
        for(var k in snapshot){
          if(!Object.prototype.hasOwnProperty.call(snapshot,k))continue;
          if(k==="bitmap")continue;
          slim[k]=snapshot[k];
        }
        snapshot=slim;
        window.__penta5FourVerifySnapshot=snapshot;
      }
      localStorage.setItem(TXT_FOUR_VERIFY_KEY,JSON.stringify(snapshot));
    }else localStorage.removeItem(TXT_FOUR_VERIFY_KEY);
