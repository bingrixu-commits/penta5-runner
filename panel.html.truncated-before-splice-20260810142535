function txtFourStatsAppend(entry){
  var store=txtFourStatsLoad();
  var list=Array.isArray(store.evaluated)?store.evaluated:[];
  // 同档位（期号+回删期数）才覆盖；100/800/1200/1500 分开记账，互不覆盖
  var key=txtFourStatsEntryKey(entry);
  var replaced=false;
  for(var i=0;i<list.length;i++){
    if(txtFourStatsEntryKey(list[i])===key){
      list[i]=entry;
      replaced=true;
      break;
    }
  }
  if(!replaced)list.push(entry);
  list.sort(function(a,b){
    var pa=String(a&&a.targetPeriod||""),pb=String(b&&b.targetPeriod||"");
    if(pa.length!==pb.length)return pb.length-pa.length;
    if(pa!==pb)return pa<pb?1:pa>pb?-1:0;
    return txtFourHistoryLimitNormalize(b.historyLimit)-txtFourHistoryLimitNormalize(a.historyLimit);
  });
  if(list.length>TXT_FOUR_STATS_MAX)list=list.slice(0,TXT_FOUR_STATS_MAX);
  store.evaluated=list;
  txtFourStatsSave(store);
  return store;
}
