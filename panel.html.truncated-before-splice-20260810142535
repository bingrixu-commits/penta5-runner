function heweiColdCodeText(data,key){
  var fields={
    wanQianBai:"wanQianBaiHewei",
    qianBaiShi:"qianBaiShiHewei",
    wanQianBaiShi:"wanQianBaiShiHewei",
    wanQianGe:"wanQianGeHewei",
    wanQianGeFreq:"wanQianGeHewei",
    wanBaiShi:"wanBaiShiHewei",
    wanBaiShiFreq:"wanBaiShiHewei"
  };
  var field=fields[key];
  if(!field)return "";
  var rows=penta5TodayHistoryRows(data);
  var counts={};
  for(var d=0;d<=9;d++)counts[String(d)]=0;
  var total=0;
  rows.forEach(function(row){
    var digit=penta5HeweiDigitFromRow(row,field);
    if(!digit)return;
    counts[digit]+=1;
    total+=1;
  });
  if(!total)return "";
  var cold="0",min=Infinity;
  Object.keys(counts).sort().forEach(function(digit){
    var n=counts[digit];
    if(n<min){min=n;cold=digit;}
  });
  return ' <br><span style="display:inline-flex;gap:5px;margin-top:3px;color:#2563eb;font-weight:800;">合尾冷码 '+esc(cold)+'('+esc(min)+') <span style="color:#64748b;font-weight:500;">今日'+esc(total)+'期</span></span>';
}


function unifiedHeweiRateText(data){
  var total=0,match=0;
  var list=(Array.isArray(data.predictions)?data.predictions:[])
    .filter(function(p){return p&&p.evaluated&&p.evaluation;})
    .slice(0,30);

  list.forEach(function(p){
    var digit=String(
      p.threeFourHeweiKillDigit ||
      p.evaluation.previousThreeFourKillDigit || ""
    );
    var group=p.evaluation.actualCompositeHeweiGroup;

    if(!digit || digit==="--" || !Array.isArray(group)) return;

    total++;
    if(
      digit!==String(group[0]) &&
      digit!==String(group[1]) &&
      digit!==String(group[2])
