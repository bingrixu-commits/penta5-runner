function pairCodeNormalize(code){
  var digits=String(code==null?"":code).replace(/\D/g,"");
  if(digits.length>=2)return digits.slice(0,2);
  return "";
}
function pairKillSuccessFromEv(ev,key){
  if(!ev)return null;
  var ex=ev.independentExtras&&ev.independentExtras[key];
  return ex&&typeof ex.success==="boolean"?ex.success:null;
}
function pairKillMissStreak(data,key){
  var rows=fourPosExcludeEvalRowsTopLevel(data||{});
  var miss=0;
  for(var i=0;i<rows.length;i++){
    var ok=pairKillSuccessFromEv(rows[i].evaluation||{},key);
    if(ok===null)continue;
    if(ok===true)break;
    miss+=1;
  }
  return miss;
}
function pairKillRecentPassPct(data,key){
  var rows=fourPosExcludeEvalRowsTopLevel(data||{}).slice(0,30);
  var total=0,hit=0;
  for(var i=0;i<rows.length;i++){
    var ok=pairKillSuccessFromEv(rows[i].evaluation||{},key);
    if(ok===null)continue;
    total+=1;
    if(ok===true)hit+=1;
  }
  return total?(hit*100/total):NaN;
}
function pairKillReverseDecide(data,key,pairCode,label){
  // 对数/两数避开 → 反车：猜下期这两码会同时出现
  data=data||{};
  var pair=pairCodeNormalize(pairCode);
  var mode=posExcludeReverseModeGet();
  label=String(label||key||"两数");
  if(pair.length!==2){
    return {active:false,mode:mode,appearPair:"",killPair:"",reason:label+"暂无对子",missStreak:0};
  }
  var show=pair.charAt(0)+"+"+pair.charAt(1);
  if(mode==="on"){
    return {active:true,mode:mode,appearPair:pair,killPair:pair,reason:"强制反车："+label+"猜下期 "+show+" 同时出现",missStreak:pairKillMissStreak(data,key)};
  }
  if(mode==="off"){
    return {active:false,mode:mode,appearPair:"",killPair:pair,reason:"正向避开："+label+" "+pair,missStreak:pairKillMissStreak(data,key)};
  }
  var miss=pairKillMissStreak(data,key);
  var passPct=pairKillRecentPassPct(data,key);
  if(miss>=POS_EXCLUDE_REVERSE_MISS_FLIP){
    return {active:true,mode:mode,appearPair:pair,killPair:pair,reason:"低谷反车："+label+"连挂 "+miss+"，猜下期 "+show+" 同时出现",missStreak:miss};
  }
  if(isFinite(passPct)&&passPct<POS_EXCLUDE_REVERSE_RATE120_FLIP){
    return {active:true,mode:mode,appearPair:pair,killPair:pair,reason:"低谷反车："+label+"近窗 "+passPct.toFixed(1)+"%偏低，猜下期 "+show+" 同时出现",missStreak:miss};
  }
  if(miss>=POS_EXCLUDE_REVERSE_SOFT_MISS&&isFinite(passPct)&&passPct<55){
    return {active:true,mode:mode,appearPair:pair,killPair:pair,reason:"低谷反车："+label+"刚挂"+miss+"且近窗一般，猜下期 "+show+" 同时出现",missStreak:miss};
  }
  return {active:false,mode:mode,appearPair:"",killPair:pair,reason:"正向避开："+label+" "+pair,missStreak:miss};
}
function fourPosExcludeDigit(prediction, key){
  prediction=prediction||{};
  var four=prediction.fourPosExclude||{};
  var items=Array.isArray(four.items)?four.items:[];
  for(var i=0;i<items.length;i++){
    var it=items[i];
    if(!it||String(it.key)!==String(key))continue;
    var digit=String(it.code==null?"":it.code).replace(/\D/g,"").charAt(0);
    if(/^\d$/.test(digit))return digit;
  }
  return "";
}
function posSingleKillHtml(digit){
  digit=String(digit==null?"":digit).replace(/\D/g,"").charAt(0);
  if(!/^\d$/.test(digit))return ball("--","dark")+" 杀码";
  return ball(digit,"dark")+" 杀码(1码)";
}
function resolveComposerPosKillDigit(prediction, stateKey){
  prediction=prediction||{};
  var digit=fourPosExcludeDigit(prediction, stateKey);
  if(digit)return digit;
  var pk=prediction.positionKills||{};
  var entry=pk[stateKey]||{};
  digit=String(entry.recommendDigit!=null?entry.recommendDigit:(entry.selectedDigit!=null?entry.selectedDigit:(entry.main!=null?entry.main:""))).replace(/\D/g,"").charAt(0);
  return /^\d$/.test(digit)?digit:"";
}



