function txtFourRateComputeFromRows(rows){
  rows=Array.isArray(rows)?rows:[];
  var codes=[];
  var periods=[];
  for(var i=0;i<rows.length;i++){
    var code=txtFourFourCodeFromHistoryRow(rows[i]);
    var period=String((rows[i]&&rows[i].period!=null&&rows[i].period!=="")?rows[i].period:(rows[i]&&rows[i].uid)||"").replace(/\D/g,"");
    if(!/^\d{4}$/.test(code)||!/^\d+$/.test(period))continue;
    codes.push(code);
    periods.push(period);
  }
  var byLimit={};
  for(var pi=0;pi<TXT_FOUR_HISTORY_PRESETS.length;pi++){
    var limit=TXT_FOUR_HISTORY_PRESETS[pi];
    var hit=0;
    var total=0;
    var maxEval=Math.min(TXT_FOUR_RATE_EVAL,Math.max(0,codes.length-limit));
    for(var ei=0;ei<maxEval;ei++){
      var seen=Object.create(null);
      var end=Math.min(codes.length,ei+1+limit);
      for(var j=ei+1;j<end;j++)seen[codes[j]]=true;
      // 全池：开奖不在近N唯一旧码=在剩码=中（与开奖核对同路）
      if(!seen[codes[ei]])hit+=1;
      total+=1;
    }
    byLimit[limit]={
      hit:hit,
      total:total,
      rate:total?Number((hit*100/total).toFixed(2)):null
    };
  }
  return {
    ok:true,
    latestPeriod:periods[0]||"",
    evalLimit:TXT_FOUR_RATE_EVAL,
    scanned:codes.length,
    byLimit:byLimit,
    at:Date.now()
  };
}
function txtFourRateRefresh(data,force){
  data=data||window.__penta5TxtState||{};
  if(TXT_FOUR_RATE_BUSY)return Promise.resolve(TXT_FOUR_RATE_CACHE);
  TXT_FOUR_RATE_BUSY=true;
  txtFourStatsRender(data);
  var path="/four-backdelete-config"+(force?"?refreshRates=1":"");
  return fetch(path,{credentials:"same-origin",cache:"no-store"}).then(function(res){
    return res.json().catch(function(){return null;}).then(function(j){
      if(!res.ok||!j||j.ok===false)throw new Error((j&&j.error)||("HTTP "+res.status));
      txtFourApplyServerConfig(j);
      return TXT_FOUR_RATE_CACHE;
    });
  }).catch(function(err){
    console.warn("四定回删服务端配置拉取失败，回退本机回算",err);
    // 服务端不可用时才本机扫 /history
    var expect=String(txtPositionLatestPeriod(data)||txtFourLatestDraw(data).period||"").replace(/\D/g,"");
    var need=Math.max.apply(null,TXT_FOUR_HISTORY_PRESETS)+TXT_FOUR_RATE_EVAL;
    var ensure=typeof window.__penta5EnsureHistoryCache==="function"?window.__penta5EnsureHistoryCache:null;
    var fetchPromise=ensure
      ?Promise.resolve(ensure(need,expect||null,!!force))
      :panelFetch("/history?limit="+need,{cache:"no-store"}).then(function(res){return res.json();}).then(function(j){
        return Array.isArray(j&&j.history)?j.history:[];
      });
    return fetchPromise.then(function(rows){
      var computed=txtFourRateComputeFromRows(rows);
      TXT_FOUR_RATE_CACHE=computed;
      return computed;
    }).catch(function(err2){
      if(!TXT_FOUR_RATE_CACHE)TXT_FOUR_RATE_CACHE={ok:false,error:String(err2&&err2.message||err2),byLimit:{}};
      return TXT_FOUR_RATE_CACHE;
    });
  }).finally(function(){
    TXT_FOUR_RATE_BUSY=false;
    txtFourStatsRender(data);
  });
}
