var TXT_THREE_REMAIN_PAGE_SIZE = 120;
var TXT_THREE_REMAIN_CACHE = null; // {period, byLimit:{100/120/150:{千百十:result,...}}}
function txtThreeUniverseCodes(){
  var out=[];
  for(var i=0;i<1000;i++)out.push(String(i).padStart(3,"0"));
  return out;
}
function txtThreeMaskToken(code,positions){
  // 三位码按原位置展开成带 x 的四位展示（与旧 txtPositionMask 口径接近）
  code=String(code||"");
  if(!/^\d{3}$/.test(code)||!Array.isArray(positions)||positions.length!==3)return code;
  var chars=["x","x","x","x"];
  for(var i=0;i<3;i++)chars[positions[i]]=code.charAt(i);
  return chars.join("");
}
function txtThreeRemainBackdeleteNoAttack(model,rows,limit){
  rows=Array.isArray(rows)?rows.slice(0,limit):[];
  var set={}, seenOld={}, deletedSources=[];
  txtThreeUniverseCodes().forEach(function(code){set[code]=true;});
  var afterFilter=1000;
  var remaining=1000;
  var deletedUnique=0;
  var scanned=0;
  for(var i=0;i<rows.length;i++){
    scanned+=1;
    var oldCode=txtPositionCodeFromRow(rows[i],model.positions);
    if(!oldCode||seenOld[oldCode])continue;
    seenOld[oldCode]=true;
    if(!set[oldCode])continue;
    delete set[oldCode];
    remaining-=1;
    deletedUnique+=1;
    deletedSources.push({
      code:oldCode,
      period:txtStrictThreePeriod(rows[i]),
      opentime:String(rows[i]&&rows[i].opentime||""),
      historyIndex:i
    });
  }
  var codes=Object.keys(set).sort();
  var tokens=codes.map(function(code){return txtThreeMaskToken(code,model.positions);});
  var pages=[];
  for(var p=0;p<tokens.length;p+=TXT_THREE_REMAIN_PAGE_SIZE){
    var slice=tokens.slice(p,p+TXT_THREE_REMAIN_PAGE_SIZE);
    pages.push({
      index:pages.length+1,
      count:slice.length,
      text:slice.join(",")+(slice.length?"各":"")
    });
  }
  return {
    ok:true,
    comboName:model.name,
    positions:model.positions.slice(),
    historyLimit:limit,
    historyCount:rows.length,
    afterFilter:afterFilter,
    deletedUnique:deletedUnique,
    scanned:scanned,
    left:codes.length,
    count:codes.length,
    codes:codes,
    tokens:tokens,
    pages:pages,
    pageCount:pages.length,
    rdsFirstPeriod:rows[0]?txtStrictThreePeriod(rows[0]):"",
    rdsLastPeriod:rows.length?txtStrictThreePeriod(rows[rows.length-1]):"",
    hitDeleteMode:true,
    mode:"no-attack"
  };
}
function txtThreeRemainBuildAll(rows){
  var byLimit={};
  TXT_STRICT_THREE_HISTORY_PRESETS.forEach(function(limit){
    byLimit[limit]={};
    TXT_STRICT_THREE_MODELS.forEach(function(model){
      byLimit[limit][model.name]=txtThreeRemainBackdeleteNoAttack(model,rows,limit);
    });
  });
  return byLimit;
}
