    if(override!=null&&Number(override)>0)return txtPositionNormalizeThreeRemainTarget(override);
    return TXT_POSITION_THREE_REMAIN_TARGET;
  }
  if(size===2){
    if(override!=null&&Number(override)>0)return txtPositionNormalizeTwoRemainTarget(override);
    return TXT_POSITION_TWO_REMAIN_TARGET;
  }
  if(override!=null&&Number(override)>0)return Number(override);
