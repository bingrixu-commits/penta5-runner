function txtPositionVerifyGate(data){
  var latest=data&&data.latestRecord||{};
  var period=txtPositionLatestPeriod(data);
  var openMs=txtPositionParseTimeMs(latest.opentime);
  if(!period)return {ok:false,retryable:true,code:"LATEST_PERIOD_PENDING",period:"",message:"最新期号尚未落库，正在等待后端同步。"};
  if(!openMs)return {ok:false,retryable:true,code:"LATEST_OPENTIME_PENDING",period:period,message:"最新期 "+period+" 的开奖时间尚未落库，正在等待后端同步。"};
  var now=Date.now();
  var slotDate=new Date(now);
  var slotMinute=slotDate.getMinutes()-(slotDate.getMinutes()%5);
  var expectedSlot=new Date(slotDate.getFullYear(),slotDate.getMonth(),slotDate.getDate(),slotDate.getHours(),slotMinute,12,0).getTime();
  if(expectedSlot>now)expectedSlot-=5*60*1000;
  if(expectedSlot-openMs>90*1000){
    return {ok:false,retryable:true,code:"LATEST_PERIOD_LAGGING",period:period,message:"当前开奖时段尚未落库：RDS 最新仍是 "+period+"（"+String(latest.opentime||"无时间")+"），正在等待追平。"};
  }
  var startAt=openMs+TXT_POSITION_VERIFY_DELAY_MS;
  return {ok:true,period:period,openMs:openMs,startAt:startAt,remainingMs:Math.max(0,startAt-now)};
}
function txtPositionHistoryRowPeriod(row){
