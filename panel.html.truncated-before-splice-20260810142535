function txtFourPeriodNewer(a,b){
  a=String(a||"").replace(/\D/g,"");
  b=String(b||"").replace(/\D/g,"");
  if(!a||!b||a===b)return false;
  if(a.length!==b.length)return a.length>b.length;
  return a>b;
}
function txtFourPeriodGap(a,b){
  // 同日期号差几期；跨日或无法比 → 大数（视为飘太远）
  a=String(a||"").replace(/\D/g,"");
  b=String(b||"").replace(/\D/g,"");
  if(!a||!b)return 999;
  if(a===b)return 0;
  if(a.length===b.length&&a.length>=11&&a.slice(0,8)===b.slice(0,8)){
    var ga=Math.abs(Number(a.slice(8))-Number(b.slice(8)));
    return isFinite(ga)?ga:999;
  }
  if(a.length>=8&&b.length>=8&&a.slice(0,8)!==b.slice(0,8))return 999;
  return 999;
}
var TXT_FOUR_PERIOD_GAP_OK=1;   // 少一期/多一期：伤害不大，放行
var TXT_FOUR_PERIOD_GAP_MAX=2;  // 再多就假，禁止飘太远发布
function txtFourPeriodAlignDecide(head,ref,label){
  // 以历史首期为准发布；±1 可接受；超过 MAX 拒绝（太假）
  head=String(head||"").replace(/\D/g,"");
  ref=String(ref||"").replace(/\D/g,"");
  if(!head)return {ok:false,code:"PANEL_HISTORY_PERIOD",message:"历史首期为空",retryable:true};
  if(!ref||head===ref){
    return {ok:true,period:head,gap:0,soft:false,note:""};
  }
  var gap=txtFourPeriodGap(head,ref);
  if(gap<=TXT_FOUR_PERIOD_GAP_OK){
    return {
      ok:true,
      period:head,
      gap:gap,
      soft:true,
      note:"期号差 "+gap+" 期（"+(label||"对照")+" "+ref+" / 历史 "+head+"），少/多一期可接受，按历史首期发布"
    };
  }
  if(gap<=TXT_FOUR_PERIOD_GAP_MAX){
    return {
      ok:false,
      retryForce:true,
      gap:gap,
      period:head,
      code:"PERIOD_GAP_RETRY",
      message:"期号差 "+gap+" 期（"+(label||"对照")+" "+ref+" / 历史 "+head+"），先强制重拉再定",
      retryable:true
    };
  }
  return {
    ok:false,
    gap:gap,
    period:head,
    code:"PERIOD_DRIFT_TOO_FAR",
    message:"四定回删：期号飘太远（差 "+gap+" 期；"+(label||"对照")+" "+ref+" / 历史 "+head+"），禁止发布假窗",
    retryable:true
  };
}
function txtFourCodesBitmap(codes){
  var bytes=[];
  for(var i=0;i<1250;i++)bytes[i]=0;
  (Array.isArray(codes)?codes:[]).forEach(function(code){
    if(!/^\d{4}$/.test(String(code)))return;
    var n=Number(code);
    if(n<0||n>9999)return;
    bytes[Math.floor(n/8)]|=(1<<(n%8));
  });
  return bytes.map(function(value){return Number(value).toString(16).padStart(2,"0");}).join("");
}
function txtFourBitmapHas(bitmap,code){
  if(!/^\d{4}$/.test(String(code)))return false;
  bitmap=String(bitmap||"");
  // 长度校验即可；每次用 2500 字正则扫 bitmap 会拖慢轮询判中
  if(bitmap.length!==2500)return false;
  var n=Number(code);
  var byteIndex=Math.floor(n/8);
  var value=parseInt(bitmap.slice(byteIndex*2,byteIndex*2+2),16)||0;
  return (value&(1<<(n%8)))!==0;
}
