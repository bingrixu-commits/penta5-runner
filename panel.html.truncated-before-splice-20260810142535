function txtRecordCode(record,width){
  var nums=Array.isArray(record&&record.numbers)?record.numbers:[];
  if(nums.length<width)return "";
  return nums.slice(0,width).map(function(n){return String(n).replace(/\D/g,"").charAt(0)||"0";}).join("");
}
function txtRecordSortValue(record){
  return String(record&&record.opentime||record&&record.period||record&&record.uid||"");
}
function txtStreakStatsFromResults(results){
  var total=0,hit=0,currentWin=0,currentMiss=0,maxWin=0,maxMiss=0,lastResult=null,lastPeriod="";
  results.forEach(function(item){
    if(typeof item.success!=="boolean")return;
    total++;
    if(item.success)hit++;
    lastResult=item.success;
    lastPeriod=item.period||lastPeriod;
    if(item.success){
      currentWin++;
      currentMiss=0;
      if(currentWin>maxWin)maxWin=currentWin;
    }else{
      currentMiss++;
      currentWin=0;
      if(currentMiss>maxMiss)maxMiss=currentMiss;
    }
  });
  return {
    total:total,
    hit:hit,
    rate:total?hit*100/total:null,
    maxWin:maxWin,
    maxMiss:maxMiss,
    currentWin:lastResult===true?currentWin:0,
    currentMiss:lastResult===false?currentMiss:0,
    lastPeriod:lastPeriod
  };
}
function txtFrameworkResults(data,config,day){
  var groupSet={};
  txtFrameworkGroups(config,day,data||{}).forEach(function(code){groupSet[code]=true;});
  return txtRecords(data).filter(function(row){return txtRowDateKey(row)===day;}).slice().sort(function(a,b){
    return txtRecordSortValue(a).localeCompare(txtRecordSortValue(b));
  }).map(function(row){
    var code=txtRecordCode(row,config.width);
    return {
      period:String(row.period||row.uid||""),
      code:code,
      success:!!groupSet[code]
    };
  }).filter(function(item){return !!item.code;});
}
function txtFrameworkStats(data,config,day){
  return txtStreakStatsFromResults(txtFrameworkResults(data,config,day));
}
function txtCombinedStats(data,day){
  var perConfig=TXT_FRAMEWORKS.map(function(config){
    var set={};
    txtFrameworkGroups(config,day,data||{}).forEach(function(code){set[code]=true;});
    return {config:config,set:set};
  });
  var results=txtRecords(data).filter(function(row){return txtRowDateKey(row)===day;}).slice().sort(function(a,b){
    return txtRecordSortValue(a).localeCompare(txtRecordSortValue(b));
  }).map(function(row){
    var ok=perConfig.every(function(item){
      var code=txtRecordCode(row,item.config.width);
      return code&&item.set[code]===true;
    });
    return {period:String(row.period||row.uid||""),success:ok};
  });
  return txtStreakStatsFromResults(results);
