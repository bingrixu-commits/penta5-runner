 * 每期只用更早真实样本重算当时主推位，再看当期 N 位是否全中。
 */
function shaMaRecommendJointTruthStats(data,settings){
  settings=posExcludeSettingsNormalize(settings||posExcludeSettingsGet());
  var ver=fourPosExcludePosVersion();
  var order=["wan","qian","bai","shi"];
  var rows=fourPosExcludeEvalRowsTopLevel(data||{});
  var samples=[]; // 新→旧
  for(var r=0;r<rows.length;r++){
    var row=rows[r];
    var block=(row.evaluation||{}).fourPosExclude;
    if(!block||block.truthEligible!==true)continue;
    if(String(block.version||"")!==ver)continue;
    var positions=block.positions||{};
    var okPos=true;
    var successByKey={};
    for(var oi=0;oi<order.length;oi++){
      var pk=order[oi];
      var pos=positions[pk];
      if(!pos||typeof pos.success!=="boolean"){okPos=false;break;}
      successByKey[pk]=pos.success===true;
    }
    if(!okPos)continue;
    var four=row.fourPosExclude||{};
    var items=Array.isArray(four.items)?four.items:[];
    if(!items.length)continue;
    samples.push({four:four,items:items,successByKey:successByKey});
  }
  var jointSeq=[]; // 新→旧，仅可回放期
  for(var i=0;i<samples.length;i++){
    var olderSuccess={wan:[],qian:[],bai:[],shi:[]};
    for(var k=i+1;k<samples.length;k++){
      var sb=samples[k].successByKey;
      order.forEach(function(key){olderSuccess[key].push(sb[key]===true);});
    }
    var scored=order.map(function(key){
      var item=null;
      var items=samples[i].items;
      for(var ii=0;ii<items.length;ii++){if(items[ii]&&String(items[ii].key)===key){item=items[ii];break;}}
      var digit=item?String(item.code==null?"":item.code).replace(/\D/g,"").charAt(0):"";
      var streak=shaMaStreakFromNewestFirstSeq(olderSuccess[key]||[]);
      var win=Number(streak.currentWin||0);
      var miss=Number(streak.currentMiss||0);
      var rate120=item&&item.rate120!=null?Number(item.rate120):NaN;
      var rateLong=item&&item.rateLong!=null?Number(item.rateLong):NaN;
      return {
        key:key,
        digit:digit,
        winStreak:win,
        missStreak:miss,
        rate120:isFinite(rate120)?rate120:-1,
        rateLong:isFinite(rateLong)?rateLong:-1,
        qualify:win>=settings.minWinStreak
      };
    }).filter(function(row){return /^\d$/.test(row.digit);});
    function rank(a,b){
      if(a.qualify!==b.qualify)return a.qualify?-1:1;
      if(a.winStreak!==b.winStreak)return b.winStreak-a.winStreak;
      if(a.rate120!==b.rate120)return b.rate120-a.rate120;
      if(a.rateLong!==b.rateLong)return b.rateLong-a.rateLong;
      if(a.missStreak!==b.missStreak)return a.missStreak-b.missStreak;
      return order.indexOf(a.key)-order.indexOf(b.key);
    }
    var qualified=scored.filter(function(x){return x.qualify;}).sort(rank);
    var picked=qualified.slice(0,settings.recommendCount);
    if(picked.length<settings.recommendCount){
      var rest=scored.filter(function(x){return !picked.some(function(p){return p.key===x.key;});}).sort(rank);
      while(picked.length<settings.recommendCount&&rest.length)picked.push(rest.shift());
    }
    if(picked.length<settings.recommendCount)continue;
    var allHit=true;
    for(var pi=0;pi<picked.length;pi++){
      if(samples[i].successByKey[picked[pi].key]!==true){allHit=false;break;}
    }
    jointSeq.push(allHit);
  }
  var streak=shaMaStreakFromNewestFirstSeq(jointSeq);
  var hit=0;
  for(var h=0;h<jointSeq.length;h++){if(jointSeq[h]===true)hit+=1;}
  var total=jointSeq.length;
  return {
    recommendCount:settings.recommendCount,
    total:total,
    hit:hit,
    rate:total?Number((hit*100/total).toFixed(2)):null,
    currentWin:streak.currentWin,
    currentMiss:streak.currentMiss,
    maxWin:streak.maxWin,
    maxMiss:streak.maxMiss,
    samplePool:samples.length
  };
}
