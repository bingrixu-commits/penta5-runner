function txtStrictThreeNormalizeCode(value,positions){
  var source=value&&typeof value==="object"
    ?(value.code!=null?value.code:(value.value!=null?value.value:(value.token!=null?value.token:value.text)))
    :value;
  var raw=String(source==null?"":source).trim();
  var digits=raw.replace(/\D/g,"");
  if(/^\d{3}$/.test(digits))return digits;
  var compact=raw.replace(/\s+/g,"");
  if(compact.length===4){
    var out=[];
    for(var i=0;i<positions.length;i++){
      var ch=compact.charAt(positions[i]);
      if(!/^\d$/.test(ch))return "";
      out.push(ch);
    }
    return out.join("");
  }
  return "";
}
