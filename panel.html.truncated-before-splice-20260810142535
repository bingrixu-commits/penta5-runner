function buildHeweiReport(data){
  var stat={
    wanQianBai:{label:"千百十合尾",total:0,match:0},
    qianBaiShi:{label:"百十个合尾",total:0,match:0},
    wanQianGe:{label:"千百个合尾(稳定)",total:0,match:0},
    wanQianGeFreq:{label:"千百个合尾(频次)",total:0,match:0},
    wanBaiShi:{label:"千十个合尾(稳定)",total:0,match:0},
    wanBaiShiFreq:{label:"千十个合尾(频次)",total:0,match:0},
    wanQianBaiShi:{label:"千百十个合尾",total:0,match:0},
    total:{label:"三个合尾统一避开码",total:0,match:0}
  };

  function getDigit(value){
    if(value && typeof value==="object")
      return String(value.killDigit||"");
    return value===undefined ? "" : String(value);
  }

  var list=Array.isArray(data.predictions)?data.predictions:[];

  list.forEach(function(p){
    if(!p || !p.evaluated || !p.evaluation) return;

    var e=p.evaluation;
    var g=e.actualCompositeHeweiGroup;
    if(!Array.isArray(g) || g.length<3) return;

    var independent=
      p.independentHeweiKills ||
      e.previousIndependentHeweiKills || {};

    [
      ["wanQianBai",0],
      ["qianBaiShi",1],
      ["wanQianBaiShi",2]
    ].forEach(function(item){
      var key=item[0],index=item[1];
      var digit=getDigit(independent[key]);
      if(!digit || digit==="--") return;
      stat[key].total++;
      if(digit!==String(g[index])) stat[key].match++;
    });

    ["wanQianGe","wanQianGeFreq","wanBaiShi","wanBaiShiFreq"].forEach(function(key){
      var digit=getDigit(independent[key]);
      var evalItem=e.independentHewei && e.independentHewei[key];
      var actual=evalItem && evalItem.actualDigit!=null ? String(evalItem.actualDigit) : "";
      if(!digit || digit==="--" || !/^\d$/.test(actual)) return;
      stat[key].total++;
      if(digit!==actual) stat[key].match++;
    });

    var unified=String(
      p.threeFourHeweiKillDigit ||
      e.previousThreeFourKillDigit || ""
    );

    if(unified && unified!=="--"){
      stat.total.total++;
      if(
        unified!==String(g[0]) &&
        unified!==String(g[1]) &&
        unified!==String(g[2])
      ) stat.total.match++;
    }
  });

  var html="";
  ["wanQianBai","qianBaiShi","wanQianGe","wanQianGeFreq","wanBaiShi","wanBaiShiFreq","wanQianBaiShi","total"]
  .forEach(function(key){
    var x=stat[key];
    html+='<div class="rate"><b>'+x.label+
      '</b><span>总共 '+x.total+
      ' 次｜命中 '+x.match+
      ' 次｜命中率 '+rate(x.total,x.match)+
      '</span></div>';
  });

  return html;
}

function buildMainBackupSummary(data){
  var stat={
    main:{total:0,match:0},
    backup:{total:0,match:0}
  };
  var positions=["wan","qian","bai","shi"];
  var list=Array.isArray(data.predictions)?data.predictions:[];

  list.forEach(function(pred){
    if(!pred || !pred.evaluated || !pred.evaluation) return;

    var e=pred.evaluation;
    var kills=e.previousPositionKills||{};
    var actual=e.actualNumbers||[];

    positions.forEach(function(pos,index){
      var arr=Array.isArray(kills[pos])?kills[pos]:[];

      if(arr[0]!==undefined && actual[index]!==undefined){
        stat.main.total++;
        if(String(arr[0])!==String(actual[index])) stat.main.match++;
      }

      if(arr[1]!==undefined && actual[index]!==undefined){
        stat.backup.total++;
        if(String(arr[1])!==String(actual[index])) stat.backup.match++;
      }
    });
  });

  return '<div class="rate"><b>主攻总命中率</b><span>总共 '+stat.main.total+
    ' 次｜命中 '+stat.main.match+' 次｜命中率 '+rate(stat.main.total,stat.main.match)+'</span></div>'+
    '<div class="rate"><b>备用总命中率</b><span>总共 '+stat.backup.total+
    ' 次｜命中 '+stat.backup.match+' 次｜命中率 '+rate(stat.backup.total,stat.backup.match)+'</span></div>';
}


function positionRateText(data,pos,index){
  var rt=0,rm=0,mt=0,mm=0,bt=0,bm=0;
  var list=(Array.isArray(data.predictions)?data.predictions:[])
    .filter(function(p){return p&&p.evaluated&&p.evaluation;})
    .slice(0,30);

  list.forEach(function(pred){
    var actual=pred.evaluation.actualNumbers;
    if(!Array.isArray(actual)||actual[index]===undefined)return;
    var saved=pred.positionKills&&pred.positionKills[pos]||{};
    var fallback=pred.evaluation.previousPositionKills&&pred.evaluation.previousPositionKills[pos]||[];
    var recommend=String(saved.recommendDigit||saved.selectedDigit||saved.main||(saved.killDigits&&saved.killDigits[0])||fallback[0]||"");
    var main=String(saved.primaryDigit||saved.mainAlgorithmDigit||saved.mainDigit||saved.main||fallback[0]||"");
    var backup=String(saved.originalBackupDigit||saved.backupAlgorithmDigit||saved.backup||saved.backupDigit||(saved.killDigits&&saved.killDigits[1])||fallback[1]||"");
    if(recommend&&recommend!=="--"){
      rt++;
      if(recommend!==String(actual[index]))rm++;
    }
    if(main&&main!=="--"){
      mt++;
      if(main!==String(actual[index]))mm++;
    }
    if(backup&&backup!=="--"){
      bt++;
      if(backup!==String(actual[index]))bm++;
    }
  });

  var stored=(window.penta5RealModelStatsHtml&&typeof window.penta5RealModelStatsHtml==="function")?window.penta5RealModelStatsHtml(data,pos):"";
  return '<div class="small">'+(stored?stored+'<br>':"")
    +(rt?('<div style="margin-top:4px;">推荐命中率 '+rate(rt,rm)+'</div>'):"")
    +positionHotColdHtml(data,index)+'</div>';
