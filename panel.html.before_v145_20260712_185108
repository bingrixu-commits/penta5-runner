  for(var i=0;i<nibbles;i++)arr[i]=0;
  (tokens||[]).forEach(function(token){
    txtAuditIndexesFromToken(token,width).forEach(function(index){
      var slot=Math.floor(index/4),bit=index%4;
      arr[slot]|=(1<<bit);
    });
  });
  return arr.map(function(value){return value.toString(16);}).join("");
}
function txtAuditBitmapHas(snapshot,token){
  snapshot=snapshot||{};
