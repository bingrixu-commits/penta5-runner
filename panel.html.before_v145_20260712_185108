function txtCustomTwoParseInput(raw){
  var labels=[
    {names:["千位","千"],index:0,label:"千"},
    {names:["百位","百"],index:1,label:"百"},
    {names:["十位","十"],index:2,label:"十"},
    {names:["个位","个"],index:3,label:"个"}
  ];
  var text=String(raw||"").replace(/\s+/g,"");
  var rules={};
  labels.forEach(function(item){rules[item.index]={digits:[],label:item.label};});
  var pattern=/(千位|百位|十位|个位|千|百|十|个)(?:排除|除|杀|不要)?([0-9]+)/g;
  var match;
  while((match=pattern.exec(text))){
    var labelText=match[1];
    var cfg=labels.filter(function(item){return item.names.indexOf(labelText)>=0;})[0];
    if(!cfg)continue;
    String(match[2]||"").replace(/\D/g,"").split("").forEach(function(digit){
      if(digit!==""&&rules[cfg.index].digits.indexOf(digit)<0)rules[cfg.index].digits.push(digit);
    });
  }
  var positions=Object.keys(rules).map(Number).filter(function(index){return rules[index].digits.length>0;}).sort(function(a,b){return a-b;});
  return {positions:positions,rules:rules,raw:text};
}
function txtCustomTwoCandidateCodes(positions,rules){
  var out=[];
  for(var a=0;a<10;a++){
    for(var b=0;b<10;b++){
      var code=String(a)+String(b);
      var reject=false;
      [0,1].forEach(function(offset){
        var position=positions[offset];
        var digit=code.charAt(offset);
        var rule=rules[position]||{digits:[]};
        if(rule.digits.indexOf(digit)>=0)reject=true;
      });
      if(!reject)out.push(code);
    }
  }
  return out;
}
function txtCustomTwoPositionText(positions,rules){
  return positions.map(function(position){
    var rule=rules[position]||{digits:[]};
    return txtPositionComboName([position])+"排除"+rule.digits.join("");
  }).join("，");
}
function txtCustomTwoFrameworkResult(){
  var input=$("txtCustomTwoInput");
  var raw=input?input.value:"";
  var parsed=txtCustomTwoParseInput(raw);
  if(parsed.positions.length!==2){
    return {ok:false,message:"自定义二定需要刚好两个位置，例如：千排除7 百排除6。"};
  }
  var data=window.__penta5TxtState||{};
  var day=txtTodayKeyForData(data);
  var rows=txtRecords(data||{});
  var positions=parsed.positions;
  var rules=parsed.rules;
  var baseCodes=txtCustomTwoCandidateCodes(positions,rules);
  var baseSet={};
  baseCodes.forEach(function(code){baseSet[code]=true;});
  var target=TXT_POSITION_TWO_TARGET;
  var baseLeft=baseCodes.length;
  var needOldDelete=Math.max(0,baseLeft-target);
  var oldRemoved=[],oldSeen={};
  rows.forEach(function(row){
    if(Object.keys(baseSet).length<=target)return;
    var code=txtPositionCodeFromRow(row,positions);
    if(!code||oldSeen[code]||!baseSet[code])return;
    oldSeen[code]=true;
    delete baseSet[code];
    oldRemoved.push(code);
  });
  var fallbackRemoved=[];
  if(Object.keys(baseSet).length>target){
    var scoreMap=txtPositionHistoryScoreMapFromRows(rows,positions);
    Object.keys(baseSet).map(function(code){
      var score=scoreMap[code]||{total:0,lastIndex:999999};
      return {
        code:code,
        total:Number(score.total||0),
        lastIndex:score.lastIndex==null?999999:Number(score.lastIndex),
        tie:txtHashSeed("custom-two-fill|"+day+"|"+positions.join("")+"|"+code)
      };
    }).sort(function(a,b){
      if(b.total!==a.total)return b.total-a.total;
      if(a.lastIndex!==b.lastIndex)return a.lastIndex-b.lastIndex;
      return a.tie-b.tie;
    }).forEach(function(item){
      if(Object.keys(baseSet).length<=target)return;
      delete baseSet[item.code];
      fallbackRemoved.push(item.code);
    });
  }
  var finalCodes=Object.keys(baseSet).sort();
  var tokens=finalCodes.map(function(code){return txtPositionMask(code,positions);});
  var note="输入模型："+txtCustomTwoPositionText(positions,rules)+"；定位初筛剩"+baseLeft+"组，距离50还需删"+needOldDelete+"组；旧码原位置删"+oldRemoved.length+"组"+(fallbackRemoved.length?"，旧码不足后按历史频次补删"+fallbackRemoved.length+"组":"")+"；最终"+tokens.length+"组。";
  return {
    ok:true,
    width:4,
    count:tokens.length,
    text:txtFormatTokenList(tokens),
    preview:txtFormatTokenList(tokens,120),
    label:"自定义二定50组："+txtPositionComboName(positions),
    source:"custom-two-position-old-code-fill-50",
    fileName:txtPositionFileName("自定义二定50组"+txtPositionComboName(positions),day,tokens.length),
    targetCount:target,
    positions:positions,
    rules:rules,
    baseLeft:baseLeft,
    needOldDelete:needOldDelete,
    oldDeleted:oldRemoved.length,
    fallbackDeleted:fallbackRemoved.length,
    note:note
  };
}
