    }
    var positionPool=list.filter(function(x){return x.kind==="position";});
    var heweiPool=list.filter(function(x){return x.kind==="hewei";});
    noteLow(positionPool,"定位池");
    noteLow(heweiPool,"合尾池");
    var safeList=list.filter(isHealthy);
    var beforePosition=chosen.length;
    addMany(safeList.filter(function(x){return x.kind==="position";}),{value:3},2);
    if(chosen.length-beforePosition<3)repairReport.push("定位池健康项不足3个，已从备用健康池补位。");
    var beforeHewei=chosen.length;
    addMany(safeList.filter(function(x){return x.kind==="hewei";}),{value:2},2);
    if(chosen.length-beforeHewei<2)repairReport.push("合尾池健康项不足2个，已从备用健康池补位。");
    var cooccurItems=twoDigitCooccurCandidateItems(data).map(function(item){
      return item;
    }).map(function(item){
      calcMulti(item);
      markItemConfidence(data,item);
      return item;
    }).filter(function(item){return item&&item.stableScore!=null;}).sort(order);
    noteLow(cooccurItems,"两数共现命中池");
    var healthyCooccurItems=cooccurItems.filter(isHealthy);
    if(cooccurItems.length){
      if(!healthyCooccurItems.length){
        repairReport.push("两数共现命中三路未达安全阈值，仍保留第6项命中对数，不降级为避开对数。");
      }
      var cooccur=(healthyCooccurItems.length?healthyCooccurItems:cooccurItems).slice().sort(function(a,b){
        var sa=comboPickScore(a),sb=comboPickScore(b);
        if(sb!==sa)return sb-sa;
        return order(a,b);
      })[0];
      cooccur.name="两数共现稳定";
      var cooccurId=itemId(cooccur);
      if(!used[cooccurId]){
        used[cooccurId]=true;
        chosen.push(cooccur);
      }
    }
    function canUseFallback(item){
      if(!isHealthy(item))return false;
      if(used[itemId(item)])return false;
      if(item.kind==="extra"&&(item.key==="twoDigitHit"||item.key==="threeDigitHit"))return false;
      return true;
    }
    var fallbackPool=safeList.filter(canUseFallback).sort(order);
    while(chosen.length<6){
      var before=chosen.length;
      if(!pickBestForCombo(fallbackPool,2))break;
      var item=chosen[chosen.length-1];
      item.repairedIntoTop=true;
      repairReport.push("健康备用补位："+modelLabel(item)+"，安全率 "+safetyText(item));
      if(chosen.length===before)break;
    }
    if(chosen.length<6){
