function txtPositionBacktestStats(rows){
  var valid=(rows||[]).filter(function(row){return typeof row.success==="boolean";});
  var hit=valid.filter(function(row){return row.success;}).length;
  var ordered=valid.slice().reverse();
  var currentWin=0,currentMiss=0,maxWin=0,maxMiss=0,last=null;
  ordered.forEach(function(row){
    last=row.success;
    if(row.success){
      currentWin++;
      currentMiss=0;
      if(currentWin>maxWin)maxWin=currentWin;
    }else{
      currentMiss++;
      currentWin=0;
      if(currentMiss>maxMiss)maxMiss=currentMiss;
    }
  });
  return {
    total:valid.length,
    hit:hit,
    rate:valid.length?hit*100/valid.length:null,
    maxWin:maxWin,
    maxMiss:maxMiss,
    currentWin:last===true?currentWin:0,
    currentMiss:last===false?currentMiss:0
  };
}
