  var target=txtPositionExcludeTarget(size);
  var universe=txtPositionUniverseCount(size);
  var best=null;
  txtPositionCombos(size).forEach(function(positions){
    var opened=txtPositionUniqueOpenedFromRows(rows,positions,target);
    var left=Math.max(0,universe-opened.unique);
    var key=positions.join(",");
    var score=opened.unique*1000-opened.scanned*0.1-left*0.01-txtHashSeed("quick-recommend|"+String(size)+"|"+String(day||"")+"|"+key)/1000000000;
    var item={
      size:size,
      name:txtPositionComboName(positions),
      positionKey:key,
      positions:positions.slice(),
      left:left,
      excluded:opened.unique,
      excludeTarget:opened.target,
      scanned:opened.scanned,
      recommendScore:score
    };
    if(!best||item.recommendScore>best.recommendScore)best=item;
  });
  return best;
