function txtPositionTokenMatchesRow(token,row){
  var nums=Array.isArray(row&&row.numbers)?row.numbers.slice(0,4).map(String):[];
  if(nums.length<4)return false;
  token=String(token||"");
  if(token.length<4)return false;
  for(var i=0;i<4;i++){
    var ch=token.charAt(i);
    if(txtIsWildcardChar(ch))continue;
    if(ch!==nums[i])return false;
  }
  return true;
}
function txtPositionResultHitsRow(result,row){
  var tokens=txtResultTokens(result&&result.text);
  if(!tokens.length)return null;
  for(var i=0;i<tokens.length;i++){
    if(txtPositionTokenMatchesRow(tokens[i],row))return true;
  }
  return false;
}
