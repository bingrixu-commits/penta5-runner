  var currentDay=txtTodayKeyForData(data||{});
  limit=Math.max(1,Number(limit||TXT_POSITION_BACKTEST_LIMIT));
  for(var i=0;i<rows.length&&out.length<limit;i++){
    var row=rows[i];
    var rowDay=txtRowDateKey(row)||currentDay;
    if(dayOnly&&rowDay!==currentDay)continue;
    var training=rows.slice(i+1);
    if(!training.length)continue;
    var recommended=txtPositionQuickRecommendItemFromRows(training,size,rowDay);
    if(!recommended||!recommended.positions)continue;
    var fast=txtPositionFastRowCheck(training,size,recommended.positions,row);
    var success=fast.success;
    out.push({
      period:String(row.period||row.uid||"--"),
      code:Array.isArray(row.numbers)?row.numbers.slice(0,4).map(String).join(""):"--",
      name:recommended.name,
      success:success,
      count:fast.count,
      excluded:fast.excluded,
      scanned:fast.scanned,
      score:recommended.recommendScore
    });
  }
  return out;
}
