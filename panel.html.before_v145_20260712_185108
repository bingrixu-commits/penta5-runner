<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>五哥数据分析</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f5f6f8;color:#111827;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}
.wrap{max-width:1080px;margin:0 auto;padding:14px}
h1{text-align:center;font-size:22px;margin:14px 0 12px}
.status{padding:12px;border-radius:10px;background:#e8f1ff;color:#1d4ed8;margin-bottom:12px;font-weight:700;word-break:break-word}
.status.ok{background:#e8f8ef;color:#047857}
.status.err{background:#fee2e2;color:#b91c1c}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.card{background:#fff;border-radius:14px;padding:14px;margin-bottom:12px;box-shadow:0 1px 5px rgba(0,0,0,.08)}
.card h2{font-size:18px;margin:0 0 12px}
.table{width:100%;border-collapse:collapse}
.table td{border-bottom:1px solid #edf0f3;padding:11px 8px;vertical-align:middle}
.table td:first-child{background:#f3f4f6;font-weight:700;width:32%}
.ball{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;margin:3px;background:#e11d48;color:#fff;font-weight:900}
.ball.dark{background:#111827}
.ball.blue{background:#4338ca}
.tag{display:inline-block;background:#eef2ff;border-radius:999px;padding:5px 9px;margin:3px;font-size:13px}
.btns{display:flex;gap:10px;margin-bottom:12px}
button{border:0;border-radius:10px;background:#2563eb;color:#fff;font-weight:800;padding:12px 14px;font-size:16px}
button.gray{background:#4b5563}
.small{font-size:13px;color:#6b7280;line-height:1.6}
.rate{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid #eee;padding:9px 0}
.rate span{text-align:right}
.shape-choice{display:flex;flex-direction:column;gap:8px;min-width:0}
.shape-choice__head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.shape-choice__code{font-weight:800;font-size:20px;color:#0f172a;line-height:1.25;word-break:break-all}
.shape-choice__rate{font-size:13px;color:#475569;white-space:nowrap}
.shape-choice__details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.shape-choice__detail{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:7px 9px;min-width:0}
.shape-choice__label{font-size:12px;color:#64748b;line-height:1.3;margin-bottom:3px}
.shape-choice__value{display:block;min-width:0}
.shape-token-list{display:grid;grid-template-columns:repeat(4,max-content);gap:4px;align-items:center;min-width:0}
.shape-token{display:inline-flex;align-items:center;justify-content:center;background:#fff;border:1px solid #cbd5e1;border-radius:6px;min-width:26px;padding:2px 5px;font-size:13px;font-weight:800;line-height:1.25;color:#0f172a;white-space:nowrap}
.shape-choice__percent{display:block;margin-top:5px;font-size:13px;font-weight:800;line-height:1.25;color:#0f172a;white-space:nowrap}
#practiceFireworks{position:fixed;inset:0;z-index:9999;pointer-events:none;overflow:hidden}
#practiceFireworks canvas{position:absolute;inset:0;width:100%;height:100%}
.practice-toast{position:absolute;left:50%;top:18%;transform:translateX(-50%);background:rgba(15,23,42,.94);color:white;border-radius:14px;padding:14px 22px;font-size:22px;font-weight:900;box-shadow:0 14px 38px rgba(15,23,42,.32);white-space:nowrap}
.practice-hit-strong{font-size:16px!important;font-weight:900!important;padding:10px 12px!important;box-shadow:0 8px 22px rgba(22,101,52,.15)}
@media(max-width:700px){.grid2{grid-template-columns:1fr}.ball{width:34px;height:34px}.rate{display:block}.rate span{text-align:left;display:block;margin-top:4px}}
@media(max-width:700px){.shape-choice__details{grid-template-columns:1fr}.shape-choice__code{font-size:18px}}
</style>
</head>
<body>
<div class="wrap">
<h1>五哥数据分析</h1>
<div id="status" class="status">等待同步...</div>

<div class="btns">
<button onclick="loadState()">刷新数据</button>
<button class="gray" onclick="manualSync()">手动同步</button>
</div>

<div class="card" id="txtConvertBox">
  <h2>TXT转换</h2>
  <div class="small">只在当前浏览器生成和下载TXT，不上传、不写数据库。</div>
  <div style="border:1px solid #d1fae5;border-radius:10px;background:#f0fdf4;padding:10px;margin-top:10px;">
    <b>指令转TXT</b>
    <div class="small">输入示例：二定 32 65；三定 123 456；四定 4651 0320；四定5000组；也可粘贴完整射击文字：千...百...十...个...四定...除对数48、除旧码最大各。</div>
    <div class="small" style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:6px;">
      <b>空位格式</b>
      <label style="display:inline-flex;gap:4px;align-items:center;cursor:pointer;"><input type="radio" name="txtBlankFormat" value="x" checked> x格式：32xx / 123x</label>
      <label style="display:inline-flex;gap:4px;align-items:center;cursor:pointer;"><input type="radio" name="txtBlankFormat" value="+"> +格式：32++ / 123+</label>
    </div>
    <div class="small" style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:6px;">
      <b>分隔格式</b>
      <label style="display:inline-flex;gap:4px;align-items:center;cursor:pointer;"><input type="radio" name="txtSeparatorFormat" value="space"> 空格：00xx 65xx</label>
      <label style="display:inline-flex;gap:4px;align-items:center;cursor:pointer;"><input type="radio" name="txtSeparatorFormat" value="each" checked> 各字结尾：00xx各65xx各</label>
    </div>
    <textarea id="txtInstructionInput" style="width:100%;min-height:62px;box-sizing:border-box;border:1px solid #86efac;border-radius:8px;padding:8px;background:white;font-size:13px;margin-top:7px;" placeholder="在这里输入指令或号码，例如：千123百456十789个012四定千百十合123百十个合456除单双单单除对数48各"></textarea>
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;">
      <button type="button" data-txt-instruction-convert="1" style="border:0;border-radius:7px;padding:7px 10px;background:#16a34a;color:white;font-weight:800;cursor:pointer;font-size:13px;">按指令转换</button>
      <button type="button" data-txt-instruction-copy="1" style="border:0;border-radius:7px;padding:7px 10px;background:#334155;color:white;font-weight:800;cursor:pointer;font-size:13px;">复制结果</button>
      <button type="button" data-txt-instruction-download="1" style="border:0;border-radius:7px;padding:7px 10px;background:#2563eb;color:white;font-weight:800;cursor:pointer;font-size:13px;">下载结果TXT</button>
    </div>
  </div>
  <div style="border:1px solid #c4b5fd;border-radius:10px;background:#f5f3ff;padding:10px;margin-top:10px;">
    <b>二定三定旧码原位置回删框架</b>
    <div class="small">按旧码原位置拆分回删：历史开 6426，二定只删 64xx、6x2x、6xx6、x42x、x4x6、xx26；三定只删 642x、64x6、6x26、x426，不串位置。</div>
    <div id="txtPositionFrameworkInfo" class="small" style="margin-top:5px;">等待远程数据...</div>
    <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;">
      <button type="button" data-txt-position-generate="two" style="border:0;border-radius:7px;padding:7px 10px;background:#7c3aed;color:white;font-weight:800;cursor:pointer;font-size:13px;">一键生成所有二定TXT</button>
      <button type="button" data-txt-position-generate="three" style="border:0;border-radius:7px;padding:7px 10px;background:#7c3aed;color:white;font-weight:800;cursor:pointer;font-size:13px;">一键生成所有三定TXT</button>
      <button type="button" data-txt-position-recommend="2" style="border:0;border-radius:7px;padding:7px 10px;background:#ea580c;color:white;font-weight:800;cursor:pointer;font-size:13px;">生成推荐二定TXT</button>
      <button type="button" data-txt-position-recommend="3" style="border:0;border-radius:7px;padding:7px 10px;background:#ea580c;color:white;font-weight:800;cursor:pointer;font-size:13px;">生成推荐三定TXT</button>
      <button type="button" data-txt-position-copy="1" style="border:0;border-radius:7px;padding:7px 10px;background:#334155;color:white;font-weight:800;cursor:pointer;font-size:13px;">一键复制</button>
      <button type="button" data-txt-position-download="1" style="border:0;border-radius:7px;padding:7px 10px;background:#2563eb;color:white;font-weight:800;cursor:pointer;font-size:13px;">下载定位TXT</button>
    </div>
    <div style="border:1px solid #fed7aa;border-radius:9px;background:#fff7ed;padding:9px;margin-top:8px;">
      <b>自定义二定50组</b>
      <div class="small">示例：千排除7 百排除6；只取你写的两个位置，先删定位排除，再按旧码原位置继续删到50组。</div>
      <textarea id="txtCustomTwoInput" style="width:100%;min-height:42px;box-sizing:border-box;border:1px solid #fdba74;border-radius:8px;padding:8px;background:white;font-size:13px;margin-top:7px;" placeholder="千排除7 百排除6"></textarea>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;">
        <button type="button" data-txt-custom-two-generate="1" style="border:0;border-radius:7px;padding:7px 10px;background:#f97316;color:white;font-weight:900;cursor:pointer;font-size:13px;">生成二定50组</button>
      </div>
      <div id="txtCustomTwoInfo" class="small" style="margin-top:6px;">等待输入。</div>
    </div>
    <textarea id="txtPositionFrameworkOutput" readonly style="width:100%;min-height:58px;box-sizing:border-box;border:1px solid #a78bfa;border-radius:8px;padding:8px;background:white;font-size:13px;margin-top:8px;"></textarea>
    <div id="txtPositionModelBox" class="small" style="margin-top:8px;"></div>
  </div>
  <textarea id="txtPreview" readonly style="width:100%;min-height:68px;box-sizing:border-box;border:1px solid #86efac;border-radius:8px;padding:8px;background:white;font-size:13px;margin-top:8px;"></textarea>
  <div id="txtConvertStatus" class="small"></div>
  <div id="txtAuditBox" style="border:1px solid #bbf7d0;border-radius:10px;background:#f0fdf4;padding:10px;margin-top:10px;">
    <b>本机TXT生成记录（非防篡改）</b>
    <div class="small">只记录本浏览器生成的 TXT 本机核对信息：期号、组数、重复/非法格式、哈希；哈希仅用于发现内容变化，不是服务器存证或防篡改证明。开奖后按远程历史自动回算。</div>
    <div id="txtAuditCurrent" class="small" style="margin-top:6px;">生成TXT后自动记录快照。</div>
    <div id="txtAuditHistory" class="small" style="margin-top:6px;"></div>
  </div>
</div>

<div class="grid2">
  <div class="card">
    <h2>最新开奖数据</h2>
    <table class="table">
      <tr><td>期号</td><td id="period">--</td></tr>
      <tr><td>开奖时间</td><td id="opentime">--</td></tr>
      <tr><td>开奖号码</td><td id="numbers">--</td></tr>
      <tr><td>三对数排除</td><td id="threeDuishuCode">--</td></tr>
      <tr><td>总合尾</td><td id="totalHewei">--</td></tr>
      <tr><td>综合合尾</td><td id="subHewei">--</td></tr>
    </table>
    <div class="small" id="meta"></div>
  </div>

  <div class="card">
    <h2>下一期大数据排除建议</h2>
    <table class="table">
      <tr><td>三个合尾统一避开码</td><td id="killThreeFour">--</td></tr>
<tr><td>万千百合尾避开码</td><td id="killWanQianBai">--</td></tr>
<tr><td>千百十合尾避开码</td><td id="killQianBaiShi">--</td></tr>
<tr><td>万千百十合尾避开码</td><td id="killWanQianBaiShi">--</td></tr>

      <tr><td>万位排除</td><td id="wan">--</td></tr>
      <tr><td>千位排除</td><td id="qian">--</td></tr>
      <tr><td>百位排除</td><td id="bai">--</td></tr>
      <tr><td>十位排除</td><td id="shi">--</td></tr>
    </table>
    <div class="small" id="predMeta"></div>
  </div>
</div>

<div class="card">
  <h2>最近后台历史</h2>
  <div id="history">--</div>
</div>
</div>

<script>
var COLD_HOT_WINDOW = 60;
function $(id){return document.getElementById(id)}
function esc(s){return String(s==null?"--":s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function ball(n,cls){return '<span class="ball '+(cls||'')+'">'+esc(n)+'</span>'}
function tag(t){return '<span class="tag">'+esc(t)+'</span>'}
function setStatus(t,ok){var el=$("status");el.textContent=t;el.className="status "+(ok?"ok":"err")}
function rate(total,match){return total?((match/total)*100).toFixed(2)+"%":"0.00%"}
function panelCleanUrl(path){
  var cleanPath=String(path||"/");
  if(cleanPath.charAt(0)!=="/")cleanPath="/"+cleanPath;
  var protocol=(location&&location.protocol)||"http:";
  var host=(location&&location.host)||"8.210.5.221:3001";
  return protocol+"//"+host+cleanPath;
}
function panelFetch(path,options){
  var opts=options||{};
  if(!opts.cache)opts.cache="no-store";
  if(!opts.credentials)opts.credentials="same-origin";
  return fetch(panelCleanUrl(path),opts);
}
var TXT_FRAMEWORKS=[];
var txtFrameworkCache={};
var TXT_PLACEHOLDER_STORAGE_KEY="penta5TxtPlaceholderFormat";
var TXT_SEPARATOR_STORAGE_KEY="penta5TxtSeparatorFormat";
function txtPlaceholderChar(){
  try{
    var checked=document.querySelector('input[name="txtBlankFormat"]:checked');
    var value=checked?checked.value:localStorage.getItem(TXT_PLACEHOLDER_STORAGE_KEY);
    return value==="+"?"+":"x";
  }catch(e){
    return "x";
  }
}
function txtPlaceholderFill(count){
  count=Math.max(0,Number(count||0));
  var ch=txtPlaceholderChar(),out="";
  for(var i=0;i<count;i++)out+=ch;
  return out;
}
function txtIsWildcardChar(ch){
  ch=String(ch||"");
  return ch==="+"||ch.toUpperCase()==="X";
}
function txtWildcardPattern(count){
  count=Math.max(0,Number(count||0));
  return "(?:x|\\+){"+count+"}";
}
function txtSeparatorFormat(){
  try{
    var checked=document.querySelector('input[name="txtSeparatorFormat"]:checked');
    var value=checked?checked.value:localStorage.getItem(TXT_SEPARATOR_STORAGE_KEY);
    return value==="space"?"space":"each";
  }catch(e){
    return "each";
  }
}
function txtTokenSeparator(){
  return txtSeparatorFormat()==="space"?" ":"各";
}
function txtFormatTokenList(tokens,limit){
  tokens=Array.isArray(tokens)?tokens:[];
  if(limit!=null)tokens=tokens.slice(0,Math.max(0,Number(limit||0)));
  if(!tokens.length)return "";
  var sep=txtTokenSeparator();
  return tokens.join(sep)+sep;
}
function txtResultTokens(text){
  return String(text||"").trim().split(/[\s，,、各]+/).filter(Boolean);
}
function txtClearGeneratedTxtResults(){
  window.__penta5TxtInstructionResult=null;
  txtPositionFrameworkLastResult=null;
  var preview=$("txtPreview");
  var positionOutput=$("txtPositionFrameworkOutput");
  var oldOutput=$("txtOldCodeFrameworkOutput");
  if(preview)preview.value="";
  if(positionOutput)positionOutput.value="";
  if(oldOutput)oldOutput.value="";
}
function txtInitPlaceholderFormat(){
  try{
    var saved=localStorage.getItem(TXT_PLACEHOLDER_STORAGE_KEY);
    var value=saved==="+"?"+":"x";
    var inputs=document.querySelectorAll('input[name="txtBlankFormat"]');
    inputs.forEach(function(input){
      input.checked=input.value===value;
      input.addEventListener("change",function(){
        if(!input.checked)return;
        var next=input.value==="+"?"+":"x";
        localStorage.setItem(TXT_PLACEHOLDER_STORAGE_KEY,next);
        txtClearGeneratedTxtResults();
        txtSetStatus("空位格式已切换为 "+next+"，请重新生成TXT。");
      });
    });
  }catch(e){}
}
function txtInitSeparatorFormat(){
  try{
    var saved=localStorage.getItem(TXT_SEPARATOR_STORAGE_KEY);
    var value=saved==="space"?"space":"each";
    if(saved==="comma")localStorage.setItem(TXT_SEPARATOR_STORAGE_KEY,"each");
    var inputs=document.querySelectorAll('input[name="txtSeparatorFormat"]');
    inputs.forEach(function(input){
      input.checked=input.value===value;
      input.addEventListener("change",function(){
        if(!input.checked)return;
        var next=input.value==="space"?"space":"each";
        localStorage.setItem(TXT_SEPARATOR_STORAGE_KEY,next);
        txtClearGeneratedTxtResults();
        txtSetStatus("分隔格式已切换为 "+(next==="each"?"各字结尾：00xx各65xx各":"空格：00xx 65xx")+"，请重新生成TXT。");
      });
    });
  }catch(e){}
}
function txtHashSeed(text){
  var hash=2166136261;
  text=String(text||"");
  for(var i=0;i<text.length;i++){
    hash^=text.charCodeAt(i);
    hash=(hash*16777619)>>>0;
  }
  return hash>>>0;
}
function txtPadNumber(value,width){
  return String(value).padStart(width,"0");
}
function txtDisplayGroup(code,width){
  code=String(code||"").replace(/\D/g,"").padStart(width,"0");
  if(width>=4)return code.slice(0,4);
  return code.slice(0,width)+txtPlaceholderFill(4-width);
}
function txtRecords(data){
  return (Array.isArray(data&&data.history)?data.history:[]).filter(function(row){
    return row&&Array.isArray(row.numbers)&&row.numbers.length>=4;
  });
}
function txtDateKeyFromValue(value){
  var text=String(value==null?"":value).trim();
  var match=text.match(/(\d{4})[-\/](\d{1,2})[-\/](\d{1,2})/);
  if(match){
    return match[1]+"-"+String(match[2]).padStart(2,"0")+"-"+String(match[3]).padStart(2,"0");
  }
  match=text.match(/^(\d{4})(\d{2})(\d{2})/);
  if(match)return match[1]+"-"+match[2]+"-"+match[3];
  return "";
}
function txtRowDateKey(row){
  var ev=row&&row.evaluation||{};
  return txtDateKeyFromValue(ev.targetOpenTime)
    ||txtDateKeyFromValue(ev.evaluatedAtText)
    ||txtDateKeyFromValue(ev.evaluatedAt)
    ||txtDateKeyFromValue(row&&row.baseOpenTime)
    ||txtDateKeyFromValue(row&&row.basePeriod)
    ||txtDateKeyFromValue(ev.targetPeriod)
    ||txtDateKeyFromValue(row&&row.opentime)
    ||txtDateKeyFromValue(row&&row.period);
}
function txtTodayKeyForData(data){
  var latest=data&&data.latestRecord||{};
  return txtDateKeyFromValue(latest.opentime)
    ||txtDateKeyFromValue(latest.period)
    ||txtDateKeyFromValue(new Date().toISOString());
}
function txtEsc(value){
  return String(value==null?"":value).replace(/[&<>\"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c];});
}
function txtTrainingRecords(data,day){
  return txtRecords(data||{}).filter(function(row){
    var key=txtRowDateKey(row);
    return key&&key<day;
  });
}
function txtTrainingSignature(data,day){
  var training=txtTrainingRecords(data,day);
  if(!training.length)return "empty";
  var first=training[0]||{},last=training[training.length-1]||{};
  return [
    training.length,
    first.period||first.uid||"",
    first.opentime||"",
    last.period||last.uid||"",
    last.opentime||""
  ].join("|");
}
function txtCodeUniverse(width){
  var size=Math.pow(10,width);
  var list=[];
  for(var i=0;i<size;i++)list.push(txtPadNumber(i,width));
  return list;
}
function txtCandidateScoreMap(data,config,day){
  var score={};
  var training=txtTrainingRecords(data,day);
  training.forEach(function(row,index){
    var code=txtRecordCode(row,config.width);
    if(!code)return;
    if(!score[code])score[code]={code:code,total:0,weighted:0,recentIndex:999999};
    score[code].total+=1;
    score[code].weighted+=1/(index+1);
    if(index<score[code].recentIndex)score[code].recentIndex=index;
  });
  return score;
}
function txtFrameworkGroups(config,day,data){
  var signature=txtTrainingSignature(data||{},day);
  var cacheKey=config.key+"|"+day+"|"+signature;
  if(txtFrameworkCache[cacheKey])return txtFrameworkCache[cacheKey];
  var universe=txtCodeUniverse(config.width);
  var count=Math.max(1,Math.min(config.count,universe.length));
  var scoreMap=txtCandidateScoreMap(data||{},config,day);
  var ranked=universe.map(function(code){
    var score=scoreMap[code]||{code:code,total:0,weighted:0,recentIndex:999999};
    return {
      code:code,
      total:score.total||0,
      weighted:score.weighted||0,
      recentIndex:score.recentIndex==null?999999:score.recentIndex,
      tie:txtHashSeed(config.key+"|"+day+"|"+code)
    };
  }).sort(function(a,b){
    if(b.total!==a.total)return b.total-a.total;
    if(b.weighted!==a.weighted)return b.weighted-a.weighted;
    if(a.recentIndex!==b.recentIndex)return a.recentIndex-b.recentIndex;
    return a.tie-b.tie;
  });
  var groups=ranked.slice(0,count).map(function(item){return item.code;}).sort();
  txtFrameworkCache[cacheKey]=groups;
  return groups;
}
function txtBuildContent(config,day,data){
  var groups=txtFrameworkGroups(config,day,data||{});
  var displayGroups=groups.map(function(code){return txtDisplayGroup(code,config.width);});
  return {count:groups.length,width:config.width,text:txtFormatTokenList(displayGroups),preview:txtFormatTokenList(displayGroups,80)};
}
var TXT_POSITION_HISTORY_WINDOW = 50;
var TXT_POSITION_TWO_EXCLUDE_TARGET = 50;
var TXT_POSITION_THREE_EXCLUDE_TARGET = 500;
var TXT_POSITION_TWO_TARGET = 50;
var TXT_POSITION_THREE_TARGET = 500;
var TXT_POSITION_BACKTEST_LIMIT = 30;
var txtPositionFrameworkLastResult = null;
function txtPositionCombos(size){
  var source=[0,1,2,3],out=[];
  function walk(start,picked){
    if(picked.length===size){
      out.push(picked.slice());
      return;
    }
    for(var i=start;i<source.length;i++){
      picked.push(source[i]);
      walk(i+1,picked);
      picked.pop();
    }
  }
  walk(0,[]);
  return out;
}
function txtPositionComboName(positions){
  var labels=["千","百","十","个"];
  return (positions||[]).map(function(index){return labels[index]||"";}).join("");
}
function txtPositionCodeFromRow(row,positions){
  var nums=Array.isArray(row&&row.numbers)?row.numbers:[];
  var out=[];
  for(var i=0;i<(positions||[]).length;i++){
    var digit=String(nums[positions[i]]==null?"":nums[positions[i]]).replace(/\D/g,"").charAt(0);
    if(!digit)return "";
    out.push(digit);
  }
  return out.join("");
}
function txtPositionMask(code,positions){
  var blank=txtPlaceholderChar();
  var out=[blank,blank,blank,blank];
  String(code||"").split("").forEach(function(digit,index){
    var pos=(positions||[])[index];
    if(pos>=0&&pos<4)out[pos]=digit;
  });
  return out.join("");
}
function txtPositionUniverse(size){
  var max=Math.pow(10,size),out=[];
  for(var i=0;i<max;i++)out.push(String(i).padStart(size,"0"));
  return out;
}
function txtPositionExcludeTarget(size){
  return size===3?TXT_POSITION_THREE_EXCLUDE_TARGET:TXT_POSITION_TWO_EXCLUDE_TARGET;
}
function txtPositionRecentWindow(size){
  return size===3?TXT_POSITION_THREE_EXCLUDE_TARGET:TXT_POSITION_TWO_EXCLUDE_TARGET;
}
function txtPositionRecentSetFromRows(rows,positions,limit){
  var set={};
  (Array.isArray(rows)?rows:[]).slice(0,Math.max(1,Number(limit||TXT_POSITION_HISTORY_WINDOW))).forEach(function(row){
    var code=txtPositionCodeFromRow(row,positions);
    if(code)set[code]=true;
  });
  return set;
}
function txtPositionUniqueOpenedFromRows(rows,positions,targetUnique){
  rows=Array.isArray(rows)?rows:[];
  targetUnique=Math.max(1,Number(targetUnique||1));
  var set={},list=[],scanned=0;
  for(var i=0;i<rows.length;i++){
    scanned++;
    var code=txtPositionCodeFromRow(rows[i],positions);
    if(!code||set[code])continue;
    set[code]=true;
    list.push(code);
    if(list.length>=targetUnique)break;
  }
  return {set:set,list:list,unique:list.length,scanned:scanned,target:targetUnique};
}
function txtPositionUniverseCount(size){
  return size===3?1000:100;
}
function txtPositionFastRowCheck(trainingRows,size,positions,row){
  var opened=txtPositionUniqueOpenedFromRows(trainingRows,positions,txtPositionExcludeTarget(size));
  var code=txtPositionCodeFromRow(row,positions);
  var success=code?opened.set[code]!==true:null;
  return {
    success:success,
    count:Math.max(0,txtPositionUniverseCount(size)-opened.unique),
    code:code,
    excluded:opened.unique,
    excludeTarget:opened.target,
    scanned:opened.scanned
  };
}
function txtPositionHistoryScoreMapFromRows(rows,positions){
  var map={};
  (Array.isArray(rows)?rows:[]).forEach(function(row,index){
    var code=txtPositionCodeFromRow(row,positions);
    if(!code)return;
    if(!map[code])map[code]={total:0,lastIndex:999999};
    map[code].total+=1;
    if(index<map[code].lastIndex)map[code].lastIndex=index;
  });
  return map;
}
function txtPositionFileName(label,day,count){
  return "TXT_"+String(label||"定位").replace(/[\\/:*?\"<>|\\s]+/g,"")+"_"+String(count||0)+"组_"+txtFileDay(day)+"_"+txtFileStamp()+".txt";
}
function txtPositionCandidateGroupFromRows(rows,size,positions,day,salt){
  rows=Array.isArray(rows)?rows:[];
  var excludeTarget=txtPositionExcludeTarget(size);
  var opened=txtPositionUniqueOpenedFromRows(rows,positions,excludeTarget);
  var name=txtPositionComboName(positions);
  var candidates=[];
  txtPositionUniverse(size).forEach(function(code){
    if(opened.set[code])return;
    candidates.push({
      token:txtPositionMask(code,positions),
      code:code,
      positions:positions.slice(),
      comboName:name,
      excludeTarget:excludeTarget,
      excluded:opened.unique,
      scanned:opened.scanned,
      tie:txtHashSeed("position-history-independent|"+String(size)+"|"+String(day||"")+"|"+String(salt||"")+"|"+name+"|"+code)
    });
  });
  candidates.sort(function(a,b){
    if(a.token!==b.token)return a.token.localeCompare(b.token);
    return a.tie-b.tie;
  });
  return {
    name:name,
    positions:positions.slice(),
    excluded:opened.unique,
    excludeTarget:excludeTarget,
    scanned:opened.scanned,
    left:candidates.length,
    candidates:candidates
  };
}
function txtPositionCandidateGroupsFromRows(rows,size,day,salt){
  var groups=[];
  txtPositionCombos(size).forEach(function(positions){
    groups.push(txtPositionCandidateGroupFromRows(rows,size,positions,day,salt));
  });
  return groups;
}
function txtPositionPickBalanced(groups,target){
  var out=[],used={},cursors=(groups||[]).map(function(){return 0;});
  target=Math.max(1,Number(target||1));
  while(out.length<target){
    var added=false;
    for(var i=0;i<(groups||[]).length&&out.length<target;i++){
      var list=groups[i].candidates||[];
      while(cursors[i]<list.length){
        var item=list[cursors[i]++];
        var key=item.token+"|"+item.comboName;
        if(used[key])continue;
        used[key]=true;
        out.push(item);
        added=true;
        break;
      }
    }
    if(!added)break;
  }
  return out;
}
