  if(!field)return "";
  var sourceRows=Array.isArray(data&&data.history)?data.history:(Array.isArray(data&&data.records)?data.records:[]);
  var rows=sourceRows.slice(0,COLD_HOT_WINDOW);
  var counts={};
  for(var d=0;d<=9;d++)counts[String(d)]=0;
  var total=0;
  rows.forEach(function(row){
    var metrics=row&&row.metrics||{};
    var digit=metrics[field];
    if(digit===undefined||digit===null||String(digit)==="--")return;
    digit=String(digit);
    if(!/^\d$/.test(digit))return;
    counts[digit]+=1;
    total+=1;
  });
  if(!total)return "";
  var cold="0",min=Infinity;
  Object.keys(counts).sort().forEach(function(digit){
    var n=counts[digit];
    if(n<min){min=n;cold=digit;}
  });
  return ' <br><span style="display:inline-flex;gap:5px;margin-top:3px;color:#2563eb;font-weight:800;">合尾冷码 '+esc(cold)+'('+esc(min)+') <span style="color:#64748b;font-weight:500;">近'+esc(total)+'期</span></span>';
}


function unifiedHeweiRateText(data){
  var total=0,match=0;
  var list=(Array.isArray(data.predictions)?data.predictions:[])
    .filter(function(p){return p&&p.evaluated&&p.evaluation;})
