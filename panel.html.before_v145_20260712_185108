function txtPositionBacktestRowsForPositionsFromRows(rows,size,positions,limit,dayOnly,currentDay){
  var out=[];
  rows=Array.isArray(rows)?rows:[];
  limit=Math.max(1,Number(limit||TXT_POSITION_BACKTEST_LIMIT));
  currentDay=String(currentDay||"");
  for(var i=0;i<rows.length&&out.length<limit;i++){
    var row=rows[i];
    if(dayOnly){
      var key=txtRowDateKey(row);
      if(key!==currentDay)continue;
    }
    var training=rows.slice(i+1);
    if(!training.length)continue;
    var fast=txtPositionFastRowCheck(training,size,positions,row);
    out.push({
      period:String(row.period||row.uid||"--"),
      code:Array.isArray(row.numbers)?row.numbers.slice(0,4).map(String).join(""):"--",
      name:txtPositionComboName(positions),
      success:fast.success,
      count:fast.count
    });
  }
  return out;
}
function txtPositionBacktestRowsForPositions(data,size,positions,limit,dayOnly){
  return txtPositionBacktestRowsForPositionsFromRows(txtRecords(data||{}),size,positions,limit,dayOnly,txtTodayKeyForData(data||{}));
}
function txtPositionBacktestRows(data,kind,limit,dayOnly){
  var rows=txtRecords(data||{});
  var out=[];
  limit=Math.max(1,Number(limit||TXT_POSITION_BACKTEST_LIMIT));
  var currentDay=txtTodayKeyForData(data||{});
  for(var i=0;i<rows.length&&out.length<limit;i++){
    var row=rows[i];
    if(dayOnly){
      var key=txtRowDateKey(row);
      if(key!==currentDay)continue;
    }
    var training=rows.slice(i+1);
    if(!training.length)continue;
    var size=kind==="three"?3:2;
    var combos=txtPositionCombos(size);
    var success=false,known=false,count=0;
    combos.forEach(function(positions){
      var fast=txtPositionFastRowCheck(training,size,positions,row);
      count+=fast.count||0;
      if(typeof fast.success==="boolean"){
        known=true;
        if(fast.success)success=true;
      }
    });
    out.push({
      period:String(row.period||row.uid||"--"),
      code:Array.isArray(row.numbers)?row.numbers.slice(0,4).map(String).join(""):"--",
      success:known?success:null,
      count:count
    });
  }
  return out;
}
