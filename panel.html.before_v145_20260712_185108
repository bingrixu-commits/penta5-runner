    function pickBestForCombo(pool,maxPerSameModel){
      var modelCount={};
      chosen.forEach(function(item){
        var modelKey=[item.kind,item.key].join(":");
        modelCount[modelKey]=Number(modelCount[modelKey]||0)+1;
      });
      var best=null,bestScore=-Infinity;
      (pool||[]).forEach(function(item){
        var id=itemId(item);
        var modelKey=[item.kind,item.key].join(":");
        if(used[id])return;
        if(Number(modelCount[modelKey]||0)>=Number(maxPerSameModel||2))return;
        var score=comboPickScore(item);
        if(score>bestScore){
          best=item;
          bestScore=score;
        }else if(score===bestScore&&best&&order(item,best)<0){
