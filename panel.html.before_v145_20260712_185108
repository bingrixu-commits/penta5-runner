function txtAuditIndexFromToken(token,width){
  width=Number(width||4);
  var digits=txtAuditNormalizeToken(token).replace(/X/g,"").replace(/\D/g,"").slice(0,width);
  if(digits.length!==width)return -1;
  var index=Number(digits);
  var max=Math.pow(10,width);
  return isFinite(index)&&index>=0&&index<max?index:-1;
}
function txtAuditIndexesFromToken(token,width){
  width=Number(width||4);
  token=txtAuditNormalizeToken(token);
  if(width===4&&/[X+]/.test(token)&&/^[0-9X+]{4}$/.test(token)&&/\d/.test(token)){
    var out=[];
    function walk(pos,chars){
      if(pos>=4){
        out.push(Number(chars.join("")));
        return;
      }
      var ch=token.charAt(pos);
      if(txtIsWildcardChar(ch)){
        for(var d=0;d<=9;d++){
          chars[pos]=String(d);
          walk(pos+1,chars);
        }
      }else if(/^\d$/.test(ch)){
        chars[pos]=ch;
        walk(pos+1,chars);
      }
    }
    walk(0,["0","0","0","0"]);
    return out.filter(function(index){return isFinite(index)&&index>=0&&index<10000;});
  }
  var index=txtAuditIndexFromToken(token,width);
  return index>=0?[index]:[];
}
function txtAuditBuildBitmap(tokens,width){
  width=Number(width||4);
