function txtPositionRecommendationScore(item){
  item=item||{};
  var recent=txtPositionStatsRate(item.recent);
  var today=txtPositionStatsRate(item.today);
  var latest=item.latest&&item.latest.success===true?2:0;
  var missPenalty=((item.recent&&item.recent.maxMiss)||0)*0.35+((item.today&&item.today.maxMiss)||0)*0.25;
  var winBoost=((item.recent&&item.recent.maxWin)||0)*0.12+((item.today&&item.today.maxWin)||0)*0.08;
  return recent*0.72+today*0.28+latest+winBoost-missPenalty;
}
function txtPositionQuickRecommendItemFromRows(rows,size,day){
  rows=Array.isArray(rows)?rows:[];
