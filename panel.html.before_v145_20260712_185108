  var backup=p.originalBackupDigit || p.backupAlgorithmDigit || p.backup || p.backupDigit || (p.killDigits&&p.killDigits[1]) || "--";
  return ball(recommend,"dark")+" 推荐 "+ball(main,"dark")+" 主攻 "+ball(backup,"blue")+" 备用";
