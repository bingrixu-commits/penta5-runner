        if(shotLanguageEnabledBox)shotLanguageEnabledBox.addEventListener("change",function(){updatePracticeModelOutput(true);});
        var autoMode=document.getElementById("practiceModeAuto"),recommend2Mode=document.getElementById("practiceModeRecommend2"),coldFrameworkMode=document.getElementById("practiceModeColdFramework"),manualMode=document.getElementById("practiceModeManual"),pureMode=document.getElementById("practiceModePure"),manualList=document.getElementById("practiceManualList");
        if(autoMode)autoMode.checked=practiceMode!=="manual"&&practiceMode!=="pure"&&practiceMode!=="recommend2"&&practiceMode!=="coldFramework";
        if(recommend2Mode)recommend2Mode.checked=practiceMode==="recommend2";
        if(coldFrameworkMode)coldFrameworkMode.checked=practiceMode==="coldFramework";
        if(manualMode)manualMode.checked=practiceMode==="manual";
        if(pureMode)pureMode.checked=practiceMode==="pure";
        if(autoMode)autoMode.addEventListener("change",function(){practiceMode="auto";savePracticeSettings();updatePracticeModelOutput(true);});
        if(recommend2Mode)recommend2Mode.addEventListener("change",function(){practiceMode="recommend2";savePracticeSettings();updatePracticeModelOutput(true);});
        if(coldFrameworkMode)coldFrameworkMode.addEventListener("change",function(){practiceMode="coldFramework";savePracticeSettings();updatePracticeModelOutput(true);});
        if(manualMode)manualMode.addEventListener("change",function(){practiceMode="manual";seedManualSelection(calculationCache?calculationCache.top:top);savePracticeSettings();updatePracticeModelOutput(true);});
        if(pureMode)pureMode.addEventListener("change",function(){practiceMode="pure";seedManualSelection(calculationCache?calculationCache.top:top);savePracticeSettings();updatePracticeModelOutput(true);});
        if(manualList)manualList.addEventListener("change",function(ev){var target=ev.target;if(target&&target.getAttribute&&target.getAttribute("data-practice-id")){practiceManualSelection[target.getAttribute("data-practice-id")]=!!target.checked;practiceManualInitialized=true;savePracticeSettings();updatePracticeModelOutput(true);}});
        document.getElementById("generatePracticeModel").addEventListener("click",async function(){
          var btn=this;
          if(btn){btn.disabled=true;btn.textContent="同步中...";}
          try{
            await refreshPracticeStateBeforeGenerate();
            updatePracticeModelOutput(true);
            armPracticeSnapshotForCurrentOutput("generate");
          }finally{
            if(btn){btn.disabled=false;btn.textContent="按当前选择生成";}
          }
        });
        document.getElementById("copyPracticeModel").addEventListener("click",copyPracticeText);
        document.getElementById("practiceToTxtModel").addEventListener("click",convertPracticeModelToTxt);
    }
    if(box._pentaUpdatePracticeModelOutput)box._pentaUpdatePracticeModelOutput(false);
    renderPracticeLayoutBox();
  }
/* PENTA5_V33_PRACTICE_FLEXIBLE_END */

  function parsePanelTimeMs(value){
    if(!value)return 0;
    var direct=Date.parse(String(value));
    if(isFinite(direct))return direct;
    var normalized=String(value).replace(/-/g,"/");
    var parsed=Date.parse(normalized);
    return isFinite(parsed)?parsed:0;
  }
  function latestSyncAgeMs(data){
    var last=(data&&data.lastSync)||{};
    var latest=(data&&data.latestRecord)||{};
    var ms=parsePanelTimeMs(last.at)||parsePanelTimeMs(latest.capturedAt)||parsePanelTimeMs(latest.opentime);
    return ms?Math.max(0,Date.now()-ms):Number.POSITIVE_INFINITY;
  }
  function maybeKickPanelSync(data){
    var now=Date.now();
    if(panelSyncRunning)return;
    if(now-panelLastSyncAttemptAt<PANEL_AUTO_SYNC_MIN_MS)return;
    if(data&&data.ok&&latestSyncAgeMs(data)<=PANEL_SYNC_STALE_MS)return;
    panelLastSyncAttemptAt=now;
    panelSyncRunning=true;
    panelFetch("/sync",{method:"POST",cache:"no-store"})
      .then(function(){setTimeout(refresh,500);})
      .catch(function(err){console.warn("panel auto sync failed",err);})
      .finally(function(){panelSyncRunning=false;});
  }
  function stateRenderKey(data){
    var latest=(data&&data.latestRecord)||{};
    var last=(data&&data.lastSync)||{};
    var current=(data&&data.currentPrediction)||{};
    var ev=current.evaluation||{};
    var nums=Array.isArray(latest.numbers)?latest.numbers.join(""):"";
    var syncNums=Array.isArray(last.latestNumbers)?last.latestNumbers.join(""):"";
    return [
      data&&data.updatedAt||"",
      latest.uid||"",
      latest.period||"",
      nums,
      last.at||"",
      last.latestPeriod||"",
      syncNums,
      current.id||"",
      current.evaluated?"1":"0",
      ev.targetUid||"",
      ev.targetPeriod||"",
      ev.evaluatedAt||"",
      Array.isArray(data&&data.predictions)?data.predictions.length:"0"
    ].join(":");
  }
  function renderLatestFast(data){
    var latest=data&&data.latestRecord||{}, nums=Array.isArray(latest.numbers)?latest.numbers:[];
    var periodCell=document.getElementById("period");
    if(periodCell)periodCell.textContent=latest.period||latest.uid||"--";
    var opentimeCell=document.getElementById("opentime");
    if(opentimeCell)opentimeCell.textContent=latest.opentime||"--";
    var numberCell=document.getElementById("numbers");
    if(numberCell&&nums.length>=5){
      numberCell.innerHTML=nums.map(function(n,i){return circle(n,i===4?"#94a3b8":"#e11d48");}).join("")+'<span style="font-size:12px;color:#64748b;">最后一位不参与分析</span>';
    }
    var first4=nums.slice(0,4).map(Number), sum=first4.reduce(function(a,b){return a+b;},0);
    var total=document.getElementById("totalHewei");
    if(total){setLabel("totalHewei","四位合尾");total.innerHTML=circle(sum%10,"#4338ca")+'总和：'+sum;}
    var sub=document.getElementById("subHewei"),m=latest.metrics||{};
    if(sub){
      setLabel("subHewei","分项合尾");
      sub.innerHTML='<span class="tag">千百十：'+esc(m.wanQianBaiHewei||"--")+'</span> '
        +'<span class="tag">百十个：'+esc(m.qianBaiShiHewei||"--")+'</span> '
        +'<span class="tag">千百十个：'+esc(m.wanQianBaiShiHewei||"--")+'</span>';
    }
  }
  function renderRecentHistory(data){
    var box=document.getElementById("history");
    if(!box)return;
    var rows=Array.isArray(data&&data.history)?data.history.slice(0,20):[];
    box.innerHTML=rows.length?rows.map(function(row){
      var period=row&&((row.period!=null&&row.period!=="")?row.period:row.uid);
      var numbers=Array.isArray(row&&row.numbers)?row.numbers:[];
      return '<div class="rate"><b>'+esc(period||"--")+'</b><span>'+esc(row&&row.opentime||"--")+' ｜ '+esc(numbers.join(" ")||"--")+'</span></div>';
    }).join(""):"--";
  }
  function renderPanelMetadata(data){
    var latest=data&&data.latestRecord||{};
    var sync=data&&data.lastSync||{};
    var prediction=data&&data.currentPrediction||{};
    var meta=document.getElementById("meta");
    if(meta){
      var syncText=sync.text||sync.at||latest.opentime||"--";
      var historyCount=Array.isArray(data&&data.history)?data.history.length:0;
      meta.innerHTML="最后同步："+esc(syncText)+"<br>共享历史："+esc(historyCount)+"期";
    }
    var predMeta=document.getElementById("predMeta");
    if(predMeta){
      var basePeriod=prediction.basePeriod||prediction.baseUid||latest.period||latest.uid||"--";
      var generatedAt=prediction.generatedAtText||prediction.generatedAt||"--";
      predMeta.innerHTML="预测基准期号："+esc(basePeriod)+"<br>生成时间："+esc(generatedAt);
    }
  }
  var panelHeavyRenderTimer=null;
  var panelHeavyRenderSeq=0;
  function schedulePanelHeavyRender(nextState){
    panelHeavyRenderSeq+=1;
    var seq=panelHeavyRenderSeq;
    if(panelHeavyRenderTimer)clearTimeout(panelHeavyRenderTimer);
    var steps=[
      function(){
        var cacheKey=stateRenderKey(nextState);
        if(!calculationCache||calculationCache.key!==cacheKey){
          evaluationCache={};
          var items=currentItems(nextState),top=backendAutoTopItems(nextState)||[],combo=combinedRate(nextState,top);
          calculationCache={key:cacheKey,items:items,top:top,combo:combo};
        }
      },
      function(){renderLatest(nextState,calculationCache?calculationCache.top:[]);},
      function(){if(calculationCache)renderTop(nextState,calculationCache.top,calculationCache.combo,calculationCache.items);},
      function(){renderTxtFrameworks(nextState);},
      function(){if(calculationCache)renderRows(nextState,calculationCache.items);},
      function(){renderPositionColdCodeFramework(nextState);},
      function(){renderRecentExactCodeFramework(nextState);},
      function(){renderRecentHistory(nextState);},
      function(){renderPanelMetadata(nextState);},
      function(){renderBrotherNumberFramework(nextState);},
      function(){if(calculationCache)ensurePracticeBox(calculationCache.top);},
      function(){if(calculationCache)renderCooccurrenceBox(nextState,calculationCache.items);translateReports();}
    ];
    var index=0;
    function runNext(){
      if(seq!==panelHeavyRenderSeq)return;
      if(index>=steps.length)return;
      try{
        steps[index]();
      }catch(err){
        console.error("panel chunk render failed",err);
        setStatus("页面模块计算失败："+(err&&err.message?err.message:err),false);
      }
      index+=1;
      panelHeavyRenderTimer=setTimeout(runNext,35);
    }
    panelHeavyRenderTimer=setTimeout(runNext,120);
  }
  function renderAll(){
    if(!state||!state.ok)return;
    ensureShapeRows();reorderRows();
    renderLatestFast(state);
    schedulePanelHeavyRender(state);
  }
  async function refresh(forceRender){
    if(loading)return;loading=true;
    try{
      setStatus("正在读取数据...",true);
      var response=await panelFetch("/state?_="+Date.now(),{cache:"no-store"});
      var nextState=await response.json();
      var previousKey=stateRenderKey(state);
      var nextKey=stateRenderKey(nextState);
      var firstRender=!state;
      state=nextState;
      if(previousKey!==nextKey){calculationCache=null;evaluationCache={};}
      if(firstRender||previousKey!==nextKey||forceRender===true){
        renderAll();
      }
      setStatus("远程同步成功",true);
    }
    catch(err){
      console.error("v5 panel refresh failed",err);
      setStatus("读取失败："+(err&&err.message?err.message:err),false);
    }
    finally{loading=false;}
  }
  function startPanelLoop(){
    if(panelLoopStarted)return;
    panelLoopStarted=true;
    initTxtConverter();
    window.__penta5PanelRefresh=refresh;
    window.loadState=function(){return refresh(true);};
    setStatus("页面已打开，正在准备读取数据...",true);
    setTimeout(function(){refresh(true);},700);
    setInterval(function(){setTimeout(refresh,0);},PANEL_REFRESH_MS);
    document.addEventListener("visibilitychange",function(){if(!document.hidden)refresh();});
    window.addEventListener("focus",refresh);
    window.addEventListener("pageshow",refresh);
    window.addEventListener("online",refresh);
  }
  document.addEventListener("DOMContentLoaded",startPanelLoop);
  if(document.readyState!=="loading")startPanelLoop();





/* PENTA5_V26_LAYOUT_START */
  function renderPracticeLayoutBox(){
    var practice=document.getElementById("practiceModelBox");
    var latest=document.getElementById("numbers");
    var latestCard=latest&&(latest.closest?latest.closest(".card"):latest.parentElement);
    if(!practice||!latestCard||!latestCard.parentNode)return;

    practice.className="card";
    practice.style.cssText="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:14px;padding:14px;margin-bottom:12px;box-shadow:0 1px 5px rgba(0,0,0,.08);";

    var autoTop=document.getElementById("autoTop5Recommend");
    var parent=(autoTop&&autoTop.parentNode)||latestCard.parentNode;
    var anchor=autoTop||latestCard;
    var after=anchor.nextSibling;
    while(after&&after.nodeType===3&&!String(after.nodeValue||"").trim())after=after.nextSibling;
    if(practice.parentNode!==parent || practice.previousSibling!==anchor){
      parent.insertBefore(practice,after);
    }
  }
/* PENTA5_V26_LAYOUT_END */

})();

</script>
