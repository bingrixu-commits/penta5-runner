      const rate = recentChoice.safetyRate === null ? "样本不足" : `${Number(recentChoice.safetyRate).toFixed(2)}%`;
      repairReport.push(`旁路稳筛近1300旧码观察：${recentChoice.name} ${recentChoice.code}，安全率 ${rate}`);
    }
