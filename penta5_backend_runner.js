const scoreThreeDuishuCandidatesLru = new Map();
const SCORE_THREE_DUISHU_LRU_MAX = Number(process.env.SCORE_THREE_DUISHU_LRU_MAX || 48);

function scoreThreeDuishuCandidatesCacheKey(history) {
