    const keys = ["twoDigitAvoid", "twoDigitAvoid2", "twoDigitAvoid3"];
    const pool = candidates.filter((item) => item && item.kind === "extra" && keys.includes(String(item.key || "")) && /^\d{2}$/.test(String(item.code || ""))).sort((a, b) => {
