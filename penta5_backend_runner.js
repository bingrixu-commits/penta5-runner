  if (threeDuishuRows.length || (state.currentPrediction && state.currentPrediction.threeDuishu)) {
    mergeDailyStreakStats("threeDuishu", day, streakStatsFromResults(day, threeDuishuRows), THREE_DUISHU_SNAPSHOT_VERSION);
  }
}

