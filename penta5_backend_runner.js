function threeDigitAvoidCandidates() {
  const out = [];
  for (let a = 0; a < 8; a++) {
    for (let b = a + 1; b < 9; b++) {
      for (let c = b + 1; c < 10; c++) out.push(`${a}${b}${c}`);
    }
  }
  return out;
}

function twoDigitAvoidCandidates() {
  const out = [];
