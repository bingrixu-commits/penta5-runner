      addItem({kind:"extra",key:extra.key,side:"recommend",name:extra.label,code:code!=null?String(code):chooseExtra(records(data),extra).value});
    });
    list.forEach(function(item){item.rate=displayedItemRate(data,item,30);item.rate10=displayedItemRate(data,item,10);markItemConfidence(data,item);});
