<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>纯 JSON 开奖大数据滚动分析系统</title>
<style>
*{box-sizing:border-box}
body{margin:0;background:#f5f6f8;color:#111827;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}
.wrap{max-width:1080px;margin:0 auto;padding:14px}
h1{text-align:center;font-size:22px;margin:14px 0 12px}
.status{padding:12px;border-radius:10px;background:#e8f1ff;color:#1d4ed8;margin-bottom:12px;font-weight:700;word-break:break-word}
.status.ok{background:#e8f8ef;color:#047857}
.status.err{background:#fee2e2;color:#b91c1c}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.card{background:#fff;border-radius:14px;padding:14px;margin-bottom:12px;box-shadow:0 1px 5px rgba(0,0,0,.08)}
.card h2{font-size:18px;margin:0 0 12px}
.table{width:100%;border-collapse:collapse}
.table td{border-bottom:1px solid #edf0f3;padding:11px 8px;vertical-align:middle}
.table td:first-child{background:#f3f4f6;font-weight:700;width:32%}
.ball{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;margin:3px;background:#e11d48;color:#fff;font-weight:900}
.ball.dark{background:#111827}
.ball.blue{background:#4338ca}
.tag{display:inline-block;background:#eef2ff;border-radius:999px;padding:5px 9px;margin:3px;font-size:13px}
.btns{display:flex;gap:10px;margin-bottom:12px}
button{border:0;border-radius:10px;background:#2563eb;color:#fff;font-weight:800;padding:12px 14px;font-size:16px}
button.gray{background:#4b5563}
.small{font-size:13px;color:#6b7280;line-height:1.6}
.rate{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid #eee;padding:9px 0}
.rate span{text-align:right}
.shape-choice{display:flex;flex-direction:column;gap:8px;min-width:0}
.shape-choice__head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.shape-choice__code{font-weight:800;font-size:20px;color:#0f172a;line-height:1.25;word-break:break-all}
.shape-choice__rate{font-size:13px;color:#475569;white-space:nowrap}
.shape-choice__details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.shape-choice__detail{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:7px 9px;min-width:0}
.shape-choice__label{font-size:12px;color:#64748b;line-height:1.3;margin-bottom:3px}
.shape-choice__value{display:block;min-width:0}
.shape-token-list{display:grid;grid-template-columns:repeat(4,max-content);gap:4px;align-items:center;min-width:0}
.shape-token{display:inline-flex;align-items:center;justify-content:center;background:#fff;border:1px solid #cbd5e1;border-radius:6px;min-width:26px;padding:2px 5px;font-size:13px;font-weight:800;line-height:1.25;color:#0f172a;white-space:nowrap}
.shape-choice__percent{display:block;margin-top:5px;font-size:13px;font-weight:800;line-height:1.25;color:#0f172a;white-space:nowrap}
#practiceFireworks{position:fixed;inset:0;z-index:9999;pointer-events:none;overflow:hidden}
#practiceFireworks canvas{position:absolute;inset:0;width:100%;height:100%}
.practice-toast{position:absolute;left:50%;top:18%;transform:translateX(-50%);background:rgba(15,23,42,.94);color:white;border-radius:14px;padding:14px 22px;font-size:22px;font-weight:900;box-shadow:0 14px 38px rgba(15,23,42,.32);white-space:nowrap}
.practice-hit-strong{font-size:16px!important;font-weight:900!important;padding:10px 12px!important;box-shadow:0 8px 22px rgba(22,101,52,.15)}
@media(max-width:700px){.grid2{grid-template-columns:1fr}.ball{width:34px;height:34px}.rate{display:block}.rate span{text-align:left;display:block;margin-top:4px}}
@media(max-width:700px){.shape-choice__details{grid-template-columns:1fr}.shape-choice__code{font-size:18px}}
</style>
</head>
<body>
<div class="wrap">
<h1>纯 JSON 开奖大数据滚动分析系统</h1>
<div id="status" class="status">等待同步...</div>

<div class="btns">
<button onclick="loadState()">刷新数据</button>
<button class="gray" onclick="manualSync()">手动同步</button>
</div>

<div class="grid2">
  <div class="card">
    <h2>最新开奖数据</h2>
    <table class="table">
      <tr><td>期号</td><td id="period">--</td></tr>
      <tr><td>开奖时间</td><td id="opentime">--</td></tr>
      <tr><td>开奖号码</td><td id="numbers">--</td></tr>
      <tr><td>三对数排除</td><td id="threeDuishuCode">--</td></tr>
      <tr><td>总合尾</td><td id="totalHewei">--</td></tr>
      <tr><td>综合合尾</td><td id="subHewei">--</td></tr>
    </table>
    <div class="small" id="meta"></div>
  </div>

  <div class="card">
    <h2>下一期大数据排除建议</h2>
    <table class="table">
      <tr><td>三个合尾统一避开码</td><td id="killThreeFour">--</td></tr>
<tr><td>万千百合尾避开码</td><td id="killWanQianBai">--</td></tr>
<tr><td>千百十合尾避开码</td><td id="killQianBaiShi">--</td></tr>
<tr><td>万千百十合尾避开码</td><td id="killWanQianBaiShi">--</td></tr>

      <tr><td>万位排除</td><td id="wan">--</td></tr>
      <tr><td>千位排除</td><td id="qian">--</td></tr>
      <tr><td>百位排除</td><td id="bai">--</td></tr>
      <tr><td>十位排除</td><td id="shi">--</td></tr>
    </table>
    <div class="small" id="predMeta"></div>
  </div>
</div>





<div class="card">
  <h2>最近后台历史</h2>
  <div id="history">--</div>
</div>
</div>

<script>
function $(id){return document.getElementById(id)}
function esc(s){return String(s==null?"--":s).replace(/[&<>"]/g,function(c){return {"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;"}[c]})}
function ball(n,cls){return '<span class="ball '+(cls||'')+'">'+esc(n)+'</span>'}
function tag(t){return '<span class="tag">'+esc(t)+'</span>'}
function setStatus(t,ok){var el=$("status");el.textContent=t;el.className="status "+(ok?"ok":"err")}
function rate(total,match){return total?((match/total)*100).toFixed(2)+"%":"0.00%"}
function panelCleanUrl(path){
  var cleanPath=String(path||"/");
  if(cleanPath.charAt(0)!=="/")cleanPath="/"+cleanPath;
  var protocol=(location&&location.protocol)||"http:";
  var host=(location&&location.host)||"8.210.5.221:3001";
  return protocol+"//"+host+cleanPath;
}
function panelFetch(path,options){
  var opts=options||{};
  if(!opts.cache)opts.cache="no-store";
  if(!opts.credentials)opts.credentials="same-origin";
  return fetch(panelCleanUrl(path),opts);
}
function posHtml(p){
  p=p||{};
  if(typeof p==="string" || typeof p==="number"){return ball(p,"dark")}
  var recommend=p.recommendDigit || p.selectedDigit || p.main || (p.killDigits&&p.killDigits[0]) || p.mainDigit || "--";
  var main=p.primaryDigit || p.mainAlgorithmDigit || p.mainDigit || p.main || "--";
  var backup=p.originalBackupDigit || p.backupAlgorithmDigit || p.backup || p.backupDigit || (p.killDigits&&p.killDigits[1]) || "--";
  return ball(recommend,"dark")+" 推荐 "+ball(main,"dark")+" 主攻 "+ball(backup,"blue")+" 备用";
}
function buildHeweiReport(data){
  var stat={
    wanQianBai:{label:"万千百合尾",total:0,match:0},
    qianBaiShi:{label:"千百十合尾",total:0,match:0},
    wanQianBaiShi:{label:"万千百十合尾",total:0,match:0},
    total:{label:"三个合尾统一避开码",total:0,match:0}
  };

  function getDigit(value){
    if(value && typeof value==="object")
      return String(value.killDigit||"");
    return value===undefined ? "" : String(value);
  }

  var list=Array.isArray(data.predictions)?data.predictions:[];

  list.forEach(function(p){
    if(!p || !p.evaluated || !p.evaluation) return;

    var e=p.evaluation;
    var g=e.actualCompositeHeweiGroup;
    if(!Array.isArray(g) || g.length<3) return;

    var independent=
      p.independentHeweiKills ||
      e.previousIndependentHeweiKills || {};

    [
      ["wanQianBai",0],
      ["qianBaiShi",1],
      ["wanQianBaiShi",2]
    ].forEach(function(item){
      var key=item[0],index=item[1];
      var digit=getDigit(independent[key]);
      if(!digit || digit==="--") return;
      stat[key].total++;
      if(digit!==String(g[index])) stat[key].match++;
    });

    var unified=String(
      p.threeFourHeweiKillDigit ||
      e.previousThreeFourKillDigit || ""
    );

    if(unified && unified!=="--"){
      stat.total.total++;
      if(
        unified!==String(g[0]) &&
        unified!==String(g[1]) &&
        unified!==String(g[2])
      ) stat.total.match++;
    }
  });

  var html="";
  ["wanQianBai","qianBaiShi","wanQianBaiShi","total"]
  .forEach(function(key){
    var x=stat[key];
    html+='<div class="rate"><b>'+x.label+
      '</b><span>总共 '+x.total+
      ' 次｜命中 '+x.match+
      ' 次｜命中率 '+rate(x.total,x.match)+
      '</span></div>';
  });

  return html;
}

function buildMainBackupSummary(data){
  var stat={
    main:{total:0,match:0},
    backup:{total:0,match:0}
  };
  var positions=["wan","qian","bai","shi"];
  var list=Array.isArray(data.predictions)?data.predictions:[];

  list.forEach(function(pred){
    if(!pred || !pred.evaluated || !pred.evaluation) return;

    var e=pred.evaluation;
    var kills=e.previousPositionKills||{};
    var actual=e.actualNumbers||[];

    positions.forEach(function(pos,index){
      var arr=Array.isArray(kills[pos])?kills[pos]:[];

      if(arr[0]!==undefined && actual[index]!==undefined){
        stat.main.total++;
        if(String(arr[0])!==String(actual[index])) stat.main.match++;
      }

      if(arr[1]!==undefined && actual[index]!==undefined){
        stat.backup.total++;
        if(String(arr[1])!==String(actual[index])) stat.backup.match++;
      }
    });
  });

  return '<div class="rate"><b>主攻总命中率</b><span>总共 '+stat.main.total+
    ' 次｜命中 '+stat.main.match+' 次｜命中率 '+rate(stat.main.total,stat.main.match)+'</span></div>'+
    '<div class="rate"><b>备用总命中率</b><span>总共 '+stat.backup.total+
    ' 次｜命中 '+stat.backup.match+' 次｜命中率 '+rate(stat.backup.total,stat.backup.match)+'</span></div>';
}


function positionRateText(data,pos,index){
  var rt=0,rm=0,mt=0,mm=0,bt=0,bm=0;
  var list=(Array.isArray(data.predictions)?data.predictions:[])
    .filter(function(p){return p&&p.evaluated&&p.evaluation;})
    .slice(0,30);

  list.forEach(function(pred){
    var actual=pred.evaluation.actualNumbers;
    if(!Array.isArray(actual)||actual[index]===undefined)return;
    var saved=pred.positionKills&&pred.positionKills[pos]||{};
    var fallback=pred.evaluation.previousPositionKills&&pred.evaluation.previousPositionKills[pos]||[];
    var recommend=String(saved.recommendDigit||saved.selectedDigit||saved.main||(saved.killDigits&&saved.killDigits[0])||fallback[0]||"");
    var main=String(saved.primaryDigit||saved.mainAlgorithmDigit||saved.mainDigit||saved.main||fallback[0]||"");
    var backup=String(saved.originalBackupDigit||saved.backupAlgorithmDigit||saved.backup||saved.backupDigit||(saved.killDigits&&saved.killDigits[1])||fallback[1]||"");
    if(recommend&&recommend!=="--"){
      rt++;
      if(recommend!==String(actual[index]))rm++;
    }
    if(main&&main!=="--"){
      mt++;
      if(main!==String(actual[index]))mm++;
    }
    if(backup&&backup!=="--"){
      bt++;
      if(backup!==String(actual[index]))bm++;
    }
  });

  return '<div class="small">推荐命中率 '+rate(rt,rm)+
    ' <br>主攻命中率 '+rate(mt,mm)+
    ' <br>备用命中率 '+rate(bt,bm)+'</div>';
}
function independentHeweiRateText(data,key,index){
  var total=0,match=0;
  var list=(Array.isArray(data.predictions)?data.predictions:[])
    .filter(function(p){return p&&p.evaluated&&p.evaluation;})
    .slice(0,30);

  list.forEach(function(pred){
    if(!pred || !pred.evaluated || !pred.evaluation) return;

    var saved=
      pred.independentHeweiKills ||
      pred.evaluation.previousIndependentHeweiKills || {};

    var item=saved[key];
    var digit=item && typeof item==="object" ?
      String(item.killDigit||"") : String(item||"");

    var group=pred.evaluation.actualCompositeHeweiGroup;

    if(!digit || digit==="--" || !Array.isArray(group)) return;

    total++;
    if(digit!==String(group[index])) match++;
  });

  return " 近30期命中率 "+rate(total,match);
}


function unifiedHeweiRateText(data){
  var total=0,match=0;
  var list=(Array.isArray(data.predictions)?data.predictions:[])
    .filter(function(p){return p&&p.evaluated&&p.evaluation;})
    .slice(0,30);

  list.forEach(function(p){
    var digit=String(
      p.threeFourHeweiKillDigit ||
      p.evaluation.previousThreeFourKillDigit || ""
    );
    var group=p.evaluation.actualCompositeHeweiGroup;

    if(!digit || digit==="--" || !Array.isArray(group)) return;

    total++;
    if(
      digit!==String(group[0]) &&
      digit!==String(group[1]) &&
      digit!==String(group[2])
    ) match++;
  });

  return " 近30期命中率 "+rate(total,match);
}

function render(data){
  if(!data || !data.ok){setStatus("后台有错误："+(data&&data.lastError?data.lastError.reason:"未知"),false)}
  else{setStatus("远程后台同步成功｜数据来自阿里云 3001｜关网页不影响后台继续跑",true)}

  var r=data.latestRecord||{};
  var nums=Array.isArray(r.numbers)?r.numbers:[];
  $("period").textContent=r.period||"--";
  $("opentime").textContent=r.opentime||"--";
  $("numbers").innerHTML=nums.length?nums.map(function(n){return ball(n)}).join(""):"--";

  var m=r.metrics||{};
  $("totalHewei").innerHTML=(m.totalHewei!=null)?ball(m.totalHewei,"blue")+" 总和："+esc(m.totalSum):"--";
  $("subHewei").innerHTML=
    tag("万千百："+(m.wanQianBaiHewei||"--"))+
    tag("千百十："+(m.qianBaiShiHewei||"--"))+
    tag("万千百十："+(m.wanQianBaiShiHewei||"--"));

  $("meta").innerHTML=
    "后台地址：http://8.210.5.221:3001<br>"+
    "最后同步："+esc(data.lastSync&&data.lastSync.text)+"<br>"+
    "硬盘文件："+esc(data.stateFile);

  var p=data.currentPrediction||{};
  $("killThreeFour").innerHTML=ball(p.threeFourHeweiKillDigit||"--","dark")+" 命中率 "+esc((data.rates&&data.rates.threeFour)||"0.00%");

  $("killThreeFour").innerHTML=ball(p.threeFourHeweiKillDigit||"--","dark")+unifiedHeweiRateText(data);
  var independentKills=p.independentHeweiKills||{};
  $("killWanQianBai").innerHTML=ball(
    independentKills.wanQianBai ?
    independentKills.wanQianBai.killDigit : "--","dark");
  $("killQianBaiShi").innerHTML=ball(
    independentKills.qianBaiShi ?
    independentKills.qianBaiShi.killDigit : "--","dark");
  $("killWanQianBaiShi").innerHTML=ball(
    independentKills.wanQianBaiShi ?
    independentKills.wanQianBaiShi.killDigit : "--","dark");

  
  $("killWanQianBai").innerHTML += independentHeweiRateText(data,"wanQianBai",0);
  $("killQianBaiShi").innerHTML += independentHeweiRateText(data,"qianBaiShi",1);
  $("killWanQianBaiShi").innerHTML += independentHeweiRateText(data,"wanQianBaiShi",2);

  var pk=p.positionKills||{};
  $("wan").innerHTML=posHtml(pk.wan)+positionRateText(data,"wan",0);
  $("qian").innerHTML=posHtml(pk.qian)+positionRateText(data,"qian",1);
  $("bai").innerHTML=posHtml(pk.bai)+positionRateText(data,"bai",2);
  $("shi").innerHTML=posHtml(pk.shi)+positionRateText(data,"shi",3);

  $("predMeta").innerHTML="预测基准期号："+esc(p.basePeriod)+"<br>生成时间："+esc(p.generatedAtText||p.generatedAt);

  var counters=data.counters||{};
  var rates=data.rates||{};
  var labels={
    positionTotal:"万千百十定位双码总击",
    wan:"万位双码",
    qian:"千位双码",
    bai:"百位双码",
    shi:"十位双码",
    totalHewei:"总合尾综合排除",
    threeFour:"三个合尾统一避开码"
  };
  var html="";
  Object.keys(labels).forEach(function(k){
    var c=counters[k]||{};
    html+='<div class="rate"><b>'+labels[k]+'</b><span>总共 '+(c.total||0)+' 次｜命中 '+(c.match||0)+' 次｜命中率 '+(rates[k]||rate(c.total||0,c.match||0))+'</span></div>';
  });
  html+=buildMainBackupSummary(data);
  if($("rates")) if($("rates")) $("rates").innerHTML=html;

  if($("heweiReport")) $("heweiReport").innerHTML=buildHeweiReport(data);

  var h=Array.isArray(data.history)?data.history.slice(0,20):[];
  $("history").innerHTML=h.length?h.map(function(x){
    return '<div class="rate"><b>'+esc(x.period)+'</b><span>'+esc(x.opentime)+' ｜ '+(x.numbers||[]).join(" ")+'</span></div>';
  }).join(""):"--";
}
async function loadState(){
  try{
    setStatus("正在读取阿里云后台...",true);
    var res=await panelFetch("/state?t="+Date.now(),{cache:"no-store"});
    var data=await res.json();
    render(data);
  }catch(e){
    setStatus("读取失败："+e.message,false);
  }
}
async function manualSync(){
  try{
    setStatus("正在手动同步...",true);
    await panelFetch("/sync",{method:"POST"});
    setTimeout(loadState,500);
  }catch(e){
    setStatus("同步失败："+e.message,false);
  }
}

function safeOrderRows(){
  var ids=["wan","qian","bai","shi","killWanQianBai","killQianBaiShi","killWanQianBaiShi","killThreeFour"];
  var rows=ids.map(function(id){
    var el=document.getElementById(id);
    return el ? el.parentElement : null;
  }).filter(Boolean);
  if(!rows.length) return;
  var parent=rows[0].parentElement;
  rows.forEach(function(row){parent.appendChild(row);});
}
safeOrderRows();
loadState();
setInterval(loadState,8000);
document.addEventListener("visibilitychange",function(){if(!document.hidden)loadState();});
window.addEventListener("focus",loadState);
window.addEventListener("pageshow",loadState);
window.addEventListener("online",loadState);
</script>








