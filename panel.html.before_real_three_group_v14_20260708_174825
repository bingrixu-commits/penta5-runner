        main=String(detail.primaryDigit||recommend||"");
        backup=String(pred.threeFourHeweiBackupDigit||detail.backupDigit||"");
        if(recommend&&recommend!=="--"){
          rt++;
          if(recommend!==String(group[0])&&recommend!==String(group[1])&&recommend!==String(group[2]))rm++;
        }
