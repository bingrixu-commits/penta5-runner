  function buildPracticeModel(base,top,options){
    var text=String(base||"").replace(/\s+/g,"");
    var list=Array.isArray(top)?top:[];
    var opts=options||{};
    var positionMap=[
      {start:"千",end:["百"],key:"wan"},
      {start:"百",end:["十"],key:"qian"},
      {start:"十",end:["个"],key:"bai"},
      {start:"个",end:["四定","千百十个合","除"],key:"shi"}
    ];
    positionMap.forEach(function(cfg){text=removeCodesFromSegment(text,cfg.start,cfg.end,selectedCodes(list,"position",cfg.key));});
    function uniqueCodes(){
      var out=[],seen={};
      Array.prototype.slice.call(arguments).forEach(function(arr){
        (arr||[]).forEach(function(code){
          code=String(code);
          if(code&&!seen[code]){seen[code]=true;out.push(code);}
        });
      });
      return out;
    }
    function removeFromPool(codes){
      var value="1234567890";
      (codes||[]).forEach(function(code){value=value.split(String(code)).join("");});
      return value;
    }
    function ensureHeweiSegment(label,endLabels,codes){
      codes=uniqueCodes(codes);
      if(!codes.length)return;
      if(text.indexOf(label)<0)text+=label+removeFromPool(codes);
      text=removeCodesFromSegment(text,label,endLabels,codes);
    }
    var unifiedHeweiCodes=selectedCodes(list,"hewei","unified");
    function independentOrUnifiedHewei(codes){
      codes=uniqueCodes(codes);
      return codes.length?codes:unifiedHeweiCodes;
    }
    ensureHeweiSegment("千百十合",["百十个合","千百十个合","除"],independentOrUnifiedHewei(selectedCodes(list,"hewei","wanQianBai")));
    ensureHeweiSegment("百十个合",["千百十个合","除"],independentOrUnifiedHewei(selectedCodes(list,"hewei","qianBaiShi")));
    ensureHeweiSegment("千百十个合",["除"],independentOrUnifiedHewei(uniqueCodes(selectedCodes(list,"hewei","total"),selectedCodes(list,"hewei","wanQianBaiShi"))));

    text=text.replace(/四定除值\d+/g,"四定");
    text=text.replace(/除对数\d{2,3}/g,"");
    text=text.replace(/含对数\d{2,3}/g,"");
    text=text.replace(/中对数\d{2,3}/g,"");
    text=text.replace(/除和值\d+/g,"");
    text=text.replace(/除值\d+/g,"");
    text=text.replace(/除[大小单双]{4}/g,"");

    var tokens=[];
    var seen={};
    function pushToken(token){
      token=String(token||"");
      if(!token||seen[token])return;
      seen[token]=true;
      tokens.push(token);
    }
    function selectedPositionDigits(key){
      var out=[];
      for(var i=0;i<list.length;i++){
        var item=list[i];
        if(!item||item.kind!=="position"||item.key!==key||item.code==null)continue;
        var digit=String(item.code).replace(/\D/g,"").charAt(0);
        if(digit!==""&&out.indexOf(digit)<0)out.push(digit);
      }
      return out;
    }
    function reversePositionToken(key,axis){
      var values=[];
      selectedPositionDigits(key).forEach(function(digit){
        var n=Number(digit);
        if(!isFinite(n))return;
        var token=axis==="parity"?(n%2===1?"双":"单"):(n>=5?"小":"大");
        if(values.indexOf(token)<0)values.push(token);
      });
      return values.length===1?values[0]:"";
    }
    function selectedShapeCode(shapeKey){
      for(var i=0;i<list.length;i++){
        var item=list[i];
        if(!item||item.kind!=="shape"||item.key!==shapeKey||item.code==null)continue;
        var code=String(item.code);
        if(/^[大小单双]{4}$/.test(code))return forceThreeWithOneShape(code,shapeKey);
      }
      return "";
    }
    function baseShapeCode(shapeKey,fallback){
      var selected=selectedShapeCode(shapeKey);
      if(selected)return selected;
      var shape=SHAPES.filter(function(s){return s.key===shapeKey;})[0];
      if(shape){
        var picked=chooseShapeSet(records(state||{}),shape);
        var code=String((picked&&picked.value)||"");
        if(/^[大小单双]{4}$/.test(code))return forceThreeWithOneShape(code,shapeKey);
      }
      return fallback;
    }
    function completeLockedShape(shapeKey,locked,fallback){
      var base=baseShapeCode(shapeKey,fallback);
      var shape=SHAPES.filter(function(s){return s.key===shapeKey;})[0];
      var pool=shape?candidates(shape):[];
      function matchesLocked(candidate){
        for(var i=0;i<4;i++){
          if(locked[i]&&candidate.charAt(i)!==locked[i])return false;
        }
        return true;
      }
      function distance(candidate,target){
        var diff=0;
        for(var i=0;i<4;i++)if(candidate.charAt(i)!==target.charAt(i))diff++;
        return diff;
      }
      var matches=pool.filter(matchesLocked);
      if(matches.length){
        return matches.slice().sort(function(a,b){
          var da=distance(a,base),db=distance(b,base);
          if(da!==db)return da-db;
          var aFirst=a.charAt(0)===base.charAt(0)?0:1;
          var bFirst=b.charAt(0)===base.charAt(0)?0:1;
          if(aFirst!==bFirst)return aFirst-bFirst;
          return a.localeCompare(b,"zh-CN");
        })[0]||base;
      }
      var out=String(base||fallback||"").split("");
      var fill=String(fallback||"");
      for(var i=0;i<4;i++){
        if(locked[i]){
          out[i]=locked[i];
        }else if(!/^[大小单双]$/.test(out[i]||"")){
          out[i]=fill.charAt(i)||"单";
        }
      }
      return out.join("");
    }
    function addReversePositionShapes(){
      var parity=[null,null,null,null];
      var size=[null,null,null,null];
      var changed=false;
      POS.forEach(function(pos,index){
        var parityToken=reversePositionToken(pos.key,"parity");
        var sizeToken=reversePositionToken(pos.key,"size");
        if(parityToken){parity[index]=parityToken;changed=true;}
        if(sizeToken){size[index]=sizeToken;changed=true;}
      });
      if(!changed)return;
      var parityCode=completeLockedShape("shapeParity",parity,"双双双单");
      var sizeCode=completeLockedShape("shapeSize",size,"大大大小");
      var evaluatedCount=evalRows(state||{}).length;
      var reverseCandidates=[];
      function addShapeCandidate(shapeKey,code,name){
        if(!/^[大小单双]{4}$/.test(code))return;
        var item={kind:"shape",key:shapeKey,side:"recommend",name:name,code:forceThreeWithOneShape(code,shapeKey)};
        var r30=displayedItemRate(state||{},item,30);
        var r60=displayedItemRate(state||{},item,60);
        var r120=displayedItemRate(state||{},item,120);
        var r300=displayedItemRate(state||{},item,MODEL_STABLE_WINDOW);
        if(r60==null||!isFinite(Number(r60)))r60=r30;
        if(r120==null||!isFinite(Number(r120)))r120=r60;
        if(r300==null||!isFinite(Number(r300)))r300=r120;
        if(evaluatedCount>=MODEL_STABLE_WINDOW){
          item.stableScore=(Number(r30||0)*0.10)+(Number(r60||0)*0.15)+(Number(r120||0)*0.20)+(Number(r300||0)*0.55);
        }else if(evaluatedCount>=120){
          item.stableScore=(Number(r30||0)*0.20)+(Number(r60||0)*0.20)+(Number(r120||0)*0.40)+(Number(r300||0)*0.20);
        }else{
          item.stableScore=(Number(r30||0)*0.45)+(Number(r60||0)*0.35)+(Number(r120||0)*0.20);
        }
        item.rate30=r30;
        item.rate60=r60;
        item.rate120=r120;
        item.rate300=r300;
        reverseCandidates.push(item);
      }
      addShapeCandidate("shapeParity",parityCode,"单双反形态");
      addShapeCandidate("shapeSize",sizeCode,"大小反形态");
      reverseCandidates.sort(function(a,b){
        if((b.stableScore||0)!==(a.stableScore||0))return (b.stableScore||0)-(a.stableScore||0);
        if((b.rate120||0)!==(a.rate120||0))return (b.rate120||0)-(a.rate120||0);
        if((b.rate300||0)!==(a.rate300||0))return (b.rate300||0)-(a.rate300||0);
        return String(a.name||"").localeCompare(String(b.name||""),"zh-CN");
      });
      if(reverseCandidates.length)pushToken("除"+reverseCandidates[0].code);
    }
    if(opts.addReversePositionShapes!==false)addReversePositionShapes();
    list.forEach(function(item){
      if(!item||!item.code)return;
      var key="";
      var token="";
      if(item.kind==="extra"&&item.key==="sumAvoid"){
        key="extra.sumAvoid";
        token="除和值"+item.code;
      }else if(item.kind==="extra"&&item.key==="threeDigitAvoid"){
        key="extra.threeDigitAvoid";
        token="除对数"+item.code;
      }else if(item.kind==="extra"&&(item.key==="twoDigitAvoid"||item.key==="twoDigitAvoid2"||item.key==="twoDigitAvoid3")){
        key="extra."+item.key;
        token="除对数"+item.code;
      }else if(item.kind==="extra"&&item.key==="twoDigitHit"){
        key="extra.twoDigitHit";
        token="含对数"+item.code;
      }else if(item.kind==="extra"&&item.key==="threeDigitHit"){
        key="extra.threeDigitHit";
        token="含对数"+item.code;
      }else if(item.kind==="threeDuishu"){
        key="threeDuishu."+String(item.code||"");
        threeDuishuPairTokens(item).forEach(function(pairCode){
          pushToken("除对数"+pairCode);
        });
        token="";
      }else if(item.kind==="shape"){
        var shapeCode=forceThreeWithOneShape(item.code,item.key);
        key="shape."+(item.key||"")+"."+shapeCode;
        token="除"+shapeCode;
      }else if(item.kind!=="position"&&item.kind!=="hewei"){
        key="other."+practiceItemId(item)+"."+item.code;
        token="除"+item.code;
      }
      if(token&&!seen[key])pushToken(token);
    });

    var generated=(text+tokens.join("")).replace(/\s+/g,"").trim();
    return generated.replace(/各+$/,"")+"各";
  }
