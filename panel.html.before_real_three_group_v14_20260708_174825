  }catch(e){practiceMode="auto";practiceManualSelection={};practiceManualInitialized=false;practiceLastCelebrationKey="";}
  var DEFAULT_PRACTICE_MODEL = "千1234567890百1234567890十1234567890个1234567890四定1234567890百十个合1234567890千百十个合123468790除小小小大各";
  function normalizePracticeSeedText(value){
    var text=String(value||DEFAULT_PRACTICE_MODEL).replace(/\s+/g,"");
    text=text.replace(/四定除值\d+/g,"四定");
    text=text.replace(/除对数\d{3}/g,"");
    text=text.replace(/含对数\d{3}/g,"");
    text=text.replace(/中对数\d{3}/g,"");
    text=text.replace(/除和值\d+/g,"");
    text=text.replace(/除值\d+/g,"");
    text=text.replace(/各+$/,"");
    return (text||DEFAULT_PRACTICE_MODEL.replace(/各+$/,""))+"各";
  }
  var POS = [
    {key:"wan", label:"千位", index:0},
    {key:"qian", label:"百位", index:1},
    {key:"bai", label:"十位", index:2},
    {key:"shi", label:"个位", index:3}
  ];
