  function launchPracticeFireworks(message){
    var old=document.getElementById("practiceFireworks");
    if(old&&old.parentNode)old.parentNode.removeChild(old);
    var overlay=document.createElement("div");
    overlay.id="practiceFireworks";
    var canvas=document.createElement("canvas");
    var toast=document.createElement("div");
    toast.className="practice-toast";
    toast.textContent=message||"靶场模型全部通过";
    overlay.appendChild(canvas);
    overlay.appendChild(toast);
    document.body.appendChild(overlay);
    var ctx=canvas.getContext("2d");
    var ratio=Math.max(1,window.devicePixelRatio||1);
    var width=0,height=0,particles=[];
    function resize(){
      width=window.innerWidth||document.documentElement.clientWidth||800;
      height=window.innerHeight||document.documentElement.clientHeight||600;
      canvas.width=Math.floor(width*ratio);
      canvas.height=Math.floor(height*ratio);
      canvas.style.width=width+"px";
      canvas.style.height=height+"px";
      ctx.setTransform(ratio,0,0,ratio,0,0);
    }
    function burst(x,y,count){
      var colors=["#ef4444","#f59e0b","#22c55e","#06b6d4","#3b82f6","#a855f7","#f43f5e"];
      for(var i=0;i<count;i++){
        var angle=Math.PI*2*i/count+Math.random()*0.22;
        var speed=2.6+Math.random()*5.2;
        particles.push({
          x:x,y:y,
          vx:Math.cos(angle)*speed,
          vy:Math.sin(angle)*speed,
          size:2+Math.random()*3.8,
          life:58+Math.random()*26,
          color:colors[Math.floor(Math.random()*colors.length)]
        });
      }
    }
    resize();
    var burstPlan=[
      [0.18,0.28,56],[0.34,0.36,50],[0.52,0.30,58],[0.70,0.40,50],[0.86,0.32,56],
      [0.25,0.46,48],[0.45,0.24,54],[0.63,0.50,48],[0.80,0.26,54],
      [0.16,0.38,46],[0.38,0.48,52],[0.58,0.34,48],[0.76,0.44,52],
      [0.28,0.30,44],[0.50,0.52,50],[0.72,0.28,44]
    ];
    burstPlan.forEach(function(plan,index){
      setTimeout(function(){burst(width*plan[0],height*plan[1],plan[2]);},index*420);
    });
    var frame=0;
    function draw(){
      frame++;
      ctx.clearRect(0,0,width,height);
      particles=particles.filter(function(p){return p.life>0;});
      particles.forEach(function(p){
        p.life-=1;
        p.vy+=0.045;
        p.x+=p.vx;
        p.y+=p.vy;
        ctx.globalAlpha=Math.max(0,p.life/84);
        ctx.fillStyle=p.color;
        ctx.beginPath();
        ctx.arc(p.x,p.y,p.size,0,Math.PI*2);
        ctx.fill();
      });
      ctx.globalAlpha=1;
      if(frame<480 || particles.length){
        requestAnimationFrame(draw);
      }else if(overlay&&overlay.parentNode){
        overlay.parentNode.removeChild(overlay);
      }
    }
    requestAnimationFrame(draw);
  }
