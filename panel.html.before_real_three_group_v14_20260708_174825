  function v24ShapeKind(shape){
    var key=String((shape&&shape.key)||shape||"").toLowerCase();
    var label=String((shape&&shape.label)||"");
    if(key.indexOf("mix")>=0 || key.indexOf("combo")>=0 || (label.indexOf("单双")>=0 && label.indexOf("大小")>=0))return "mix";
    if(key.indexOf("big")>=0 || key.indexOf("size")>=0 || label.indexOf("大小")>=0)return "size";
    return "oddEven";
  }
  function v24ShapeValue(record,shape){
    var digits=v24RecordDigits(record);
    if(digits.length<4)return "";
    var kind=v24ShapeKind(shape);
    if(kind==="size")return digits.map(function(n){return n>=5?"大":"小";}).join("");
    if(kind==="mix")return "";
    return digits.map(function(n){return n%2?"单":"双";}).join("");
  }
  function v24HashText(text){
    var hash=2166136261;
    text=String(text||"");
    for(var i=0;i<text.length;i++){hash^=text.charCodeAt(i);hash=(hash*16777619)>>>0;}
    return hash>>>0;
  }
  function v24HistoryBeforeRecord(data,evaluation){
    var hist=(data&&data.history)||[];
    if(!evaluation)return hist;
    var idx=-1;
    for(var i=0;i<hist.length;i++){
      if((evaluation.uid&&hist[i].uid===evaluation.uid)||(evaluation.period&&hist[i].period===evaluation.period)){idx=i;break;}
    }
    return idx>=0?hist.slice(idx+1):hist;
  }
  function v24ShapeScores(history,shape){
    var rows=(history||[]).slice(0,1000);
    var pool=candidates(shape);
    var prior=pool.length?1/pool.length:0;
    return pool.map(function(value){
      var weightedHits=0,weights=0,hits=0,recent=9999;
      rows.forEach(function(record,index){
        var w=rows.length-index;
        weights+=w;
        if(shapeMatches(record,shape.key,value)){
          weightedHits+=w;
          hits++;
          if(recent===9999)recent=index;
        }
      });
      var occurrence=(weightedHits+prior*10)/(weights+10);
      return {value:value,score:occurrence,hits:hits,recent:recent};
    }).sort(function(a,b){
      if(a.score!==b.score)return a.score-b.score;
      if(a.hits!==b.hits)return a.hits-b.hits;
      if(a.recent!==b.recent)return b.recent-a.recent;
      return a.value.localeCompare(b.value,"zh-CN");
    });
  }
  function chooseShapeSet(history,shape){
    var scores=v24ShapeScores(history||[],shape);
    if(!scores.length)return {value:"--",primary:"--",backup:"--",detail:{poolSize:0,dynamic:true}};
    var primary=scores[0].value;
    var backup=(scores.find(function(item){return item.value!==primary;})||scores[0]).value;
    var latest=(history&&history[0])||{};
    var seed=v24HashText(String((shape&&shape.key)||shape||"")+"|"+String(latest.period||latest.uid||"")+"|"+scores.slice(0,6).map(function(item){return item.value+":"+item.score;}).join("|"));
    var pool=scores.slice(0,Math.min(scores.length,5));
    var selected=(pool[seed%pool.length]||scores[0]).value;
    if(selected===backup && pool.length>2)backup=(pool[(seed+1)%pool.length]||scores[1]||scores[0]).value;
    return {value:selected,primary:primary,backup:backup,detail:{poolSize:pool.length,dynamic:true}};
  }
