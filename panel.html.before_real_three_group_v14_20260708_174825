    SHAPES.forEach(function(s){
      var chosen=chooseShapeSet(records(data),s);
      addItem({kind:"shape",key:s.key,side:"recommend",name:s.label+"推荐",code:chosen.value});
      addItem({kind:"shape",key:s.key,side:"main",name:s.label+"主攻",code:chosen.primary});
