      var backup=entry.originalBackupDigit!=null?entry.originalBackupDigit:(entry.backupAlgorithmDigit!=null?entry.backupAlgorithmDigit:(entry.backup!=null?entry.backup:(entry.backupDigit!=null?entry.backupDigit:(entry.killDigits&&entry.killDigits[1]))));
