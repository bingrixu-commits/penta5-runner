      ?practiceHeweiLabelStartIndex(text,startLabel)
      :text.indexOf(startLabel);
    if(start<0)return "";
    var valueStart=start+startLabel.length;
    var end=text.length;
    (endLabels||[]).forEach(function(label){
      var idx;
      if(typeof practiceHeweiLabelStartIndex==="function"){
        idx=practiceHeweiLabelStartIndex(text.slice(valueStart),label);
        if(idx>=0)idx=valueStart+idx;
