      function done(){
        var old=btn.textContent;
        btn.textContent="已复制";
        setTimeout(function(){btn.textContent=old||"复制攻击语";},1200);
      }
      if(navigator.clipboard&&navigator.clipboard.writeText){
        navigator.clipboard.writeText(copyValue).then(done).catch(function(){
          if(copyBox&&copyBox.select){copyBox.focus();copyBox.select();document.execCommand("copy");}
          done();
        });
      }else if(copyBox&&copyBox.select){
        copyBox.focus();copyBox.select();document.execCommand("copy");done();
      }
    });
