<!doctype html>
<html lang="zh-CN">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>五路横财数据分析</title>
<style>
:root{
  --bg:#eef2f7;
  --panel:#fff;
  --ink:#111827;
  --muted:#64748b;
  --line:#e2e8f0;
  --blue:#2563eb;
  --blue-soft:#eff6ff;
  --green:#047857;
  --green-soft:#e8f8ef;
  --red:#b91c1c;
  --red-soft:#fee2e2;
  --shadow:0 1px 5px rgba(0,0,0,.08);
  --shadow-lg:0 10px 28px rgba(15,23,42,.10);
  --radius:14px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:linear-gradient(180deg,#f7fafc 0%,var(--bg) 100%);color:var(--ink);font-family:"Microsoft YaHei","PingFang SC",-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}
.wrap{max-width:1180px;margin:0 auto;padding:0 14px 24px}
.panel-hero{position:sticky;top:0;z-index:120;background:rgba(247,250,252,.92);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);margin:0 -14px 14px;padding:12px 14px 10px;box-shadow:0 4px 18px rgba(15,23,42,.06)}
.panel-hero__head{display:grid;grid-template-columns:minmax(0,1fr) auto minmax(0,1fr);align-items:center;gap:12px}
.panel-hero__brand{min-width:0}
.panel-hero h1{margin:0;font-size:24px;font-weight:900;letter-spacing:.02em}
.panel-hero__center{justify-self:center;align-self:center;text-align:center;min-width:0;padding:2px 0}
.panel-hero__center h1{margin:0;font-size:24px;font-weight:900;letter-spacing:.02em;line-height:1.2;white-space:nowrap}
.panel-hero__center .status{display:inline-block;margin-top:6px;max-width:min(100%,420px)}
.panel-hero__actions{display:flex;align-items:center;justify-content:flex-end;gap:8px;flex-wrap:wrap;justify-self:end}
.panel-hero__actions button{padding:10px 14px;font-size:14px;cursor:pointer;transition:transform .15s ease,box-shadow .15s ease}
.panel-hero__actions button:hover{transform:translateY(-1px);box-shadow:0 6px 16px rgba(37,99,235,.22)}
.panel-hero__actions button:active{transform:translateY(0)}
.topbar-clock{font-size:12px;color:var(--muted);padding:0 4px;white-space:nowrap}
.status{padding:8px 12px;border-radius:999px;background:var(--blue-soft);color:#1d4ed8;font-weight:800;word-break:break-word;font-size:13px;line-height:1.45;max-width:100%}
.status.ok{background:var(--green-soft);color:var(--green)}
.status.err{background:var(--red-soft);color:var(--red)}
.status.loading{position:relative;padding-left:28px}
.status.loading::before{content:"";position:absolute;left:10px;top:50%;width:12px;height:12px;margin-top:-6px;border:2px solid currentColor;border-right-color:transparent;border-radius:50%;animation:panelSpin .8s linear infinite}
.status.is-hidden{display:none}
@keyframes panelSpin{to{transform:rotate(360deg)}}
.summary-grid{display:grid;grid-template-columns:repeat(5,minmax(0,1fr));gap:8px;margin-top:10px}
.summary-card{background:var(--panel);border:1px solid var(--line);border-radius:10px;padding:10px 12px;box-shadow:var(--shadow);min-width:0}
.summary-card b{display:block;font-size:11px;color:var(--muted);font-weight:700;margin-bottom:4px}
.summary-card span{display:block;font-size:16px;font-weight:900;color:var(--ink);white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.section-nav{display:flex;gap:6px;flex-wrap:wrap;margin-top:10px}
.section-nav a{display:inline-flex;align-items:center;padding:6px 11px;border-radius:999px;background:#fff;border:1px solid var(--line);color:#334155;font-size:12px;font-weight:800;text-decoration:none;transition:background .15s ease,border-color .15s ease,color .15s ease}
.section-nav a:hover{background:var(--blue-soft);border-color:#93c5fd;color:#1d4ed8}
.panel-hero__extras{margin-top:0}
.panel-hero__extras.is-collapsed{display:none!important;margin:0!important;padding:0!important;border:0!important}
.panel-hero.is-extras-collapsed{padding-bottom:8px}
.panel-hero__actions .card-toggle{margin:0}
.grid2{display:grid;grid-template-columns:1fr 1fr;gap:12px}
.card{background:var(--panel);border-radius:var(--radius);padding:14px;margin-bottom:12px;box-shadow:var(--shadow);border:1px solid rgba(226,232,240,.9);transition:box-shadow .2s ease}
.card:hover{box-shadow:var(--shadow-lg)}
.card h2{font-size:18px;margin:0 0 12px;padding-bottom:8px;border-bottom:2px solid var(--blue-soft)}
.card-head{display:flex;align-items:center;justify-content:space-between;gap:10px;margin-bottom:12px;padding-bottom:8px;border-bottom:2px solid var(--blue-soft)}
.card-head h2{margin:0;padding:0;border:0}
.card-head-title{min-width:0;flex:1}
.card-head-title h2,.card-head-title b{margin:0;padding:0;border:0;display:block}
.card-head-title .small{margin-top:4px}
.card-toggle{border:1px solid var(--line)!important;background:#fff!important;color:#475569!important;padding:6px 10px!important;font-size:12px!important;font-weight:800!important;border-radius:8px!important;cursor:pointer;flex:0 0 auto}
.card-body.is-collapsed,.nested-collapse>.card-body.is-collapsed,.prediction-section.is-collapsible>.card-body.is-collapsed{display:none!important;max-height:0!important;overflow:hidden!important;margin:0!important;padding:0!important;border:0!important}
.prediction-section.is-collapsible{max-height:none;overflow:visible}
.prediction-section.is-collapsible>.card-head{margin-bottom:8px;padding-bottom:6px;border-bottom:1px solid #cbd5e1}
.prediction-section.is-collapsible>.card-body{max-height:220px;overflow-y:auto}
.nested-collapse{margin-top:10px}
.nested-collapse>.card-head{margin-bottom:8px;padding-bottom:6px;border-bottom:1px solid rgba(15,23,42,.12)}
.table{width:100%;border-collapse:collapse}
.table td{border-bottom:1px solid #edf0f3;padding:11px 8px;vertical-align:middle}
.table td:first-child{background:#f3f4f6;font-weight:700;width:32%}
.ball{display:inline-flex;align-items:center;justify-content:center;width:36px;height:36px;border-radius:50%;margin:3px;background:#e11d48;color:#fff;font-weight:900}
.ball.dark{background:#111827}
.ball.blue{background:#4338ca}
.tag{display:inline-block;background:#eef2ff;border-radius:999px;padding:5px 9px;margin:3px;font-size:13px}
.btns{display:flex;gap:10px;margin-bottom:0;flex-wrap:wrap}
button{border:0;border-radius:10px;background:var(--blue);color:#fff;font-weight:800;padding:12px 14px;font-size:16px}
button.gray{background:#4b5563}
.small{font-size:13px;color:#6b7280;line-height:1.6}
.rate{display:flex;justify-content:space-between;gap:12px;border-bottom:1px solid #eee;padding:9px 0}
.rate span{text-align:right}
.shape-choice{display:flex;flex-direction:column;gap:8px;min-width:0}
.shape-choice__head{display:flex;align-items:baseline;gap:10px;flex-wrap:wrap}
.shape-choice__code{font-weight:800;font-size:20px;color:#0f172a;line-height:1.25;word-break:break-all}
.shape-choice__rate{font-size:13px;color:#475569;white-space:nowrap}
.shape-choice__details{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:8px}
.shape-choice__detail{background:#f8fafc;border:1px solid #e2e8f0;border-radius:8px;padding:7px 9px;min-width:0}
.shape-choice__label{font-size:12px;color:#64748b;line-height:1.3;margin-bottom:3px}
.shape-choice__value{display:block;min-width:0}
.shape-token-list{display:grid;grid-template-columns:repeat(4,max-content);gap:4px;align-items:center;min-width:0}
.shape-token{display:inline-flex;align-items:center;justify-content:center;background:#fff;border:1px solid #cbd5e1;border-radius:6px;min-width:26px;padding:2px 5px;font-size:13px;font-weight:800;line-height:1.25;color:#0f172a;white-space:nowrap}
.shape-choice__percent{display:block;margin-top:5px;font-size:13px;font-weight:800;line-height:1.25;color:#0f172a;white-space:nowrap}
#practiceFireworks{position:fixed;inset:0;z-index:9999;pointer-events:none;overflow:hidden}
#practiceFireworks canvas{position:absolute;inset:0;width:100%;height:100%}
.practice-toast{position:absolute;left:50%;top:18%;transform:translateX(-50%);background:rgba(15,23,42,.94);color:white;border-radius:14px;padding:14px 22px;font-size:22px;font-weight:900;box-shadow:0 14px 38px rgba(15,23,42,.32);white-space:nowrap}
.practice-hit-strong{font-size:16px!important;font-weight:900!important;padding:10px 12px!important;box-shadow:0 8px 22px rgba(22,101,52,.15)}
#predictionPanel{width:100%;box-sizing:border-box;padding:0;overflow:hidden;scroll-margin-top:96px}
.prediction-section{margin:12px 0;padding:12px;border:1px solid #333;border-radius:10px;background:rgba(255,255,255,.72);max-height:260px;overflow-y:auto}
.prediction-title{font-weight:700;margin-bottom:8px}
.prediction-list{display:flex;flex-wrap:wrap;gap:6px;align-items:flex-start;white-space:normal;word-break:break-word}
.prediction-chip{display:inline-flex;align-items:center;justify-content:center;gap:2px;min-width:48px;max-width:none;overflow:visible;padding:4px 10px;border-radius:999px;border:1px solid #555;font-family:monospace;font-size:14px;line-height:1.4;white-space:nowrap;box-sizing:border-box}
.prediction-chip__name{color:#475569;font-weight:600}
.prediction-chip__code{color:#1d4ed8;font-weight:900;letter-spacing:.03em}
.prediction-empty{color:#64748b;font-size:13px;line-height:1.5}
/* 四框架替补号：参考样式，绿色大圈内显示百分比 */
.fw-backup-ref{display:inline-flex;align-items:center;gap:10px;margin:4px 0 0;padding:6px 14px 6px 6px;border-radius:999px;background:#ecfdf5;border:1px solid #86efac;vertical-align:middle;line-height:1.2;box-sizing:border-box;max-width:100%}
.fw-backup-ref__ring{position:relative;width:44px;height:44px;border-radius:50%;flex:0 0 auto;display:inline-flex;align-items:center;justify-content:center;background:conic-gradient(#16a34a calc(var(--p,0)*1%),#dcfce7 0);box-shadow:inset 0 0 0 1px rgba(22,163,74,.22),0 1px 2px rgba(15,23,42,.06)}
.fw-backup-ref__ring::before{content:"";position:absolute;inset:6px;border-radius:50%;background:#ecfdf5;box-shadow:inset 0 0 0 1px #bbf7d0;z-index:0}
.fw-backup-ref__pct{position:relative;z-index:1;font-size:12px;font-weight:900;color:#14532d;white-space:nowrap;letter-spacing:-.02em;line-height:1}
.fw-backup-ref__label{font-size:15px;font-weight:800;color:#334155;white-space:nowrap}
@media(max-width:700px){
  .fw-backup-ref{gap:8px;padding:5px 12px 5px 5px}
  .fw-backup-ref__ring{width:40px;height:40px}
  .fw-backup-ref__ring::before{inset:5px}
  .fw-backup-ref__pct{font-size:11px}
  .fw-backup-ref__label{font-size:14px}
}
.panel-fab{position:fixed;right:18px;bottom:18px;z-index:130;width:44px;height:44px;border-radius:50%;background:#1e293b;color:#fff;font-size:20px;font-weight:900;cursor:pointer;box-shadow:0 10px 24px rgba(15,23,42,.28);opacity:0;pointer-events:none;transform:translateY(8px);transition:opacity .2s ease,transform .2s ease}
.panel-fab.is-visible{opacity:1;pointer-events:auto;transform:translateY(0)}
.storm-banner{display:none;margin:10px 0 0;padding:10px 12px;border-radius:10px;border:1px solid #fecaca;background:#fef2f2;color:#7f1d1d;font-size:13px;font-weight:800;line-height:1.45}
.storm-banner.is-on{display:block}
.tip-ready-banner{display:none;margin:10px 0 0;padding:10px 12px;border-radius:10px;border:1px solid #fde68a;background:#fffbeb;color:#92400e;font-size:13px;font-weight:800;line-height:1.45}
.tip-ready-banner.is-on{display:block}
.tip-ready-banner.is-ok{border-color:#86efac;background:#ecfdf5;color:#14532d}
.section-anchor{scroll-margin-top:96px}
@media(max-width:900px){.summary-grid{grid-template-columns:repeat(2,minmax(0,1fr))}}
@media(max-width:700px){.grid2{grid-template-columns:1fr}.ball{width:34px;height:34px}.rate{display:block}.rate span{text-align:left;display:block;margin-top:4px}.panel-hero__head{grid-template-columns:minmax(0,1fr) auto;gap:8px}.panel-hero__actions{grid-column:2;grid-row:1;justify-self:end}.panel-hero__center{grid-column:1 / -1;grid-row:2;justify-self:center;text-align:center}.panel-hero__center h1,.panel-hero h1{font-size:18px;white-space:normal}.summary-grid{grid-template-columns:1fr 1fr}}
@media(max-width:700px){.shape-choice__details{grid-template-columns:1fr}.shape-choice__code{font-size:18px}}
</style>
</head>
<body>
<div class="wrap">
<div class="panel-hero" id="panelHero">
  <div class="panel-hero__head">
    <div class="panel-hero__brand" aria-hidden="true"></div>
    <div class="panel-hero__center">
      <h1>五路横财数据分析</h1>
      <div id="status" class="status is-hidden">等待同步...</div>
    </div>
    <div class="panel-hero__actions btns">
      <span id="topbarClock" class="topbar-clock"></span>
      <button type="button" class="card-toggle" id="panelHeroExtrasToggle" data-collapse-toggle="panelHeroExtras" data-collapse-default="0" aria-expanded="true" title="收起或展开顶栏摘要与分区按键">收起顶栏</button>
      <button type="button" onclick="loadState()">刷新数据</button>
      <button type="button" class="gray" onclick="manualSync()">手动同步</button>
    </div>
  </div>
  <div class="panel-hero__extras card-body" id="panelHeroExtras" data-collapse-body="panelHeroExtras">
    <div class="summary-grid" id="panelSummary">
      <div class="summary-card"><b>当前期号</b><span id="summaryPeriod">--</span></div>
      <div class="summary-card"><b>开奖号码</b><span id="summaryNumbers">--</span></div>
      <div class="summary-card"><b>预测基准</b><span id="summaryBasePeriod">--</span></div>
      <div class="summary-card"><b>最后同步</b><span id="summarySync">--</span></div>
      <div class="summary-card"><b>共享历史</b><span id="summaryHistory">--</span></div>
    </div>
    <div id="stormBanner" class="storm-banner" role="status" aria-live="polite"></div>
    <div id="tipReadyBanner" class="tip-ready-banner" role="status" aria-live="polite"></div>
    <nav class="section-nav" id="sectionNav" aria-label="页面分区">
      <a href="#practiceModelBox">自有转换靶场</a>
      <a href="#txtConvertBox">二三定回删</a>
      <a href="#section-lottery">开奖数据</a>
      <a href="#section-prediction">四定推荐</a>
      <a href="#section-history">历史记录</a>
      <a href="#section-singlePosition">单位置号码排除</a>
    </nav>
  </div>
</div>

<div class="card section-anchor" id="txtConvertBox">
  <div class="card-head">
    <div class="card-head-title"><h2>二三定回删</h2><div class="small">二定只留千百三档：删20剩80 / 删30剩70 / 删40剩60；三定只留千百十四档：删400剩600 / 删300剩700 / 删200剩800 / 回删100剩900；本机下载 TXT，后台不保存。</div></div>
    <button type="button" class="card-toggle" id="txtConvertToggle" data-collapse-toggle="txtConvert" data-collapse-default="0" aria-expanded="true">收起</button>
  </div>
  <div class="card-body" id="txtConvertBody" data-collapse-body="txtConvert">
  <div class="small" style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;">
    <b>空位格式</b>
    <label style="display:inline-flex;gap:4px;align-items:center;cursor:pointer;"><input type="radio" name="txtBlankFormat" value="x" checked> x格式：32xx / 123x</label>
    <label style="display:inline-flex;gap:4px;align-items:center;cursor:pointer;"><input type="radio" name="txtBlankFormat" value="+"> +格式：32++ / 123+</label>
  </div>
  <div class="small" style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:6px;">
    <b>输出口径</b>
    <span style="color:#64748b;">TXT 文件固定空格；攻击语：二定逗号 / 三定各字封尾</span>
  </div>

  <div id="txtTwoRemainTopBox" class="nested-collapse" style="margin:10px 0 0;border:1px solid #8b5cf6;border-radius:12px;background:#f5f3ff;padding:10px;">
    <div class="card-head" data-collapse-head="txtTwoRemainTop">
      <div class="card-head-title"><b style="font-size:16px;color:#5b21b6;">二定旧码回删（只留千百 · 删20剩80 / 删30剩70 / 删40剩60）</b><div class="small" style="color:#5b21b6;">每档仅一张卡；攻击语逗号；TXT空格；纯回删不加排除码</div></div>
      <button type="button" class="card-toggle" data-collapse-toggle="txtTwoRemainTop" data-collapse-default="1" aria-expanded="false">展开</button>
    </div>
    <div class="card-body is-collapsed" data-collapse-body="txtTwoRemainTop">
      <div id="txtTwoFrameworkInfo" class="small">等待远程数据...</div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;">
        <button type="button" data-txt-position-generate="two" style="border:0;border-radius:7px;padding:7px 10px;background:#7c3aed;color:white;font-weight:800;cursor:pointer;font-size:13px;">一键生成所有二定TXT</button>
        <button type="button" data-txt-position-recommend="2" style="border:0;border-radius:7px;padding:7px 10px;background:#7c3aed;color:white;font-weight:800;cursor:pointer;font-size:13px;">生成推荐二定TXT</button>
        <button type="button" data-txt-position-copy="two" style="border:0;border-radius:7px;padding:7px 10px;background:#334155;color:white;font-weight:800;cursor:pointer;font-size:13px;">复制二定攻击语</button>
        <button type="button" data-txt-position-download="two" style="border:0;border-radius:7px;padding:7px 10px;background:#2563eb;color:white;font-weight:800;cursor:pointer;font-size:13px;">下载二定TXT</button>
      </div>
      <textarea id="txtTwoFrameworkOutput" readonly style="width:100%;min-height:58px;box-sizing:border-box;border:1px solid #a78bfa;border-radius:8px;padding:8px;background:white;font-size:13px;margin-top:8px;" placeholder="二定TXT（空格分隔）"></textarea>
      <div id="section-singlePosition" class="section-anchor" style="margin-top:8px;">
        <div id="txtTwoRemainContent" class="small"></div>
        <div id="txtTwoModelBox" class="small" style="margin-top:8px;"></div>
      </div>
    </div>
  </div>
  <div id="txtThreeRemainTopBox" class="nested-collapse" style="margin:10px 0 0;border:1px solid #f97316;border-radius:12px;background:#fff7ed;padding:10px;">
    <div class="card-head" data-collapse-head="txtThreeRemainTop">
      <div class="card-head-title"><b style="font-size:16px;color:#9a3412;">三定旧码回删（只留千百十 · 删400剩600 / 删300剩700 / 删200剩800 / 回删100剩900）</b><div class="small" style="color:#9a3412;">每档仅一张卡；真实旧号回删；攻击语各字封尾；TXT空格</div></div>
      <button type="button" class="card-toggle" data-collapse-toggle="txtThreeRemainTop" data-collapse-default="1" aria-expanded="false">展开</button>
    </div>
    <div class="card-body is-collapsed" data-collapse-body="txtThreeRemainTop">
      <div id="txtThreeFrameworkInfo" class="small">等待远程数据...</div>
      <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px;">
        <button type="button" data-txt-position-generate="three" style="border:0;border-radius:7px;padding:7px 10px;background:#ea580c;color:white;font-weight:800;cursor:pointer;font-size:13px;">一键生成所有三定TXT</button>
        <button type="button" data-txt-position-recommend="3" style="border:0;border-radius:7px;padding:7px 10px;background:#ea580c;color:white;font-weight:800;cursor:pointer;font-size:13px;">生成推荐三定TXT</button>
        <button type="button" data-txt-position-copy="three" style="border:0;border-radius:7px;padding:7px 10px;background:#334155;color:white;font-weight:800;cursor:pointer;font-size:13px;">复制三定攻击语</button>
        <button type="button" data-txt-position-download="three" style="border:0;border-radius:7px;padding:7px 10px;background:#2563eb;color:white;font-weight:800;cursor:pointer;font-size:13px;">下载三定TXT</button>
      </div>
      <textarea id="txtThreeFrameworkOutput" readonly style="width:100%;min-height:58px;box-sizing:border-box;border:1px solid #fb923c;border-radius:8px;padding:8px;background:white;font-size:13px;margin-top:8px;" placeholder="三定TXT（空格分隔）"></textarea>
      <div id="txtThreeRemainContent" class="small" style="margin-top:8px;"></div>
      <div id="txtThreeModelBox" class="small" style="margin-top:8px;"></div>
    </div>
  </div>
  <div id="txtConvertStatus" class="small" style="margin-top:8px;"></div>
  <textarea id="txtPreview" data-role="txt-target" readonly aria-hidden="true" style="position:absolute;left:-9999px;width:1px;height:1px;opacity:0;"></textarea>
  </div>
</div>

<div class="grid2 section-anchor" id="section-lottery">
  <div class="card">
    <h2>最新开奖数据</h2>
    <table class="table">
      <tr><td>期号</td><td id="period">--</td></tr>
      <tr><td>开奖时间</td><td id="opentime">--</td></tr>
      <tr><td>开奖号码</td><td id="numbers">--</td></tr>
      <tr><td>三对数排除</td><td id="threeDuishuCode">--</td></tr>
      <tr><td>总合尾</td><td id="totalHewei">--</td></tr>
      <tr><td>综合合尾</td><td id="subHewei">--</td></tr>
    </table>
    <div class="small" id="meta"></div>
  </div>

  <div class="card">
    <div class="card-head">
