  function practiceScriptThreeDingIndexes(text){
    var raw=String(text||"");
    if(raw.indexOf("三定")<0)return null;
    var order={千:0,百:1,十:2,个:3};
    var cut=raw.indexOf("三定");
    var head=cut>=0?raw.slice(0,cut):raw;
    var indexes=[],match,regex=/(千|百|十|个)(\d+)/g;
    while((match=regex.exec(head))){
      var index=order[match[1]];
      if(index===undefined||indexes.indexOf(index)>=0)continue;
      indexes.push(index);
    }
    return indexes.length===3?indexes.sort(function(a,b){return a-b;}):null;
  }
  function practiceScriptEvaluationResults(standardValue,row){
    var text=String(standardValue||"").replace(/\s+/g,"");
    var actual=practiceActualForRow(row);
    var ev=row&&row.evaluation||{};
