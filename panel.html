  snapshot.evaluated=true;
  snapshot.resultPeriod=String(row.period||row.uid||snapshot.targetPeriod||"");
  snapshot.actualCode=actual;
  snapshot.success=!!(actual&&txtAuditBitmapHas(snapshot,actual));
  snapshot.evaluatedAt=new Date().toISOString();
