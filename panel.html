      if(value&&typeof value==="object")return JSON.stringify(value);
      return String(value==null?"":value);
    });
  }else{
    raw=[String(items)];
  }
  const cleaned=raw.map(function(item){
    if(item===null||item===undefined)return "";
    if(typeof item==="object")return item.code||item.value||item.text||item.name||JSON.stringify(item);
    return String(item);
  }).join(" ").replace(/各+/g,",").split(/[\s,，、|;\n\r\t]+/).map(function(item){
    return String(item).trim();
  }).map(function(item){
    return item.replace(/^各+/,"")
      .replace(/各+$/,"");
  }).map(function(item){
    return item.replace(/^[，,、|;]+|[，,、|;]+$/g,"");
  }).map(function(item){
