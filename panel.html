      var recommend=entry.recommendDigit!=null?entry.recommendDigit:(entry.selectedDigit!=null?entry.selectedDigit:(entry.main!=null?entry.main:(entry.killDigits&&entry.killDigits[0])));
      var main=entry.primaryDigit!=null?entry.primaryDigit:(entry.mainAlgorithmDigit!=null?entry.mainAlgorithmDigit:(entry.mainDigit!=null?entry.mainDigit:entry.main));
