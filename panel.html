function txtAuditFindRow(data,period){
  data=data||{};
  var target=String(period||"");
  if(!target)return null;
  var rows=[];
  if(data.latestRecord)rows.push(data.latestRecord);
  if(Array.isArray(data.history))rows=rows.concat(data.history);
  for(var i=0;i<rows.length;i++){
    var row=rows[i]||{};
    if(String(row.period||"")===target||String(row.uid||"").indexOf(target)>=0)return row;
  }
  return null;
