function formatTxtDigits(value){
  var digits=[];
  function collect(input,limit){
    if(input===null||input===undefined)return;
    if(Array.isArray(input)){
      var max=limit!=null?limit:input.length;
      for(var ai=0;ai<input.length&&ai<max;ai++)collect(input[ai],1);
      return;
    }
    if(typeof input==="object"){
      // 定位正式排除优先取 killDigits 两个号；替补号不另加第三码
      var preferred=["killDigits","digits","recommendDigit","selectedDigit","main","killDigit","value","code"];
      for(var i=0;i<preferred.length;i++){
        var key=preferred[i];
        if(!Object.prototype.hasOwnProperty.call(input,key))continue;
        var before=digits.length;
        collect(input[key],key==="killDigits"||key==="digits"?2:null);
        if(digits.length>before)return;
      }
      return;
    }
    if(typeof input==="number"&&!isFinite(input))return;
    var text=String(input).trim();
    if(!text||/^(?:undefined|null|NaN)$/i.test(text))return;
    var colonIndex=Math.max(text.lastIndexOf("："),text.lastIndexOf(":"));
    if(colonIndex>=0)text=text.slice(colonIndex+1);
    text=text.replace(/各+/g,",");
    var found=text.match(/[0-9]/g)||[];
    found.forEach(function(digit){
      if(digits.indexOf(digit)<0)digits.push(digit);
    });
  }
  collect(value);
  if(!digits.length)return "";
  // 正式定位杀码：最多两个排除号 → 例如 3,7各
  return digits.slice(0,2).join(",")+"各";
}
function positionFormalKillDigits(entry){
  entry=entry||{};
  var out=[];
  function pushDigit(value){
    var digit=String(value==null?"":value).replace(/\D/g,"").charAt(0);
    if(digit&&out.indexOf(digit)<0)out.push(digit);
  }
  if(Array.isArray(entry.killDigits)&&entry.killDigits.length){
    entry.killDigits.forEach(pushDigit);
  }else{
    pushDigit(entry.recommendDigit!=null?entry.recommendDigit:(entry.selectedDigit!=null?entry.selectedDigit:(entry.main!=null?entry.main:entry.killDigit)));
    pushDigit(entry.primaryDigit!=null?entry.primaryDigit:(entry.mainAlgorithmDigit!=null?entry.mainAlgorithmDigit:entry.mainDigit));
    if(out.length<2)pushDigit(entry.originalBackupDigit!=null?entry.originalBackupDigit:(entry.backupAlgorithmDigit!=null?entry.backupAlgorithmDigit:(entry.backup!=null?entry.backup:entry.backupDigit)));
  }
  return out.slice(0,2);
}
function singleModelBackupDigit(entry){
  entry=entry||{};
  if(typeof txtPositionBackupDigitFromEntry==="function"){
    return txtPositionBackupDigitFromEntry(entry);
  }
  var digit=entry.originalBackupDigit!=null?entry.originalBackupDigit
    :(entry.backupAlgorithmDigit!=null?entry.backupAlgorithmDigit
    :(entry.backup!=null?entry.backup
    :(entry.backupDigit!=null?entry.backupDigit
    :(entry.killDigits&&entry.killDigits[1]))));
  return String(digit==null?"":digit).replace(/\D/g,"").charAt(0)||"";
}
function singleBackupRefHtml(digit,ratePct){
  var raw=String(digit==null?"":digit).trim();
  if(!raw||raw==="--")return "";
  var num=raw.replace(/\D/g,"").charAt(0);
  var shape=raw.replace(/[^大小单双]/g,"").charAt(0);
  digit=num||shape||raw.charAt(0);
  if(!digit)return "";
  var p=ratePct!=null&&isFinite(Number(ratePct))?Math.max(0,Math.min(100,Number(ratePct))):0;
  var rateText=Math.round(p)+"%";
  return '<span class="fw-backup-ref" style="--p:'+esc(Number(p).toFixed(2))+'" title="替补号仅供参考；正式杀码仍是两个排除号">'
    +'<span class="fw-backup-ref__ring" aria-hidden="true"><span class="fw-backup-ref__pct">'+esc(rateText)+'</span></span>'
    +'<span class="fw-backup-ref__label">替补号 '+esc(digit)+'</span>'
    +'</span>';
}
function positionBackupRatePct(data,posKey){
  var counters=(data&&data.counters)||{};
  var stats=counters["position."+posKey+".backup"];
  if(stats&&Number(stats.total)>0&&isFinite(Number(stats.match))){
    var rate=stats.rate!=null&&isFinite(Number(stats.rate))?Number(stats.rate):(Number(stats.match)*100/Number(stats.total));
    if(isFinite(rate))return Math.max(0,Math.min(100,rate));
  }
  return 0;
}
function formatOutputWithGe(items){
  // 统一口径：组间英文逗号，整串末尾只封一个「各」→ 00xx,65xx各
  var source=Array.isArray(items)?items:[items];
  var tokens=[];
  source.flat(Infinity).forEach(function(item){
    if(item===null||item===undefined)return;
    var value=typeof item==="object"
      ?(item.code||item.value||item.text||item.name||"")
      :String(item);
    String(value).replace(/各+/g,",").split(/[\s，,、|;\n\r\t]+/).forEach(function(token){
      token=String(token||"").trim().replace(/^各+|各+$/g,"");
      if(token&&tokens.indexOf(token)<0)tokens.push(token);
    });
  });
  return tokens.length?tokens.join(",")+"各":"";
}
function formatPositionExcludeText(items){
  const body=(Array.isArray(items)?items.slice():[]).sort(function(a,b){
    return Number(a&&a.index!=null?a.index:999)-Number(b&&b.index!=null?b.index:999);
  }).slice(0,5).map(function(item){
