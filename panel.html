      if(!samePracticeCode(main,recommend)){
        addItem({kind:kind,key:key,stateKey:stateKey,side:"main",name:label+"主攻",code:String(main)});
      }
      if(!samePracticeCode(backup,recommend)&&!samePracticeCode(backup,main)){
