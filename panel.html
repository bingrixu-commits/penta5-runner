  function buildPracticeModel(base,top,options){
    var text=String(base||"").replace(/\s+/g,"");
    text=stripPracticeSeedSegments(text);
    var list=Array.isArray(top)?top:[];
    var positionMap=[
      {start:"千",end:["百"],key:"wan"},
      {start:"百",end:["十"],key:"qian"},
      {start:"十",end:["个"],key:"bai"},
      {start:"个",end:["四定","千百十个合","除"],key:"shi"}
    ];
    positionMap.forEach(function(cfg){text=removeCodesFromSegment(text,cfg.start,cfg.end,selectedCodes(list,"position",cfg.key));});
    function uniqueCodes(){
      var out=[],seen={};
      Array.prototype.slice.call(arguments).forEach(function(arr){
        (arr||[]).forEach(function(code){
          code=String(code);
          if(code&&!seen[code]){seen[code]=true;out.push(code);}
        });
      });
      return out;
    }
    function removeFromPool(codes){
      var value="1234567890";
      (codes||[]).forEach(function(code){value=value.split(String(code)).join("");});
      return value;
    }
    function ensureHeweiSegment(label,endLabels,codes){
      codes=uniqueCodes(codes).map(function(code){
        return String(code==null?"":code).replace(/\D/g,"").charAt(0);
      }).filter(function(code){return /^\d$/.test(code);});
      if(!codes.length)return;
      if(practiceHeweiLabelStartIndex(text,label)<0)text+=label+removeFromPool(codes);
      text=removeCodesFromSegment(text,label,endLabels,codes);
    }
    var unifiedHeweiCodes=selectedCodes(list,"hewei","unified");
    function independentOrUnifiedHewei(codes){
      codes=uniqueCodes(codes);
      return codes.length?codes:unifiedHeweiCodes;
    }
    ensureHeweiSegment("千百十合",["百十个合","千百十个合","除"],independentOrUnifiedHewei(selectedCodes(list,"hewei","wanQianBai")));
    ensureHeweiSegment("百十个合",["千百十个合","除"],independentOrUnifiedHewei(selectedCodes(list,"hewei","qianBaiShi")));
    ensureHeweiSegment("千百十个合",["除"],independentOrUnifiedHewei(uniqueCodes(selectedCodes(list,"hewei","total"),selectedCodes(list,"hewei","wanQianBaiShi"))));

    text=text.replace(/四定除值\d+/g,"四定");
    text=text.replace(/四定\d+/g,"四定");
    text=text.replace(/除对数\d{2,3}(?:-\d{2,3})*/g,"");
    text=text.replace(/含对数\d{2,3}/g,"");
    text=text.replace(/中对数\d{2,3}/g,"");
    text=text.replace(/二数合\d+/g,"");
    text=text.replace(/三数合\d+/g,"");
    text=text.replace(/除(?:和值|值)\d+(?:到|至|-)\d+/g,"");
    text=text.replace(/除和值\d+/g,"");
    text=text.replace(/除值\d+/g,"");
    text=text.replace(/除(?:跨度|跨)\d/g,"");
    text=text.replace(/除(?:重号|一对|双重|三重|四重)/g,"");
    text=text.replace(/除(?:连号|二连|三连|四连)/g,"");
    text=text.replace(/除(?:奇偶比)?[0-4]单[0-4]双/g,"");
    text=text.replace(/除(?:大小比)?[0-4]大[0-4]小/g,"");
    text=text.replace(/除(?:旧码|重复码|历史码)(?:300|500|800|1000|1300|最大|全部|MAX)/gi,"");
    text=text.replace(/除[大小单双]{4}/g,"");

    var tokens=[];
    var seen={};
    function pushToken(token){
      token=String(token||"");
      if(!token||seen[token])return;
      seen[token]=true;
      tokens.push(token);
    }
    list.forEach(function(item){
      if(!item||!item.code)return;
      // 替补号绝不并进杀码/攻击语 token；绿色参考另处展示
      if(item.side==="backup")return;
      var key="";
      var token="";
      if(item.kind==="extra"&&item.key==="sumAvoid"){
        key="extra.sumAvoid";
        token="除值"+item.code;
      }else if(item.kind==="extra"&&item.key==="sumRangeAvoid"){
        key="extra.sumRangeAvoid";
        token="除值"+item.code;
      }else if(item.kind==="extra"&&item.key==="spanAvoid"){
        key="extra.spanAvoid";
        token="除跨度"+item.code;
      }else if(item.kind==="extra"&&item.key==="repeatAvoid"){
        key="extra.repeatAvoid";
        token="除"+item.code;
      }else if(item.kind==="extra"&&item.key==="consecutiveAvoid"){
        key="extra.consecutiveAvoid";
        token="除"+item.code;
      }else if(item.kind==="extra"&&item.key==="parityRatioAvoid"){
        key="extra.parityRatioAvoid";
        token="除奇偶比"+item.code;
      }else if(item.kind==="extra"&&item.key==="sizeRatioAvoid"){
        key="extra.sizeRatioAvoid";
        token="除大小比"+item.code;
      }else if(item.kind==="extra"&&/^recentExactCodeAvoid(?:\d+|Max)$/.test(String(item.key||""))){
        key="extra."+item.key;
        token="除旧码"+recentExactCodeWindowValueFromKey(item.key,item.code);
      }else if(item.kind==="extra"&&item.key==="threeDigitAvoid"){
        key="extra.threeDigitAvoid";
        token="除对数"+item.code;
      }else if(item.kind==="extra"&&(item.key==="twoDigitAvoid"||item.key==="twoDigitAvoid2"||item.key==="twoDigitAvoid3")){
        key="extra."+item.key;
        token="除对数"+item.code;
      }else if(item.kind==="extra"&&item.key==="twoDigitHit"){
        key="extra.twoDigitHit";
        token="除对数"+item.code;
      }else if(item.kind==="extra"&&item.key==="threeDigitHit"){
        key="extra.threeDigitHit";
        token="含对数"+item.code;
      }else if(item.kind==="extra"&&item.key==="anyTwoHeweiHit"){
        key="extra.anyTwoHeweiHit";
        token="二数合"+item.code;
      }else if(item.kind==="extra"&&item.key==="anyThreeHeweiHit"){
        key="extra.anyThreeHeweiHit";
        token="三数合"+item.code;
      }else if(item.kind==="brotherNumber"){
        // 固定取二兄弟：攻击语只写「取二兄弟」，永不输出「否」
        key="brotherNumber.有";
        token="取二兄弟";
      }else if(item.kind==="threeDuishu"){
        key="threeDuishu."+String(item.code||"");
        var pairCodes=threeDuishuPairTokens(item);
        // 三对数必须拆对子写入：除对数16除对数38除对数49，禁止只写除对数689
        pairCodes.forEach(function(pair){pushToken("除对数"+pair);});
        token="";
      }else if(item.kind==="shape"){
        var shapeCode=forceThreeWithOneShape(item.code,item.key);
        if(!/^[大小单双]{4}$/.test(shapeCode))return;
        key="shape."+(item.key||"")+"."+shapeCode;
        token="除"+shapeCode;
      }else if(item.kind==="derivedReverseShape"){
        var reverseShapeKey=item.shapeKey||(item.key==="reverseSize"?"shapeSize":"shapeParity");
        var reverseShapeCode=forceThreeWithOneShape(item.code,reverseShapeKey);
        if(!/^[大小单双]{4}$/.test(reverseShapeCode))return;
        key="derivedReverseShape."+(item.key||"")+"."+reverseShapeCode;
        token="除"+reverseShapeCode;
      }else if(item.kind!=="position"&&item.kind!=="hewei"){
        key="other."+practiceItemId(item)+"."+item.code;
        token="除"+item.code;
      }
      if(token&&!seen[key])pushToken(token);
    });

    var generated=(text+tokens.join("")).replace(/\s+/g,"").trim();
    // 各字封尾：整串末尾只保留一个「各」（与 TXT 各字封尾口径一致）
    return ensurePracticeShotGeTail(generated);
  }
  function ensurePracticeShotGeTail(text){
    text=String(text||"").replace(/\s+/g,"").replace(/各+$/,"");
    if(!text||/^等待/.test(text))return String(text||"");
    return text+"各";
