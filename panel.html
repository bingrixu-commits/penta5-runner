  function positionColdCodeStats(data,index){
    var sourceRows=Array.isArray(data&&data.history)?data.history:(Array.isArray(data&&data.records)?data.records:[]);
    var rows=sourceRows.slice(0,COLD_HOT_WINDOW);
    var counts={};
    for(var d=0;d<=9;d++)counts[String(d)]=0;
    var total=0;
    rows.forEach(function(row){
      var nums=Array.isArray(row&&row.numbers)?row.numbers:[];
      if(nums[index]===undefined||nums[index]===null)return;
      var digit=String(nums[index]);
      if(!/^\d$/.test(digit))return;
      counts[digit]+=1;
      total+=1;
    });
    if(!total)return {total:0,cold:[],hot:[],min:null,max:null,counts:counts};
    var cold=[],hot=[],min=Infinity,max=-Infinity;
    Object.keys(counts).sort().forEach(function(digit){
      var n=counts[digit];
      if(n<min){min=n;cold=[digit];}
      else if(n===min)cold.push(digit);
      if(n>max){max=n;hot=[digit];}
      else if(n===max)hot.push(digit);
    });
    return {total:total,cold:cold,hot:hot,min:min,max:max,counts:counts};
  }
