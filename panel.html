    try{
      if(!control)return false;
      control.focus();
      control.select();
      return document.execCommand("copy")===true;
    }catch(error){
      return false;
    }
  }
  if(navigator.clipboard&&navigator.clipboard.writeText){
    return navigator.clipboard.writeText(text).then(function(){
      copyButtonStatus(button,true);
      return true;
    }).catch(function(){
      var ok=fallback();
