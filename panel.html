function txtAuditRender(data){
  var current=$("txtAuditCurrent"),history=$("txtAuditHistory");
  if(!current&&!history)return;
  var list=txtAuditLoad().map(function(item){return txtAuditEvaluateSnapshot(item,data||{});});
  txtAuditSaveList(list);
  if(!list.length){
    if(current)current.textContent="生成TXT后自动记录快照。";
    if(history)history.replaceChildren();
    return;
  }
  if(current)setHtml(current,txtAuditLine(list[0]));
  if(history)setHtml(history,list.slice(1,4).map(txtAuditLine).join(""));
}
