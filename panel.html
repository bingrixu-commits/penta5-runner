  var actual=snapshot.evaluated?(" ｜ 开奖码 "+txtEsc(snapshot.actualCode||"--")):"";
  var bad=snapshot.validationOk?"":(" ｜ 重复 "+txtEsc(snapshot.duplicateCount||0)+" ｜ 非法 "+txtEsc((snapshot.illegal||[]).join(" ")||0));
