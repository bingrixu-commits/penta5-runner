    if(item&&item.kind==="position"){
      var pos=positionByKey(item.stateKey||item.key);
      if(pos)key="position."+pos.stateKey+".backup";
    }else if(item&&item.kind==="hewei"){
      if(item.key==="unified"||item.key==="threeFour")key="hewei.unified.backup";
      else if(item.key==="total")key="hewei.total.backup";
      else if(item.key)key="hewei."+item.key+".backup";
    }
    var stats=key?counters[key]:null;
    if(validStoredStats(stats)){
      var rate=storedStatsRate(stats);
      if(rate!==null&&isFinite(rate))return Math.max(0,Math.min(100,rate));
