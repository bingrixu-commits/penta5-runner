  function normalizeRealStreakStats(day,stats){
    if(!stats||typeof stats!=="object")return null;
    var cleanDay=stats.day||day||todayKeyForData(state||{});
    if(!cleanDay)return null;
    if(stats.day&&String(stats.day)!==String(cleanDay))return null;
    var total=Number(stats.total||0);
    var hit=Number(stats.hit||0);
    if(!isFinite(total)||!isFinite(hit)||total<0||hit<0||hit>total)return null;
    var lastPeriod=String(stats.lastPeriod||"");
    if(lastPeriod&&!streakPeriodMatchesDay(cleanDay,lastPeriod))return null;
    var rate=stats.rate!==undefined&&stats.rate!==null&&isFinite(Number(stats.rate))?Number(stats.rate):(total?hit*100/total:null);
    return {
      day:cleanDay,
      total:total,
      hit:hit,
      rate:rate,
      currentWin:Number(stats.currentWin||0),
      currentMiss:Number(stats.currentMiss||0),
      maxWin:Number(stats.maxWin||0),
      maxMiss:Number(stats.maxMiss||0),
      lastPeriod:lastPeriod,
      source:stats.source||"real"
    };
  }
  function chooseRealStreakStats(day,sources){
    var valid=(sources||[]).map(function(source){return normalizeRealStreakStats(day,source);}).filter(Boolean);
    if(!valid.length)return {day:day,total:0,hit:0,rate:null,currentWin:0,currentMiss:0,maxWin:0,maxMiss:0,lastPeriod:"",source:"none"};
    valid.sort(function(a,b){
      var ap=String(a.lastPeriod||""),bp=String(b.lastPeriod||"");
      if(ap!==bp)return bp.localeCompare(ap);
      if(Number(a.total||0)!==Number(b.total||0))return Number(b.total||0)-Number(a.total||0);
      return String(a.source||"").localeCompare(String(b.source||""));
    });
    var best=valid[0];
    // 峰值取所有可信来源的上确界，防止刷新/重算把今日最高连中/连败往回掉
    var maxWin=0,maxMiss=0;
    valid.forEach(function(item){
      if(Number(item.maxWin||0)>maxWin)maxWin=Number(item.maxWin||0);
      if(Number(item.maxMiss||0)>maxMiss)maxMiss=Number(item.maxMiss||0);
    });
    return {
      day:best.day||day,
      total:Number(best.total||0),
      hit:Number(best.hit||0),
      rate:best.rate,
      currentWin:Number(best.currentWin||0),
      currentMiss:Number(best.currentMiss||0),
      maxWin:maxWin,
      maxMiss:maxMiss,
      lastPeriod:String(best.lastPeriod||""),
      source:best.source||"real"
    };
  }
