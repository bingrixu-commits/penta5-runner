    if(!actual.length)return results;
    function add(name,code,success){
      if(typeof success==="boolean")results.push({item:{name:name,code:code,kind:"script"},success:success});
    }
    var threeDingPosEnds=["三定","四定","千百十合","百十个合","千百十个合","二数合","三数合","取二兄弟","兄弟号","除","含","中","各"];
    [
      {label:"千",end:["百","十","个"].concat(threeDingPosEnds),index:0,name:"千位脚本"},
      {label:"百",end:["十","个"].concat(threeDingPosEnds),index:1,name:"百位脚本"},
      {label:"十",end:["个"].concat(threeDingPosEnds),index:2,name:"十位脚本"},
      {label:"个",end:threeDingPosEnds,index:3,name:"个位脚本"}
    ].forEach(function(cfg){
      var digits=practiceDigitsFromText(practiceScriptSegment(text,cfg.label,cfg.end));
      if(digits.length>0&&digits.length<10)add(cfg.name,digits.join(""),digits.indexOf(String(actual[cfg.index]))>=0);
    });
    var group=Array.isArray(ev.actualCompositeHeweiGroup)?ev.actualCompositeHeweiGroup.map(String):[];
    var scriptTailEnds=["二数合","三数合","取二兄弟","兄弟号","除","含","中","各"];
    [
      {label:"千百十合",end:["百十个合","千百十个合"].concat(scriptTailEnds),index:0,name:"千百十合脚本"},
      {label:"百十个合",end:["千百十个合"].concat(scriptTailEnds),index:1,name:"百十个合脚本"},
      {label:"千百十个合",end:scriptTailEnds,index:2,name:"千百十个合脚本"}
    ].forEach(function(cfg){
      var digits=practiceDigitsFromText(practiceScriptSegment(text,cfg.label,cfg.end));
      if(group.length>=3&&digits.length>0&&digits.length<10)add(cfg.name,digits.join(""),digits.indexOf(String(group[cfg.index]))>=0);
    });
    function scriptHeweiCombinationTailMask(numbers,size){
      var values=(numbers||[]).map(Number);
      var need=Math.max(1,Number(size||1));
      if(values.length<need||values.some(function(n){return !Number.isFinite(n);}))return 0;
      var mask=0;
      function walk(start,picked,sum){
        if(picked===need){mask|=(1<<(Math.abs(sum)%10));return;}
        for(var i=start;i<values.length;i++)walk(i+1,picked+1,sum+values[i]);
      }
      walk(0,0,0);
      return mask;
    }
    var threeDingIndexes=practiceScriptThreeDingIndexes(text);
    var heweiActual=threeDingIndexes
      ? threeDingIndexes.map(function(index){return actual[index];}).filter(function(digit){return digit!==undefined&&digit!==null&&digit!=="";})
      : actual;
    function scriptHeweiCombinationHit(code,size,minMatched){
      var selected=practiceDigitsFromText(code);
      var required=Math.max(1,Number(minMatched||1));
      if(selected.length<required)return null;
      var tailMask=scriptHeweiCombinationTailMask(heweiActual,size);
      if(!tailMask)return null;
      var matched=0;
      for(var i=0;i<selected.length;i++){
        var digit=Number(String(selected[i]));
        if(Number.isFinite(digit)&&digit>=0&&digit<=9&&(tailMask&(1<<digit)))matched+=1;
      }
      return matched>=required;
    }
    var twoHeweiRegex=/二数合(\d+)/g,twoHeweiMatch;
    while((twoHeweiMatch=twoHeweiRegex.exec(text))){
      add("二数合脚本",twoHeweiMatch[1],scriptHeweiCombinationHit(twoHeweiMatch[1],2,1));
    }
    var threeHeweiRegex=/三数合(\d+)/g,threeHeweiMatch;
    while((threeHeweiMatch=threeHeweiRegex.exec(text))){
      add("三数合脚本",threeHeweiMatch[1],scriptHeweiCombinationHit(threeHeweiMatch[1],3,1));
    }
    var sumMatch=text.match(/除(?:和值|值)(\d+)(?![\d到至-])/);
    if(sumMatch){
      var actualSum=actual.reduce(function(total,digit){return total+Number(digit||0);},0);
      add("除值脚本",sumMatch[1],String(actualSum)!==String(sumMatch[1]));
    }
    var sumRangeRegex=/除(?:和值|值)(\d+)(?:到|至|-)(\d+)/g,sumRangeMatch;
    while((sumRangeMatch=sumRangeRegex.exec(text))){
      var range=txtRangeObject(sumRangeMatch[1]+"-"+sumRangeMatch[2]);
      var rangeActualSum=actual.reduce(function(total,digit){return total+Number(digit||0);},0);
      add("和值区间脚本",range?range.code:(sumRangeMatch[1]+"-"+sumRangeMatch[2]),range?!(rangeActualSum>=range.start&&rangeActualSum<=range.end):null);
    }
    var spanRegex=/除(?:跨度|跨)([0-9])/g,spanMatch;
    while((spanMatch=spanRegex.exec(text))){
      add("跨度脚本",spanMatch[1],String(txtShotCodeSpan(actual.join("")))!==String(spanMatch[1]));
    }
    var repeatRegex=/除(重号|一对|双重|三重|四重)/g,repeatMatch;
    while((repeatMatch=repeatRegex.exec(text))){
      var repeatCode=repeatMatch[1];
      var repeatOk=repeatCode==="重号"?!txtShotCodeHasRepeat(actual.join("")):txtShotCodeRepeatShape(actual.join(""))!==repeatCode;
      add("重号结构脚本",repeatCode,repeatOk);
    }
    var consecutiveRegex=/除(连号|二连|三连|四连)/g,consecutiveMatch;
    while((consecutiveMatch=consecutiveRegex.exec(text))){
      var consecutiveCode=consecutiveMatch[1];
      var consecutiveOk=consecutiveCode==="连号"?!txtShotCodeHasConsecutive(actual.join("")):txtShotCodeConsecutiveShape(actual.join(""))!==consecutiveCode;
      add("连号结构脚本",consecutiveCode,consecutiveOk);
    }
    var parityRatioRegex=/除(?:奇偶比)?([0-4]单[0-4]双)/g,parityRatioMatch;
    while((parityRatioMatch=parityRatioRegex.exec(text))){
      add("奇偶比脚本",parityRatioMatch[1],txtShotCodeParityRatio(actual.join(""))!==parityRatioMatch[1]);
    }
    var sizeRatioRegex=/除(?:大小比)?([0-4]大[0-4]小)/g,sizeRatioMatch;
    while((sizeRatioMatch=sizeRatioRegex.exec(text))){
      add("大小比脚本",sizeRatioMatch[1],txtShotCodeSizeRatio(actual.join(""))!==sizeRatioMatch[1]);
    }
    var oldCodeRegex=/除(?:旧码|重复码|历史码)(300|500|800|1000|1300|最大|全部|MAX)/gi,oldCodeMatch;
    while((oldCodeMatch=oldCodeRegex.exec(text))){
      var oldWindow=recentExactCodeWindowIsMax(oldCodeMatch[1])?"最大":oldCodeMatch[1];
      add("旧码脚本",oldWindow,txtRecentExactCodeList(oldWindow).indexOf(actual.join(""))<0);
    }
    var duishuRegex=/除对数(\d{2,3}(?:-\d{2,3})*)/g,duishuMatch;
    while((duishuMatch=duishuRegex.exec(text))){
      var actualText=actual.join("");
      var parts=String(duishuMatch[1]||"").split("-").filter(Boolean);
      var appeared=parts.some(function(part){
        return String(part).split("").every(function(digit){return actualText.indexOf(String(digit))>=0;});
      });
      add("除对数脚本",duishuMatch[1],!appeared);
    }
    var hitRegex=/(?:含对数|中对数)(\d{2,3})/g,hitMatch;
    while((hitMatch=hitRegex.exec(text))){
      var hitActualText=actual.join("");
      var hitAppeared=String(hitMatch[1]||"").split("").every(function(digit){return hitActualText.indexOf(String(digit))>=0;});
      add("含对数脚本",hitMatch[1],hitAppeared);
    }
    var brotherRegex=/(?:取二兄弟|兄弟号)(有|否)?/g,brotherMatch;
    while((brotherMatch=brotherRegex.exec(text))){
      var brotherActual=brotherNumberResultFromCode(actual.join(""));
      var brotherChoice=brotherMatch[1]||"有";
      add("取二兄弟脚本",brotherChoice,brotherActual===brotherChoice);
    }
    var shapeRegex=/除([大小单双]{4})/g,shapeMatch;
    while((shapeMatch=shapeRegex.exec(text))){
      var code=shapeMatch[1];
      add("形态脚本",code,!txtShotCodeMatchesShape(actual.join(""),code));
    }
    return results;
  }
  function practiceStrictItemSuccess(data,item,row){
    if(!item||!row||item.code==null||String(item.code)==="--")return null;
    var ev=row&&row.evaluation||{};
    var actual=(Array.isArray(ev.actualNumbers)&&ev.actualNumbers.length>=4)?ev.actualNumbers:(Array.isArray(ev.actualFirstFourDigits)?ev.actualFirstFourDigits:[]);
    if(!Array.isArray(actual)||actual.length<4)return null;
    var code=String(item.code);
    if(item.kind==="position"){
      var pos=positionByKey(item.key);
      if(!pos||actual[pos.index]===undefined)return null;
      var digits=code.replace(/\D/g,"").split("").filter(function(digit,index,self){return digit!==""&&self.indexOf(digit)===index;});
      if(!digits.length)return null;
      return digits.indexOf(String(actual[pos.index]))<0;
    }
    if(item.kind==="hewei"){
      var group=ev.actualCompositeHeweiGroup;
      if(!Array.isArray(group)||group.length<3)return null;
      var heweiDigits=code.replace(/\D/g,"").split("").filter(function(digit,index,self){return digit!==""&&self.indexOf(digit)===index;});
      if(!heweiDigits.length)return null;
      if(item.key==="unified"){
        return group.slice(0,3).every(function(value){return heweiDigits.indexOf(String(value))<0;});
      }
      var index=item.key==="wanQianBai"?0:(item.key==="qianBaiShi"?1:2);
      return heweiDigits.indexOf(String(group[index]))<0;
    }
    if(item.kind==="shape"){
      return /^[大小单双]{4}$/.test(code)?!shapeMatches({numbers:actual},item.key,forceThreeWithOneShape(code,item.key)):null;
    }
    if(item.kind==="derivedReverseShape"){
      var reverseShapeKey=item.shapeKey||(item.key==="reverseSize"?"shapeSize":"shapeParity");
      return /^[大小单双]{4}$/.test(code)?!shapeMatches({numbers:actual},reverseShapeKey,forceThreeWithOneShape(code,reverseShapeKey)):null;
    }
    if(item.kind==="extra"){
      var extra=EXTRAS.filter(function(s){return s.key===item.key;})[0];
      if(!extra)return null;
      var extraRuntime=Object.assign({},extra);
      if(Array.isArray(item.codes))extraRuntime.codes=item.codes.slice(0,recentExactCodeCodeLimitForItem(item));
      return extraSuccess(extraRuntime,extraMatches({numbers:actual},extraRuntime,code));
    }
    if(item.kind==="threeDuishu"){
      var actualText=actual.slice(0,4).map(String).join("");
      var pairs=threeDuishuPairTokens(item);
      if(!pairs.length)return null;
      var appeared=pairs.some(function(pair){
        return String(pair).split("").every(function(digit){return actualText.indexOf(String(digit))>=0;});
      });
      return !appeared;
    }
    if(item.kind==="brotherNumber"){
      var brotherCode=brotherNumberResultFromCode(actual.slice(0,4).map(String).join(""));
      if(brotherCode===null)return null;
      return brotherCode===String(item.code);
    }
    return itemSuccess(data,item,row);
  }
