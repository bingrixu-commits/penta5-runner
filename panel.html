function positionHotColdHtml(data,index){
  var sourceRows=Array.isArray(data&&data.history)?data.history:(Array.isArray(data&&data.records)?data.records:[]);
  var rows=sourceRows.slice(0,COLD_HOT_WINDOW);
  var counts={};
  for(var d=0;d<=9;d++)counts[String(d)]=0;
  var total=0;
  rows.forEach(function(row){
    var nums=Array.isArray(row&&row.numbers)?row.numbers:[];
    if(nums[index]===undefined||nums[index]===null)return;
    var digit=String(nums[index]);
    if(!/^\d$/.test(digit))return;
    counts[digit]+=1;
    total+=1;
  });
  if(!total)return "";
  var cold=[],hot=[],min=Infinity,max=-Infinity;
  Object.keys(counts).forEach(function(digit){
    var n=counts[digit];
    if(n<min){min=n;cold=[digit];}
    else if(n===min)cold.push(digit);
    if(n>max){max=n;hot=[digit];}
    else if(n===max)hot.push(digit);
  });
  return '<br><span style="display:inline-flex;gap:7px;flex-wrap:wrap;margin-top:3px;">'
    +'<span style="color:#2563eb;font-weight:800;">冷码 '+esc(cold.join(""))+'('+esc(min)+')</span>'
    +'<span style="color:#dc2626;font-weight:800;">热码 '+esc(hot.join(""))+'('+esc(max)+')</span>'
    +'<span style="color:#64748b;">近'+esc(total)+'期</span>'
    +'</span>';
}
function independentHeweiRateText(data,key,index){
  var total=0,match=0;
  var list=(Array.isArray(data.predictions)?data.predictions:[])
    .filter(function(p){return p&&p.evaluated&&p.evaluation;})
    .slice(0,30);

  list.forEach(function(pred){
    if(!pred || !pred.evaluated || !pred.evaluation) return;

    var saved=
      pred.independentHeweiKills ||
      pred.evaluation.previousIndependentHeweiKills || {};

    var item=saved[key];
    var digit=item && typeof item==="object" ?
      String(item.killDigit||"") : String(item||"");

    var group=pred.evaluation.actualCompositeHeweiGroup;

    if(!digit || digit==="--" || !Array.isArray(group)) return;

    total++;
    if(digit!==String(group[index])) match++;
  });

  return " 当前码近30期历史通过率（非未来概率） "+rate(total,match)+heweiColdCodeText(data,key);
}

function heweiColdCodeText(data,key){
