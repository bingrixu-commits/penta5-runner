  function todayTwoDigitAvoidGroupLedgerStats(data){
    var today=todayKeyForData(data);
    var keys=["twoDigitAvoid","twoDigitAvoid2","twoDigitAvoid3"];
    function freshStats(){
      return {total:0,hit:0,rate:null,currentWin:0,currentMiss:0,maxWin:0,maxMiss:0,lastResult:null,lastPeriod:""};
    }
    function applyStats(stats,ok,period){
      stats.total++;
      if(ok)stats.hit++;
      stats.rate=stats.total?stats.hit*100/stats.total:null;
      stats.lastResult=ok;
      stats.lastPeriod=String(period||"");
      if(ok){
        stats.currentWin++;
        stats.currentMiss=0;
        if(stats.currentWin>stats.maxWin)stats.maxWin=stats.currentWin;
      }else{
        stats.currentMiss++;
        stats.currentWin=0;
        if(stats.currentMiss>stats.maxMiss)stats.maxMiss=stats.currentMiss;
      }
    }
    var itemStats={};
    keys.forEach(function(key){itemStats[key]=freshStats();});
    var list=evalRows(data).filter(function(row){return rowDateKey(row)===today;});
    list=list.slice().sort(function(a,b){
      var ae=(a&&a.evaluation)||{},be=(b&&b.evaluation)||{};
      return String(ae.targetOpenTime||ae.evaluatedAt||a.baseOpenTime||a.basePeriod||"").localeCompare(String(be.targetOpenTime||be.evaluatedAt||b.baseOpenTime||b.basePeriod||""));
    });
    var valid=0,hit=0,currentWin=0,currentMiss=0,maxWin=0,maxMiss=0,lastResult=null,lastPeriod="";
    list.forEach(function(row){
      var ev=(row&&row.evaluation)||{};
      var extras=ev.independentExtras||{};
      var results=[],period=ev.targetPeriod||row.basePeriod||"";
      for(var i=0;i<keys.length;i++){
        var saved=extras[keys[i]];
        if(saved&&typeof saved.success==="boolean"){
          var itemOk=!!saved.success;
          applyStats(itemStats[keys[i]],itemOk,period);
          results.push(itemOk);
        }else{
          results.push(null);
        }
      }
      if(results.filter(function(item){return typeof item==="boolean";}).length!==keys.length)return;
      var ok=results.every(Boolean);
      valid++;
      if(ok)hit++;
      lastResult=ok;
      lastPeriod=String(period||"");
      if(ok){
        currentWin++;
        currentMiss=0;
        if(currentWin>maxWin)maxWin=currentWin;
      }else{
        currentMiss++;
        currentWin=0;
        if(currentMiss>maxMiss)maxMiss=currentMiss;
      }
    });
    return {
      day:today,
      total:valid,
      hit:hit,
      rate:valid?hit*100/valid:null,
      currentWin:lastResult===true?currentWin:0,
      currentMiss:lastResult===false?currentMiss:0,
      maxWin:maxWin,
      maxMiss:maxMiss,
      lastPeriod:lastPeriod,
      items:itemStats
    };
  }
