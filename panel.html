  function removeCodesFromSegment(text,startLabel,endLabels,codes){
    var start=typeof practiceHeweiLabelStartIndex==="function"
      ?practiceHeweiLabelStartIndex(text,startLabel)
      :String(text||"").indexOf(startLabel);
    if(start<0)return text;
    var valueStart=start+startLabel.length,end=text.length;
    (endLabels||[]).forEach(function(label){
      var idx;
      if(typeof practiceHeweiLabelStartIndex==="function"){
        idx=practiceHeweiLabelStartIndex(text.slice(valueStart),label);
        if(idx>=0)idx=valueStart+idx;
      }else{
        idx=text.indexOf(label,valueStart);
      }
      if(idx>=0&&idx<end)end=idx;
    });
    var value=text.slice(valueStart,end);
    if(!/^\d+$/.test(value))return text;
    (codes||[]).forEach(function(code){value=value.split(String(code)).join("");});
    return text.slice(0,valueStart)+value+text.slice(end);
  }
  function positionItemMatchesKey(item,key){
    if(!item||item.kind!=="position")return false;
    if(item.key===key||item.stateKey===key)return true;
    var pos=positionByKey(item.stateKey||item.key);
    var target=positionByKey(key);
    if(!pos||!target)return false;
    return pos.stateKey===target.stateKey||pos.key===target.key;
  }
  function selectedCodes(top,kind,key){
    return top.filter(function(item){
      if(!item||item.kind!==kind)return false;
      // 攻击语路径已在 frameworkAttackItems 去掉 backup；此处再兜底一次，避免替补进正式杀码位段
      if(item.side==="backup")return false;
      if(item.code==null||String(item.code)===""||String(item.code)==="--")return false;
      // 后台快照会把定位 key 从 wan/qian/bai/shi 映射成 ball1..ball4，写靶场时两边都要认
      if(kind==="position")return positionItemMatchesKey(item,key);
      return item.key===key;
    }).map(function(item){return item.code;});
  }
  function derivedReverseShapeItems(data,top){
    var list=Array.isArray(top)?top:[];
    function selectedPositionDigits(key){
      var out=[];
      for(var i=0;i<list.length;i++){
        var item=list[i];
        if(!item||!positionItemMatchesKey(item,key)||item.code==null)continue;
        var digit=String(item.code).replace(/\D/g,"").charAt(0);
        if(digit!==""&&out.indexOf(digit)<0)out.push(digit);
      }
      return out;
    }
    function reversePositionToken(key,axis){
      var values=[];
      selectedPositionDigits(key).forEach(function(digit){
        var n=Number(digit);
        if(!isFinite(n))return;
        var token=axis==="parity"?(n%2===1?"双":"单"):(n>=5?"小":"大");
        if(values.indexOf(token)<0)values.push(token);
      });
      return values.length===1?values[0]:"";
    }
    function completeLockedShape(shapeKey,locked,fallback){
      var shape=SHAPES.filter(function(s){return s.key===shapeKey;})[0];
      var pool=shape?candidates(shape):[];
      function matchesLocked(candidate){
        for(var i=0;i<4;i++){
          if(locked[i]&&candidate.charAt(i)!==locked[i])return false;
        }
        return true;
      }
      var matches=pool.filter(matchesLocked);
      if(matches.length){
        var rows=records(data||{}).slice(0,120);
        function recentSeenScore(candidate){
          var score=0;
          rows.forEach(function(row,index){
            if(patternOf(row,shapeKey)===candidate)score+=Math.pow(0.94,index);
          });
          return score;
        }
        function distance(candidate,target){
          var diff=0;
          for(var i=0;i<4;i++)if(candidate.charAt(i)!==target.charAt(i))diff++;
          return diff;
        }
        return matches.slice().sort(function(a,b){
          var sa=recentSeenScore(a),sb=recentSeenScore(b);
          if(sa!==sb)return sa-sb;
          var da=distance(a,fallback),db=distance(b,fallback);
          if(da!==db)return da-db;
          return a.localeCompare(b,"zh-CN");
        })[0]||fallback;
      }
      var out=String(fallback||"").split("");
      for(var i=0;i<4;i++){
        if(locked[i])out[i]=locked[i];
        else if(!/^[大小单双]$/.test(out[i]||""))out[i]=(fallback||"单单单双").charAt(i)||"单";
      }
      return forceThreeWithOneShape(out.join(""),shapeKey);
    }
    var parity=[null,null,null,null],size=[null,null,null,null],changed=false;
    POS.forEach(function(pos,index){
      var parityToken=reversePositionToken(pos.key,"parity");
      var sizeToken=reversePositionToken(pos.key,"size");
      if(parityToken){parity[index]=parityToken;changed=true;}
      if(sizeToken){size[index]=sizeToken;changed=true;}
    });
    if(!changed)return [];
    var parityCode=forceThreeWithOneShape(completeLockedShape("shapeParity",parity,"双双双单"),"shapeParity");
    var sizeCode=forceThreeWithOneShape(completeLockedShape("shapeSize",size,"大大大小"),"shapeSize");
    var out=[];
    if(/^[大小单双]{4}$/.test(parityCode))out.push({kind:"derivedReverseShape",key:"reverseParity",name:"单双反向形态",code:parityCode});
    if(/^[大小单双]{4}$/.test(sizeCode))out.push({kind:"derivedReverseShape",key:"reverseSize",name:"大小反向形态",code:sizeCode});
    return out;
  }
