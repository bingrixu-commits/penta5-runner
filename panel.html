  function frameworkItemBackupDigit(data,item){
    // 该项本身已是备用选型时，不再叠第二个「替补号」参考圈，避免一眼看着乱
    if(!item||item.side==="backup"||item.side==="cold")return "";
    data=data||state||{};
    var pred=data.currentPrediction||{};
    var primary=String(item.code==null?"":item.code).replace(/\D/g,"").charAt(0);
    function pickDigit(value){
      var digit=String(value==null?"":value).replace(/\D/g,"").charAt(0);
      if(!digit||digit===primary)return "";
      return digit;
    }
    if(Array.isArray(item.coldPool)&&item.coldPool.length>1){
      var coldBackup=pickDigit(item.coldPool[1]);
      if(coldBackup)return coldBackup;
    }
    if(item.kind==="position"){
      var pos=positionByKey(item.stateKey||item.key);
      if(!pos)return "";
      var entry=(pred.positionKills||{})[pos.stateKey]||{};
      return pickDigit(typeof txtPositionBackupDigitFromEntry==="function"?txtPositionBackupDigitFromEntry(entry):(entry.originalBackupDigit!=null?entry.originalBackupDigit:(entry.backupAlgorithmDigit!=null?entry.backupAlgorithmDigit:(entry.backup!=null?entry.backup:(entry.backupDigit!=null?entry.backupDigit:(entry.killDigits&&entry.killDigits[1]))))));
    }
    if(item.kind==="hewei"){
      if(item.key==="unified"||item.key==="threeFour"){
        var detail=pred.detail&&pred.detail.threeFourHeweiKill||{};
        return pickDigit(pred.threeFourHeweiBackupDigit||detail.backupDigit);
      }
      if(item.key==="total"){
        var totalDetail=pred.detail&&pred.detail.totalHeweiKill||{};
        return pickDigit(pred.totalHeweiBackupDigit||totalDetail.backupDigit);
      }
      var hewei=(pred.independentHeweiKills||{})[item.key]||{};
      return pickDigit(hewei.backupDigit);
    }
    return "";
  }
  function frameworkItemBackupRatePct(data,item){
