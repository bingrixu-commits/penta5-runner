    opts=opts||{};
    if(!state||!state.ok)return;
    // 不再先清空 predictionPanel：刷新时就地替换，避免整页跳回空白初始态
    var run=function(){
      ensureShapeRows();reorderRows();
      renderLatestFast(state);
      schedulePanelHeavyRender(state,{preserveView:opts.preserveView!==false});
      savePanelWarmSnapshot(state);
    };
    if(opts.preserveView===false)run();
    else withPreservedPanelView(run);
  }
  var panelRefreshPending=null;
  var panelBootReady=false;
  function refreshSourcePriority(source){
    if(source==="user"||source==="boot")return 2;
    if(source==="auto")return 0;
    return 1;
  }
  async function refresh(forceRender,opts){
    opts=opts||{};
    var source=opts.source||(forceRender===true?"user":"auto");
    if(loading){
      // 启动/用户刷新优先，避免 pageshow 静默刷新抢跑后把 boot 直接丢掉
      if(!panelRefreshPending||refreshSourcePriority(source)>=refreshSourcePriority(panelRefreshPending.source)){
        panelRefreshPending={forceRender:forceRender===true,source:source};
      }
      return;
    }
    // 首屏 boot 完成前，忽略 focus/pageshow 触发的静默刷新
    if(!panelBootReady&&source==="auto")return;
    var silent=source==="auto";
    var userAsked=source==="user"||source==="boot";
    loading=true;
    try{
      if(!silent)setStatus("正在读取数据...",true);
      var response=await panelFetch("/state?_="+Date.now(),{cache:"no-store"});
      var nextState=await response.json();
      var previousKey=stateRenderKey(state);
      var nextKey=stateRenderKey(nextState);
      var firstRender=!state;
      var keyChanged=previousKey!==nextKey;
      state=nextState;
      if(keyChanged){calculationCache=null;evaluationCache={};}
      if(firstRender){
        renderAll({preserveView:false});
      }else if(keyChanged){
        // 数据变了：更新内容，但保留滚动/焦点/操作位置
        withPreservedPanelView(function(){
          renderLatestFast(state);
          schedulePanelHeavyRender(state,{preserveView:true});
          savePanelWarmSnapshot(state);
        });
      }else if(userAsked){
        // 用户点刷新且内容相同：只更新顶栏，不拆操作页
        withPreservedPanelView(function(){
          renderLatestFast(state);
          renderPanelMetadata(state);
          savePanelWarmSnapshot(state);
        });
      }else{
        // 后台轮询且内容相同：页面完全不动，只静默记暖启动快照
        savePanelWarmSnapshot(state);
      }
      if(!silent){
        if(nextState&&nextState.syncing)setStatus("正在同步预测...",true);
        else setStatus("远程同步成功",true);
      }
      else if(!panelBootReady)setStatus(nextState&&nextState.syncing?"正在同步预测...":"远程同步成功",true);
      try{maybeKickPanelSync(state);}catch(e){}
    }
    catch(err){
      console.error("v5 panel refresh failed",err);
      if(!silent)setStatus("读取失败："+(err&&err.message?err.message:err),false);
    }
    finally{
      loading=false;
      if(source==="boot")panelBootReady=true;
      var pending=panelRefreshPending;
      panelRefreshPending=null;
      if(pending){
        setTimeout(function(){
          refresh(pending.forceRender,{source:pending.source});
        },0);
      }
    }
  }
  function schedulePanelRefreshLoop(){
    if(panelRefreshTimer)clearTimeout(panelRefreshTimer);
    var delay=panelRefreshIntervalMs();
    panelRefreshTimer=setTimeout(function(){
      Promise.resolve(refresh(false,{source:"auto"})).finally(function(){
        try{maybeKickPanelSync(state||{});}catch(e){}
        schedulePanelRefreshLoop();
      });
    },delay);
  }
  function coalescePanelRefresh(forceRender,source){
    if(!panelBootReady&&(source||"auto")==="auto")return;
    if(panelRefreshCoalesceTimer)clearTimeout(panelRefreshCoalesceTimer);
    panelRefreshCoalesceTimer=setTimeout(function(){
      panelRefreshCoalesceTimer=null;
      refresh(forceRender===true,{source:source||"auto"});
    },280);
  }
  function startPanelLoop(){
    if(panelLoopStarted)return;
    panelLoopStarted=true;
    panelBootReady=false;
    initPanelChrome();
    paintPanelWarmSnapshot();
    initTxtConverter();
    if(typeof initTxtPositionDocumentClicks==="function")initTxtPositionDocumentClicks();
    window.__penta5PanelRefresh=refresh;
    window.loadState=function(){return refresh(true,{source:"user"});};
    window.__penta5ManualSync=async function(){
      try{
        setStatus("正在手动同步...",true);
        panelFetch("/sync",{method:"POST",cache:"no-store"}).catch(function(err){
          console.warn("manual sync failed",err);
          setStatus("同步失败："+(err&&err.message?err.message:err),false);
        });
        for(var i=0;i<120;i+=1){
          await refresh(false,{source:"user"});
          if(!state||!state.syncing)break;
          await new Promise(function(r){setTimeout(r,800);});
        }
        if(state&&!state.syncing)setStatus("远程同步成功",true);
      }catch(err){
        setStatus("同步失败："+(err&&err.message?err.message:err),false);
      }
    };
    window.manualSync=window.__penta5ManualSync;
    setStatus("页面已打开，正在准备读取数据...",true);
    setTimeout(function(){
      Promise.resolve(refresh(true,{source:"boot"})).finally(function(){
        panelBootReady=true;
        recommend2PromptArmed=true;
        schedulePanelRefreshLoop();
      });
    },700);
    document.addEventListener("visibilitychange",function(){if(!document.hidden)coalescePanelRefresh(false,"auto");});
    window.addEventListener("focus",function(){coalescePanelRefresh(false,"auto");});
    window.addEventListener("pageshow",function(){coalescePanelRefresh(false,"auto");});
    window.addEventListener("online",function(){coalescePanelRefresh(true,"auto");});
  }
  document.addEventListener("DOMContentLoaded",startPanelLoop);
  if(document.readyState!=="loading")startPanelLoop();





/* PENTA5_V26_LAYOUT_START */
  function renderPracticeLayoutBox(){
    var practice=document.getElementById("practiceModelBox");
    var latest=document.getElementById("numbers");
    var latestCard=latest&&(latest.closest?latest.closest(".card"):latest.parentElement);
    if(!practice||!latestCard||!latestCard.parentNode)return;

    practice.className="card section-anchor";
    practice.style.cssText="background:#f0fdf4;border:1px solid #bbf7d0;border-radius:14px;padding:14px;margin-bottom:12px;box-shadow:0 1px 5px rgba(0,0,0,.08);";

    var autoTop=document.getElementById("autoTop5Recommend");
    var parent=(autoTop&&autoTop.parentNode)||latestCard.parentNode;
    var anchor=autoTop||latestCard;
    var after=anchor.nextSibling;
    while(after&&after.nodeType===3&&!String(after.nodeValue||"").trim())after=after.nextSibling;
    if(practice.parentNode!==parent || practice.previousSibling!==anchor){
      parent.insertBefore(practice,after);
    }
  }
/* PENTA5_V26_LAYOUT_END */

/* PENTA5_V34_UI_CHROME_START */
  function updatePanelChrome(data){
    var latest=data&&data.latestRecord||{};
    var sync=data&&data.lastSync||{};
    var prediction=data&&data.currentPrediction||{};
    var periodEl=document.getElementById("summaryPeriod");
    if(periodEl)periodEl.textContent=latest.period||latest.uid||"--";
    var numbersEl=document.getElementById("summaryNumbers");
    if(numbersEl){
      var nums=Array.isArray(latest.numbers)?latest.numbers.slice(0,5):[];
      numbersEl.textContent=nums.length?nums.join(" "):"--";
    }
    var baseEl=document.getElementById("summaryBasePeriod");
    if(baseEl)baseEl.textContent=prediction.basePeriod||prediction.baseUid||"--";
    var syncEl=document.getElementById("summarySync");
    if(syncEl){
      var syncText=String(sync.text||sync.at||"--");
      syncEl.textContent=syncText.length>20?syncText.slice(0,20):syncText;
      syncEl.title=syncText;
    }
    var histEl=document.getElementById("summaryHistory");
    if(histEl)histEl.textContent=Array.isArray(data&&data.history)?String(data.history.length)+"期":"--";
    var storm=data&&data.stormMode||{};
    var stormBanner=document.getElementById("stormBanner");
    if(stormBanner){
      if(storm&&storm.active){
        stormBanner.className="storm-banner is-on";
        stormBanner.innerHTML="风暴模式已开启：冻结换码锁 + 机器人停射。原因："+esc(storm.reason||"--")
          +" ｜ 六项连败 "+esc(storm.autoTop6CurrentMiss||0)
          +" ｜ 三对数连败 "+esc(storm.threeDuishuCurrentMiss||0)
          +"。恢复需连败归零或连中达标并稳定。";
      }else{
        stormBanner.className="storm-banner";
        stormBanner.innerHTML="";
      }
    }
    var tipReadyBanner=document.getElementById("tipReadyBanner");
    if(tipReadyBanner){
      var tipReady=data&&data.tipReady;
      var tipIssues=Number(data&&data.tipReadyIssueCount||0);
      if(tipReady===false){
        tipReadyBanner.className="tip-ready-banner is-on";
        tipReadyBanner.innerHTML="结构未完美：tipReady=false，已阻断射击发布。问题数 "+esc(tipIssues)
          +"。后端将自动修到八框架完整封存后才放行。";
      }else if(tipReady===true){
        tipReadyBanner.className="tip-ready-banner is-on is-ok";
        tipReadyBanner.innerHTML="结构完美：八框架完整且开奖前封存有效，tipReady=true。";
      }else{
        tipReadyBanner.className="tip-ready-banner";
        tipReadyBanner.innerHTML="";
      }
    }
  }
  window.updatePanelChrome=updatePanelChrome;
  function updatePanelClock(){
    var clock=document.getElementById("topbarClock");
    if(!clock)return;
    var now=new Date();
    clock.textContent=now.toLocaleString("zh-CN",{hour12:false,hour:"2-digit",minute:"2-digit",second:"2-digit"});
  }
  window.updatePanelClock=updatePanelClock;
  function initPanelChrome(){
    if(window.__pentaPanelChromeReady)return;
    window.__pentaPanelChromeReady=true;
    updatePanelClock();
    setInterval(updatePanelClock,1000);
    if(typeof initPanelCollapseDelegation==="function")initPanelCollapseDelegation();
    else if(typeof restorePanelCollapsibles==="function")restorePanelCollapsibles(document);
    var fab=document.getElementById("panelFab");
    if(fab){
      function syncFab(){
        fab.classList.toggle("is-visible",(window.scrollY||0)>320);
      }
      window.addEventListener("scroll",syncFab,{passive:true});
      fab.addEventListener("click",function(){window.scrollTo({top:0,behavior:"smooth"});});
      syncFab();
    }
  }
  window.initPanelChrome=initPanelChrome;
  if(document.readyState!=="loading")initPanelChrome();
  else document.addEventListener("DOMContentLoaded",initPanelChrome);
/* PENTA5_V34_UI_CHROME_END */

})();

</script>
