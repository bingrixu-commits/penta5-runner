  // 框架攻击语必须走保留码底稿口径（千…百…十…个…四定），不能改成「除千X」错格式。
  // 20260714：不再用 stripUntouched 删全量10码位段——该后处理会把「未匹配到定位排除」的位整段抹掉，排除结果失真。
  // 三定框架例外：只输出系统挑中的3个位置 +「三定」标记，未挑中的位置整段不要。
  function threeDingAttackPositionLabel(item){
    if(!item||item.kind!=="position")return "";
    var pos=positionByKey(item.stateKey||item.key);
    var key=String((pos&&(pos.stateKey||pos.key||pos.domId))||item.stateKey||item.key||"");
    if(key==="wan"||key==="ball1")return "千";
    if(key==="qian"||key==="ball2")return "百";
    if(key==="bai"||key==="ball3")return "十";
    if(key==="shi"||key==="ball4")return "个";
    return "";
  }
  function threeDingKeepDigitsFromExclude(code){
    var value="1234567890";
    String(code==null?"":code).replace(/\D/g,"").split("").forEach(function(digit){
      if(digit)value=value.split(digit).join("");
    });
    return value;
  }
  function expandThreeDingAttackToFourDingText(raw){
    var text=String(raw||"").replace(/\s+/g,"").replace(/各+$/,"");
    if(!text||text.indexOf("三定")<0)return "";
    var matches=[],match,regex=/(千|百|十|个)(\d+)/g;
    while((match=regex.exec(text))){
      matches.push({label:match[1],digits:match[2],end:match.index+match[0].length});
    }
    // 展示攻击语固定千百十三段；转TXT时补个位全码并升为四定底稿
    if(matches.length<1||matches.length>4)return "";
    var seen={},order=["千","百","十","个"],byLabel={};
    matches.forEach(function(item){
      if(seen[item.label])return;
      seen[item.label]=true;
      byLabel[item.label]=item.digits;
    });
    if(!byLabel["千"]&&!byLabel["百"]&&!byLabel["十"])return "";
    var head=order.map(function(label){return label+(byLabel[label]||"1234567890");}).join("");
    var lastPos=matches[matches.length-1];
    var tail=text.slice(lastPos.end).replace(/^三定/,"四定");
    if(tail.indexOf("四定")!==0)tail="四定"+tail.replace(/^三定/,"");
    return head+tail;
  }
  function buildThreeDingFrameworkAttackText(items){
    var list=frameworkAttackItems(items);
    if(!list.length)return "";
    // 三定系列攻击语必须写明千/百/十三个位置：挑中的位除码，未挑中的位保留全码；不含个位
    var order=["千","百","十"];
    var keepByLabel={};
    var picked=0;
    list.forEach(function(item){
      if(!item||item.kind!=="position")return;
      var label=threeDingAttackPositionLabel(item);
      if(order.indexOf(label)<0)return;
      var keep=threeDingKeepDigitsFromExclude(item.code);
      if(!keep)return;
      picked+=1;
      if(!keepByLabel[label]){
        keepByLabel[label]=keep;
        return;
      }
      keepByLabel[label]=keepByLabel[label].split("").filter(function(digit){
        return keep.indexOf(digit)>=0;
      }).join("");
    });
    // 至少要有1个定位排除（B=1 / A=2 / 原三定=3），否则攻击语无意义
    if(picked<1)return "";
    var head=order.map(function(label){return label+(keepByLabel[label]||"1234567890");}).join("");
    var full="";
    try{
      full=String(buildPracticeModel(DEFAULT_PRACTICE_MODEL,list,{addReversePositionShapes:false})||"");
    }catch(e){
      full="";
    }
    var idx=full.indexOf("四定");
    var tail=idx>=0?full.slice(idx+2).replace(/各+$/,""):"";
    return ensurePracticeShotGeTail(head+"三定"+tail);
  }
  function frameworkAttackTextFromItems(items,options){
    var list=frameworkAttackItems(items);
    if(!list.length)return "";
    var opts=options&&typeof options==="object"?options:{};
    try{
      if(opts.threeDing===true){
        // 三定系列禁止回退成四定全位攻击语（A/B 定位不足3时曾整段错成千百十个+四定）
        return buildThreeDingFrameworkAttackText(list) || "";
      }
      var shot=buildPracticeModel(DEFAULT_PRACTICE_MODEL,list,{addReversePositionShapes:false});
      return ensurePracticeShotGeTail(shot);
    }catch(e){
      return "";
    }
  }
