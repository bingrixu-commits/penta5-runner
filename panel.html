function txtOldCodeIntegrityCheck(oldCodes,remainCodes,historyRows,windowSize){
  oldCodes=Array.isArray(oldCodes)?oldCodes:[];
  remainCodes=Array.isArray(remainCodes)?remainCodes:[];
  historyRows=Array.isArray(historyRows)?historyRows:[];
  var issues=[];
  if(!historyRows.length)issues.push("共享历史为空，无法回删真实号码");
  var lookback=recentExactCodeWindowIsMax(windowSize)?historyRows.length:Math.max(1,Number(windowSize||0));
  var scanned=Math.min(lookback,historyRows.length);
  if(scanned<1)issues.push("窗口期内没有可扫描历史");
  if(oldCodes.length+remainCodes.length!==10000)issues.push("删除组+剩余组不等于10000");
  var remainSet={};
  remainCodes.forEach(function(code){remainSet[String(code)]=true;});
  var leaked=[];
  oldCodes.forEach(function(code){
    if(remainSet[String(code)])leaked.push(String(code));
  });
  if(leaked.length)issues.push("剩余结果仍含已删旧码 "+leaked.slice(0,5).join(","));
  var oldSet={};
  oldCodes.forEach(function(code){oldSet[String(code)]=true;});
  var missingFromDelete=[];
  for(var i=0;i<Math.min(30,scanned);i++){
    var nums=historyRows[i]&&historyRows[i].numbers?historyRows[i].numbers.slice(0,4):[];
    if(nums.length<4)continue;
    var code=nums.map(function(n){return String(n);}).join("");
    if(/^\d{4}$/.test(code)&&!oldSet[code])missingFromDelete.push(code);
  }
  if(missingFromDelete.length)issues.push("窗口真实号码未进入删除集 "+missingFromDelete.slice(0,5).join(","));
  var deletedSamples=oldCodes.slice(0,8);
  var historySamples=[],seenSample={};
  for(var j=0;j<Math.min(40,scanned);j++){
    var ns=historyRows[j]&&historyRows[j].numbers?historyRows[j].numbers.slice(0,4):[];
    if(ns.length<4)continue;
    var c=ns.map(function(n){return String(n);}).join("");
    if(/^\d{4}$/.test(c)&&!seenSample[c]){seenSample[c]=true;historySamples.push(c);}
    if(historySamples.length>=8)break;
  }
  return {ok:!issues.length,issues:issues,scanned:scanned,deletedSamples:deletedSamples,historySamples:historySamples};
}
