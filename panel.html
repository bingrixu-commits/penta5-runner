  function restorePanelViewState(view){
    if(!view)return;
    try{
      window.scrollTo(view.scrollX||0, view.scrollY||0);
    }catch(e){}
    var el=null;
    if(view.activeId)el=document.getElementById(view.activeId);
    if(!el&&view.activeName)el=document.querySelector('[name="'+view.activeName.replace(/"/g,"")+'"]');
    if(!el)return;
    try{
      if(typeof el.focus==="function")el.focus({preventScroll:true});
      if(view.selectionStart!=null&&view.selectionEnd!=null&&typeof el.setSelectionRange==="function"){
        el.setSelectionRange(view.selectionStart, view.selectionEnd);
