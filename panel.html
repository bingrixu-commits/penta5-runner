  function killFrameworkPickTop(data,pool,count,preferUniqueKey){
    var sorted=(pool||[]).slice().sort(function(a,b){
      var ra=killFrameworkRate(data,a),rb=killFrameworkRate(data,b);
      if(rb!==ra)return rb-ra;
      return String(a.name||"").localeCompare(String(b.name||""),"zh-CN");
    });
    var out=[],usedKeys={},usedHeweiDigits={};
    function heweiDigit(item){
      if(!item||item.kind!=="hewei")return "";
      if((item.side||"recommend")==="backup")return "";
      var digits=String(item.code==null?"":item.code).replace(/\D/g,"");
      return digits.length===1?digits:"";
    }
    sorted.forEach(function(item){
      if(out.length>=count)return;
      if(!item||item.code==null||String(item.code)==="--"||String(item.code)==="")return;
      var key=String(item.key||item.stateKey||"");
      if(preferUniqueKey&&key&&usedKeys[key])return;
      var digit=heweiDigit(item);
      if(digit&&usedHeweiDigits[digit])return;
      usedKeys[key]=true;
      if(digit)usedHeweiDigits[digit]=true;
      out.push(item);
    });
    if(out.length<count){
      sorted.forEach(function(item){
        if(out.length>=count)return;
        if(!item||item.code==null||String(item.code)==="--"||String(item.code)==="")return;
        if(out.some(function(picked){return practiceItemId(picked)===practiceItemId(item);}))return;
        var digit=heweiDigit(item);
        if(digit&&usedHeweiDigits[digit])return;
        if(digit)usedHeweiDigits[digit]=true;
        out.push(item);
      });
    }
    return out;
