  function brotherNumberStreakStats(results){
    var source=(results||[]).filter(function(item){return typeof item.success==="boolean";});
    var total=source.length;
    var hit=source.filter(function(item){return item.success;}).length;
    var chronological=source.slice().reverse();
    var win=0,miss=0,maxWin=0,maxMiss=0;
    chronological.forEach(function(item){
      if(item.success){
        win++;
        miss=0;
        if(win>maxWin)maxWin=win;
      }else{
        miss++;
        win=0;
        if(miss>maxMiss)maxMiss=miss;
      }
    });
    var currentWin=0,currentMiss=0;
    if(source.length){
      if(source[0].success){
        for(var i=0;i<source.length&&source[i].success;i++)currentWin++;
      }else{
        for(var j=0;j<source.length&&source[j].success===false;j++)currentMiss++;
      }
    }
    return {
      total:total,
      hit:hit,
      rate:total?hit*100/total:null,
      maxWin:maxWin,
      maxMiss:maxMiss,
      currentWin:currentWin,
      currentMiss:currentMiss
    };
  }
