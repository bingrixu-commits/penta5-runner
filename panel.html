    }
    function comboPickScore(item){
      var stats=comboStatsFor(chosen.concat([item]));
      var full=stats.rate===null?-1:Number(stats.rate||0);
      var near=stats.nearRate===null?full:Number(stats.nearRate||0);
      var avg=stats.avgRate===null?0:Number(stats.avgRate||0);
