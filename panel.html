  width=Number(width||4);
  if(!txtAuditTokenPattern(width).test(token))return false;
  if(width===4&&!/\d/.test(token))return false;
  return true;
}
function txtAuditValidateResult(result){
  var width=Number(result&&result.width||4);
  var tokens=txtResultTokens(result&&result.text);
  var seen={},duplicates=0,illegal=[];
  tokens.forEach(function(rawToken){
    var token=txtAuditNormalizeToken(rawToken);
    if(!txtAuditTokenIsValid(token,width)&&illegal.length<8)illegal.push(rawToken);
    if(seen[token])duplicates++;
    seen[token]=true;
  });
  return {
    width:width,
    count:tokens.length,
    declaredCount:Number(result&&result.count||0),
    uniqueCount:Object.keys(seen).length,
    duplicateCount:duplicates,
    illegal:illegal,
    countOk:Number(result&&result.count||0)===tokens.length,
    ok:Number(result&&result.count||0)===tokens.length&&duplicates===0&&illegal.length===0
  };
}
function txtAuditIndexFromToken(token,width){
  width=Number(width||4);
  var digits=txtAuditNormalizeToken(token).replace(/X/g,"").replace(/\D/g,"").slice(0,width);
  if(digits.length!==width)return -1;
  var index=Number(digits);
  var max=Math.pow(10,width);
  return isFinite(index)&&index>=0&&index<max?index:-1;
}
function txtAuditIndexesFromToken(token,width){
  width=Number(width||4);
  token=txtAuditNormalizeToken(token);
  if(width===4&&/[X+]/.test(token)&&/^[0-9X+]{4}$/.test(token)&&/\d/.test(token)){
    var out=[];
    function walk(pos,chars){
      if(pos>=4){
        out.push(Number(chars.join("")));
        return;
      }
      var ch=token.charAt(pos);
      if(txtIsWildcardChar(ch)){
        for(var d=0;d<=9;d++){
          chars[pos]=String(d);
          walk(pos+1,chars);
        }
      }else if(/^\d$/.test(ch)){
        chars[pos]=ch;
        walk(pos+1,chars);
      }
    }
    walk(0,["0","0","0","0"]);
    return out.filter(function(index){return isFinite(index)&&index>=0&&index<10000;});
  }
  var index=txtAuditIndexFromToken(token,width);
  return index>=0?[index]:[];
}
function txtAuditBuildBitmap(tokens,width){
  width=Number(width||4);
  var max=Math.pow(10,width),nibbles=Math.ceil(max/4),arr=[];
  for(var i=0;i<nibbles;i++)arr[i]=0;
  (tokens||[]).forEach(function(token){
    txtAuditIndexesFromToken(token,width).forEach(function(index){
      var slot=Math.floor(index/4),bit=index%4;
      arr[slot]|=(1<<bit);
    });
  });
  return arr.map(function(value){return value.toString(16);}).join("");
}
function txtAuditBitmapHas(snapshot,token){
  snapshot=snapshot||{};
  var width=Number(snapshot.width||4);
  var index=txtAuditIndexFromToken(token,width);
  if(index<0)return false;
  if(Array.isArray(snapshot.tokens)){
    return snapshot.tokens.indexOf(token)>=0;
  }
  var bitmap=String(snapshot.bitmap||"");
  var slot=Math.floor(index/4),bit=index%4;
  if(slot<0||slot>=bitmap.length)return false;
  var value=parseInt(bitmap.charAt(slot),16);
  return isFinite(value)&&((value&(1<<bit))!==0);
}
function txtAuditNextPeriod(period){
