    +'<b style="color:'+(snapshot.evaluated?(snapshot.success?"#15803d":"#b45309"):"#1d4ed8")+';">'+txtEsc(stateText)+'</b>'
    +' ｜ '+txtEsc(snapshot.label)
    +' ｜ 目标期 '+txtEsc(snapshot.targetPeriod||"--")
    +actual
    +' ｜ '+txtEsc(snapshot.count)+'组'
