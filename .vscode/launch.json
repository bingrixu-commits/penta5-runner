{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Python: algorithms/run.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/algorithms/run.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Python: penta5_supervisor.py",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/penta5_supervisor.py",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "envFile": "${workspaceFolder}/.env"
    },
    {
      "name": "Node: penta5_backend_runner.js",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/penta5_backend_runner.js",
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env",
      "runtimeArgs": ["--max-old-space-size=2048"]
    }
  ]
}
