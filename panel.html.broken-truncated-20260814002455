function panelCollapseIsComposerPosForceOpen(id){
  return id==="composerPosWan"||id==="composerPosQian"||id==="composerPosBai"||id==="composerPosShi";
}
function panelCollapseIsStored(id,defaultCollapsed){
  try{
    if(panelCollapseIsComposerPosForceOpen(id)){
      try{localStorage.removeItem(panelCollapseStorageKey(id));}catch(eForce){}
      return false;
    }
    if(id==="txtConvert"){
      var legacy=localStorage.getItem("penta5TxtCollapsed");
      if(legacy==="1"||legacy==="0"){
        localStorage.setItem(panelCollapseStorageKey("txtConvert"),legacy);
        localStorage.removeItem("penta5TxtCollapsed");
        return legacy==="1";
      }
    }
    var saved=localStorage.getItem(panelCollapseStorageKey(id));
    if(saved==="1")return true;
    if(saved==="0")return false;
  }catch(e){}
  return !!defaultCollapsed;
}
function panelCollapseApply(toggle,body,collapsed){
  if(!body)return;
  body.classList.toggle("is-collapsed",!!collapsed);
  if(toggle){
    var heroExtras=toggle.getAttribute("data-collapse-toggle")==="panelHeroExtras";
    toggle.textContent=collapsed?(heroExtras?"展开顶栏":"展开"):(heroExtras?"收起顶栏":"收起");
    toggle.setAttribute("aria-expanded",collapsed?"false":"true");
  }
  if(body.id==="panelHeroExtras"||(body.getAttribute&&body.getAttribute("data-collapse-body")==="panelHeroExtras")){
    var hero=document.getElementById("panelHero");
    if(hero)hero.classList.toggle("is-extras-collapsed",!!collapsed);
  }
}
function panelCollapseSet(id,collapsed,toggle,body){
  // 四位各排1码四卡：禁止再次折叠，避免「收起」但正文被掏空后看起来像白卡
  if(panelCollapseIsComposerPosForceOpen(id))collapsed=false;
  panelCollapseApply(toggle,body,collapsed);
  try{
    if(panelCollapseIsComposerPosForceOpen(id))localStorage.removeItem(panelCollapseStorageKey(id));
    else localStorage.setItem(panelCollapseStorageKey(id),collapsed?"1":"0");
  }catch(e){}
}
