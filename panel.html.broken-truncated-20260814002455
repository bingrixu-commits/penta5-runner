  var store=txtThreeStickyLoad();
  var verify=txtThreeVerifyLoad();
  if(!verify.lastByKey)verify.lastByKey={};
  var advanced=0;
  Object.keys(store.items||{}).forEach(function(key){
    var sticky=store.items[key];
    if(!sticky||!Array.isArray(sticky.codes)||!sticky.codes.length)return;
    if(!txtThreePeriodNewer(latest.period,sticky.basePeriod))return;
    var model=txtThreeModelByName(sticky.comboName);
