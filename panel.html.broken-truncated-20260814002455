    return copy;
  }).filter(function(item){return item.recommendScore!==null&&isFinite(Number(item.recommendScore));});
  list.sort(function(a,b){
    if(b.recommendScore!==a.recommendScore)return b.recommendScore-a.recommendScore;
    var br=txtPositionStatsRate(b.recent),ar=txtPositionStatsRate(a.recent);
    if(br!==ar)return br-ar;
    var bt=txtPositionStatsRate(b.today),at=txtPositionStatsRate(a.today);
    if(bt!==at)return bt-at;
    var am=(a.recent&&a.recent.maxMiss)||0,bm=(b.recent&&b.recent.maxMiss)||0;
