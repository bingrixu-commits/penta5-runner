function txtFourThrowFlattenCodes(result){
  // 优先用回删完整 codes；禁止静默去重导致组数变少
  if(result&&Array.isArray(result.codes)&&result.codes.length){
    var fromCodes=result.codes.map(String);
    for(var i=0;i<fromCodes.length;i++){
      if(!/^\d{4}$/.test(fromCodes[i]))throw new Error("回删码表第 "+(i+1)+" 项非四位，已停止");
    }
    if(result.left!=null&&Number(result.left)!==fromCodes.length){
      throw new Error("回删 left="+result.left+" 与 codes="+fromCodes.length+" 不一致，疑似截断，已停止");
    }
    return fromCodes;
  }
  var out=[];
  if(result&&Array.isArray(result.pages)){
    for(var p=0;p<result.pages.length;p++){
      var codes=result.pages[p]&&result.pages[p].codes;
      if(!Array.isArray(codes))throw new Error("第 "+(p+1)+" 页缺少码表，已停止");
      for(var c=0;c<codes.length;c++){
        var code=String(codes[c]||"");
        if(!/^\d{4}$/.test(code))throw new Error("第 "+(p+1)+" 页含非四位码，已停止");
        out.push(code);
      }
    }
  }
  return out;
}
function txtFourThrowBuildPlan(fromPage,toPage){
  var result=window.__penta5FourBackdeleteLast||txtFourResultFromSticky();
  if(!result||result.ok===false){
    throw new Error(result&&result.fanRemain===false
      ?"请先回删，网页上要有真实页/组数。"
      :"请先装载反码转发池，或先正车回删出页。");
  }
  if(result.truncated===true){
    throw new Error("回删结果标记为已截断，拒绝转发（不滥竽充数）。请全量重生成。");
  }
  var allCodes=txtFourThrowFlattenCodes(result);
  if(!allCodes.length)throw new Error("请先回删，网页上要有真实页/组数。");
  var expectLeft=result.left!=null?Number(result.left):allCodes.length;
  if(expectLeft!==allCodes.length){
    throw new Error("转发前校验失败：剩码 "+expectLeft+" ≠ 码表 "+allCodes.length+"，疑似截断。");
  }
  var pages=txtFourPagesFromCodes(allCodes);
  var pageSum=pages.reduce(function(sum,page){return sum+Number(page.count||0);},0);
  if(pageSum!==allCodes.length){
    throw new Error("分页合计 "+pageSum+" ≠ 剩码 "+allCodes.length+"，拒绝转发。");
  }
  result.codes=allCodes;
  result.pages=pages;
  result.pageCount=pages.length;
  result.pageSize=TXT_FOUR_PAGE_SIZE;
  result.left=allCodes.length;
  result.truncated=false;
  window.__penta5FourBackdeleteLast=result;
  try{
    // 反码剩号不渲染进正车回删区，避免两套框架搅乱
    if(!result.fanRemain)txtFourBackdeleteRender(result);
  }catch(eRender){}
  fromPage=Math.floor(Number(fromPage));
  toPage=Math.floor(Number(toPage));
  if(!isFinite(fromPage)||!isFinite(toPage)||fromPage<1||toPage<1){
    throw new Error("页号必须是从 1 开始的整数。");
  }
  if(fromPage>toPage)throw new Error("起始页不能大于结束页。");
  var maxPage=pages.length;
  if(fromPage>maxPage)throw new Error("网页一共只有 "+maxPage+" 页，没有第 "+fromPage+" 页。");
  if(toPage>maxPage){
    toPage=maxPage;
    if($("txtFourThrowTo"))$("txtFourThrowTo").value=String(toPage);
    if($("fanDrop6ThrowTo"))$("fanDrop6ThrowTo").value=String(toPage);
  }
  var plan=[];
  var planSum=0;
  for(var pageNo=fromPage;pageNo<=toPage;pageNo++){
    var page=pages.filter(function(item){return Number(item.index)===pageNo;})[0];
    if(!page)throw new Error("网页上找不到第 "+pageNo+" 页。");
    var pageCodes=Array.isArray(page.codes)?page.codes.map(String):[];
    var count=pageCodes.length;
    var text=pageCodes.join(",")+"各";
    if(!count||!text)throw new Error("第 "+pageNo+" 页网页上没有组，已停止。");
    if(String(page.attackText||"")!==text){
      throw new Error("第 "+pageNo+" 页原文与码表不一致，已停止（不脑补）。");
    }
    planSum+=count;
    plan.push({index:pageNo,count:count,codes:pageCodes,attackText:text});
  }
  if(fromPage===1&&toPage===maxPage&&planSum!==allCodes.length){
    throw new Error("计划发送合计 "+planSum+" ≠ 剩码 "+allCodes.length+"，拒绝滥竽充数。");
  }
  return plan;
}
function txtFourThrowPollStatus(){
  var q=__txtFourThrowBatch.jobId?("?jobId="+encodeURIComponent(__txtFourThrowBatch.jobId)):"";
  fetch("/four-throw-status"+q,{credentials:"same-origin",cache:"no-store"}).then(function(res){return res.json();}).then(function(j){
    if(!j||j.ok===false){
      txtFourThrowSetStatus("状态："+(j&&j.error||"未知"),"err");
      txtFourThrowRenderFailPages([],[],[],[],false);
      return;
    }
    var failPages=Array.isArray(j.failedPages)?j.failedPages:[];
    var failTips=Array.isArray(j.failTips)?j.failTips:[];
    var alertPages=Array.isArray(j.alertPages)?j.alertPages:[];
    var alertTips=Array.isArray(j.alertTips)?j.alertTips:[];
    var retrying=false;
    var okN=j.okCount!=null?j.okCount:(Array.isArray(j.okPages)?j.okPages.length:null);
    if(failPages.length){
      __txtFourThrowBatch.lastFailedPages=failPages.slice();
      __txtFourThrowBatch.lastFailTips=failTips.slice();
    }
    var line="任务 "+(j.jobId||"-")+"｜"+String(j.status||"?")+"｜进度 "+(j.done||0)+"/"+(j.total||0)
      +(okN!=null?("｜成功 "+okN):"")
      +(failPages.length?("｜没转成功："+failPages.map(function(p){return "第"+p+"页";}).join("、")+"｜可点「继续发失败页」"):"")
      +(j.message?("｜"+j.message):"");
    txtFourThrowSetStatus(line,j.status==="error"||failPages.length?"err":(j.status==="done"?"ok":""));
    txtFourThrowRenderFailPages(failPages, failTips, alertPages.length?alertPages:failPages, alertTips, retrying);
    if(j.status==="done"||j.status==="error"||j.status==="stopped"){
      __txtFourThrowBatch.active=false;
      txtFourThrowStopPoll();
      txtFourThrowSyncButtons();
    }
  }).catch(function(err){
    txtFourThrowSetStatus("拉状态失败："+String(err&&err.message||err),"err");
  });
}
function txtFourThrowStart(){
  try{
    if(__txtFourThrowBatch.active){
      txtFourThrowSetStatus("分批扔进行中，先点停止。","err");
      return;
    }
    var cfg=txtFourThrowReadConfig();
    var amount=cfg.amount;
    if(!amount)throw new Error("请先输入金额（服务不脑补金额）。");
    if(!/^\d+(\.\d+)?$/.test(amount))throw new Error("金额只能是数字，例如 1 或 0.2。");
    var from=($("txtFourThrowFrom")&&$("txtFourThrowFrom").value)||1;
    var toEl=$("txtFourThrowTo");
    var to=toEl?String(toEl.value||"").trim():"";
    var source=window.__penta5FourBackdeleteLast||txtFourResultFromSticky(null,{lane:TXT_FOUR_LANE_DING})||txtFourResultFromSticky();
    var totalPages=(source&&source.pages&&source.pages.length)||(source&&source.pageCount)||0;
    if(!to||!Number(to)){
      if(!totalPages)throw new Error("到页为空：请先回删出结果，或手动填写到页。");
      to=String(totalPages);
      if(toEl)toEl.value=to;
    }
    var plan=txtFourThrowBuildPlan(from,to);
    var slot=String(cfg.active||"1");
    var url=String((cfg.urls&&cfg.urls[slot])||"").trim();
    if(!url)throw new Error("网址为空：先填网址并点「保存金额+网址到服务」。");
    __txtFourThrowBatch.active=true;
    txtFourThrowSyncButtons();
    txtFourThrowRenderFailPages([],[],[],[],false);
    __txtFourThrowBatch.lastFailedPages=[];
    __txtFourThrowBatch.lastFailTips=[];
    txtFourThrowSetStatus("正在提交服务端分批真发：第 "+plan[0].index+"–"+plan[plan.length-1].index+" 页（失败会标出，再由你点「继续发失败页」）…");
    fetch("/four-throw-send",{
      method:"POST",
      credentials:"same-origin",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        slot:slot,
        amount:amount,
        pageFrom:Number(from),
        pageTo:Number(to),
        pages:plan,
        config:cfg
      })
    }).then(function(res){return res.json().then(function(j){return {res:res,j:j};});}).then(function(pack){
      if(!pack.res.ok||!pack.j||pack.j.ok===false)throw new Error((pack.j&&pack.j.error)||("HTTP "+pack.res.status));
      __txtFourThrowBatch.jobId=String(pack.j.jobId||"");
      txtFourThrowSetStatus("已接单 job="+__txtFourThrowBatch.jobId+"，服务端按网页实数逐页发送中…","ok");
      txtFourThrowStopPoll();
      __txtFourThrowBatch.pollTimer=setInterval(txtFourThrowPollStatus,2000);
      txtFourThrowPollStatus();
    }).catch(function(err){
      txtFourThrowStop("提交失败："+String(err&&err.message||err),"err");
    });
  }catch(err){
    txtFourThrowStop(String(err&&err.message||err),"err");
  }
}
function txtFourThrowNext(){
  txtFourThrowPollStatus();
}
function txtFourThrowContinueFailed(){
  try{
    if(__txtFourThrowBatch.active){
      txtFourThrowSetStatus("分批扔进行中，先点停止。","err");
      return;
    }
    var failed=__txtFourThrowBatch.lastFailedPages||[];
    if(!failed.length){
      txtFourThrowSetStatus("没有失败页可继续发。先跑一轮「服务端分批真发」。","err");
      return;
    }
    var cfg=txtFourThrowReadConfig();
    var amount=cfg.amount;
    if(!amount)throw new Error("请先输入金额（服务不脑补金额）。");
    if(!/^\d+(\.\d+)?$/.test(amount))throw new Error("金额只能是数字，例如 1 或 0.2。");
    var minP=Math.min.apply(null, failed);
    var maxP=Math.max.apply(null, failed);
    var full=txtFourThrowBuildPlan(minP, maxP);
    var want={};
    for(var i=0;i<failed.length;i++)want[String(failed[i])]=true;
    var plan=full.filter(function(p){return want[String(p.index)];});
    if(!plan.length)throw new Error("失败页已不在当前回删结果里，请重新回删后再发。");
    var slot=String(cfg.active||"1");
    var url=String((cfg.urls&&cfg.urls[slot])||"").trim();
    if(!url)throw new Error("网址为空：先填网址并保存。");
    __txtFourThrowBatch.active=true;
    txtFourThrowSyncButtons();
    txtFourThrowSetStatus("继续发失败页：第 "+plan.map(function(p){return p.index;}).join("、")+" 页…");
    fetch("/four-throw-send",{
      method:"POST",
      credentials:"same-origin",
      headers:{"Content-Type":"application/json"},
      body:JSON.stringify({
        slot:slot,
        amount:amount,
        pageFrom:plan[0].index,
        pageTo:plan[plan.length-1].index,
        pages:plan,
        config:cfg
      })
    }).then(function(res){return res.json().then(function(j){return {res:res,j:j};});}).then(function(pack){
      if(!pack.res.ok||!pack.j||pack.j.ok===false)throw new Error((pack.j&&pack.j.error)||("HTTP "+pack.res.status));
      __txtFourThrowBatch.jobId=String(pack.j.jobId||"");
      __txtFourThrowBatch.lastFailedPages=[];
      txtFourThrowSetStatus("已接单继续发 job="+__txtFourThrowBatch.jobId+"，只发上次失败页…","ok");
      txtFourThrowStopPoll();
      __txtFourThrowBatch.pollTimer=setInterval(txtFourThrowPollStatus,2000);
      txtFourThrowPollStatus();
    }).catch(function(err){
      txtFourThrowStop("继续发提交失败："+String(err&&err.message||err),"err");
    });
  }catch(err){
    txtFourThrowStop(String(err&&err.message||err),"err");
  }
}
