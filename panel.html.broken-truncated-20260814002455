function copyButtonStatus(button,ok){
  if(!button)return;
  if(!button._txtCopyLabel)button._txtCopyLabel=button.textContent||"复制";
  if(button._txtCopyTimer)clearTimeout(button._txtCopyTimer);
  button.textContent=ok?"已复制":"复制失败";
  button._txtCopyTimer=setTimeout(function(){
    button.textContent=button._txtCopyLabel;
    button._txtCopyTimer=null;
  },1000);
}
function copyTxtText(text,button,control){
  text=String(text||"");
  if(!text){
    copyButtonStatus(button,false);
    return Promise.resolve(false);
  }
  function fallback(){
    try{
      if(!control)return false;
      control.focus();
      control.select();
      return document.execCommand("copy")===true;
    }catch(error){
      return false;
    }
  }
  if(navigator.clipboard&&navigator.clipboard.writeText){
    return navigator.clipboard.writeText(text).then(function(){
      copyButtonStatus(button,true);
      return true;
    }).catch(function(){
      var ok=fallback();
      copyButtonStatus(button,ok);
      return ok;
    });
  }
  var ok=fallback();
  copyButtonStatus(button,ok);
  return Promise.resolve(ok);
}
