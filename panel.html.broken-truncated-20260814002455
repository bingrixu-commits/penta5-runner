    if(!positions)return;
    var targetCode=txtPositionCodeFromRow(latest,positions);
    if(!/^\d{3}$/.test(String(targetCode||"")))return;
    var limit=txtStrictThreeHistoryLimitNormalize(sticky.historyLimit);
    // 同组合+档位+目标期只记一次
    var stats=txtThreeHitStatsLoad();
    var dup=false;
    (stats.evaluated||[]).forEach(function(item){
      if(item&&item.comboName===sticky.comboName
        &&txtStrictThreeHistoryLimitNormalize(item.historyLimit)===limit
        &&String(item.targetPeriod||"")===String(latest.period)
        &&item.evaluated===true)dup=true;
    });
    var settleBase=String(sticky.basePeriod||"");
    var poolLeft=sticky.codes.length;
