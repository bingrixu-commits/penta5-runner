      if(pos>=4){
        out.push(Number(chars.join("")));
        return;
      }
      var ch=token.charAt(pos);
      if(txtIsWildcardChar(ch)){
        for(var d=0;d<=9;d++){
          chars[pos]=String(d);
          walk(pos+1,chars);
        }
      }else if(/^\d$/.test(ch)){
        chars[pos]=ch;
        walk(pos+1,chars);
      }
    }
    walk(0,["0","0","0","0"]);
    return out.filter(function(index){return isFinite(index)&&index>=0&&index<10000;});
  }
