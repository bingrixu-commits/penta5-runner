    if(!rule)return {ok:false,message:combo.name+" 攻击语规则解析失败。"};
    if(rule.error)return {ok:false,message:rule.error};
    var codes=api.threeDingFilterCandidates(rule,combo);
    if(!codes.length)return {ok:false,message:combo.name+" 排除后无剩余号码。"};
    pools[combo.name]={name:combo.name,key:combo.key||combo.name,positions:combo.positions.slice(),codes:codes,afterFilter:codes.length};
    notes.push(combo.name+" 缩池 "+codes.length+" 组");
