function txtFourPagesFromCodes(codes){
  var pages=[];
  var list=Array.isArray(codes)?codes.map(String):[];
  for(var i=0;i<list.length;i++){
    if(!/^\d{4}$/.test(list[i])){
      throw new Error("分页遇到非四位码，已停止（拒绝截断糊弄）："+list[i]);
    }
  }
  for(var p=0;p<list.length;p+=TXT_FOUR_PAGE_SIZE){
    var chunk=list.slice(p,p+TXT_FOUR_PAGE_SIZE);
    pages.push({
      index:pages.length+1,
      count:chunk.length,
      codes:chunk,
      attackText:chunk.join(",")+"各"
    });
  }
  var summed=pages.reduce(function(sum,page){return sum+Number(page.count||0);},0);
  if(summed!==list.length){
    throw new Error("分页合计 "+summed+" ≠ 剩码 "+list.length+"，疑似截断，已停止。");
  }
  return pages;
}
