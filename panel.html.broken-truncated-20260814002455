function txtFourGenerateCandidatesFromAttack(raw,opts){
  opts=opts||{};
  var lane=txtFourLaneNormalize(opts.lane||txtFourLaneActive());
  var api=window.Penta5AttackTxtConvert;
  if(!api||typeof api.convert!=="function"){
    throw txtPositionMakeError("四定转换脚本未加载，请 Ctrl+F5 硬刷新","FOUR_CONVERT_MISSING",false);
  }
  var shot=String(raw||"");
  // 四定回删与四因子一样清脏尾巴（各0.1），避免金额小数渗进展开
  if(!txtFourLaneIsDing(lane))shot=txtFourNormalizeFactorAttackShot(shot);
  else shot=stripAttackShotJunkTail(stripAttackShotPeriods(shot));
  // 故意不传 panelThreeDuishuPair：不覆盖攻击语里的除对数
  var converted=null;
  try{
    converted=api.convert(shot,{});
  }catch(err){
    throw txtPositionMakeError("四定攻击语展开异常："+String(err&&err.message||err),"FOUR_ATTACK_THROW",false);
  }
  if(!converted||converted.ok!==true){
    throw txtPositionMakeError("四定攻击语展开失败："+String(converted&&converted.message||"未识别攻击语"),"FOUR_ATTACK_PARSE",false);
  }
  var codes=String(converted.text||"").trim().split(/\s+/).filter(function(token){return /^\d{4}$/.test(token);});
  if(!codes.length){
    throw txtPositionMakeError("攻击语展开后没有四位号码，禁止回删","FOUR_ATTACK_EMPTY",false);
  }
  if(codes.length!==Number(converted.count||0)){
    throw txtPositionMakeError("攻击语展开计数不一致：标记 "+converted.count+"，实际 "+codes.length,"FOUR_ATTACK_COUNT",false);
  }
  var uniq={};
  codes.forEach(function(code){uniq[code]=true;});
  var list=Object.keys(uniq).sort();
  if(list.length!==codes.length){
    throw txtPositionMakeError("攻击语展开含重复四位码，已停止（拒绝糊弄）","FOUR_ATTACK_DUP",false);
  }
  return {
    codes:list,
    count:list.length,
    note:String(converted.note||""),
    modelText:String(converted.modelText||raw||""),
    source:String(converted.source||"attack")
  };
}
function txtFourParseNumberDump(raw){
  var text=String(raw||"");
  var matches=text.match(/\d{4}/g)||[];
  var uniq={};
  var list=[];
  matches.forEach(function(code){
    if(!uniq[code]){
      uniq[code]=true;
      list.push(code);
    }
  });
  list.sort();
  return list;
}
function txtFourPoolFromCodes(codes,note,source,mark){
  var list=[];
  var uniq={};
  (Array.isArray(codes)?codes:[]).forEach(function(code){
    var c=String(code||"");
    if(!/^\d{4}$/.test(c)||uniq[c])return;
    uniq[c]=true;
    list.push(c);
  });
