function txtFourBackdeleteRun(opts){
  opts=opts||{};
  var lane=txtFourLaneNormalize(opts.lane||(opts.candidatePool?TXT_FOUR_LANE_FACTOR_EXCLUDE:TXT_FOUR_LANE_DING));
  txtFourLaneSetActive(lane);
  var content=$(txtFourLaneContentId(lane));
  var laneLabel=txtFourLaneIsDing(lane)?"四定框架":"混四因子";
  if(txtFourBackdeleteBusy){
    if(txtFourLaneIsDing(lane))txtFourAttackSetStatus(laneLabel+"回删正在执行，请稍候。","err");
    else txtFourFactorSetStatus(laneLabel+"回删正在执行，请稍候。","err");
    return Promise.resolve({ok:false,busy:true});
  }
  if(txtFourLaneIsDing(lane)){
    try{txtFourAttackSetStatus("四定回删已点到：正在展开四定框架攻击语…");}catch(eKick){}
  }else{
    txtFourFactorSetStatus("混四因子回删已点到：正在拉池…");
    try{if(typeof txtFourGotoThrower==="function")txtFourGotoThrower({smooth:false});}catch(eGo){}
  }
  var data=window.__penta5TxtState||{};
  var period=String(opts.expectedPeriod||txtPositionLatestPeriod(data)||"");
  var force=opts.force===true;
  var stickyPre=txtFourStickyLoad({lane:lane});
  if(stickyPre&&Array.isArray(stickyPre.codes)&&stickyPre.codes.length&&period&&txtFourPeriodNewer(period,stickyPre.basePeriod)){
    txtFourStickyAdvance(txtFourLatestDraw(data),data,lane);
    txtSetStatus("新一期 "+period+"："+laneLabel+"上期已比对结算，剩码保留。");
  }else if(txtFourClearPreviousPeriodSticky(period,"run-new-period",lane)){
    txtSetStatus("新一期 "+period+"："+laneLabel+"粘码已结算推进。");
  }
  var sticky=txtFourStickyLoad({lane:lane});
  var hasSticky=!!(sticky&&Array.isArray(sticky.codes)&&sticky.codes.length);
  if(!period){
    if(content)setHtml(content,'<div style="color:#b91c1c;font-weight:800;">当前开奖期号为空，禁止回删。</div>'+txtFourBackdeleteActionButtonsHtml(hasSticky,lane));
    return Promise.resolve({ok:false,code:"LATEST_PERIOD_PENDING"});
  }
  if(!force&&hasSticky){
    var stickyResult=txtFourResultFromSticky(sticky);
    stickyResult.poolLane=lane;
    window.__penta5FourBackdeleteLast=stickyResult;
    txtFourVerifyRefreshLane(data,lane);
    if(stickyResult)txtFourBackdeleteRender(stickyResult);
    txtSetStatus(laneLabel+"：已用粘码刷新核对（未换新码）。要重扫请点「全量重生成」。");
    return Promise.resolve(Object.assign({ok:true,stickyRefresh:true},stickyResult||{}));
  }
  var limit=txtFourHistoryLimitSave(txtFourHistoryLimitGet());
  var candidatePool=null;
  var extMem=txtFourLaneExternalMem(lane);
  var extPool=window[extMem]||null;
  if(opts.candidatePool&&Array.isArray(opts.candidatePool.codes)&&opts.candidatePool.codes.length){
    try{
      candidatePool=txtFourPoolFromCodes(
        opts.candidatePool.codes,
        opts.candidatePool.note||opts.candidatePool.mark||"外部号码池",
        opts.candidatePool.source||"external",
        opts.candidatePool.mark||""
      );
      if(opts.candidatePool.mark)candidatePool.mark=String(opts.candidatePool.mark);
      if(opts.candidatePool.modelId!=null)candidatePool.modelId=opts.candidatePool.modelId;
    }catch(errExt){
      var extMsg=errExt&&errExt.message?errExt.message:String(errExt||"外部号码池无效");
      if(content)setHtml(content,'<div style="color:#b91c1c;font-weight:800;">'+txtEsc(extMsg)+'</div>'+txtFourBackdeleteActionButtonsHtml(hasSticky,lane));
      if(txtFourLaneIsDing(lane))txtFourAttackSetStatus(laneLabel+"回删已停止："+extMsg,"err");
      else txtFourFactorSetStatus(laneLabel+"回删已停止："+extMsg,"err");
      return Promise.resolve({ok:false,error:extMsg,code:errExt&&errExt.code||"FOUR_EXTERNAL_POOL"});
    }
  }else if(!txtFourLaneIsDing(lane)&&window.__penta5FourExternalPool&&Array.isArray(window.__penta5FourExternalPool.codes)&&window.__penta5FourExternalPool.codes.length){
    extPool=window.__penta5FourExternalPool;
    candidatePool=extPool;
  }else if(extPool&&Array.isArray(extPool.codes)&&extPool.codes.length){
    var attackPeek=txtFourLaneIsDing(lane)?txtFourAttackTextResolve():"";
    var dumpPeek=txtFourParseNumberDump(attackPeek);
    var peekDigitOnly=String(attackPeek||"").replace(/\s+/g,"");
    var peekDumpMode=false;
    if(dumpPeek.length>=100&&peekDigitOnly.length>0){
      peekDumpMode=(dumpPeek.join("").length/peekDigitOnly.length)>=0.9;
    }
    var peekMatchesExt=dumpPeek.length&&txtFourCodeListsEqual(dumpPeek.slice().sort(),extPool.codes.map(String).slice().sort());
    if(opts.useExternalPool===true||!String(attackPeek||"").trim()||peekMatchesExt){
      candidatePool=extPool;
    }else if(peekDumpMode){
      try{
        candidatePool=txtFourResolveMarkedPool(dumpPeek,"手贴/灌入号码池 "+dumpPeek.length+" 组",{lane:lane});
      }catch(errMix){
        var mixMsg=errMix&&errMix.message?errMix.message:String(errMix||"号码池无效");
        if(content)setHtml(content,'<div style="color:#b91c1c;font-weight:800;">'+txtEsc(mixMsg)+'</div>'+txtFourBackdeleteActionButtonsHtml(hasSticky,lane));
        txtFourAttackSetStatus(laneLabel+"回删已停止："+mixMsg,"err");
        return Promise.resolve({ok:false,error:mixMsg,code:errMix&&errMix.code||"FOUR_NUMBER_DUMP"});
      }
    }
  }
  if(!candidatePool){
    if(!txtFourLaneIsDing(lane)){
      if(content)setHtml(content,'<div style="color:#b91c1c;font-weight:800;">混四因子回删：请先「装载排除转发池」。</div>'+txtFourBackdeleteActionButtonsHtml(hasSticky,lane));
      txtFourFactorSetStatus("混四因子回删已停止：请先装载排除池。","err");
      return Promise.resolve({ok:false,code:"FOUR_FACTOR_POOL_MISSING"});
    }
    var attackText=txtFourAttackTextResolve();
    var dumpCodes=txtFourParseNumberDump(attackText);
    var dumpMode=false;
    if(dumpCodes.length>=100){
      var digitOnly=String(attackText||"").replace(/\s+/g,"");
      var covered=dumpCodes.join("").length;
      if(digitOnly.length>0&&covered/digitOnly.length>=0.9)dumpMode=true;
    }
    if(dumpMode){
      try{
        candidatePool=txtFourResolveMarkedPool(dumpCodes,"手贴/灌入号码池 "+dumpCodes.length+" 组",{lane:lane});
      }catch(errDump){
        var dumpMsg=errDump&&errDump.message?errDump.message:String(errDump||"号码池无效");
        if(content)setHtml(content,'<div style="color:#b91c1c;font-weight:800;">'+txtEsc(dumpMsg)+'</div>'+txtFourBackdeleteActionButtonsHtml(hasSticky,lane));
        txtFourAttackSetStatus("四定回删已停止："+dumpMsg,"err");
        return Promise.resolve({ok:false,error:dumpMsg,code:errDump&&errDump.code||"FOUR_NUMBER_DUMP"});
      }
    }else{
      if(!attackText){
        if(content)setHtml(content,'<div style="color:#b91c1c;font-weight:800;">缺少四定框架攻击语：请点「填入四定框架攻击语」或手贴后再回删。</div>'+txtFourBackdeleteActionButtonsHtml(hasSticky,lane));
        txtFourAttackSetStatus("四定回删已停止：缺少四定框架攻击语。","err");
        return Promise.resolve({ok:false,code:"FOUR_ATTACK_MISSING"});
      }
      try{
        candidatePool=txtFourGenerateCandidatesFromAttack(attackText,{lane:lane});
        candidatePool.mark=candidatePool.mark||"四定框架攻击语";
      }catch(errPool){
        var poolMsg=errPool&&errPool.message?errPool.message:String(errPool||"攻击语展开失败");
        if(content)setHtml(content,'<div style="color:#b91c1c;font-weight:800;">'+txtEsc(poolMsg)+'</div>'+txtFourBackdeleteActionButtonsHtml(hasSticky,lane));
        txtFourAttackSetStatus("四定回删已停止："+poolMsg,"err");
        return Promise.resolve({ok:false,error:poolMsg,code:errPool&&errPool.code||"FOUR_ATTACK_PARSE"});
      }
      var inputEl=$("txtFourAttackInput");
      if(inputEl&&!String(inputEl.value||"").trim())inputEl.value=attackText;
    }
  }
  if(candidatePool&&!txtFourLaneIsDing(lane)&&extPool&&Array.isArray(extPool.codes)){
    var extCodes=extPool.codes.map(String).slice().sort();
    var curCodes=(candidatePool.codes||[]).map(String).slice().sort();
    if(candidatePool.mark&&extPool.mark&&candidatePool.mark===extPool.mark&&!txtFourCodeListsEqual(curCodes,extCodes)){
