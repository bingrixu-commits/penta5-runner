function restorePanelCollapsibles(root){
  var scope=root&&root.querySelectorAll?root:document;
  var toggles=scope.querySelectorAll("[data-collapse-toggle]");
  for(var i=0;i<toggles.length;i++){
    var toggle=toggles[i];
    var id=toggle.getAttribute("data-collapse-toggle");
    if(!id)continue;
    var body=(root&&root.querySelector)
      ?root.querySelector('[data-collapse-body="'+id+'"]')
      :document.querySelector('[data-collapse-body="'+id+'"]');
    if(!body&&root!==document)body=document.querySelector('[data-collapse-body="'+id+'"]');
    if(!body)continue;
    var defaultCollapsed=toggle.getAttribute("data-collapse-default")==="1";
    panelCollapseApply(toggle,body,panelCollapseIsStored(id,defaultCollapsed));
  }
}
