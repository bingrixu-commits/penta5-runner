function panelOpenNavTarget(hash){
  var id=String(hash||"").replace(/^#/,"");
  if(!id)return null;
  var el=document.getElementById(id);
  if(!el)return null;
  if(id==="practiceModelBox"||id==="section-practice"){
    panelExpandCollapseId("practiceModel");
  }
  if(id==="section-singlePosition"||id==="txtTwoRemainContent"||id==="txtThreeRemainContent"){
    panelExpandCollapseId("txtConvert");
    panelExpandCollapseId("txtThreeRemainTop");
  }
  if(id==="txtConvertBox"||id==="txtThreeRemainTopBox"||id==="txtFourRemainTopBox"){
    panelExpandCollapseId("txtConvert");
    if(id==="txtThreeRemainTopBox")panelExpandCollapseId("txtThreeRemainTop");
    if(id==="txtFourRemainTopBox")panelExpandCollapseId("txtFourRemainTop");
    if(id==="txtFourThrowTopBox")panelExpandCollapseId("txtFourThrowTop");
  }
  if(id==="frameworkVisibleMount"||id==="fourDingFrameworkBox"||id==="twoDigitAvoidGroupBox"||id==="brotherNumberFrameworkBox"||id==="section-framework-visible-label"){
    if(id==="fourDingFrameworkBox")panelExpandCollapseId("fourDingFramework");
    if(id==="brotherNumberFrameworkBox")panelExpandCollapseId("brotherNumberFramework");
    if(id==="frameworkVisibleMount"||id==="section-framework-visible-label"){
      panelExpandCollapseId("fourDingFramework");
      panelExpandCollapseId("brotherNumberFramework");
    }
  }
  // 三定框架已下线：导航/框架卡展开逻辑移除
  if(id==="section-history")panelExpandCollapseId("history");
  var node=el;
  while(node&&node!==document.body){
    if(node.getAttribute){
      var collapseId=node.getAttribute("data-collapse-body");
      if(collapseId)panelExpandCollapseId(collapseId);
    }
    node=node.parentElement;
  }
  // anti-jump: 禁止 smooth（会与自动重绘叠成漂移）；滚完清掉 hash，避免残留锚点反复对齐
  try{el.scrollIntoView({behavior:"auto",block:"start"});}catch(e){try{el.scrollIntoView(true);}catch(e2){}}
  try{history.replaceState(null,"",location.pathname+(location.search||""));}catch(eHash){}
  return el;
}
