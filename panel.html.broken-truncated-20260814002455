function txtFourStickyWriteLastCheck(settleBase,poolLeft,latest,hit,evaluatedAt,lane){
  lane=txtFourLaneNormalize(lane||txtFourLaneActive());
  var sticky=txtFourStickyLoad({lane:lane});
  var snapshot=txtFourVerifyLoad({lane:lane})||{};
  // 中奖核对只同步粘码期号/剩组 + lastCheck，禁止重建 bitmap
  if(sticky&&Array.isArray(sticky.codes)){
    snapshot.basePeriod=String(sticky.basePeriod||"");
    snapshot.left=sticky.codes.length;
    snapshot.scanned=Number(sticky.scanned||snapshot.scanned||0);
    snapshot.deletedUnique=Number(sticky.deletedUnique||snapshot.deletedUnique||0);
    snapshot.evaluated=false;
    snapshot.targetPeriod="";
    snapshot.targetCode="";
    snapshot.hit=null;
  }
  if(!snapshot.basePeriod)return null;
  snapshot.lastCheck={
    basePeriod:String(settleBase||""),
    left:Number(poolLeft||0),
    targetPeriod:String(latest&&latest.period||""),
    targetCode:String(latest&&latest.code||""),
    hit:hit===true,
    evaluatedAt:evaluatedAt||Date.now()
  };
  txtFourVerifySave(snapshot,{lane:lane});
  return snapshot;
}
function txtFourStickyAdvance(latest,data,lane){
  latest=latest||txtFourLatestDraw(data);
  if(lane==null||lane===undefined){
    var outDing=txtFourStickyAdvance(latest,data,TXT_FOUR_LANE_DING);
    var outFactor=txtFourStickyAdvance(latest,data,TXT_FOUR_LANE_FACTOR_EXCLUDE);
    return txtFourLaneActive()===TXT_FOUR_LANE_DING?outDing:outFactor;
  }
  lane=txtFourLaneNormalize(lane);
  var sticky=txtFourStickyLoad({lane:lane});
  if(!sticky||!Array.isArray(sticky.codes)||!sticky.codes.length)return sticky;
  if(!latest.period||!/^\d{4}$/.test(String(latest.code||"")))return sticky;
  if(!txtFourPeriodNewer(latest.period,sticky.basePeriod))return sticky;
  var store=txtFourStatsLoad();
  var alreadyEntry=null;
  var stickyLimit=txtFourHistoryLimitNormalize(sticky.historyLimit||txtFourHistoryLimitGet());
  var evaluated=store.evaluated||[];
  for(var ei=0;ei<evaluated.length;ei++){
    var item=evaluated[ei];
    if(item&&item.evaluated===true
      &&txtFourLaneNormalize(item.lane)===lane
      &&String(item.targetPeriod||"")===String(latest.period)
      &&txtFourHistoryLimitNormalize(item.historyLimit)===stickyLimit){
      alreadyEntry=item;
      break;
    }
  }
  if(alreadyEntry){
    // 本档本期已记过：只刷新 lastCheck，剩码继续留着给转发/下期再用
    txtFourStickyWriteLastCheck(
      alreadyEntry.basePeriod,
      sticky.codes.length,
      latest,
      alreadyEntry.hit===true,
      alreadyEntry.evaluatedAt||Date.now(),
      lane
    );
    if(String(sticky.basePeriod||"")!==String(latest.period)){
      sticky.basePeriod=String(latest.period);
      sticky.left=sticky.codes.length;
      txtFourStickySave(sticky,{lane:lane});
    }
    return sticky;
  }
  var settleBase=String(sticky.basePeriod||"");
  var poolLeft=sticky.codes.length;
  var target=String(latest.code);
  // 核对口径：开奖码在装载池里=中（四因子默认排除池=正路盖全）；不在=不中
  var inRemain=false;
  for(var ci=0;ci<sticky.codes.length;ci++){
    if(String(sticky.codes[ci])===target){inRemain=true;break;}
  }
  var hit=inRemain===true;
  if(inRemain){
    sticky.codes=sticky.codes.filter(function(code){return String(code)!==target;});
  }
  sticky.left=sticky.codes.length;
  sticky.basePeriod=String(latest.period);
  var evaluatedAt=Date.now();
  var entry={
    lane:lane,
    basePeriod:settleBase,
    targetPeriod:String(latest.period),
    targetCode:target,
    targetDay:txtFourStatsTodayKey(data),
    hit:hit===true,
    inRemain:inRemain===true,
    left:poolLeft,
    historyLimit:Number(sticky.historyLimit||txtFourHistoryLimitGet()),
    evaluated:true,
    evaluatedAt:evaluatedAt
  };
  txtFourStatsAppend(entry);
  // 跨期只结算：命中删那一码，剩码保留继续转发/下期再用（禁止清零逼换码）
  txtFourStickyWriteLastCheck(settleBase,poolLeft,latest,hit===true,evaluatedAt,lane);
  txtFourStickySave(sticky,{lane:lane});
  try{
    var snap=txtFourVerifyLoad({lane:lane})||{};
    snap.basePeriod=String(latest.period);
    snap.left=sticky.codes.length;
    snap.evaluated=false;
    snap.targetPeriod="";
    snap.targetCode="";
    snap.hit=null;
    txtFourVerifySave(snap,{lane:lane});
  }catch(eKeep){}
  if(sticky.mark&&!txtFourLaneIsDing(lane))txtFourSetPoolMark(sticky.mark,sticky.left,sticky.basePeriod);
  txtSetStatus((txtFourLaneIsDing(lane)?"四定框架":"混四因子")+"开奖比对："+(hit?"中":"不中")+"（"+target+"）。剩 "+sticky.codes.length+" 组。");
  return sticky;
}
function txtFourVerifyEvaluate(snapshot,latest,opts){
  opts=opts||{};
  latest=latest||txtFourLatestDraw();
  var lane=txtFourLaneNormalize(opts.lane||txtFourLaneActive());
  if(opts.skipAdvance!==true)txtFourStickyAdvance(latest,null,lane);
  var sticky=txtFourStickyLoad({lane:lane});
  if(sticky&&Array.isArray(sticky.codes)&&sticky.codes.length){
    snapshot=txtFourVerifyLoad({lane:lane})||snapshot||{};
    if(!snapshot.basePeriod||String(snapshot.basePeriod||"")!==String(sticky.basePeriod||"")||Number(snapshot.left||0)!==sticky.codes.length){
      snapshot.basePeriod=String(sticky.basePeriod||"");
      snapshot.left=sticky.codes.length;
      snapshot.scanned=Number(sticky.scanned||snapshot.scanned||0);
      snapshot.deletedUnique=Number(sticky.deletedUnique||snapshot.deletedUnique||0);
      snapshot.evaluated=false;
      snapshot.targetPeriod="";
      snapshot.targetCode="";
      snapshot.hit=null;
      txtFourVerifySave(snapshot,{lane:lane});
    }
    return snapshot;
  }
  snapshot=txtFourVerifyLoad({lane:lane})||snapshot;
  if(!snapshot||!snapshot.basePeriod||!snapshot.bitmap)return snapshot||null;
  if(!latest.period||!/^\d{4}$/.test(String(latest.code||"")))return snapshot;
  if(!txtFourPeriodNewer(latest.period,snapshot.basePeriod))return snapshot;
  if(snapshot.evaluated===true&&String(snapshot.targetPeriod||"")===String(latest.period)&&typeof snapshot.hit==="boolean"){
    snapshot.lastCheck={
      basePeriod:String(snapshot.basePeriod),
      left:Number(snapshot.left||0),
      targetPeriod:String(snapshot.targetPeriod),
      targetCode:String(snapshot.targetCode||""),
      hit:snapshot.hit===true,
      evaluatedAt:snapshot.evaluatedAt||Date.now()
    };
    txtFourVerifySave(snapshot,{lane:lane});
    return snapshot;
  }
  snapshot.targetPeriod=String(latest.period);
  snapshot.targetCode=String(latest.code);
  snapshot.hit=txtFourBitmapHas(snapshot.bitmap,snapshot.targetCode)===true;
  snapshot.evaluated=true;
  snapshot.evaluatedAt=Date.now();
  snapshot.lastCheck={
    basePeriod:String(snapshot.basePeriod),
    left:Number(snapshot.left||0),
    targetPeriod:String(snapshot.targetPeriod),
    targetCode:String(snapshot.targetCode),
    hit:snapshot.hit===true,
    evaluatedAt:snapshot.evaluatedAt
  };
  txtFourVerifySave(snapshot,{lane:lane});
  return snapshot;
}
function txtFourVerifySaveFromResult(result){
  if(!result||result.ok!==true||!result.expectedPeriod)return null;
  var lane=txtFourLaneNormalize(result.poolLane||txtFourLaneActive());
  var prev=txtFourVerifyLoad({lane:lane})||{};
  var lastCheck=prev.lastCheck||null;
  if(prev.evaluated===true&&typeof prev.hit==="boolean"){
    lastCheck={
      basePeriod:String(prev.basePeriod||""),
      left:Number(prev.left||0),
      targetPeriod:String(prev.targetPeriod||""),
      targetCode:String(prev.targetCode||""),
      hit:prev.hit===true,
      evaluatedAt:prev.evaluatedAt||Date.now()
    };
  }
  var snapshot={
    basePeriod:String(result.expectedPeriod),
    left:Number(result.left||0),
    deletedUnique:Number(result.deletedUnique||0),
    scanned:Number(result.scanned||0),
    createdAt:Date.now(),
    evaluated:false,
    targetPeriod:"",
    targetCode:"",
    hit:null,
    lastCheck:lastCheck,
    source:"sticky",
    poolLane:lane
  };
  txtFourVerifySave(snapshot,{lane:lane});
  return snapshot;
}
function txtFourVerifyRefreshLane(data,lane){
  data=data||window.__penta5TxtState||{};
  lane=txtFourLaneNormalize(lane||txtFourLaneActive());
  var latest=txtFourLatestDraw(data);
  var stickyBefore=txtFourStickyLoad({lane:lane});
  var beforeSig=stickyBefore
    ? (String(stickyBefore.basePeriod||"")+"|"+String((stickyBefore.codes&&stickyBefore.codes.length)||stickyBefore.left||0))
    : "";
  var sticky=txtFourStickyAdvance(latest,data,lane);
  var afterSig=sticky
    ? (String(sticky.basePeriod||"")+"|"+String((sticky.codes&&sticky.codes.length)||sticky.left||0))
    : "";
  var needFullRender=false;
  if(sticky&&Array.isArray(sticky.codes)&&sticky.codes.length){
    var stickyResult=txtFourResultFromSticky(sticky);
    if(stickyResult){
      stickyResult.poolLane=lane;
      if(!txtFourLaneIsDing(lane)){
        var light=txtFourResultFromSticky(sticky,{light:true});
        if(light)window.__penta5FourBackdeleteLast=light;
      }
      needFullRender=!window.__penta5FourBackdeleteRenderedSticky||beforeSig!==afterSig;
      if(needFullRender){
        txtFourBackdeleteRender(stickyResult);
        window.__penta5FourBackdeleteRenderedSticky=true;
        window.__penta5FourStickyRenderSig=afterSig;
      }
    }
  }
  var snapshot=txtFourVerifyEvaluate(txtFourVerifyLoad({lane:lane}),latest,{skipAdvance:true,lane:lane});
  txtFourVerifyRender(snapshot,latest,lane);
  return {snapshot:snapshot,latest:latest,sticky:sticky,fullRender:needFullRender===true,lane:lane};
}
function txtFourVerifyRefresh(data){
  data=data||window.__penta5TxtState||{};
  txtFourLaneMigrateLegacyCachesOnce();
  txtFourHistoryLimitSyncInput();
  try{txtFourRateRefresh(data,false);}catch(eRate){}
  if(!window.__penta5FourThrowUrlsLoaded&&typeof txtFourThrowLoadUrls==="function"){
    window.__penta5FourThrowUrlsLoaded=true;
    txtFourThrowLoadUrls();
  }
  if(typeof txtFourThrowSyncButtons==="function")txtFourThrowSyncButtons();
  txtFourVerifyRefreshLane(data,TXT_FOUR_LANE_DING);
  var factorOut=txtFourVerifyRefreshLane(data,TXT_FOUR_LANE_FACTOR_EXCLUDE);
  txtFourStatsRender(data);
  return factorOut;
}
function stripAttackShotPeriods(text){
  return String(text||"").replace(/。/g,"");
}
/** 脏尾巴：各0.1 / 各 。 → 各（框架语末尾常粘金额/小数） */
function stripAttackShotJunkTail(text){
  var s=String(text||"");
  s=s.replace(/各[\s\u3000]*[0-9]+(?:\.[0-9]+)?\s*$/,"各");
  s=s.replace(/各[\s\u3000]*[。．.]+$/,"各");
  return s;
}
/** 四因子旧口令 千除7 → 除千7（转换器只认除+位；旧序会假展开成 10000） */
function txtFourNormalizeFactorAttackShot(text){
  return stripAttackShotJunkTail(String(text||"").replace(/(千位|百位|十位|个位|千|百|十|个)除([0-9])/g,"除$1$2"));
}
