function txtFourStatsStreak(rows){
  var list=Array.isArray(rows)?rows.slice():[];
  list.sort(function(a,b){
    var pa=String(a&&a.targetPeriod||""),pb=String(b&&b.targetPeriod||"");
    if(pa.length!==pb.length)return pa.length-pb.length;
    return pa<pb?-1:pa>pb?1:0;
  });
  var hit=0,total=0,maxWin=0,maxMiss=0,curWin=0,curMiss=0;
  list.forEach(function(row){
    if(!row||typeof row.hit!=="boolean")return;
    total+=1;
    if(row.hit){
      hit+=1;curWin+=1;curMiss=0;
      if(curWin>maxWin)maxWin=curWin;
    }else{
      curMiss+=1;curWin=0;
      if(curMiss>maxMiss)maxMiss=curMiss;
    }
  });
  var currentWin=0,currentMiss=0;
  if(list.length){
    if(list[list.length-1].hit===true)currentWin=curWin;
    else if(list[list.length-1].hit===false)currentMiss=curMiss;
  }
  return {
    total:total,
    hit:hit,
    rate:total?Number((hit*100/total).toFixed(2)):null,
    maxWin:maxWin,
    maxMiss:maxMiss,
    currentWin:currentWin,
    currentMiss:currentMiss
  };
}
