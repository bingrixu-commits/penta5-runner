function txtFourFactorShotFromOwn(own){
  if(!own||own.ok===false)return "";
  var shot=String(own.shot||"").trim();
  if(shot)return txtFourNormalizeFactorAttackShot(stripAttackShotPeriods(shot));
  if(Array.isArray(own.dropKills)&&own.dropKills.length){
    return txtFourNormalizeFactorAttackShot(stripAttackShotPeriods(own.dropKills.map(function(k){return k&&k.attack?String(k.attack):"";}).filter(Boolean).join("")));
  }
  return "";
}
function txtFourRewriteKeepPoolDigit(shot,label,digit){
  var d=String(digit||"").replace(/\D/g,"").charAt(0);
  if(!d)return String(shot||"");
  var re=new RegExp(label+"(\\d+)");
  var s=String(shot||"");
  if(re.test(s))return s.replace(re,label+d);
  return s+label+"出"+d;
}
function txtFourBuildReverseAttackText(data){
  data=data||window.__penta5TxtState||state||{};
  var pred=data.currentPrediction||{};
  var fw=$("frameworkAttackFourDing");
  var base=fw?String(fw.value||"").trim():"";
  if(!base){
    var snap=pred.fourDingFramework||{};
    base=String(snap.shot||"").trim();
  }
  if(!base){
    var killBox=document.querySelector("[id^=\"frameworkAttack\"]");
    if(killBox)base=String(killBox.value||killBox.textContent||"").trim();
  }
  base=stripAttackShotPeriods(base);
  var posSpecs=[
    {key:"wan",label:"千"},
    {key:"qian",label:"百"},
    {key:"bai",label:"十"},
    {key:"shi",label:"个"}
  ];
  var appearParts=[];
  var shot=base;
  var any=false;
  posSpecs.forEach(function(spec){
    var digit="";
    try{digit=String(fourPosExcludeDigit(pred,spec.key)||"");}catch(e0){}
    digit=digit.replace(/\D/g,"").charAt(0);
    if(!digit){
      var pk=pred.positionKills||{};
      var entry=pk[spec.key]||{};
      digit=String(entry.recommendDigit!=null?entry.recommendDigit:(entry.selectedDigit!=null?entry.selectedDigit:(entry.main!=null?entry.main:""))).replace(/\D/g,"").charAt(0);
    }
    var decide=typeof posExcludeReverseDecide==="function"?posExcludeReverseDecide(data,spec.key,digit,null):null;
    if(!(decide&&decide.active&&decide.appearDigit))return;
    any=true;
    appearParts.push(spec.label+"出"+decide.appearDigit);
    if(shot)shot=txtFourRewriteKeepPoolDigit(shot,spec.label,decide.appearDigit);
  });
  var heweiMap=[
    {key:"total",field:"totalHeweiKill",label:"出千百十个合",name:"合尾综合"},
    {key:"threeFour",field:"threeFourHeweiKill",label:"出千百十个合",name:"三四字"},
    {key:"wanQianBai",field:"wanQianBaiHeweiKill",label:"出千百十合",name:"千百十"},
    {key:"qianBaiShi",field:"qianBaiShiHeweiKill",label:"出百十个合",name:"百十个"},
    {key:"wanQianGe",field:"wanQianGeHeweiKill",label:"出千百个合",name:"千百个"},
    {key:"wanBaiShi",field:"wanBaiShiHeweiKill",label:"出千十个合",name:"千十个"},
    {key:"wanQianBaiShi",field:"wanQianBaiShiHeweiKill",label:"出千百十个合",name:"千百十个"}
  ];
  heweiMap.forEach(function(cfg){
    var digit=String(pred[cfg.field]==null?"":pred[cfg.field]).replace(/\D/g,"").charAt(0);
    if(!digit)return;
    var d=typeof heweiKillReverseDecide==="function"?heweiKillReverseDecide(data,cfg.key,digit,cfg.name):null;
    if(!(d&&d.active&&d.appearDigit))return;
    any=true;
    var tok=cfg.label+d.appearDigit;
    appearParts.push(tok);
    if(String(shot||"").indexOf(tok)<0)shot=String(shot||"")+tok;
  });
  try{
    var items=pred.twoDigitAvoidGroup||pred.twoDigitAvoid||[];
    if(!Array.isArray(items)&&items&&Array.isArray(items.items))items=items.items;
    if(Array.isArray(items)){
      items.forEach(function(it,idx){
        var key=String(it&&it.key||("pair"+(idx+1)));
        var pair=String(it&&(it.code||it.pair||it.digits)||"").replace(/\D/g,"").slice(0,2);
        if(pair.length<2)return;
        var d=typeof pairKillReverseDecide==="function"?pairKillReverseDecide(data,key,pair,key):null;
        if(!(d&&d.active))return;
        var pair2=String(d.appearPair||d.killPair||pair).replace(/\D/g,"").slice(0,2);
        if(pair2.length<2)return;
        any=true;
        var tok="含对数"+pair2;
        appearParts.push(tok);
        if(String(shot||"").indexOf(tok)<0)shot=String(shot||"")+tok;
      });
    }
  }catch(ePairRev){}
  if(!any){
    posSpecs.forEach(function(spec){
      var digit="";
      try{digit=String(fourPosExcludeDigit(pred,spec.key)||"");}catch(e){}
      digit=digit.replace(/\D/g,"").charAt(0);
      if(!digit){
        var pk2=pred.positionKills||{};
        var entry2=pk2[spec.key]||{};
        digit=String(entry2.recommendDigit!=null?entry2.recommendDigit:(entry2.selectedDigit!=null?entry2.selectedDigit:(entry2.main!=null?entry2.main:""))).replace(/\D/g,"").charAt(0);
      }
      if(!digit)return;
      any=true;
      appearParts.push(spec.label+"出"+digit);
      if(shot)shot=txtFourRewriteKeepPoolDigit(shot,spec.label,digit);
      else shot=String(shot||"")+spec.label+"出"+digit;
    });
  }
  if(!shot&&appearParts.length){
    // 无框架底稿：拼完整保留池短射（千2百3十4个5四定…各）
    var keep={wan:"0123456789",qian:"0123456789",bai:"0123456789",shi:"0123456789"};
    var labelKey={千:"wan",百:"qian",十:"bai",个:"shi"};
    appearParts.forEach(function(p){
      var m=String(p||"").match(/^(千|百|十|个)出(\d)/);
      if(!m)return;
      keep[labelKey[m[1]]]=m[2];
    });
    shot="千"+keep.wan+"百"+keep.qian+"十"+keep.bai+"个"+keep.shi+"四定";
    appearParts.forEach(function(p){
      if(/^出/.test(p)||/^含对数/.test(p))shot+=p;
    });
    shot+="各";
  }
  shot=stripAttackShotPeriods(shot);
  if(shot&&shot.charAt(shot.length-1)!=="各")shot+="各";
  return {ok:!!shot,shot:shot,parts:appearParts,any:any};
}
