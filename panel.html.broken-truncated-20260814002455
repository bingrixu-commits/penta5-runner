function txtFourApplyServerConfig(cfg){
  if(!cfg||typeof cfg!=="object")return;
  if(Array.isArray(cfg.presets)&&cfg.presets.length){
    var next=[];
    for(var i=0;i<cfg.presets.length;i++){
      var p=txtFourHistoryLimitNormalize(cfg.presets[i]);
      if(next.indexOf(p)<0)next.push(p);
    }
    if(next.length)TXT_FOUR_HISTORY_PRESETS=next.sort(function(a,b){return a-b;});
  }
  if(cfg.rateEval!=null&&isFinite(Number(cfg.rateEval)))TXT_FOUR_RATE_EVAL=Math.max(50,Math.min(2000,Math.floor(Number(cfg.rateEval))));
  if(cfg.historyLimit!=null){
    txtFourHistoryLimitSave(cfg.historyLimit,{skipServer:true});
  }
  if(cfg.rates&&cfg.rates.ok&&cfg.rates.byLimit){
    // server byLimit keys may be strings
    var byLimit={};
    Object.keys(cfg.rates.byLimit).forEach(function(k){
      byLimit[txtFourHistoryLimitNormalize(k)]=cfg.rates.byLimit[k];
    });
    TXT_FOUR_RATE_CACHE={
      ok:true,
      latestPeriod:String(cfg.rates.latestPeriod||""),
      evalLimit:Number(cfg.rates.evalLimit||TXT_FOUR_RATE_EVAL),
      scanned:Number(cfg.rates.scanned||0),
      byLimit:byLimit,
      at:cfg.rates.at||cfg.updatedAt||Date.now(),
      source:String(cfg.rates.source||"server")
    };
  }
  window.__penta5FourBackdeleteServerConfig=cfg;
  txtFourStatsRender(window.__penta5TxtState||{});
}
