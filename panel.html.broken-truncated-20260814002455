  for(var i=0;i<list.length;i++){
    if(txtThreeHitStatsEntryKey(list[i])===key){list[i]=entry;replaced=true;break;}
  }
  if(!replaced)list.push(entry);
  list.sort(function(a,b){
    var pa=String(a&&a.targetPeriod||""),pb=String(b&&b.targetPeriod||"");
    if(pa.length!==pb.length)return pb.length-pa.length;
