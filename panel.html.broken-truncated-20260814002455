function txtFourVerifySave(snapshot,opts){
  opts=opts||{};
  var lane=txtFourLaneNormalize(opts.lane||(snapshot&&snapshot.poolLane)||txtFourLaneActive());
  var memKey=txtFourLaneVerifyMem(lane);
  window[memKey]=snapshot||null;
  try{
    if(snapshot){
      if(snapshot.bitmap){
        var slim={};
        for(var k in snapshot){
          if(!Object.prototype.hasOwnProperty.call(snapshot,k))continue;
          if(k==="bitmap")continue;
          slim[k]=snapshot[k];
        }
        snapshot=slim;
        snapshot.poolLane=lane;
        window[memKey]=snapshot;
      }else{
        snapshot.poolLane=lane;
      }
      localStorage.setItem(txtFourLaneVerifyKey(lane),JSON.stringify(snapshot));
