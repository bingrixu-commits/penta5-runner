  var periodIndex={};
  (Array.isArray(rows)?rows:[]).forEach(function(row,index){periodIndex[txtStrictThreePeriod(row)]=index;});
  list.forEach(function(snapshot){
    if(!snapshot||snapshot.evaluated===true)return;
