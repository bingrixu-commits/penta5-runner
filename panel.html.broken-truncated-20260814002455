function txtThreeBuildPoolsFromAttack(raw){
  var api=window.Penta5AttackTxtConvert;
  if(!api||typeof api.normalizeThreeDingAttackText!=="function"||typeof api.threeDingFilterCandidates!=="function"){
    return {ok:false,message:"txt_attack_convert.js 未加载，无法解析三定攻击语。请 Ctrl+F5。"};
  }
  var text=String(raw||"").trim();
  if(!text)return {ok:false,message:"请先粘贴三定攻击语。"};
  var segments=[];
  if(typeof api.threeDingIndependentSegments==="function"){
    var seg=api.threeDingIndependentSegments(text);
    if(seg&&seg.ok===false)return {ok:false,message:seg.message||"攻击语分段失败"};
    segments=(seg&&seg.segments)||[text];
  }else{
    segments=text.split(/各+/).map(function(s){return String(s||"").trim();}).filter(Boolean);
    if(!segments.length)segments=[text];
  }
  var pools={};
  var notes=[];
  var shotRule=typeof api.shotRuleFromText==="function"?api.shotRuleFromText:(typeof txtShotRuleFromText==="function"?txtShotRuleFromText:null);
  for(var i=0;i<segments.length;i++){
    var part=segments[i];
    var prepared=api.normalizeThreeDingAttackText(part);
    if(prepared&&prepared.error)return {ok:false,message:prepared.error};
    if(!prepared||!prepared.ok)return {ok:false,message:"第"+(i+1)+"段未识别为三定攻击语（仅支持千百十/百十个等）。"};
