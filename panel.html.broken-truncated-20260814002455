    if(pa.length!==pb.length)return pa.length-pb.length;
    return pa<pb?-1:pa>pb?1:0;
  });
  var hit=0,total=0,maxWin=0,maxMiss=0,curWin=0,curMiss=0;
  list.forEach(function(row){
    if(!row||typeof row.hit!=="boolean")return;
