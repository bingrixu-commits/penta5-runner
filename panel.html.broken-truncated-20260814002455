      if(status===403)throw txtPositionMakeError("当前账号没有读取四定回删旧码的权限","PANEL_HISTORY_FORBIDDEN",false);
      if(status===503)throw txtPositionMakeError("四定回删：RDS 近 "+limit+" 期尚未就绪","RDS_HISTORY_NOT_READY",true);
